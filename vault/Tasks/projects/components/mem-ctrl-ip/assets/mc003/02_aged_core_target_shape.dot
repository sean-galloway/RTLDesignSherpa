// MC-003 aged-matrix pick core target shape
// House style per vault/handbook/authoring/block-diagrams.md.
// rankdir=LR because the cone is intentionally read left-to-right.
// Green = target additions; red is reserved for the failing diagram.
digraph aged_core_target_shape {
    graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.55", ranksep="1.00", splines=ortho,
           label="Target pick shape (pair-only winner + tag gate + store-boundary head pipe)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ----------------------------------------------------------------------
    // Left: entry store with per-fifo arrays
    // ----------------------------------------------------------------------
    entry_store [label="entry store\n16 age fifos (8 banks x rd/wr)\nmc_xddr2_entry_store",
                 fillcolor="white", group=C, width=2.4, height=1.5];

    startpoint [label="fifo array reg\nr_row / r_slot",
                fillcolor="#E2F0D9", group=C, width=1.4, fontsize=9];

    // ----------------------------------------------------------------------
    // Boundary cluster (store -> scheduler plane)
    // ----------------------------------------------------------------------
    subgraph cluster_boundary {
        label="store -> scheduler boundary";
        labelloc=b;
        labeljust=c;
        fontsize=10;
        style=dashed;
        color="black";
        bgcolor="white";
        p_top [style=invis, width=0.01, height=0.6, label=""];
        head_pipe [label="head pipe\n2-deep per bank\nhead / head2 registered\nat boundary",
                   fillcolor="#E2F0D9", group=C, width=1.5, fontsize=9];
        p_bot [style=invis, width=0.01, height=0.6, label=""];
    }

    // ----------------------------------------------------------------------
    // Scheduler side blocks (left to right)
    // ----------------------------------------------------------------------
    tag_gate [label="tag gate\nact ? rowop-readies OR : rdwr_ready",
              fillcolor="#E2F0D9", group=C, width=2.2];

    age_min [label="age-minimum tree\nfireable-only\n16 x 6-bit",
             fillcolor="#E2F0D9", group=C, width=2.2];

    matrix [label="16x16 matrix arbiter\nmc_cmd_arbiter - matrix",
            shape=invtrapezium, width=2.7, fillcolor="#BFD7EE", fontsize=11, group=C];

    endpoint [label="endpoint: r_winner {vld, is_rd, bank} / D\npick cone ~10 levels  11 bits",
              fillcolor="#E2F0D9", group=C, width=2.5, fontsize=9];

    fire_stage [label="fire stage\nJEDEC authority\nmc_bank_sched - fire",
                fillcolor="#E2F0D9", group=C, width=2.3];

    // ----------------------------------------------------------------------
    // Side note box
    // ----------------------------------------------------------------------
    risk_box [label="Open: tag-gate N=1 functional bug\n(winner never loads at sparse grants -\nrepro gate-1-0, probe data in evidence doc section 16);\nfix before build.",
              fillcolor="white", fontsize=9, shape=box, style=dashed, group=C];

    // ----------------------------------------------------------------------
    // Flows
    // ----------------------------------------------------------------------
    // head pipe breaks the combinational boundary (green)
    p_mid [shape=point, width=0.01, group=C];
    entry_store -> p_mid [color="green", penwidth=2.0,
                          xlabel="head + head2\n(valid + age[5:0] + act tag)"];
    p_mid -> head_pipe [color="green", penwidth=2.0];
    head_pipe -> tag_gate [color="green", penwidth=1.5,
                           xlabel="registered head view"];

    // small-field pick cone (green)
    tag_gate -> age_min [color="green", penwidth=1.5, xlabel="fireable valid + age"];
    age_min -> matrix [color="green", penwidth=1.5, xlabel="age==min requests"];
    matrix -> endpoint [color="green", penwidth=1.8, xlabel="grant"];

    // winner drives fire stage
    endpoint -> fire_stage [color="green", penwidth=1.5, xlabel="winner {vld,is_rd,bank}"];

    // fire stage reads live head from the store (green, its own route)
    entry_store -> fire_stage [color="green", style=dashed, penwidth=1.2,
                               constraint=false,
                               xlabel="fire-cycle comb, no register endpoint\nfire stage stays sole JEDEC authority"];

    // startpoint bubble attached to store
    startpoint -> entry_store [style=dashed, arrowhead=none];

    // note placement
    age_min -> risk_box [style=invis];

    // ----------------------------------------------------------------------
    // Rank pinning
    // ----------------------------------------------------------------------
    { rank=same; entry_store; startpoint; }
    entry_store -> startpoint [style=invis];

    { rank=same; tag_gate; age_min; matrix; endpoint; fire_stage; }
    tag_gate -> age_min -> matrix -> endpoint -> fire_stage [style=invis];

    // invisible vertical spine to keep the command column straight
    s0 [shape=point, style=invis, width=0.01, group=C];
    entry_store -> s0 -> p_mid -> head_pipe -> tag_gate -> age_min -> matrix -> endpoint -> fire_stage [style=invis, weight=10];
}
