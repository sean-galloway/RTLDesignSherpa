// MC-003 aged-matrix pick core failing cone
// House style per vault/handbook/authoring/block-diagrams.md.
// rankdir=LR because the cone is intentionally read left-to-right.
// Red = failing / critical path; green is reserved for the target diagram.
digraph aged_core_failing_cone {
    graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.95", splines=ortho,
           label="The aged-matrix pick core's failing cone (WNS -33.4 ns @75 MHz, 2026-10-19 build)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ----------------------------------------------------------------------
    // Left: entry store with per-fifo arrays
    // ----------------------------------------------------------------------
    entry_store [label="entry store\n16 age fifos (8 banks x rd/wr)\nmc_xddr2_entry_store",
                 fillcolor="white", group=C, width=2.6, height=1.5];

    startpoint [label="STARTPOINT\nfifo array reg\nr_row / r_slot\nfanout 92+",
                fillcolor="#FBE5D6", group=C, width=1.6, fontsize=9];

    // ----------------------------------------------------------------------
    // Boundary cluster (store -> scheduler plane)
    // ----------------------------------------------------------------------
    subgraph cluster_boundary {
        label="store -> scheduler boundary";
        labelloc=b;
        labeljust=c;
        fontsize=10;
        style=dashed;
        color="black";
        bgcolor="white";
        p_top [style=invis, width=0.01, height=0.6, label=""];
        p_cmd [shape=point, width=0.01, group=C];
        p_bot [style=invis, width=0.01, height=0.6, label=""];
    }

    // ----------------------------------------------------------------------
    // Scheduler side blocks (left to right)
    // ----------------------------------------------------------------------
    op_decode [label="per-bank op decode\n16x row-compare vs open-row image\n-> op[NOP/WR/PRE/ACT]",
               group=C, width=2.5];

    age_min [label="age-minimum tree\n16 x 6-bit", group=C, width=2.2];

    req_mask [label="request mask\nvalid && op!=NOP && age==min",
              group=C, width=2.2];

    matrix [label="16x16 matrix arbiter\nmc_cmd_arbiter - matrix",
            shape=invtrapezium, width=3.0, fillcolor="#BFD7EE", fontsize=11, group=C];

    payload_mux [label="16:1 winner payload mux\n38-bit (slot/row/col/id/last)",
                 group=C, width=2.4];

    endpoint [label="endpoint: r_winner[head payload] / D\n53 logic levels  81% routing  -33.4 ns",
              fillcolor="#F4B084", group=C, width=2.6, fontsize=9];

    // ----------------------------------------------------------------------
    // Side note boxes
    // ----------------------------------------------------------------------
    root_cause [label="Root cause: payload + live decode inside the pick cone\n+ comb head buses across the boundary;\nthe placer cannot co-locate store+fifos+scheduler\n(14.8k failing endpoints, domain-wide routing 80%).",
                fillcolor="white", fontsize=9, shape=box, style=dashed, group=C];

    // ----------------------------------------------------------------------
    // Flows
    // ----------------------------------------------------------------------
    // heavy head-bus arrow crossing the boundary
    entry_store -> p_cmd [dir=none, color="red", headclip=false, penwidth=2.4];
    p_cmd -> op_decode [color="red",
                        xlabel="per-bank head+head2 payload buses\n(~1300 wires: slot/row/col/id/last + age[5:0] + act, x16 pairs x 2)",
                        penwidth=2.4, tailclip=false];

    // critical path annotation (red dashed)
    op_decode -> age_min [color="red", style=dashed, penwidth=1.5, xlabel="age[5:0] + op"];
    age_min -> req_mask [color="red", style=dashed, penwidth=1.5, xlabel="min_age + candidate"];
    req_mask -> matrix [color="red", style=dashed, penwidth=1.5, xlabel="fireable requests"];
    matrix -> payload_mux [color="red", style=dashed, penwidth=1.8, xlabel="grant"];
    payload_mux -> endpoint [color="red", style=dashed, penwidth=1.8, xlabel="winner payload"];

    // startpoint bubble attached to store
    startpoint -> entry_store [style=dashed, arrowhead=none];

    // root cause note below the mask/matrix area
    req_mask -> root_cause [style=invis];
    matrix -> root_cause [style=invis];

    // ----------------------------------------------------------------------
    // Rank pinning
    // ----------------------------------------------------------------------
    { rank=same; entry_store; startpoint; }
    entry_store -> startpoint [style=invis];

    { rank=same; op_decode; age_min; req_mask; matrix; payload_mux; endpoint; }
    op_decode -> age_min -> req_mask -> matrix -> payload_mux -> endpoint [style=invis];

    // invisible vertical spine to keep the command column straight
    s0 [shape=point, style=invis, width=0.01, group=C];
    entry_store -> s0 -> p_cmd -> op_decode -> age_min -> req_mask -> matrix -> payload_mux -> endpoint [style=invis, weight=10];
}
