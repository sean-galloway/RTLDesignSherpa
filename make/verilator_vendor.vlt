`verilator_config
// Lint configuration for make/fpga_lint.mk: rules switched off only for
// source this repo does not write by hand -- AMD's IP library (by path) and
// one proven-legal PeakRDL pattern (by variable name). Hand-written RTL is
// never listed here: fix it (fpga_lint.mk, the notes above LINT_WAIVERS).
// (No comment here may begin with the tool's name: it reads that as a pragma.)

// AMD/Xilinx IP library source (the Vivado install), which a build lints when
// it reads a vendor IP's RTL directly (fabric-benchmark's axi_crossbar)
lint_off -rule WIDTH -file "*/Vivado/data/ip/*"

// PeakRDL regblocks: each field's always_comb writes its own member of the
// one `field_combo` struct (`field_combo.CTRL.GO.load_next` here,
// `field_combo.CTRL.STOP.next` there). That is legal -- the one-writer rule of
// always_comb (IEEE 1800-2023 9.2.2.2) is per longest static prefix, and the
// members are distinct -- but this tool flags the whole variable. Exempted by
// that variable's name only: any other multi-driven signal fails lint (Vivado
// reports none in a regblock; it did report the real ones, bridge BUG-022).
// (any file: some regblocks are not under generated/, e.g. retro_legacy_blocks'
// *_regs.sv). Simulations load this file too, through
// TBClasses.shared.verilator_cfg.FIELD_COMBO_VLT, in place of -Wno-MULTIDRIVEN.
lint_off -rule MULTIDRIVEN -file "*" -match "*'field_combo'*"
// OpenHW HPDcache (vendor/cv-hpdcache, PROVENANCE.md) and the PULP axi_pkg its
// memory-to-AXI adapters import (vendor/pulp-axi): upstream SV this repo does
// not write by hand. Two width casts in hpdcache_ctrl (a 1-bit zero assigned
// to a 23- and a 64-bit error-data bus) and one in axi_pkg's address function;
// the hand-written wrapper around them (ref_hpdcache_top) is linted in full.
lint_off -rule WIDTH -file "*/vendor/cv-hpdcache/*"
lint_off -rule WIDTH -file "*/vendor/pulp-axi/src/axi_pkg.sv"
// hpdcache's CMO/refill response mux is reported as an unoptimizable
// combinational loop (a simulator scheduling note, not a logic loop: the
// path closes through registered FIFO state); upstream's own waiver set
// accepts it, so it is accepted here for that tree only.
lint_off -rule UNOPTFLAT -file "*/vendor/cv-hpdcache/*"
// OpenHW CVA6 write-back data cache (vendor/cva6-dcache, PROVENANCE.md) and
// the PULP common cell it instantiates (lfsr_8bit): upstream SV this repo does
// not write by hand (width casts throughout its miss handler and AXI adapter);
// the hand-written wrapper around it (ref_cva6_dcache_top) is linted in full.
lint_off -rule WIDTH -file "*/vendor/cva6-dcache/*"
lint_off -rule WIDTH -file "*/vendor/pulp-common_cells/src/lfsr_8bit.sv"
// the same tree: an unlabelled generate loop (std_nbdcache), a response
// struct whose error bit no path drives (cache_ctrl), and the miss
// handler's AMO/miss response muxes that the scheduler reports as loops
lint_off -rule GENUNNAMED -file "*/vendor/cva6-dcache/*"
lint_off -rule UNDRIVEN -file "*/vendor/cva6-dcache/*"
lint_off -rule UNOPTFLAT -file "*/vendor/cva6-dcache/*"
