// math_bf16_multiplier block diagram - house style
// (vault/handbook/authoring/block-diagrams.md).
// Fully combinational. Operands enter at the top and are unpacked and
// classified; the three field paths then run side by side -- sign (thin left
// column), mantissa (center, the Dadda multiplier), exponent (right, the bias
// adder, which needs the mantissa's normalize bit). RNE rounding joins the
// mantissa and exponent, the special-case select applies the priority, and
// the packed result leaves through the output bar.
// Source of truth: rtl/math/math_bf16_multiplier.sv (generated by
// bin/rtl_generators/bf16/bf16_multiplier.py).
digraph math_bf16_multiplier {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="math_bf16_multiplier - BF16 x BF16 -> BF16, RNE, flush-to-zero (combinational)";

    // ---- inputs (white) ----
    a_in [label="Operand A\ni_a[15:0] = {sign, exp[7:0], mant[6:0]}", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    b_in [label="Operand B\ni_b[15:0] = {sign, exp[7:0], mant[6:0]}", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    // ---- unpack + classify ----
    unp [group=M, width=6.5, label="Unpack + Classify (combinational)\nsplit sign / exponent / mantissa of each operand\nzero, subnormal (flushed to zero), infinity, NaN\nnormal operands get the hidden 1", style="filled", fillcolor="white"];

    // ---- three field paths ----
    sgn  [group=S, label="Sign\nsign_a ^ sign_b", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    mm   [group=M, label="Mantissa Multiply\nmath_bf16_mantissa_mult - u_mant_mult\n8x8 Dadda tree with 4:2 compressors\n(math_multiplier_dadda_4to2_008)\nnormalize select, guard / round / sticky", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    ea   [group=E, label="Exponent Add\nmath_bf16_exponent_adder - u_exp_add\nexp_a + exp_b - 127 + needs_norm\nsaturates; overflow / underflow flags", style="filled", fillcolor="white"];

    // ---- rounding ----
    rnd  [group=M, label="Round to Nearest Even\nround up = G & (R | S | LSB)\nmantissa carry-out: exponent + 1", peripheries=2, style="filled", fillcolor="#D6E4F0"];

    // ---- special-case select ----
    sel  [group=M, width=8.2, label="Special-Case Select (priority)\nNaN or 0 x inf -> quiet NaN (invalid)  >  zero -> signed 0\n>  inf or overflow -> signed inf  >  underflow -> 0 (unless rounding\nreached the minimum normal)  >  else the rounded product", style="filled", fillcolor="white"];

    // ---- output bar ----
    bar  [label="Outputs\now_result[15:0] = {sign, exp, mant}   |   ow_overflow   |   ow_underflow   |   ow_invalid",
          fillcolor="white", width=8.5, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    // ---- flows ----
    a_in -> unp [xlabel="i_a"];
    b_in -> unp [xlabel="i_b"];
    unp -> sgn  [xlabel="sign_a, sign_b"];
    unp -> mm   [xlabel="mant_a, mant_b,\nis_normal"];
    unp -> ea   [xlabel="exp_a, exp_b"];
    mm  -> ea   [xlabel="needs_norm"];
    mm  -> rnd  [xlabel="mant[6:0], G, R, S"];
    ea  -> rnd  [xlabel="exp_sum"];
    rnd -> sel  [xlabel="rounded mant, exp"];
    ea  -> sel  [xlabel="overflow,\nunderflow"];
    sgn -> sel  [xlabel="result sign"];
    p_cls [shape=point, width=0.01, group=F];
    unp -> p_cls [arrowhead=none, headclip=false, style=dashed, color="#777777"];
    p_cls -> sel [style=dashed, color="#777777", tailclip=false, xlabel="zero / inf / NaN\nflags"];
    sel -> bar  [xlabel="result, flags", penwidth=1.8];

    // ---- rank pinning ----
    { rank=same; a_in; b_in; }
    { rank=same; sgn; mm; }
    { rank=same; ea; }
    { rank=same; rnd; p_cls; }
    a_in -> b_in [style=invis, minlen=3];
    sgn -> mm [style=invis, minlen=2];
    rnd -> p_cls [style=invis, minlen=9];
}
