// math_adder_full block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// A leaf cell: the gates ARE the structure. The propagate XOR (i_a ^ i_b) is
// shared by the sum path and the propagate half of the carry path.
// Source of truth: rtl/math/math_adder_full.sv.
digraph math_adder_full {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.55", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="math_adder_full - one-bit full adder (combinational)";

    ops  [label="Operand Bits\ni_a, i_b", fillcolor="white"];
    cin  [label="Carry In\ni_c", fillcolor="white"];

    pxor [label="Propagate XOR\np = i_a ^ i_b"];
    gand [label="Generate AND\ng = i_a & i_b"];
    sxor [label="Sum XOR\now_sum = p ^ i_c"];
    pand [label="Propagate AND\np & i_c"];
    cor  [label="Carry OR\now_carry = g | (p & i_c)"];

    outs [label="Outputs\now_sum   |   ow_carry", fillcolor="white", width=4.2];

    ops  -> gand [xlabel="i_a, i_b"];
    ops  -> pxor [xlabel="i_a, i_b"];
    pxor -> sxor [xlabel="p"];
    pxor -> pand [xlabel="p (shared)"];
    cin  -> p_c  [arrowhead=none, headclip=false, xlabel="i_c"];
    p_c  [shape=point, width=0.01];
    p_c  -> sxor;
    p_c  -> pand;
    gand -> cor  [xlabel="g"];
    pand -> cor  [xlabel="p & i_c"];
    sxor -> outs [xlabel="ow_sum"];
    cor  -> outs [xlabel="ow_carry"];

    { rank=same; ops; cin; }
    { rank=same; pxor; gand; }
    ops -> cin [style=invis, minlen=2];
    gand -> pxor [style=invis];
}
