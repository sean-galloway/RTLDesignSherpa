// math_ieee754_2008_fp32_multiplier block diagram - house style
// (vault/handbook/authoring/block-diagrams.md). Combinational. Operands down
// the center; sign, mantissa and exponent paths side by side; the optional
// gradual-underflow rescue dashed (SUBNORMAL_SUPPORT=1 only); special-case
// flags down the left as dashed sideband into the final select.
// Source of truth: rtl/math/math_ieee754_2008_fp32_multiplier.sv (generated by
// bin/rtl_generators/ieee754/fp32_multiplier.py).
digraph math_ieee754_2008_fp32_multiplier {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.55", splines=ortho, newrank=true,
           label="math_ieee754_2008_fp32_multiplier - a x b, IEEE 754-2008 FP32, RNE (combinational)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lSUBNORMAL_SUPPORT: 0 = flush subnormal inputs\l    and results to zero (FTZ);\l    1 = IEEE gradual underflow\l", fillcolor="white", shape=note];
    opa  [label="Operands\ni_a[31:0], i_b[31:0]", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    unp  [label="Field Extract + Classify (combinational)\nsign / exp[7:0] / mant[22:0] per operand\nzero, subnormal, infinity, NaN flags; hidden bit", style="filled", fillcolor="white"];
    mm   [label="Mantissa Multiply\nmath_ieee754_2008_fp32_mantissa_mult - u_mant_mult\n24 x 24 Dadda 4:2 tree, 48-bit product\n+ guard / round / sticky", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    ea   [label="Exponent Add\nmath_ieee754_2008_fp32_exponent_adder - u_exp_add\nexp_a + exp_b - 127 (+1 if product >= 2)", style="filled", fillcolor="white"];
    sub  [label="Gradual-Underflow Rescue (SUBNORMAL_SUPPORT=1 only)\nleft-normalize a product below 1.0;\nright-shift onto the subnormal grid, true sticky",
          style="filled,dashed", peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];
    rne  [label="RNE Round\nround up iff guard & (round | sticky | LSB)\nmantissa carry-out bumps the exponent", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    spc  [label="Result Select (combinational), priority order:\nNaN or invalid (0 x inf) > infinity or overflow\n> subnormal / zero / underflow flush > normal\nresult sign = sign_a XOR sign_b", style="filled", fillcolor="white"];
    outs [label="Outputs\now_result[31:0]   |   ow_overflow   |   ow_underflow   |   ow_invalid",
          fillcolor="white", width=7.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    opa -> unp [xlabel="i_a, i_b"];
    unp -> mm  [xlabel="mantissas + hidden bits"];
    unp -> ea  [xlabel="exponents"];
    mm  -> sub [xlabel="48-bit product, G/R/S"];
    ea  -> sub [xlabel="exponent sum"];
    sub -> rne [xlabel="normalized significand, exponent"];
    rne -> spc [xlabel="rounded mant + exp"];
    unp -> spc [style=dashed, color="#777777", xlabel="zero / inf / NaN flags,\nsigns"];
    spc -> outs [penwidth=1.8, xlabel="result, flags"];

    { rank=same; prm; opa; }
    { rank=same; mm; ea; }
    prm -> opa [style=invis, minlen=2];
    mm -> ea [style=invis];
}
