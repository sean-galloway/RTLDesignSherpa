// axi4_slave_wr_stub block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Slave port (s_axi) at the top, the module boundary bar at the bottom.
// W (write data) takes its own lane down the left, AW goes down the center, and B
// (sideband for the clock-gate wrapper) leaves through the bar.
// Source of truth: rtl/amba/axi4/axi4_slave_wr_stub.sv.
digraph axi4_slave_wr_stub {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.90", splines=ortho, newrank=true,
           label="axi4_slave_wr_stub - AXI4 write slave: packed-packet stub, one skid buffer per channel (single clock: aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lSKID_DEPTH_AW: AW entries buffered (default 2)\lSKID_DEPTH_W: W beats buffered (default 4)\lSKID_DEPTH_B: B responses buffered (default 2)\l    deeper = more decoupling, more flops\l", fillcolor="white", shape=note];
    fub  [label="AXI4 Slave Port (s_axi_*)\nfrom the interconnect / master\ns_axi_aw* / s_axi_w* in  /  s_axi_b* out", fillcolor="white", width=3.0, style="rounded,filled", fillcolor="#E2EFDA"];

    w    [label="W Skid Buffer\ngaxi_skid_buffer - inst_w_phase\n(DEPTH = SKID_DEPTH_W)", shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    aw   [label="AW Skid Buffer\ngaxi_skid_buffer - inst_aw_phase\n(DEPTH = SKID_DEPTH_AW)\nrd_count drives fub_axi_aw_count", shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    b    [label="B Skid Buffer\ngaxi_skid_buffer - inst_b_phase\n(DEPTH = SKID_DEPTH_B)", shape=cylinder, style="filled", fillcolor="#E8DFF5"];

    mport [label="Module Boundary (packed packets to the backend)\nfub_axi_aw_pkt + fub_axi_aw_count, fub_axi_w_pkt out  |  fub_axi_b_pkt in",
           fillcolor="white", width=9.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    // write data: its own lane down the left
    fub -> w     [xlabel="W: data, strb, last\n(wvalid / wready)"];
    w   -> mport [xlabel="W packet"];
    // address: down the center
    fub -> aw    [xlabel="AW: id, addr, len, size,\nburst, ... (awvalid / awready)"];
    aw  -> mport [xlabel="AW packet;\naw_count"];
    // response: back up the right lane (dir=back keeps the ranks top-down)
    b   -> mport [color="#1A7A1A", dir=back, xlabel="B packet"];
    fub -> b     [color="#1A7A1A", dir=back, xlabel="B (bvalid / bready)"];

    { rank=same; prm; fub; }
    { rank=same; w; aw; b; }
    prm -> fub [style=invis];
    w -> aw [style=invis]; aw -> b [style=invis, minlen=1];
}
