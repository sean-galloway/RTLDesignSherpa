// apb4_slave_cdc block diagram - house style (vault/handbook/authoring/block-diagrams.md),
// CDC mapping per the rtl-cdc set, stacked vertically: pclk above, aclk below,
// each domain named in its block label (a dashed region here only collided
// with the crossing labels). Each crossing is a
// gaxi_fifo_async child box (it has its own diagram) that straddles the
// boundary. The command drops down the left lane (pclk -> aclk); the
// response climbs the right lane (aclk -> pclk).
// Source of truth: rtl/amba/apb4/apb4_slave_cdc.sv.
digraph apb4_slave_cdc {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.70", splines=ortho, newrank=true,
           label="apb4_slave_cdc - APB4 completer on pclk, command / response ports on aclk",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    bus [label="APB4 Completer Bus  s_apb_*  (pclk, presetn)\nin: PSEL, PENABLE, PADDR, PWRITE, PWDATA, PSTRB, PPROT   |   out: PREADY, PRDATA, PSLVERR",
         fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    core [label="APB4 Slave Core  (pclk domain)\napb4_slave - u_apb4_slave (see its diagram)\ncompleter FSM, command and response skids, on pclk", peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];

    cmdf [label="Command CDC FIFO  (pclk -> aclk)\ngaxi_fifo_async - u_cmd_cdc_fifo (see its diagram)\nCDC_FIFO_DEPTH = max(DEPTH, 4) entries\nGray pointers, N_FLOP_CROSS = 2\n(USE_JOHNSON = 1: Johnson, any depth)", style="filled", fillcolor="white"];
    rspf [label="Response CDC FIFO  (aclk -> pclk)\ngaxi_fifo_async - u_rsp_cdc_fifo (see its diagram)\nCDC_FIFO_DEPTH = max(DEPTH, 4) entries\nGray pointers, N_FLOP_CROSS = 2\n(USE_JOHNSON = 1: Johnson, any depth)", style="filled", fillcolor="white"];

    be [label="Backend Interface  (aclk domain: aclk, aresetn)\ncmd_valid / cmd_ready + cmd_* fields   |   rsp_valid / rsp_ready, rsp_prdata, rsp_pslverr",
        fillcolor="white", width=10.5, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    bus -> core [dir=both, xlabel="transfer / PREADY, PRDATA, PSLVERR"];
    core -> cmdf [dir=both, penwidth=1.8, xlabel="command (pclk side)\n/ ready"];
    cmdf -> be [dir=both, xlabel="cmd_valid + fields / cmd_ready\n(aclk side)"];
    rspf -> be [dir=both, xlabel="rsp_valid + prdata, pslverr\n/ rsp_ready (aclk side)"];
    core -> rspf [dir=both, penwidth=1.8, xlabel="response (pclk side)\n/ pop"];

    { rank=same; cmdf; rspf; }
    cmdf -> rspf [style=invis, minlen=3];
}
