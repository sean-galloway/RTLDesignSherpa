// apb4_slave_stub block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Standalone (does not instantiate apb4_slave): a two-state completer FSM
// between the APB bus (top) and packed command / response ports (bottom bar).
// Transfer down the left through the command skid; response up the right
// through the response skid; PREADY / PRDATA / PSLVERR are combinational.
// Source of truth: rtl/amba/apb4/apb4_slave_stub.sv.
digraph apb4_slave_stub {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.70", splines=ortho, newrank=true,
           label="apb4_slave_stub - APB4 completer to packed command / response ports (single clock: pclk, presetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    bus [label="APB4 Completer Bus  s_apb_*\nin: PSEL, PENABLE, PADDR, PWRITE, PWDATA, PSTRB, PPROT   |   out: PREADY, PRDATA, PSLVERR",
         fillcolor="white"];

    fsm  [label="Completer FSM (state flop; outputs combinational)\nIDLE > XFER_DATA\nIDLE: push the command on PSEL & PENABLE (if skid has room)\nXFER_DATA: on a response, PREADY + PRDATA + PSLVERR the same clock"];

    cmdq [label="Command Skid Buffer\ngaxi_skid_buffer - cmd_skid_buffer_inst\nDEPTH entries of {pwrite, pprot, pstrb, paddr, pwdata}"];
    rspq [label="Response Skid Buffer\ngaxi_skid_buffer - resp_skid_buffer_inst\nDEPTH entries of {pslverr, prdata}"];

    be [label="Packed Backend Interface\ncmd_valid / cmd_ready, cmd_data = {pwrite, pprot, pstrb, paddr, pwdata}   |   rsp_valid / rsp_ready, rsp_data = {pslverr, prdata}",
        fillcolor="white", width=10.5];

    bus -> fsm [dir=both, penwidth=1.8, xlabel="transfer (PSEL, PENABLE, address, data)\n/ PREADY, PRDATA, PSLVERR"];
    fsm -> cmdq [dir=both, xlabel="command\n/ room"];
    cmdq -> be [dir=both, xlabel="cmd_valid + cmd_data / cmd_ready"];
    rspq -> be [dir=both, xlabel="rsp_valid + rsp_data\n/ rsp_ready"];
    fsm -> rspq [dir=both, xlabel="response\n/ pop"];

    { rank=same; cmdq; rspq; }
    cmdq -> rspq [style=invis, minlen=3];
}
