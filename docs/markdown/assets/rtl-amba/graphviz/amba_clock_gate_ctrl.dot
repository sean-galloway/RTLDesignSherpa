// amba_clock_gate_ctrl block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Thin AMBA wrapper over rtl/common clock_gate_ctrl: the two activity valids are ORed and
// flopped into r_wakeup, which drives the base controller's wakeup; idle = ~r_wakeup.
// Main flow (heavy): the clock, straight down the left column through the base controller
// to clk_out. The base controller is ONE child box (its own diagram is in rtl-common).
// Source of truth: rtl/amba/shared/amba_clock_gate_ctrl.sv.
digraph amba_clock_gate_ctrl {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="amba_clock_gate_ctrl - activity-driven clock gating for an AMBA block";

    clk_in  [group=CK, label="Clock In\nclk_in, aresetn", fillcolor="white"];
    act_in  [group=CT, label="Activity Inputs\nuser_valid (any user-side valid)\naxi_valid (any AXI-side valid)", fillcolor="white"];
    cfg_in  [group=CF, label="Configuration\ncfg_cg_enable,\ncfg_cg_idle_count\n[CG_IDLE_COUNT_WIDTH-1:0]", fillcolor="white"];

    wake    [group=CT, label="Wakeup Register (flop on clk_in)\nr_wakeup <= user_valid | axi_valid\nreset to 1: the block starts ungated"];
    idleinv [group=CT, label="Idle Decode (combinational)\nidle = ~r_wakeup"];
    base    [group=CK, label="Base Clock-Gate Controller\nclock_gate_ctrl - u_clock_gate_ctrl\n(see its diagram: idle countdown + ICG)\nIDLE_CNTR_WIDTH = CG_IDLE_COUNT_WIDTH"];

    out     [label="Outputs\nclk_out (gated clock)   |   gating   |   idle (no activity last cycle)",
             fillcolor="white", width=7.0];

    act_in -> wake    [xlabel="user_valid | axi_valid"];
    wake   -> base    [xlabel="r_wakeup (wakeup)"];
    wake   -> idleinv [xlabel="r_wakeup"];
    cfg_in -> base    [style=dashed, xlabel="enable,\nidle count"];

    clk_in -> base [xlabel="clk_in", penwidth=1.8];
    base   -> out  [xlabel="clk_out, gating", penwidth=1.8];
    idleinv -> out [xlabel="idle"];

    { rank=same; clk_in; act_in; cfg_in; }
    cfg_in -> clk_in [style=invis, minlen=1];
    clk_in -> act_in [style=invis, minlen=2];
    { rank=same; base; idleinv; }
    base -> idleinv [style=invis, minlen=2];
}
