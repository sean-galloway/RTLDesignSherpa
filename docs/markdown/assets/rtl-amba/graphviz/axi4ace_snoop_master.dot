// axi4ace_snoop_master block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// ACE snoop-channel transport (initiator, CCU / coherency-manager side): one skid buffer per channel, the same
// pattern as the axi4 rd/wr blocks. The snoop request (AC) drops down the left
// lane; the snoop response (CR) and snoop data (CD) climb their own lanes on
// the right. Pure transport: no snoop decode, no ordering logic.
// Source of truth: rtl/amba/ace/axi4ace_snoop_master.sv.
digraph axi4ace_snoop_master {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.65", splines=ortho, newrank=true,
           label="axi4ace_snoop_master - ACE snoop initiator transport, CCU side: issues snoops, collects responses (single clock: aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lSKID_DEPTH_AC / _CR / _CD: entries\l    per skid (default 2 / 4 / 4)\l", fillcolor="white", shape=note];
    top  [width=4.8, label="FUB Side (coherency manager)\nfub_ac* in  /  fub_cr*, fub_cd* out\nAC: acaddr, acsnoop[3:0], acprot", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    ac   [group=A, label="AC Skid Buffer\ngaxi_skid_buffer - ac_channel\n(DEPTH = SKID_DEPTH_AC)", shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    cr   [group=R, label="CR Skid Buffer\ngaxi_skid_buffer - cr_channel\n(DEPTH = SKID_DEPTH_CR)", shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    cd   [group=D, label="CD Skid Buffer\ngaxi_skid_buffer - cd_channel\n(DEPTH = SKID_DEPTH_CD)", shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    busy [label="Busy Detect (combinational)\nany AC, CR or CD entry held, or\nfub_acvalid / m_axi_crvalid / m_axi_cdvalid arriving", style="filled", fillcolor="white"];

    bot  [label="Module Boundary (to the cached master)\nm_axi_ac* out  |  busy (to the clock-gate wrapper)  |  m_axi_cr*, m_axi_cd* in", fillcolor="white", width=8.4, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    top -> ac  [xlabel="AC\n(acvalid / acready)"];
    ac  -> bot [xlabel="AC"];
    p_cr [group=R, shape=point, width=0.01];
    p_cd [group=D, shape=point, width=0.01];
    p_cr -> bot [color="#1A7A1A", dir=none, tailclip=false];
    cr  -> p_cr [color="#1A7A1A", dir=back, headclip=false, xlabel="CR: crresp[4:0]"];
    top -> cr  [color="#1A7A1A", dir=back, xlabel="CR (crvalid / crready)"];
    p_cd -> bot [color="#1A7A1A", dir=none, tailclip=false];
    cd  -> p_cd [color="#1A7A1A", dir=back, headclip=false, xlabel="CD: cddata, cdlast"];
    top -> cd  [color="#1A7A1A", dir=back, xlabel="CD (cdvalid / cdready)"];
    ac  -> busy [style=dashed, color="#777777", xlabel="ac count"];
    cr  -> busy [style=dashed, color="#777777", xlabel="cr count"];
    cd  -> busy [style=dashed, color="#777777", xlabel="cd count"];
    busy -> bot [style=dashed, color="#777777", xlabel="busy"];

    { rank=same; prm; top; }
    { rank=same; ac; cr; cd; }
    prm -> top [style=invis];
    ac -> cr [style=invis, minlen=3]; cr -> cd [style=invis];
    { rank=same; busy; p_cr; p_cd; }
    busy -> p_cr [style=invis]; p_cr -> p_cd [style=invis];
}
