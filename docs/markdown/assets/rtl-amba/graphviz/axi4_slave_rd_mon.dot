// axi4_slave_rd_mon block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Monitored wrapper: the base axi4_slave_rd is one child box (see its own diagram).
// AXI traffic runs down the left column through the stall gate; the monitor taps the
// FUB (backend) side (owner rule: monitors always tap the FUB side, for timing) and emits monitor-bus packets (the heavy edge). A full transaction table
// pushes back on the AR gate through block_ready.
// Source of truth: rtl/amba/axi4/axi4_slave_rd_mon.sv.
digraph axi4_slave_rd_mon {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           label="axi4_slave_rd_mon - axi4_slave_rd with an optional transaction monitor (single clock: aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lUSE_MONITOR: 0 = monitor omitted, outputs tied,\l    never stalls the bus\lMAX_TRANSACTIONS: outstanding reads tracked\lENABLE_*_LOGIC: which packet classes are built\lN_ADDR_RANGES: address-range checks (0 = none)\l", fillcolor="white", shape=note];
    fub  [label="AXI4 Slave Port (s_axi_*)\ns_axi_ar* in  /  s_axi_r* out", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    cfg  [label="Monitor Configuration (runtime input ports)\lcfg_monitor_enable: master gate; 0 = monitor inert\lcfg_*_enable: per-class packet enables\lcfg_timeout_cycles: timeout in us (0 = never)\lcfg_axi_*_mask: per-event drop masks\laddress ranges, ID / address filters,\l    perf-window start / end events\l", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    gate [label="AR Stall Gate (combinational)\ns_axi arvalid and arready both ANDed with\nblock_ready (or monitor disabled)", style="filled", fillcolor="white"];
    base [label="AXI4 Read Slave\naxi4_slave_rd - axi4_slave_rd_inst\n(see its diagram)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    taps [label="Bus Taps (combinational)\ncmd = fub_axi_arvalid, data = rvalid,\nresp = rvalid & rlast; each AND\ncfg_monitor_enable", style="filled", fillcolor="white"];
    mon  [label="Transaction Monitor (USE_MONITOR=1 only)\naxi_monitor_filtered - axi_monitor_inst\ntransaction table, timeouts, perf window,\npacket filter", style="filled,dashed", peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];

    bar  [label="Module Boundary\lfub_axi_ar* out / fub_axi_r* in (to the backend)  |  monbus_valid, packet, timestamp (monbus_ready in)\lbusy, active_transactions, perf_* counters, cfg_conflict_error\l",
          fillcolor="white", width=8.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    // AXI path: down the left (requests down, responses back up on the same pair).
    // The tap point sits on the FUB (backend) side, below the base: the gate stalls
    // the upstream s_axi request, the monitor watches the backend handshake.
    fub  -> gate [dir=both, xlabel="AR / R"];
    gate -> base [dir=both, xlabel="AR (gated) / R"];
    p_ax [shape=point, width=0.01];
    base -> p_ax [dir=back, headclip=false];
    p_ax -> bar  [dir=forward, tailclip=false, xlabel="AR down / R up"];
    // observation and packets
    p_ax -> taps [style=dashed, color="#777777", tailclip=false, xlabel="tap: fub_axi valids,\nfields"];
    taps -> mon  [minlen=2, xlabel="cmd / data / resp"];
    mon  -> bar  [penwidth=1.8, xlabel="monitor-bus packets,\ncounters"];
    gate -> mon  [style=dashed, color="#777777", dir=back, constraint=false, xlabel="block_ready\n(table not full)"];
    cfg  -> mon  [style=dashed, color="#777777", xlabel="config"];

    { rank=same; prm; fub; cfg; }
    { rank=same; p_ax; taps; }
    prm -> fub [style=invis]; fub -> cfg [style=invis];
}
