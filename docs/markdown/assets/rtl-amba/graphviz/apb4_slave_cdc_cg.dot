// apb4_slave_cdc_cg block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// apb4_slave_cdc with one idle-timeout clock gate per domain. The core and the
// two gaxi_fifo_async crossings are child boxes (own diagrams); this diagram
// adds the two amba_clock_gate_ctrl instances, whose gated clocks are the
// heavy edges, and the ready masking applied while a domain is gated.
// Domains stacked vertically and named in labels (as in apb4_slave_cdc).
// Source of truth: rtl/amba/apb4/apb4_slave_cdc_cg.sv.
digraph apb4_slave_cdc_cg {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.65", splines=ortho, newrank=true,
           label="apb4_slave_cdc_cg - apb4_slave_cdc with a clock gate in each domain (pclk, aclk)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    cfg  [label="Clock-Gate Configuration (runtime input ports, both domains)\lcfg_cg_enable: 1 = allow gating\lcfg_cg_idle_count: idle clocks to wait before gating\l", fillcolor="white"];
    mask [label="Gating Mask (combinational)\lwhile pclk is gated: s_apb_PREADY, the core's cmd ready\l    and rsp ready are forced to 0\lwhile aclk is gated: rsp_ready is forced to 0\lcg_gating / cg_idle = AND of both domains\l", fillcolor="white"];
    bus [label="APB4 Completer Bus  s_apb_*  (pclk, presetn)\nin: PSEL, PENABLE, PADDR, PWRITE, PWDATA, PSTRB, PPROT\nout: PREADY, PRDATA, PSLVERR",
         fillcolor="white"];

    cgp [label="pclk Clock Gate\namba_clock_gate_ctrl - pclk_gate_ctrl\nwake: PSEL | response waiting | command queued"];
    core [label="APB4 Slave Core  (gated pclk)\napb4_slave - u_apb4_slave (see its diagram)"];

    cmdf [label="Command CDC FIFO  (pclk -> aclk)\ngaxi_fifo_async - u_cmd_cdc_fifo (see its diagram)\nmax(DEPTH, 4) entries; write side gated_pclk, read side gated_aclk"];
    rspf [label="Response CDC FIFO  (aclk -> pclk)\ngaxi_fifo_async - u_rsp_cdc_fifo (see its diagram)\nmax(DEPTH, 4) entries; write side gated_aclk, read side gated_pclk"];
    cga [label="aclk Clock Gate\namba_clock_gate_ctrl - aclk_gate_ctrl\nwake: rsp_valid | cmd_valid | cmd_ready | PSEL\n(PSEL via a 2-flop sync on aclk)"];

    be [label="Backend Interface  (aclk domain: aclk, aresetn)\ncmd_valid / cmd_ready + cmd_* fields   |   rsp_valid / rsp_ready, rsp_prdata, rsp_pslverr",
        fillcolor="white", width=8.0];

    cfg -> cgp [style=dashed, xlabel="enable, idle count\n(both gates)"];
    cgp -> core [penwidth=1.8, xlabel="gated_pclk"];
    bus -> core [dir=both, xlabel="transfer / PREADY, PRDATA, PSLVERR"];
    core -> cmdf [dir=both, xlabel="command / ready"];
    cmdf -> be [dir=both, xlabel="cmd_valid + fields / cmd_ready"];
    rspf -> be [dir=both, xlabel="rsp_valid + prdata, pslverr / rsp_ready"];
    core -> rspf [dir=both, xlabel="response / pop"];
    cmdf -> cga [dir=back, penwidth=1.8, xlabel="gated_aclk\n(both FIFOs' aclk sides)"];

    { rank=same; cfg; bus; }
    { rank=same; cgp; mask; }
    { rank=same; cmdf; rspf; }
    { rank=same; cga; be; }
    cfg -> bus [style=invis];
    cgp -> mask [style=invis, minlen=4];
    cmdf -> rspf [style=invis, minlen=2];
    cga -> be [style=invis];
}
