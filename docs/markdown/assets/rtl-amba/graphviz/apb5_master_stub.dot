// apb5_master_stub block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Packed-port wrapper: the base apb5_master is ONE child box (own diagram).
// The {last, first} framing side FIFO (issue #111, ported from
// apb4_master_stub TASK-067) pairs each response with its own command's framing.
// Source of truth: rtl/amba/apb5/apb5_master_stub.sv.
digraph apb5_master_stub {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.65", splines=ortho, newrank=true,
           label="apb5_master_stub - packed command / response ports with first / last framing (single clock: pclk, presetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    cmd_port [label="Command Port (packed)\ncmd_valid / cmd_ready\ncmd_data = {last, first, pwrite, pprot,\npstrb, paddr, pwdata, pauser, pwuser}", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    rsp_port [label="Response Port (packed)\nrsp_valid / rsp_ready\nrsp_data = {last, first, pslverr,\nprdata, pruser, pbuser}", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    unpk [label="Unpack (wiring)\nAPB fields to the core;\n{last, first} to the side FIFO", style="filled", fillcolor="white"];
    flq  [label="First / Last Side FIFO\ngaxi_fifo_sync - u_first_last_fifo\nDEPTH = CMD_DEPTH + RSP_DEPTH + 2\n(the true outstanding bound)\npush on cmd, pop on rsp handshake", style="filled", fillcolor="white"];
    core [label="APB5 Master Core\napb5_master - u_apb5_master (see its diagram)\nskids, transfer FSM, PWAKEUP, check bits", peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    pack [label="Pack (wiring)\n{fifo last, first, core pslverr,\nprdata, pruser, pbuser}", style="filled", fillcolor="white"];

    bus [label="APB5 Requester Bus  m_apb_* (+ *CHK)\nout: PSEL, PENABLE, PADDR, PWRITE, PWDATA, PSTRB,\nPPROT, PAUSER, PWUSER, PWAKEUP\nin: PRDATA, PSLVERR, PREADY, PRUSER, PBUSER",
         fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    cmd_port -> unpk [dir=both, xlabel="cmd_valid + cmd_data / cmd_ready"];
    unpk -> core [penwidth=1.8, xlabel="APB fields\n(incl. pauser, pwuser)"];
    unpk -> flq [xlabel="{last, first}"];
    flq -> pack [xlabel="{last, first}\nof this response"];
    core -> bus [dir=both, xlabel="APB transfer / PREADY, PRDATA, PSLVERR"];
    core -> pack [xlabel="rsp_prdata, pslverr,\npruser, pbuser"];
    rsp_port -> pack [dir=both, xlabel="rsp_valid +\nrsp_data\n/ rsp_ready"];

    { rank=same; cmd_port; rsp_port; }
    { rank=same; core; flq; }
    cmd_port -> rsp_port [style=invis, minlen=3];
    core -> flq [style=invis, minlen=2];
}
