// sdpram_slave_axi4_axil block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Thin wrapper: a AXI4 slave-write leaf and a AXIL slave-read leaf bridge their
// FUB sides onto sdpram_core (drawn as the bottom bar; see its own diagram).
// Each side shares ONE dir=both edge per node pair: requests down, responses up.
// Source of truth: rtl/amba/shared/sdpram_slave_axi4_axil.sv.
digraph sdpram_slave_axi4_axil {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.70", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="sdpram_slave_axi4_axil - AXI4 write, AXI-Lite read over the shared BRAM core";

    wport [group=W, label="AXI4 Write Port (slave)\ns_axi_aw / s_axi_w in,  s_axi_b out", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    cport [group=C, label="Bulk Clear and Debug\ni_cfg_start_clear / o_cfg_done_clear,\ndebug taps", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    rport [group=R, label="AXIL Read Port (slave)\ns_axi_ar in,  s_axi_r out", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    wleaf [group=W, label="AXI4 Slave Write Leaf\naxi4_slave_wr - u_axi4_wr\nskid buffers on AW / W / B\nFUB: real id, len, size, burst", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    rleaf [group=R, label="AXIL Slave Read Leaf\naxil4_slave_rd - u_axil_rd\nskid buffers on AR / R\nFUB tied: id 0, len 0, INCR", peripheries=2, style="filled", fillcolor="#D6E4F0"];

    core  [group=C, label="BRAM Backend\nsdpram_core - u_core   (see its diagram)\nAW / AR queues, burst trackers, BRAM, clear FSM",
           width=8.5, height=0.8, shape=cylinder, style="filled", fillcolor="#E8DFF5"];

    wport -> wleaf [dir=both, xlabel="AW, W  /  B"];
    rport -> rleaf [dir=both, xlabel="AR  /  R"];
    wleaf -> core  [dir=both, xlabel="fub AW, W  /  fub B"];
    rleaf -> core  [dir=both, xlabel="fub AR  /  fub R"];
    cport -> core  [style=dashed, color="#777777", dir=both, xlabel="start / done"];

    { rank=same; wport; cport; rport; }
    wport -> cport [style=invis, minlen=2];
    cport -> rport [style=invis, minlen=2];
    { rank=same; wleaf; rleaf; }
    wleaf -> rleaf [style=invis, minlen=4];
}
