// arbiter_monbus_common block diagram - house style
// (vault/handbook/authoring/block-diagrams.md). A pure observer: it snoops an
// arbiter's request/grant/ack signals (nothing driven back) and emits its own
// ocelus event packets.
// Flows:
//   observation - top-down the center: arbiter signals -> per-client trackers
//                 -> registered event detect -> priority packet select ->
//                 event FIFO -> monitor-bus bar
//   sampling    - sample timer + monitor FSM beside the trackers feed the
//                 fairness / efficiency analysis into event detect
//   timestamp   - i_mon_time drops straight to the bar (sampled on emission)
//   debug       - status counters down the left lane to the bar
// Source of truth: rtl/amba/ocelus/arbiter_monbus_common.sv.
digraph arbiter_monbus_common {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.60", splines=ortho, newrank=true,
           label="arbiter_monbus_common - arbiter observer that emits its own ocelus event packets\n(single clock: clk, rst_n)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external inputs (white) ----
    prm  [label="Parameters (fixed at build)\lWAIT_GNT_ACK: 1 = per-client grant-to-ack timers\l    raise ACK-timeout events; 0 = timers tied off\lFAIRNESS_REPORT_CYCLES / MIN_GRANTS_FOR_FAIRNESS:\l    fairness is judged once per window, and only\l    after enough grants\lMON_FIFO_DEPTH: event packets buffered\lMON_AGENT_ID / MON_UNIT_ID: stamped in every packet\l", fillcolor="white"];
    arb  [group=C, label="Arbiter Signals (observed, nothing driven back)\nrequest, grant_valid, grant, grant_id, grant_ack, block_arb", fillcolor="white"];
    cfg  [label="Monitor Config (runtime input ports)\lcfg_mon_enable: 0 = no events detected\lcfg_mon_pkt_type_enable: one bit per packet class\lcfg_mon_*_thresh: latency, starvation, fairness,\l    active-request, ACK-timeout, efficiency limits\lcfg_mon_sample_period: analysis sample interval\lcfg_max_thresh: client weights, the expected\l    share each client should get (fairness)\l", fillcolor="white"];
    tim  [group=T, label="Timebase\ni_mon_time", fillcolor="white"];

    // ---- logic ----
    trk  [group=C, label="Per-Client Trackers (flops)\nlatency / starvation counters while a request waits\ngrant and completion counts\nACK timers from grant to grant_ack (WAIT_GNT_ACK=1)"];
    fsm  [label="Sample Timer + Monitor FSM (flops)\nIDLE > ACTIVE > SAMPLE > ANALYZE > FAIRNESS\nper window: fairness deviation vs the client\nweights, grant efficiency"];
    det  [group=C, label="Event Detect (flop pipeline register)\nthreshold compares, gated by cfg_mon_enable:\nstarvation, ACK timeout, latency, fairness,\nefficiency, active requests, completion, grant"];
    sel  [group=C, label="Packet Select (combinational, priority order)\nstarvation > ACK timeout > latency > fairness\n> efficiency > active requests > completion > grant\neach class masked by cfg_mon_pkt_type_enable;\nprotocol ARB, agent / unit IDs, client, data"];
    fifo [group=C, label="Event FIFO\ngaxi_fifo_sync - u_event_fifo (MON_FIFO_DEPTH)\npacket only, 128 bits"];

    // ---- the boundary bar ----
    outs [group=C, label="Monitor Bus + Debug\nmonbus_valid, monbus_packet, monbus_timestamp / monbus_ready   |   debug_fifo_count, debug_packet_count,\ndebug_ack_timeout, debug_protocol_violations, debug_grant_efficiency, debug_client_starvation, debug_fairness_deviation, debug_monitor_state",
          fillcolor="white", width=10.5];

    // ---- main flow ----
    arb  -> trk  [xlabel="observed signals"];
    trk  -> det  [xlabel="counts, timers"];
    fsm  -> det  [xlabel="window results"];
    det  -> sel  [xlabel="event flags (registered)"];
    sel  -> fifo [xlabel="one packet per event cycle", penwidth=1.8];
    fifo -> outs [xlabel="monbus_packet (valid down, ready up)", penwidth=1.8];

    // ---- config (dashed) ----
    cfg  -> fsm  [style=dashed, xlabel="sample period, weights"];

    // ---- timestamp straight down the right ----
    p_t1 [group=T, shape=point, width=0.01];
    tim  -> p_t1 [arrowhead=none, headclip=false];
    p_t1 -> outs [xlabel="monbus_timestamp\n(sampled on emission)", tailclip=false];

    // ---- debug down the left ----
    p_d1 [group=L, shape=point, width=0.01];
    trk  -> p_d1 [arrowhead=none, headclip=false];
    p_d1 -> outs [xlabel="debug_*", tailclip=false];

    // ---- rank pinning ----
    { rank=same; prm; arb; cfg; tim; }
    { rank=same; trk; fsm; }
    { rank=same; p_d1; det; p_t1; }
    { rank=max; outs; }
    prm -> arb -> cfg -> tim [style=invis];
    trk -> fsm [style=invis, minlen=2];
    p_d1 -> det [style=invis, minlen=2];
    det -> p_t1 [style=invis, minlen=3];
}
