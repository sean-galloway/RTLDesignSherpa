// axis4_slave_cg block diagram (derived from axis4_master_cg.dot) - house style (vault/handbook/authoring/block-diagrams.md).
// Variant rule: the base axis4_slave is ONE child box (see its own diagram);
// this diagram shows only what the _cg wrapper adds - an amba_clock_gate_ctrl
// whose gated clock drives the base (heavy: the output is a clock), and a
// ready gate that holds s_axis_tready low while the clock is gated.
// Source of truth: rtl/amba/axis4/axis4_slave_cg.sv.
digraph axis4_slave_cg {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.65", splines=ortho, newrank=true,
           label="axis4_slave_cg - axis4_slave behind an idle-timeout clock gate\n(clock in: aclk; the base runs on gated_aclk)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    clk  [label="Clock In\naclk, aresetn", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    cfg  [label="Clock-Gate Config (runtime ports)\ncfg_cg_enable: 1 = gating allowed\ncfg_cg_idle_count: idle cycles before gating", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    fub  [label="AXI4-Stream Slave Bus (upstream)\ns_axis_tvalid + T fields / s_axis_tready", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    cgc  [label="Clock-Gate Controller\namba_clock_gate_ctrl - i_amba_clock_gate_ctrl\nactivity (stays awake): user_valid = s_axis_tvalid | base busy,\naxi_valid = fub_axis_tvalid; gates after the idle count", style="filled", fillcolor="white"];
    rdyg [label="Ready Gate (combinational)\ns_axis_tready = cg_gating ? 0 : int_tready", style="filled", fillcolor="white"];
    base [label="Base Stream Slave\naxis4_slave - i_axis_slave\n(see the axis4_slave diagram)", width=3.6, peripheries=2, style="filled", fillcolor="#D6E4F0"];

    bus  [label="FUB Stream Port (downstream) + status\nfub_axis_tvalid + T fields / fub_axis_tready   |   cg_gating, cg_idle",
          fillcolor="white", width=7.5, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    clk  -> cgc  [xlabel="aclk", penwidth=1.8];
    cfg  -> cgc  [style=dashed, color="#777777", xlabel="enable, idle count"];
    cgc  -> base [xlabel="gated_aclk", penwidth=1.8];
    fub  -> base [xlabel="T beat"];
    base -> bus  [xlabel="fub_axis T beat"];
    bus  -> base [style=dashed, color="#777777", constraint=false, xlabel="s_axis_tready"];
    base -> rdyg [style=dashed, color="#777777", xlabel="int_tready"];
    cgc  -> rdyg [style=dashed, color="#777777", xlabel="cg_gating"];
    rdyg -> fub  [style=dashed, color="#777777", constraint=false, xlabel="s_axis_tready"];
    cgc  -> bus  [style=dashed, color="#777777", xlabel="cg_gating, cg_idle"];

    { rank=same; clk; cfg; fub; }
    { rank=same; cgc; rdyg; }
    clk -> cfg -> fub [style=invis];
    cgc -> rdyg [style=invis, minlen=3];
}
