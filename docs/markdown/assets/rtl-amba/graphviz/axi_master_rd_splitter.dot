// axi_master_rd_splitter block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Upstream FUB read port at the top, the downstream m_axi port as the bottom bar.
// The AR request flows down the center: split control holds the original burst and
// asks axi_split_combi where the boundary is, issuing one downstream AR per piece.
// R returns UP the right lane, passing through; only rlast is regenerated so the
// upstream sees one burst. A split-info record per original goes out through a FIFO.
// Source of truth: rtl/amba/shared/axi_master_rd_splitter.sv.
digraph axi_master_rd_splitter {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.85", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="axi_master_rd_splitter - splits AXI read bursts at an alignment boundary (one clock: aclk)";

    sinfo [group=S, label="Split Info Out\nfub_split_addr / _id / _cnt\n/ fub_split_ready\no_split_fifo_overflow (sticky)", fillcolor="white"];
    fport [group=C, label="Upstream FUB Read Port\nfub_ar in   |   fub_r out", fillcolor="white"];
    ctl   [group=K, label="Control Inputs\nalignment_mask[11:0]\n(0xFFF = 4 KB)\nblock_ready", fillcolor="white"];

    fifo  [group=S, label="Split Info FIFO\ngaxi_fifo_sync -\ninst_split_info_fifo\none {addr, id, count}\nper original burst"];
    fsm   [group=C, label="Split Control (flops)\nIDLE / SPLITTING; r_orig_* hold the original AR\nr_current_addr / len step through the pieces\nnew AR only when idle, unblocked, R drained"];
    calc  [group=K, label="Split Calculator\naxi_split_combi -\ninst_axi_split_combi\n(see its diagram)"];
    ardrv [group=C, label="AR Drive (combinational)\nIDLE: fub fields\nSPLITTING: held fields\narlen = split_len"];
    rpath [group=R, label="R Return\nid, data, resp pass up;\nr_rbeats_remaining (flop):\nfub_rlast only on the\noriginal's last beat"];

    bar   [label="Downstream AXI Read Port (m_axi)\nm_axi_ar out: one AR per split piece   |   m_axi_r in",
           fillcolor="white", width=8.5];

    fport -> fsm  [xlabel="AR (original burst)"];
    ctl   -> fsm  [style=dashed, xlabel="block_ready"];
    fsm   -> calc [dir=both, xlabel="addr, len /\nsplit_len, remaining"];
    ctl   -> calc [style=dashed, xlabel="alignment_mask"];
    fsm   -> ardrv [xlabel="current piece"];
    ardrv -> bar  [xlabel="AR (per piece)"];
    rpath -> bar  [dir=back, xlabel="R beats"];
    rpath -> fport [xlabel="R (rlast regenerated)"];
    fsm   -> rpath [style=dashed, xlabel="beat count\nat admit"];
    fsm -> fifo [xlabel="record at\nlast piece"];
    fifo  -> sinfo [xlabel="split info"];

    { rank=same; sinfo; ctl; fport; }
    sinfo -> ctl [style=invis];
    ctl -> fport [style=invis];
    { rank=same; fifo; calc; ardrv; rpath; }
    fifo -> calc [style=invis];
    calc -> ardrv [style=invis];
    ardrv -> rpath [style=invis];
}
