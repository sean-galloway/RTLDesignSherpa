// axi4ace_master_rd block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Built from the owner-reviewed axi4 diagram; adds what ACE carries (IHI 0022H part D).
// Requester (FUB) side at the top, the module boundary bar at the bottom.
// AR goes down the left lane through its skid buffer; R comes back up the right
// lane through its own skid buffer. busy (sideband for the clock-gate wrapper)
// sits between the lanes and leaves through the bar.
// Source of truth: rtl/amba/ace/axi4ace_master_rd.sv.
digraph axi4ace_master_rd {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           label="axi4ace_master_rd - ACE read master: AXI4 read + ACE fields and RACK (single clock: aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lSKID_DEPTH_AR: AR entries buffered (default 2)\lSKID_DEPTH_R: R beats buffered (default 4)\l    deeper = more decoupling, more flops\l", fillcolor="white"];
    fub  [label="FUB Side (requester)\nfub_axi_ar* in  /  fub_axi_r* out\nACE on AR: arsnoop[3:0], ardomain, arbar", fillcolor="white", width=4.0];

    ar   [group=L, label="AR Skid Buffer\ngaxi_skid_buffer - ar_channel\n(DEPTH = SKID_DEPTH_AR)"];
    r    [group=R, label="R Skid Buffer\ngaxi_skid_buffer - r_channel\n(DEPTH = SKID_DEPTH_R)\nresp[3] IsShared, resp[2] PassDirty"];
    busy [group=C, label="Busy Detect (combinational)\nany AR or R entry held,\nor arvalid / rvalid arriving"];

    mport [label="Module Boundary\nm_axi_ar* out (to the interconnect)  |  busy (to the clock-gate wrapper)  |  m_axi_r* in, m_axi_rack out",
           fillcolor="white", width=7.6];

    // request: down the left lane
    fub -> ar    [xlabel="AR + ACE fields\n(arvalid / arready)"];
    ar  -> mport [xlabel="AR"];
    // response: back up the right lane (dir=back keeps the ranks top-down)
    r   -> mport [dir=back, xlabel="R: id, data,\nresp[3:0], last"];
    fub -> r     [dir=back, xlabel="R (rvalid / rready)"];
    // sideband between the lanes
    ar  -> busy  [style=dashed, xlabel="ar count"];
    r   -> busy  [style=dashed, xlabel="r count"];
    busy -> mport [style=dashed, xlabel="busy"];

    { rank=same; prm; fub; }
    { rank=same; ar; r; }
    prm -> fub [style=invis];
    ar -> r [style=invis, minlen=4];
    rack [label="RACK Pulse (flop) r_rack\none clock after the last R beat\n(m_axi_rvalid & rready & rlast)"];
    rack -> mport [xlabel="m_axi_rack"];
    r -> rack [style=dashed, xlabel="last R beat\n(m_axi side)"];
    { rank=same; busy; rack; }
    busy -> rack [style=invis, minlen=2];
}
