// axil5_slave_rd_mon block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Variant of axil5_slave_rd: the wrapped module is ONE child box (see its own diagram);
// only what this wrapper adds is drawn. Generated from the axil4 variant template
// with AXI5-Lite names (IDs on every channel, i_axil5_* instances).
// Source of truth: rtl/amba/axil5/axil5_slave_rd_mon.sv.
digraph axil5_slave_rd_mon {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.80", splines=ortho, newrank=true,
           label="axil5_slave_rd_mon - axil5_slave_rd with an ocelus transaction monitor on the s_axil side\n(aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    top   [label="AXI5-Lite Bus, slave side (s_axil_*)\nfrom the interconnect / master", fillcolor="white", width=3.8];
    child [label="axil5_slave_rd\naxil5_slave_rd_inst\n(see its diagram: one skid buffer per channel)", width=3.4, height=1.0];
    bot   [label="Read Completer (fub_axil_*)\nbackend serving reads", fillcolor="white", width=4.4];

    mcfg  [label="Monitor Config (runtime input ports)\lcfg_monitor_enable: 0 = taps off, never stalls\lcfg_*_enable: error / timeout / compl /\l    threshold / perf / debug packet classes\lcfg_axi_*_mask: per-event drop masks\lcfg_timeout_cycles (us), cfg_freq_sel,\l    cfg_latency_threshold, address ranges\li_mon_time (timestamp in), cam_clear\l", fillcolor="white"];
    mon   [label="Ocelus Monitor (USE_MONITOR=1 only)\naxi_monitor_filtered - axi_monitor_inst\ntaps AR (cmd, ID), R (data, resp, ID) on the s_axil side\ntracks up to MAX_TRANSACTIONS (default 8)\nraises block_ready low when its table is full\nUSE_MONITOR=1 requires ID_WIDTH <= 8 (keys 8 ID bits;\nelaboration check -- use _monlite for wider IDs)", style="filled,dashed"];
    gate  [label="AR Handshake Gate (combinational)\ns_axil_arvalid AND s_axil_arready\nboth masked by block_ready\n(unless cfg_monitor_enable = 0)"];
    mout  [label="Monitor Outputs\lmonbus_packet / monbus_valid / monbus_ready,\l    monbus_timestamp (ocelus monitor bus)\lbusy, active_transactions, error_count,\l    transaction_count, perf_* window counters\l", fillcolor="white"];
    mcfg -> mon [style=dashed, xlabel="config"];
    mon  -> gate [style=dashed, xlabel="block_ready"];
    mon  -> mout [xlabel="ocelus packets", penwidth=1.8];

    top  -> gate  [xlabel="AR (arid, araddr, ...)", penwidth=1.8];
    gate -> child [xlabel="gated valid", penwidth=1.8];
    child -> bot  [dir=both, xlabel="AR (arid, araddr, ...) out /\nR (rid, rdata, rresp, ...) in", penwidth=1.8];

    top -> child [dir=back, xlabel="R (rid, rdata, rresp, ...)", constraint=false];
    top -> mon [style=dashed, xlabel="tap"];

    { rank=same; gate; mcfg; }
    { rank=same; child; mon; }
    child -> mon [style=invis, minlen=2];
    { rank=same; bot; mout; }
    bot -> mout [style=invis];
}
