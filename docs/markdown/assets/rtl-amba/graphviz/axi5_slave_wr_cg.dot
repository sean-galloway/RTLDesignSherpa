// axi5_slave_wr_cg block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Clock-gated wrapper: the base axi5_slave_wr is one child box (see its own diagram).
// The clock is the heavy main column: aclk -> amba_clock_gate_ctrl -> gated_aclk -> base.
// AXI traffic passes through on the left; activity wakes the gate.
// Source of truth: rtl/amba/axi5/axi5_slave_wr_cg.sv.
digraph axi5_slave_wr_cg {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           label="axi5_slave_wr_cg - axi5_slave_wr behind an idle-timeout clock gate",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    fub  [label="AXI5 Slave Port (s_axi_*)\ns_axi_aw* / s_axi_w* in  /  s_axi_b* out", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    clk  [label="Clock In\naclk, aresetn", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    cfg  [label="Gate Configuration (runtime input ports)\lcfg_cg_enable: 1 = allow gating\lcfg_cg_idle_count: idle clocks before\l    the clock stops\l", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    act  [label="Activity Detect (combinational)\nuser_valid = s_axi awakeup | awvalid | wvalid | bvalid | base busy\naxi_valid = fub awvalid | wvalid | bvalid\n(awakeup counts only when ENABLE_WAKEUP=1)", style="filled", fillcolor="white"];
    ctrl [label="Clock Gate Controller\namba_clock_gate_ctrl - i_amba_clock_gate_ctrl\nidle countdown; gates aclk when idle", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    base [label="AXI5 Write Slave\naxi5_slave_wr - i_axi5_slave_wr\n(see its diagram; runs on gated_aclk)", width=3.6, peripheries=2, style="filled", fillcolor="#D6E4F0"];

    bar  [label="Module Boundary\nfub_axi_aw* / fub_axi_w* out  /  fub_axi_b* in (to the backend)  |  cg_gating, cg_idle (gate status)",
          fillcolor="white", width=7.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    // AXI pass-through (requests down, responses up on the same pair)
    fub  -> base [dir=both, xlabel="AW / W / B\n(s_axi_awready, wready\nforced 0 while gating)"];
    base -> bar  [dir=both, minlen=2, xlabel="AW / W / B\n(fub_axi_bready forced 0\nwhile gating)"];
    // the clock: heavy main column
    clk  -> ctrl [penwidth=1.8, xlabel="aclk"];
    ctrl -> base [penwidth=1.8, xlabel="gated_aclk"];
    // wake-up and configuration
    fub  -> act  [style=dashed, color="#777777", xlabel="valids"];
    act  -> ctrl [xlabel="user_valid,\naxi_valid"];
    cfg  -> ctrl [style=dashed, color="#777777", xlabel="enable,\nidle count"];
    base -> act  [style=dashed, color="#777777", constraint=false, xlabel="busy"];
    ctrl -> bar  [style=dashed, color="#777777", xlabel="cg_gating,\ncg_idle"];

    { rank=same; fub; clk; cfg; }
    fub -> clk [style=invis, minlen=2]; clk -> cfg [style=invis];
}
