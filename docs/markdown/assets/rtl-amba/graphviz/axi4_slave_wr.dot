// axi4_slave_wr block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Slave port (s_axi) at the top, the module boundary bar at the bottom.
// W (write data) takes its own lane down the left, AW goes down the center, and B
// comes back up the right lane. Each channel has its own skid buffer. busy
// (sideband for the clock-gate wrapper) leaves through the bar.
// Source of truth: rtl/amba/axi4/axi4_slave_wr.sv.
digraph axi4_slave_wr {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           label="axi4_slave_wr - AXI4 write slave: one skid buffer per channel (single clock: aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lSKID_DEPTH_AW: AW entries buffered (default 2)\lSKID_DEPTH_W: W beats buffered (default 4)\lSKID_DEPTH_B: B responses buffered (default 2)\l    deeper = more decoupling, more flops\l", fillcolor="white"];
    fub  [label="AXI4 Slave Port (s_axi_*) - from the interconnect / master\ns_axi_aw* / s_axi_w* in  /  s_axi_b* out", fillcolor="white", width=5.0];

    w    [label="W Skid Buffer\ngaxi_skid_buffer - i_w_channel\n(DEPTH = SKID_DEPTH_W)"];
    aw   [label="AW Skid Buffer\ngaxi_skid_buffer - i_aw_channel\n(DEPTH = SKID_DEPTH_AW)"];
    b    [label="B Skid Buffer\ngaxi_skid_buffer - i_b_channel\n(DEPTH = SKID_DEPTH_B)"];
    busy [label="Busy Detect (combinational)\nany AW, W or B entry held, or\nawvalid / wvalid / bvalid arriving"];

    mport [label="Module Boundary\nfub_axi_aw* / fub_axi_w* out (to the backend)  |  busy (to the clock-gate wrapper)  |  fub_axi_b* in",
           fillcolor="white", width=9.0];

    // write data: its own lane down the left
    fub -> w     [xlabel="W: data, strb, last\n(wvalid / wready)"];
    w   -> mport [xlabel="W"];
    // address: down the center
    fub -> aw    [xlabel="AW: id, addr, len, size,\nburst, ... (awvalid / awready)"];
    aw  -> mport [xlabel="AW"];
    // response: back up the right lane (dir=back keeps the ranks top-down)
    b   -> mport [dir=back, xlabel="B: id, resp"];
    fub -> b     [dir=back, xlabel="B (bvalid / bready)"];
    // sideband
    w   -> busy  [style=dashed, xlabel="w count"];
    aw  -> busy  [style=dashed, xlabel="aw count"];
    b   -> busy  [style=dashed, xlabel="b count"];
    busy -> mport [style=dashed, xlabel="busy"];

    { rank=same; prm; fub; }
    { rank=same; w; aw; b; }
    prm -> fub [style=invis];
    w -> aw [style=invis]; aw -> b [style=invis, minlen=4];
}
