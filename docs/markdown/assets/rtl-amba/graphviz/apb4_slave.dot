// apb4_slave block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// The APB bus it completes is the port at the top; the local command /
// response interface to the backend is the bottom bar. A transfer drops down
// the left through the FSM and the command skid to the backend; the backend's
// response climbs the right lane through the response skid back to the FSM,
// which returns PREADY / PRDATA / PSLVERR to the bus.
// Source of truth: rtl/amba/apb4/apb4_slave.sv.
digraph apb4_slave {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.70", splines=ortho, newrank=true,
           label="apb4_slave - one APB4 completer to queued command / response ports (single clock: pclk, presetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    bus [label="APB4 Completer Bus  s_apb_*\nin: PSEL, PENABLE, PADDR, PWRITE, PWDATA, PSTRB, PPROT   |   out: PREADY, PRDATA, PSLVERR",
         fillcolor="white"];

    fsm  [label="APB Completer FSM (flop)\nr_apb_state: IDLE > BUSY > WAIT\nIDLE: capture on the PENABLE rising edge; drop an orphan response\nBUSY: on a response, drive PREADY / PRDATA / PSLVERR for one clock"];

    cmdq [label="Command Skid Buffer\ngaxi_skid_buffer - cmd_skid_buffer_inst\nDEPTH entries of {pwrite, pprot, pstrb, paddr, pwdata}"];
    rspq [label="Response Skid Buffer\ngaxi_skid_buffer - resp_skid_buffer_inst\nDEPTH entries of {pslverr, prdata}"];

    be [label="Backend Interface\ncmd_valid / cmd_ready, cmd_pwrite, cmd_paddr, cmd_pwdata, cmd_pstrb, cmd_pprot   |   rsp_valid / rsp_ready, rsp_prdata, rsp_pslverr",
        fillcolor="white", width=10.5];

    bus -> fsm [dir=both, penwidth=1.8, xlabel="transfer (PSEL, PENABLE, address, data)\n/ PREADY, PRDATA, PSLVERR (registered)"];
    fsm -> cmdq [dir=both, xlabel="command (r_cmd_valid)\n/ space"];
    cmdq -> be [dir=both, xlabel="cmd_valid + fields / cmd_ready"];
    rspq -> be [dir=both, xlabel="rsp_valid + prdata, pslverr\n/ rsp_ready"];
    fsm -> rspq [dir=back, xlabel="response\n/ pop (r_rsp_ready)", arrowhead=normal];

    { rank=same; cmdq; rspq; }
    cmdq -> rspq [style=invis, minlen=3];
}
