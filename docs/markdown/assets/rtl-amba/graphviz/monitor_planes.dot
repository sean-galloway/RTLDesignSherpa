// Ocelus five-plane architecture (docs/markdown/rtl-amba/monitor/monitor_planes.md)
// House style: vault/handbook/authoring/block-diagrams.md
// Five purpose-sliced planes; observed bus enters top, drain leaves through one boundary bar.

digraph ocelus_planes {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.50", ranksep="0.70", splines=ortho];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.14,0.07"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // External observed bus
    observed_bus [label="Observed bus\n(AXI / AXIS / APB / ARB / CORE)",
                  shape=box, style=filled, fillcolor="white", color="black", style="rounded,filled", fillcolor="#E2EFDA"];

    // Protocol plane: the sensor
    protocol_plane [label="Protocol plane\naxi_monitor_lite / _base, axis_, cxs_,\naxi4ace_snoop_, trans_mgr, trans_cam,\naddr_check, timeout, timer, filtered",
                    fillcolor="#D6E4F0", peripheries=2, style="filled", fillcolor="#D6E4F0"];

    // Reporter planes
    error_plane [label="Error plane\nreporter_error, reporter_timeout,\nreporter_threshold",
                 fillcolor="#D6E4F0", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    debug_plane [label="Debug plane\nreporter_debug, reporter_compl",
                 fillcolor="#D6E4F0", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    perf_plane [label="Perf plane\nreporter_perf",
                fillcolor="#D6E4F0", peripheries=2, style="filled", fillcolor="#D6E4F0"];

    // Output plane internal chain
    monbus_arbiter [label="monbus_arbiter\n(N:1 merge, packet + timestamp)",
                    shape=invtrapezium, fillcolor="#D6E4F0", width=2.4, height=0.45, style="filled", fillcolor="#FFF2CC"];
    monbus_group [label="monbus_group_core\n+ filters + group wrappers",
                  fillcolor="#D6E4F0", peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    compress_pack [label="monbus_compressor\n+ halfbeat_packer",
                   shape=box, style="dashed,filled", fillcolor="#E8F0E8",
                   color="black", margin="0.12,0.06", peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];

    // Boundary bar: the off-chip capture interface
    boundary [label="Off-chip capture interface\nAXI4 / AXI-Lite / Wishbone slave-read (IRQ)\n+ master-write ring",
              shape=box, style=filled, fillcolor="white", color="black", style="rounded,filled", fillcolor="#E2EFDA"];

    // Main flows
    observed_bus -> protocol_plane [label="observed bus signals\n(nothing driven back)"];

    protocol_plane -> error_plane [label="error / timeout / threshold\nevents"];
    protocol_plane -> debug_plane [label="completion / debug\nevents"];
    protocol_plane -> perf_plane [label="perf\nevents"];

    error_plane -> monbus_arbiter [label="error / timeout /\nthreshold packets"];
    debug_plane -> monbus_arbiter [label="completion / debug\npackets"];
    perf_plane -> monbus_arbiter [label="perf\npackets"];

    monbus_arbiter -> monbus_group [label="merged monbus stream\n(packet + timestamp)", penwidth=1.8];
    monbus_group -> boundary [label="error FIFO + write\nFIFO drains"];
    monbus_group -> compress_pack [label="write path\n(USE_COMPRESSION)", style=dashed, color="#777777"];
    compress_pack -> boundary [label="compressed / packed\nwrite FIFO drain"];

    // Rank pins to keep the diagram readable
    { rank=same; error_plane; debug_plane; perf_plane; }
    { rank=same; monbus_group; compress_pack; }
}
