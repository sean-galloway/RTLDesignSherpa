// apb5_slave_cdc_cg block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Variant rule: the whole apb5_slave_cdc is ONE child box (own diagram); one
// clock gate on pclk only (aclk is never gated). aclk-side activity reaches
// the pclk wakeup through a 2-flop synchronizer.
// this diagram shows what the variant adds - the activity wakeup flop and
// amba_clock_gate_ctrl, whose gated clock (heavy column) clocks the core.
// Source of truth: rtl/amba/apb5/apb5_slave_cdc_cg.sv.
digraph apb5_slave_cdc_cg {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.65", splines=ortho, newrank=true,
           label="apb5_slave_cdc_cg - apb5_slave_cdc with an idle-timeout clock gate on pclk",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    clk  [label="Clock In\npclk, presetn", fillcolor="white"];
    cfg  [label="Clock-Gate Configuration (runtime input ports)\lcfg_cg_enable: 1 = allow gating\lcfg_cg_idle_count: idle clocks to wait\l    before gating\l", fillcolor="white"];
    bus  [label="APB5 Completer Bus  s_apb_*\nin: PSEL, PENABLE, PADDR, PWRITE, PWDATA, PSTRB,\nPPROT, PAUSER, PWUSER, PWAKEUP + *CHK\nout: PREADY, PRDATA, PSLVERR, PRUSER, PBUSER + *CHK", fillcolor="white"];

    wake [label="Wakeup (flop on ungated pclk)\nr_wakeup <= PWAKEUP | PSEL | PENABLE\n| sync2(cmd_valid | rsp_valid)  (aclk activity,\n2-flop synchronized onto pclk)\n(reset: 1, so the clock runs out of reset)"];
    cgc  [label="Clock-Gate Controller\namba_clock_gate_ctrl - amba_clock_gate_ctrl\nidle countdown; gates when enabled and quiet"];
    stat [label="Clock-Gate Status\ncg_gating, cg_idle", fillcolor="white"];

    core [label="APB5 Slave CDC  apb5_slave_cdc - u_apb5_slave_cdc  (see its diagram)\npclk side on gated_pclk; aclk side on the ungated aclk",
          width=7.5];

    be [label="Backend Interface  (aclk domain: aclk, aresetn; never gated)\ncmd_valid / cmd_ready + cmd_* fields (incl. user)   |   rsp_valid / rsp_ready + rsp_* fields (incl. user)\nparity_error_wdata, parity_error_ctrl",
        fillcolor="white", width=10.0];

    clk -> wake [xlabel="pclk"];
    clk -> cgc [penwidth=1.8, xlabel="pclk"];
    wake -> cgc [xlabel="user_valid (wake)"];
    cfg -> cgc [style=dashed, xlabel="enable, idle count"];
    cgc -> stat [style=dashed];
    cgc -> core [penwidth=1.8, xlabel="gated_pclk"];
    bus -> core [dir=both, xlabel="APB transfer / PREADY, PRDATA, PSLVERR"];
    core -> be [dir=both, xlabel="command / response (valid-ready each)"];

    { rank=same; clk; cfg; bus; }
    { rank=same; cgc; stat; }
    clk -> cfg [style=invis]; cfg -> bus [style=invis];
    cgc -> stat [style=invis];
}
