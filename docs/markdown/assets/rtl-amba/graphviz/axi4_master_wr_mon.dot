// axi4_master_wr_mon block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Monitored wrapper: the base axi4_master_wr is one child box (see its own diagram).
// AXI traffic runs down the left column through the AW stall gate; the monitor taps the
// m_axi side and emits monitor-bus packets (the heavy edge). A full transaction table
// pushes back on the AR gate through block_ready.
// Source of truth: rtl/amba/axi4/axi4_master_wr_mon.sv.
digraph axi4_master_wr_mon {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           label="axi4_master_wr_mon - axi4_master_wr with an optional transaction monitor (single clock: aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lUSE_MONITOR: 0 = monitor omitted, outputs tied,\l    never stalls the bus\lMAX_TRANSACTIONS: outstanding writes tracked\lENABLE_*_LOGIC: which packet classes are built\lN_ADDR_RANGES: address-range checks (0 = none)\l", fillcolor="white"];
    fub  [label="FUB Side (requester)\nfub_axi_aw* / fub_axi_w* in  /  fub_axi_b* out", fillcolor="white"];
    cfg  [label="Monitor Configuration (runtime input ports)\lcfg_monitor_enable: master gate; 0 = monitor inert\lcfg_*_enable: per-class packet enables\lcfg_timeout_cycles: timeout in us (0 = never)\lcfg_axi_*_mask: per-event drop masks\laddress ranges, ID / address filters,\l    perf-window start / end events\l", fillcolor="white"];

    gate [label="AW Stall Gate (combinational)\nawvalid and awready both ANDed with\nblock_ready (or monitor disabled)"];
    base [label="AXI4 Write Master\naxi4_master_wr - axi4_master_wr_inst\n(see its diagram)"];
    taps [label="Bus Taps (combinational)\ncmd = m_axi_awvalid, data = wvalid,\nresp = bvalid; each AND\ncfg_monitor_enable"];
    mon  [label="Transaction Monitor (USE_MONITOR=1 only)\naxi_monitor_filtered - axi_monitor_inst\ntransaction table, timeouts, perf window,\npacket filter", style="filled,dashed"];

    bar  [label="Module Boundary\lm_axi_aw* / m_axi_w* out / m_axi_b* in  |  monbus_valid, packet, timestamp (monbus_ready in)\lbusy, active_transactions, perf_* counters, cfg_conflict_error\l",
          fillcolor="white", width=8.0];

    // AXI path: down the left (requests down, responses back up on the same pair)
    fub  -> gate [dir=both, xlabel="AW / W / B"];
    gate -> base [dir=both, xlabel="AW (gated) / W / B"];
    p_ax [shape=point, width=0.01];
    base -> p_ax [dir=back, headclip=false];
    p_ax -> bar  [dir=forward, tailclip=false, xlabel="AW, W down / B up"];
    // observation and packets
    p_ax -> taps [style=dashed, tailclip=false, xlabel="tap: m_axi valids,\nfields"];
    taps -> mon  [xlabel="cmd / data / resp"];
    mon  -> bar  [penwidth=1.8, xlabel="monitor-bus packets,\ncounters"];
    gate -> mon  [style=dashed, dir=back, constraint=false, taillabel="block_ready\n(table not full)", labelangle=0, labeldistance=6];
    cfg  -> mon  [style=dashed, xlabel="config"];

    { rank=same; prm; fub; cfg; }
    { rank=same; taps; p_ax; }
    prm -> fub [style=invis]; fub -> cfg [style=invis];
}
