// gaxi_skid_buffer block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Same geography as the approved fifo_sync / gaxi_fifo_sync: write port top
// left, read port top right, write data down the LEFT edge into the storage
// bar, read data (always slot 0) back UP the RIGHT edge. The storage is a
// shift register, not an addressed RAM: a write lands at the tail
// (index == count), a read shifts every slot down by one.
// The center block holds the slot count and the REGISTERED ready/valid, so
// both handshake returns are flops (dashed feedback to their ports).
// Source of truth: rtl/amba/gaxi/gaxi_skid_buffer.sv.
digraph gaxi_skid_buffer {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.85", splines=ortho, newrank=true,
           label="gaxi_skid_buffer - DEPTH-slot shift-register skid buffer\n(single clock: axi_aclk, axi_aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm [label="Parameters (fixed at build)\lDEPTH: 2 .. 8 slots (elaboration $error\l    outside that range; odd depths legal)\l", fillcolor="white"];

    wr_port [group=WO, label="Write Port (valid/ready)\nwr_valid, wr_data / wr_ready", fillcolor="white"];
    rd_port [group=RO, label="Read Port (valid/ready)\nrd_valid, rd_data / rd_ready", fillcolor="white"];

    ctl [group=C, label="Count + Handshake Registers (flops)\nr_data_count: +1 write only, -1 read only\nwr_ready / rd_valid are flops, set one cycle ahead\nfrom count and this cycle's transfers"];

    mem [group=C, label="Slot Shift Register  r_data[DEPTH]  (one flop row per slot)\nwrite only: wr_data lands at slot [count]\nread only: every slot shifts down one\nwrite + read: shift, and wr_data lands at slot [count-1]\nrd_data = slot [0]",
         width=11.0, height=0.9];

    wr_port -> ctl [dir=both, xlabel="wr_valid /\nwr_ready"];
    rd_port -> ctl [dir=both, xlabel="rd_ready /\nrd_valid,\ncount, rd_count"];
    ctl -> mem [xlabel="tail index (count),\nload / shift select"];

    aw    [group=WD, shape=point, width=0.01, style=invis];
    ar    [group=RD, shape=point, width=0.01, style=invis];
    p_wd  [group=WD, shape=point, width=0.01];
    p_rdd [group=RD, shape=point, width=0.01];
    wr_port -> p_wd [arrowhead=none, headclip=false];
    p_wd -> mem [xlabel="wr_data", tailclip=false];
    p_rdd -> mem [dir=none, tailclip=false, xlabel="rd_data (slot 0)"];
    p_rdd -> rd_port [tailclip=false, constraint=false];
    aw -> p_wd [style=invis, weight=10];
    ar -> p_rdd [style=invis, weight=10];

    node [style=invis, shape=point, width=0.01, group=C];
    c0; c3;
    node [style=filled, shape=box, width=0.75, group=""];
    c0 -> ctl -> c3 -> mem [style=invis, weight=10];

    { rank=same; aw; wr_port; c0; rd_port; ar; }
    { rank=min; prm; }
    prm -> wr_port [style=invis];
    { rank=same; p_wd; c3; p_rdd; }
    { rank=max; mem; }
    aw -> wr_port [style=invis, minlen=4];
    wr_port -> c0 -> rd_port [style=invis, minlen=3];
    rd_port -> ar [style=invis, minlen=4];
    p_wd -> c3 -> p_rdd [style=invis];
}
