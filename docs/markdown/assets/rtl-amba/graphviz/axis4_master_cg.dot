// axis4_master_cg block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Variant rule: the base axis4_master is ONE child box (see its own diagram);
// this diagram shows only what the _cg wrapper adds - an amba_clock_gate_ctrl
// whose gated clock drives the base (heavy: the output is a clock), and a
// ready gate that holds fub_axis_tready low while the clock is gated.
// Source of truth: rtl/amba/axis4/axis4_master_cg.sv.
digraph axis4_master_cg {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.65", splines=ortho, newrank=true,
           label="axis4_master_cg - axis4_master behind an idle-timeout clock gate\n(clock in: aclk; the base runs on gated_aclk)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    clk  [label="Clock In\naclk, aresetn", fillcolor="white"];
    cfg  [label="Clock-Gate Config (runtime ports)\ncfg_cg_enable: 1 = gating allowed\ncfg_cg_idle_count: idle cycles before gating", fillcolor="white"];
    fub  [label="FUB Stream Port (upstream)\nfub_axis_tvalid + T fields / fub_axis_tready", fillcolor="white"];

    cgc  [label="Clock-Gate Controller\namba_clock_gate_ctrl - i_amba_clock_gate_ctrl\nactivity (stays awake): user_valid = fub_axis_tvalid | base busy,\naxi_valid = m_axis_tvalid; gates after the idle count"];
    rdyg [label="Ready Gate (combinational)\nfub_axis_tready = cg_gating ? 0 : int_tready"];
    base [label="Base Stream Master\naxis4_master - i_axis_master\n(see the axis4_master diagram)", width=3.6];

    bus  [label="AXI4-Stream Master Bus + status\nm_axis_tvalid + T fields / m_axis_tready   |   cg_gating, cg_idle",
          fillcolor="white", width=7.5];

    clk  -> cgc  [xlabel="aclk", penwidth=1.8];
    cfg  -> cgc  [style=dashed, xlabel="enable, idle count"];
    cgc  -> base [xlabel="gated_aclk", penwidth=1.8];
    fub  -> base [xlabel="T beat"];
    base -> bus  [xlabel="m_axis T beat"];
    bus  -> base [style=dashed, constraint=false, xlabel="m_axis_tready"];
    base -> rdyg [style=dashed, xlabel="int_tready"];
    cgc  -> rdyg [style=dashed, xlabel="cg_gating"];
    rdyg -> fub  [style=dashed, constraint=false, xlabel="fub_axis_tready"];
    cgc  -> bus  [style=dashed, xlabel="cg_gating, cg_idle"];

    { rank=same; clk; cfg; fub; }
    { rank=same; cgc; rdyg; }
    clk -> cfg -> fub [style=invis];
    cgc -> rdyg [style=invis, minlen=3];
}
