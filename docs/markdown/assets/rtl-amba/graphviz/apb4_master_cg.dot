// apb4_master_cg block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Variant rule: the base apb4_master is ONE child box (it has its own
// diagram); this diagram shows what the variant adds - the activity wakeup
// flop and amba_clock_gate_ctrl, whose gated clock (the heavy column, per the
// "output is a clock" ruling) clocks the core.
// Source of truth: rtl/amba/apb4/apb4_master_cg.sv.
digraph apb4_master_cg {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.65", splines=ortho, newrank=true,
           label="apb4_master_cg - apb4_master behind an idle-timeout clock gate",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    clk  [label="Clock In\npclk, presetn", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    cfg  [label="Clock-Gate Configuration (runtime input ports)\lcfg_cg_enable: 1 = allow gating\lcfg_cg_idle_count: idle clocks to wait\l    before gating\l", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    cmd_port [label="Command Port\ncmd_valid / cmd_ready + cmd_* fields", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    rsp_port [label="Response Port\nrsp_valid / rsp_ready, rsp_prdata, rsp_pslverr", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    wake [label="Wakeup (flop on ungated pclk)\nr_wakeup <= cmd_valid | rsp_valid | PSEL | PENABLE\n(reset: 1, so the clock runs out of reset)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    cgc  [label="Clock-Gate Controller\namba_clock_gate_ctrl - amba_clock_gate_ctrl\nidle countdown; gates when enabled and quiet", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    stat [label="Clock-Gate Status\ncg_gating, cg_idle", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    core [label="APB4 Master Core  apb4_master - u_apb4_master  (see its diagram)\ncommand skid, transfer FSM, response skid; clocked by gated_pclk",
          width=7.5, peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];

    bus [label="APB4 Requester Bus  m_apb_*\nout: PSEL, PENABLE, PADDR, PWRITE, PWDATA, PSTRB, PPROT   |   in: PRDATA, PSLVERR, PREADY",
         fillcolor="white", width=10.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    clk -> wake [xlabel="pclk"];
    clk -> cgc [penwidth=1.8, xlabel="pclk"];
    wake -> cgc [xlabel="user_valid (wake)"];
    cfg -> cgc [style=dashed, color="#777777", xlabel="enable, idle count"];
    cgc -> stat [style=dashed, color="#777777"];
    cgc -> core [penwidth=1.8, xlabel="gated_pclk"];
    cmd_port -> core [dir=both, xlabel="cmd_valid + fields / cmd_ready"];
    rsp_port -> core [dir=both, xlabel="rsp_valid + prdata, pslverr / rsp_ready"];
    core -> bus [dir=both, penwidth=1.0, xlabel="APB transfer / PREADY, PRDATA, PSLVERR"];

    { rank=same; clk; cfg; cmd_port; rsp_port; }
    { rank=same; cgc; stat; }
    clk -> cfg [style=invis]; cfg -> cmd_port [style=invis]; cmd_port -> rsp_port [style=invis];
    cgc -> stat [style=invis];
}
