// axi4_master_wr_injector block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// The writer half of the pair with axi4_master_rd_crc_check. A CSR-programmed AXI4 write MASTER:
// the memory under test is the bottom bar. AW requests come down the LEFT column; W data
// (generated in lockstep by a second address generator and the data source) comes down the
// CENTER; B responses climb UP the RIGHT into completion tracking and the results.
// Source of truth: rtl/amba/shared/axi4_master_wr_injector.sv.
digraph axi4_master_wr_injector {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.70", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="axi4_master_wr_injector - pattern write driver with expected-CRC roll-up (aclk)";

    prm  [label="Parameters (fixed at build)\lMAX_OUTSTANDING: AWs issued minus Bs received\l    (ceiling); cfg_max_outstanding dials it down\lLFSR_* / CRC_*: must match axi4_master_rd_crc_check\l", fillcolor="white"];
    cfg  [group=A, label="Run Configuration (CSR inputs)\ncfg_start_addr, cfg_addr_stride_0/1, cfg_addr_wrap_mask_0/1,\ncfg_burst_len, cfg_txn_count, cfg_axi_size / _burst,\ncfg_id_mode, cfg_hammer_en, cfg_wr_gap,\ncfg_max_outstanding;  cfg_start", fillcolor="white"];
    dsrc [group=W, label="Data Source Config\ncfg_data_mode: 0 LFSR phase, 1 address hash,\n2 fill pattern; cfg_lfsr_seed, cfg_hash_seed0..2,\ncfg_fill_pattern", fillcolor="white"];
    res  [group=B, label="Results\ncfg_done (all Bs received)\no_expected_crc (+ valid with cfg_done)\no_bresp_error (sticky: any non-OKAY)", fillcolor="white"];

    agaw [group=A, label="AW Address Generator\ndma_address_gen - u_addr_gen_aw\nindex 0 .. cfg_txn_count-1 -> address"];
    iss  [group=A, label="AW Issue (flops)\nburst count, outstanding cap, wr gap;\nid per cfg_id_mode (u_id_lfsr for LFSR ids)"];
    agw  [group=W, label="W Address Generator\ndma_address_gen - u_addr_gen_w\nwalks the same descriptor in lockstep"];
    gen  [group=W, label="Pattern + CRC (flops)\nshifter_lfsr_fibonacci - u_lfsr (LFSR mode),\naddress hash, or fill pattern; one word per W beat;\ndataint_crc - u_crc over the same stream"];
    bcnt [group=B, label="Completion Tracking (flops)\ncounts Bs against cfg_txn_count;\nnon-OKAY bresp sets the sticky error"];
    leaf [label="AXI4 Master Write Leaf\naxi4_master_wr - u_master_wr\nskid buffers on AW / W / B"];

    bar  [label="Memory Under Test (m_axi master port)\nm_axi_aw, m_axi_w out   |   m_axi_b in",
          fillcolor="white", width=9.0];

    cfg  -> agaw [xlabel="descriptor, cfg_start"];
    agaw -> iss  [xlabel="AW address"];
    iss  -> leaf [xlabel="fub AW (addr, len, id)"];
    agw  -> gen  [xlabel="beat address"];
    dsrc -> gen  [style=dashed, xlabel="mode, seeds"];
    gen  -> leaf [xlabel="fub W (pattern, wlast)"];
    leaf -> bar  [dir=both, xlabel="AW, W  /  B"];
    bcnt -> leaf [dir=back, xlabel="fub B (bresp)"];
    bcnt -> res  [xlabel="done, bresp error"];
    gen  -> res  [xlabel="expected CRC"];

    { rank=same; cfg; dsrc; res; }
    cfg -> dsrc [style=invis];
    dsrc -> res [style=invis];
    { rank=same; agaw; agw; }
    { rank=same; iss; gen; bcnt; }
    gen -> bcnt [style=invis];
    { rank=same; prm; leaf; }
    prm -> leaf [style=invis];
}
