// apb4_monitor block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// A passive observer: the cmd / rsp handshakes it taps enter at the top; the
// Ocelus monitor-bus packet stream leaves through the bottom bar. Parallel
// independent checks share one rank and fan into the event select (a
// priority select among candidate packets - plain box, order in the label).
// The address-range checker is a SEPARATE packet source: its stream and the
// event FIFO compete for the bus in a 2:1 priority merge (FIFO first) - a
// genuine pick, so the trapezium - then an output skid buffer.
// Source of truth: rtl/amba/apb4/apb4_monitor.sv.
digraph apb4_monitor {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           label="apb4_monitor - APB command / response observer emitting Ocelus monitor packets (single clock: aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lUSE_MONITOR: 0 = no monitor body; outputs tied off\lN_ADDR_RANGES: 0 = no address-range checker\lMAX_TRANSACTIONS: transaction-table entries\lUNIT_ID / AGENT_ID: stamped into every packet\l", fillcolor="white", shape=note];
    taps [label="Observed Handshakes (inputs only)\ncmd_valid / cmd_ready, cmd_pwrite, paddr, pwdata, pstrb, pprot\nrsp_valid / rsp_ready, rsp_prdata, rsp_pslverr", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    cfg  [label="Runtime Configuration (input ports)\lcfg_*_enable: one enable per packet class\l    (error, timeout, protocol, slverr, perf,\l    latency, throughput, debug, trans_debug)\lcfg_cmd / rsp_timeout_cnt, latency and\l    throughput thresholds, debug level\lcfg_addr_*: range enables and bounds\l", fillcolor="white", shape=note];

    trk  [label="Transaction Tracker (flop)\nhandshake detect; r_trans_state: IDLE > CMD_SENT > COMPLETE\ntransaction table (MAX_TRANSACTIONS) with start timestamps", peripheries=2, style="filled", fillcolor="#D6E4F0"];

    tmo  [label="Timeout Detect\ncmd / rsp waits vs\ncfg_*_timeout_cnt", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    err  [label="Error Detect\nPSLVERR, protocol\nviolations", style="filled", fillcolor="white"];
    perf [label="Performance\nlatency and throughput\nvs thresholds", style="filled", fillcolor="white"];

    evt  [label="Event Select (combinational, priority)\nerror > timeout > performance > debug > completion\none packet per event, gated by its cfg enable", style="filled", fillcolor="white"];
    fifo [label="Packet FIFO\ngaxi_fifo_sync, MONITOR_FIFO_DEPTH entries\n(mux read)", shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    addr [label="Address-Range Check  (N_ADDR_RANGES > 0 only)\napb_monitor_addr_check - addr_check\nreads the cmd handshake and cmd_paddr;\nrange-miss packets with their own timestamp", style="filled,dashed", peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];

    merge [label="Packet Merge (2:1 priority)\nevent FIFO first, then range misses", shape=invtrapezium, fillcolor="#BFD7EE", width=4.6, height=0.7, fixedsize=true, style="filled", fillcolor="#FFF2CC"];
    skid [label="Output Skid Buffer\ngaxi_skid_buffer, DEPTH 2", shape=cylinder, style="filled", fillcolor="#E8DFF5"];

    out  [label="Ocelus Monitor Bus   monbus_valid / monbus_ready, monbus_packet (128-bit), monbus_timestamp\nstatistics: active_count, error_count, transaction_count",
          fillcolor="white", width=10.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    taps -> trk [penwidth=1.8, xlabel="cmd / rsp handshakes"];
    taps -> addr [style=dashed, color="#777777"];
    trk -> tmo [xlabel="open entries"];
    trk -> err [xlabel="completions"];
    trk -> perf [xlabel="start / end times"];
    tmo -> evt [xlabel="timeout"];
    err -> evt [xlabel="error"];
    perf -> evt [xlabel="perf"];
    evt -> fifo [penwidth=1.8, xlabel="packet"];
    fifo -> merge [xlabel="event packets\n(i_mon_time)"];
    addr -> merge [style=dashed, color="#777777", xlabel="range-miss packets"];
    merge -> skid [penwidth=1.8, xlabel="packet + timestamp"];
    skid -> out [penwidth=1.8, xlabel="monbus packet / ready"];

    { rank=same; prm; taps; cfg; }
    { rank=same; tmo; err; perf; }
    { rank=same; fifo; addr; }
    prm -> taps [style=invis]; taps -> cfg [style=invis];
    tmo -> err [style=invis]; err -> perf [style=invis];
    fifo -> addr [style=invis, minlen=2];
}
