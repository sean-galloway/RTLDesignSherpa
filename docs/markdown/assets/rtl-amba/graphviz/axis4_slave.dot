// axis4_slave block diagram (mirror of axis4_master.dot) - house style (vault/handbook/authoring/block-diagrams.md).
// AXI4-Stream channel geometry: the upstream AXI4-Stream bus is the white
// port at the top, the downstream FUB side the white bar at the bottom. Transfers (valid
// + payload) flow straight down the center through ONE gaxi_skid_buffer;
// tready returns dashed up the right, one hop at a time.
// Source of truth: rtl/amba/axis4/axis4_slave.sv.
digraph axis4_slave {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           label="axis4_slave - AXI4-Stream slave to FUB stream, one skid buffer\n(single clock: aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lSKID_DEPTH: slots in the T skid buffer (2 .. 8)\lAXIS_ID/DEST/USER_WIDTH: 0 drops the field\l    (the port stays 1 bit wide, driven 0)\l", fillcolor="white", shape=note];

    fub  [label="AXI4-Stream Slave Bus (upstream)\ns_axis_tvalid, tdata, tstrb, tlast, tid, tdest, tuser\n/ s_axis_tready", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    pack [label="Pack (wiring)\n{tdata, tstrb, tlast, tid, tdest, tuser}\none TSize-bit word per beat", style="filled", fillcolor="white"];
    skid [label="T Skid Buffer\ngaxi_skid_buffer - i_t_channel\nDEPTH = SKID_DEPTH, registered ready / valid", shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    unp  [label="Unpack (wiring)\nper-field slices back to fub_axis_t*", style="filled", fillcolor="white"];
    bus  [label="FUB Stream Port (downstream)\nfub_axis_tvalid, tdata, tstrb, tlast, tid, tdest, tuser  /  fub_axis_tready\nbusy = (rd_count > 0) | s_axis_tvalid",
          fillcolor="white", width=6.5, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    fub  -> pack [xlabel="T beat (valid + payload)"];
    pack -> skid [xlabel="wr_valid, wr_data"];
    skid -> unp  [xlabel="rd_valid, rd_data"];
    unp  -> bus  [xlabel="fub_axis_tvalid + T fields"];

    bus  -> skid [style=dashed, color="#777777", constraint=false, xlabel="fub_axis_tready\n(= rd_ready)"];
    skid -> fub  [style=dashed, color="#777777", constraint=false, xlabel="s_axis_tready\n(= wr_ready)"];

    { rank=min; prm; }
    prm -> fub [style=invis];
}
