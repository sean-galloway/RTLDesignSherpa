// axil5_slave_rd_mon_cg block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Variant of axil5_slave_rd: the wrapped module is ONE child box (see its own diagram);
// only what this wrapper adds is drawn. Generated from the axil4 variant template
// with AXI5-Lite names (IDs on every channel, i_axil5_* instances).
// Source of truth: rtl/amba/axil5/axil5_slave_rd_mon_cg.sv.
digraph axil5_slave_rd_mon_cg {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.80", splines=ortho, newrank=true,
           label="axil5_slave_rd_mon_cg - axil5_slave_rd_mon on a gated clock\n(aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    top   [label="AXI5-Lite Bus, slave side (s_axil_*)\nfrom the interconnect / master", fillcolor="white", width=3.8];
    child [label="axil5_slave_rd_mon\naxil5_slave_rd_mon_inst\n(see its diagram: core + ocelus monitor)", width=3.4, height=1.0];
    bot   [label="Read Completer (fub_axil_*)\nbackend serving reads", fillcolor="white", width=4.4];

    clk   [label="Clock In\naclk, aresetn", fillcolor="white"];
    cfg   [label="Clock-Gate Config (runtime input ports)\lcfg_cg_enable: 1 = allow gating\lcfg_cg_idle_count: idle cycles before the\l    clock stops (CG_IDLE_COUNT_WIDTH bits)\l", fillcolor="white"];
    cgc   [label="Clock-Gate Controller\namba_clock_gate_ctrl - i_amba_clock_gate_ctrl\nidle countdown on activity:\nuser_valid: s_axil_arvalid, s_axil_rvalid, child busy,\nmonbus_valid or active_transactions\naxi_valid: fub_axil_arvalid, fub_axil_rvalid\nwhile gating, forces low: s_axil_arready, fub_axil_rready"];
    cgo   [label="Status Outputs\ncg_gating (clock stopped), cg_idle", fillcolor="white"];
    clk -> cgc  [xlabel="aclk", penwidth=1.8];
    cfg -> cgc  [style=dashed, xlabel="enable, idle count"];
    cgc -> child [xlabel="gated_aclk", penwidth=1.8];
    cgc -> cgo  [style=dashed, xlabel="cg_gating, cg_idle"];

    top   -> child [dir=both, xlabel="AR (arid, araddr, ...) down /\nR (rid, rdata, rresp, ...) up", penwidth=1.8];
    child -> bot   [dir=both, xlabel="AR (arid, araddr, ...) out /\nR (rid, rdata, rresp, ...) in", penwidth=1.8];

    mout  [label="Monitor Outputs (passed through)\lmonbus_packet / valid / ready, monbus_timestamp\lbusy, active_transactions, counters\lmonitor config ports pass through to the child\l", fillcolor="white"];
    child -> mout [headlabel="ocelus\npackets", labelangle=-60, labeldistance=4.5, penwidth=1.8];

    { rank=same; clk; cfg; top; }
    cfg -> clk [style=invis]; clk -> top [style=invis];
    { rank=same; cgc; }
    { rank=same; child; }
    cgc -> child [style=invis];
    { rank=same; bot; mout; cgo; }
    cgo -> bot [style=invis]; bot -> mout [style=invis];
}
