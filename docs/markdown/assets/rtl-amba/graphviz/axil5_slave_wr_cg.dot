// axil5_slave_wr_cg block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Variant of axil5_slave_wr: the wrapped module is ONE child box (see its own diagram);
// only what this wrapper adds is drawn. Generated from the axil4 variant template
// with AXI5-Lite names (IDs on every channel, i_axil5_* instances).
// Source of truth: rtl/amba/axil5/axil5_slave_wr_cg.sv.
digraph axil5_slave_wr_cg {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.80", splines=ortho, newrank=true,
           label="axil5_slave_wr_cg - axil5_slave_wr on a gated clock (idle-timeout clock gating)\n(aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    top   [label="AXI5-Lite Bus, slave side (s_axil_*)\nfrom the interconnect / master", fillcolor="white", width=3.8, style="rounded,filled", fillcolor="#E2EFDA"];
    child [label="axil5_slave_wr\ni_axil5_slave_wr\n(see its diagram: one skid buffer per channel)", width=3.4, height=1.0, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    bot   [label="Write Completer (fub_*)\nbackend serving writes", fillcolor="white", width=4.4, style="rounded,filled", fillcolor="#E2EFDA"];

    clk   [label="Clock In\naclk, aresetn", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    cfg   [label="Clock-Gate Config (runtime input ports)\lcfg_cg_enable: 1 = allow gating\lcfg_cg_idle_count: idle cycles before the\l    clock stops (CG_IDLE_COUNT_WIDTH bits)\l", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    cgc   [label="Clock-Gate Controller\namba_clock_gate_ctrl - i_amba_clock_gate_ctrl\nidle countdown on activity:\nuser_valid: s_axil_awvalid, s_axil_wvalid or child busy\naxi_valid: fub_awvalid, fub_wvalid,\nfub_bvalid, s_axil_bvalid\nwhile gating, forces low: s_axil_awready, s_axil_wready, fub_bready", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    cgo   [label="Status Outputs\ncg_gating (clock stopped), cg_idle", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    clk -> cgc  [xlabel="aclk", penwidth=1.8];
    cfg -> cgc  [style=dashed, color="#777777", xlabel="enable, idle count"];
    cgc -> child [xlabel="gated_aclk", penwidth=1.8];
    cgc -> cgo  [style=dashed, color="#777777", xlabel="cg_gating, cg_idle"];

    top   -> child [dir=both, xlabel="AW + W (awid, awaddr, ... / wdata, wstrb, ...) down /\nB (bid, bresp, ...) up", penwidth=1.8];
    child -> bot   [dir=both, xlabel="AW + W (awid, awaddr, ... / wdata, wstrb, ...) out /\nB (bid, bresp, ...) in", penwidth=1.8];

    { rank=same; clk; cfg; top; }
    cfg -> clk [style=invis]; clk -> top [style=invis];
    { rank=same; cgc; }
    { rank=same; child; }
    cgc -> child [style=invis];
    { rank=same; bot; cgo; }
    cgo -> bot [style=invis];
}
