// monbus_pkt_tally block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Source of truth: projects/components/utility-ip/misc/rtl/monbus_pkt_tally.sv.
// Flow: packet in (top) -> key -> legal-set CAM -> bin select -> single-port
// count SRAM (bottom bar). The saturating read-modify-write climbs the right
// edge back into the SRAM port select; the same read data is the host readback.
digraph monbus_pkt_tally {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.60", splines=ortho, newrank=true,
           label="monbus_pkt_tally - on-chip packet-coverage histogram (single clock: clk, rst_n)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lN_PROFILE: legal-set entries = dense bins\l    0 .. N_PROFILE-1; UNEXPECTED = bin N_PROFILE\lADDR_BITS: count SRAM is 2^ADDR_BITS words\lCOUNT_WIDTH: saturating count width\lNUM_LATCH: first-event capture slots\l", fillcolor="white"];
    pin  [group=M, label="Packet In\nin_valid, in_packet, in_ts / in_ready", fillcolor="white"];
    load [label="Legal-Set Load (runtime port)\lprofile_clear, profile_we,\lprofile_waddr, profile_wvalid,\lprofile_wkey: one {key, index}\lper entry\l", fillcolor="white"];
    ctl  [group=L, label="Host Control\ni_freeze (hold counting), i_clear (zero all)\ni_flush (no-op) / o_flush_busy", fillcolor="white"];
    rdp  [label="Readback Port\nrd_addr / rd_count", fillcolor="white"];

    key  [group=M, label="Key Extract (combinational)\n{agent[15:0], protocol[3:0],\npkt_type[3:0], event_code[7:0]}"];
    cam  [group=M, label="Legal-Set Lookup\nmonbus_legal_cam - u_legal_cam\nN_PROFILE parallel compares (see its diagram)"];
    bsel [group=M, label="Bin Select (combinational)\nhit: dense index (position in the legal set)\nmiss: UNEXPECTED bin (index N_PROFILE)"];
    fsm  [group=L, label="Controller FSM (flops)\nST_RUN: accept, read the bin\nST_WR: write the increment back\nST_CLEAR: walk the SRAM to 0"];
    pmux [group=M, label="SRAM Port Select (combinational)\nST_CLEAR: write 0 at the walk index\nST_WR: write sat_inc(old) at the held bin\naccept: read the bin  |  idle: read rd_addr"];
    inc  [label="Saturating Increment\n(combinational)\ncount + 1, pegged at\nall-ones (never wraps)"];
    lat  [group=R, label="First-Event Latch Bank (flops)\nNUM_LATCH slots of {packet, ts}\nlatches when armed and the pkt_type\nis watched OR the key missed the\nlegal set; latch_sel picks a slot", style="filled"];
    latp [group=R, label="Watch Port\ni_watch_arm, i_watch_pkttype_mask,\nlatch_sel / latch_valid, latch_packet,\nlatch_ts, latch_fill", fillcolor="white"];

    sram [label="Count SRAM  r_sram[2^ADDR_BITS] x COUNT_WIDTH  (single port, synchronous read + write)\nN_PROFILE+1 words used; read-old on a same-address read/write; r_sram_rdata registered",
          width=11.0, height=0.8];

    // main flow
    pin  -> key  [label="accepted packet\n(in_valid & in_ready)", penwidth=1.8];
    key  -> cam  [label="lookup key", penwidth=1.8];
    load -> cam  [style=dashed, xlabel="legal set"];
    cam  -> bsel [label="hit, hit index", penwidth=1.8];
    bsel -> pmux [label="bin address", penwidth=1.8];
    pmux -> sram [label="addr, we, wdata", penwidth=1.8];

    // control
    ctl  -> fsm  [style=dashed, label="freeze, clear"];
    fsm  -> pmux [style=dashed, label="state, clear index"];

    // RMW loop and readback: SRAM read data climbs the right edge
    p_rd [shape=point, width=0.01];
    p_rd -> sram [dir=back, arrowtail=none, headclip=true, tailclip=false];
    p_rd -> inc  [dir=back, xlabel="old count"];
    inc  -> pmux [label="count + 1"];
    p_rd -> rdp  [xlabel="rd_count", constraint=false];
    rdp  -> pmux [style=dashed, label="rd_addr"];

    // latch bank beside the main column
    key  -> lat  [style=dashed, label="packet, ts"];
    bsel -> lat  [style=dashed, xlabel="miss"];
    latp -> lat  [dir=both, style=dashed, label="arm, mask, sel /\nlatched packets"];

    { rank=same; prm; ctl; load; pin; latp; rdp; }
    { rank=same; fsm; key; }
    { rank=same; cam; lat; }
    { rank=same; pmux; inc; p_rd; }
    { rank=max; sram; }
    ctl -> load [style=invis]; load -> pin [style=invis]; pin -> latp [style=invis, minlen=2]; latp -> rdp [style=invis];
    fsm -> key [style=invis, minlen=2];
    cam -> lat [style=invis, minlen=2];
    pmux -> inc [style=invis]; inc -> p_rd [style=invis];
    prm -> ctl [style=invis];
}
