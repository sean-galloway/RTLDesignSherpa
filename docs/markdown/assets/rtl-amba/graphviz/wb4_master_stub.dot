// wb4_master_stub block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Packing wrapper: wb4_master as ONE child box; the FUB sees packed cmd_data / rsp_data.
// Source of truth: rtl/amba/wb4/wb4_master_stub.sv.
digraph wb4_master_stub {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.80", splines=ortho, newrank=true,
           label="wb4_master_stub - wb4_master with packed command / response words (single clock: clk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    top   [label="FUB Side (packed words)\ncmd_valid / cmd_ready, cmd_data = {we, adr, dat, sel, cti, bte}\nrsp_valid / rsp_ready, rsp_data = {status, dat}", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    pk    [label="Pack / Unpack (wiring)\nsplits cmd_data into fields,\njoins {rsp_status, rsp_dat} into rsp_data", style="filled", fillcolor="white"];
    child [label="wb4_master\nu_wb4_master\n(see its diagram)", width=3.2, height=0.9, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    bot   [label="Wishbone B4 Requester Bus (m_wb_*)", fillcolor="white", width=4.4, style="rounded,filled", fillcolor="#E2EFDA"];
    top -> pk    [dir=both, xlabel="cmd_data down /\nrsp_data up"];
    pk -> child  [dir=both, xlabel="cmd_* fields down /\nrsp_status, rsp_dat up"];
    child -> bot [dir=both, xlabel="CYC, STB, ... out /\nSTALL, ACK / ERR / RTY, DAT_R in", penwidth=1.8];
}
