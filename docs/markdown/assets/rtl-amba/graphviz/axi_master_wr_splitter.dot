// axi_master_wr_splitter block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Upstream FUB write port at the top, the downstream m_axi port as the bottom bar.
// AW flows down the center through split control (axi_split_combi gives each piece);
// W data drops through the beat counter, which regenerates WLAST at every piece boundary;
// B responses return UP the right lane and are consolidated into one upstream B.
// Source of truth: rtl/amba/shared/axi_master_wr_splitter.sv.
digraph axi_master_wr_splitter {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.85", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="axi_master_wr_splitter - splits AXI write bursts at an alignment boundary (one clock: aclk)";

    sinfo [group=S, label="Split Info Out\nfub_split_addr / _id / _cnt\n/ fub_split_ready\no_split_fifo_overflow (sticky)", fillcolor="white"];
    ctl   [group=K, label="Control Inputs\nalignment_mask[11:0]\n(0xFFF = 4 KB)\nblock_ready", fillcolor="white"];
    fport [group=C, label="Upstream FUB Write Port\nfub_aw, fub_w in   |   fub_b out", fillcolor="white"];

    fifo  [group=S, label="Split Info FIFO\ngaxi_fifo_sync -\ninst_split_info_fifo\none {addr, id, count}\nper original burst"];
    fsm   [group=C, label="Split Control (flops)\nIDLE / SPLITTING; r_orig_* hold the original AW\nr_current_addr / len step through the pieces\nfub_awready held low until the final piece"];
    calc  [group=K, label="Split Calculator\naxi_split_combi -\ninst_axi_split_combi\n(see its diagram)"];
    awdrv [group=C, label="AW Drive (combinational)\nIDLE: fub fields\nSPLITTING: held fields\nawlen = split_len"];
    wpath [group=W, label="W Beat Counter (flops)\nr_beat_counter vs r_expected_beats\nm_axi_wlast at every piece end\nfub_wready = wready & AW issued"];
    bcons [group=B, label="B Consolidation (flops)\ncounts the pieces' responses,\nkeeps the worst bresp;\none fub_b per original burst"];

    bar   [label="Downstream AXI Write Port (m_axi)\nm_axi_aw out: one AW per piece   |   m_axi_w out   |   m_axi_b in",
           fillcolor="white", width=9.0];

    fport -> fsm   [xlabel="AW (original burst)"];
    ctl   -> fsm   [style=dashed, xlabel="block_ready"];
    fsm   -> calc  [dir=both, xlabel="addr, len /\nsplit_len, remaining"];
    ctl   -> calc  [style=dashed, xlabel="alignment_mask"];
    fsm   -> awdrv [xlabel="current piece"];
    awdrv -> bar   [xlabel="AW (per piece)"];
    fport -> wpath [xlabel="W beats"];
    fsm   -> wpath [style=dashed, xlabel="piece lengths"];
    wpath -> bar   [xlabel="W (wlast per piece)"];
    bcons -> bar   [dir=back, xlabel="B per piece"];
    bcons -> fport [xlabel="B (consolidated)"];
    fsm   -> bcons [style=dashed, xlabel="expected\nresponses"];
    fsm   -> fifo  [xlabel="record at\nlast piece"];
    fifo  -> sinfo [xlabel="split info"];

    { rank=same; sinfo; ctl; fport; }
    sinfo -> ctl [style=invis];
    ctl -> fport [style=invis];
    { rank=same; fifo; calc; awdrv; wpath; bcons; }
    fifo -> calc [style=invis];
    calc -> awdrv [style=invis];
    awdrv -> wpath [style=invis];
    wpath -> bcons [style=invis];
}
