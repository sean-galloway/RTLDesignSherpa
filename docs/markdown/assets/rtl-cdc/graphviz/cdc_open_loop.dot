// cdc_open_loop block diagram - house style
// (vault/handbook/authoring/block-diagrams.md, "Dual-clock / CDC blocks";
// fifo_async.dot is the approved template).
// Flows:
//   data      - src_data drops down the LEFT edge into the held data bus
//               (r_src_data, clk_src); dst_data climbs the RIGHT edge. The
//               bus crosses with no synchronizer: the stretch window keeps it
//               stable until the destination has sampled it.
//   control   - ONE synchronized crossing, source to destination: the
//               stretched valid. There is no acknowledge, so nothing crosses
//               back; src_busy is the source's only protection.
// Source of truth: rtl/cdc/cdc_open_loop.sv
digraph cdc_open_loop {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.75", splines=ortho, newrank=true,
           label="cdc_open_loop - stretched valid, one crossing, no acknowledge",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external interfaces (white) ----
    src_port [group=SO, label="Source Port\nclk_src domain", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    dst_port [group=DO, label="Destination Port\nclk_dst domain", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    subgraph cluster_src {
        label="clk_src domain"; style=dashed; fontsize=10;
        stretch [group=SO, label="Stretch Control\nr_stretch_count, r_src_valid_stretch\nSTRETCH_CYCLES or AUTO_STRETCH", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    }

    subgraph cluster_dst {
        label="clk_dst domain"; style=dashed; fontsize=10;
        dst_ctl   [group=DO, label="Capture Control\ndst_valid = one-cycle pulse\non the synchronized rise", peripheries=2, style="filled", fillcolor="#D6E4F0"];
        vsync     [group=DI, label="Valid Sync + Rise Detect\nglitch_free_n_dff_arn (SYNC_STAGES on clk_dst)\nrise = sync & !previous", style="filled", fillcolor="white"];
    }

    // ---- the boundary bar: the held data bus both clocks touch ----
    bus [group=C, label="Held Data Bus  [DATA_WIDTH]  (crosses unsynchronized, stable for the stretch window)\nr_src_data loaded on clk_src at the left, captured into dst_data on clk_dst at the right",
         width=13.0, height=0.8, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    // ---- port interfaces ----
    src_port -> stretch [dir=both, label="src_valid / src_busy"];
    dst_port -> dst_ctl [color="#1A7A1A", dir=back, label="dst_valid"];

    // ---- the one crossing ----
    stretch -> vsync [headlabel="valid (stretched)", labelangle=-60, labeldistance=5, penwidth=1.8];

    // ---- rise back up to the capture control ----
    dst_ctl -> vsync [color="#1A7A1A", dir=back, xlabel="valid rise"];

    // ---- bar connections via point scaffolds ----
    p_sd  [shape=point, width=0.01];
    p_ld  [shape=point, width=0.01, group=SO];
    p_cap [shape=point, width=0.01, group=DO];
    p_dd  [shape=point, width=0.01];

    src_port -> p_sd [arrowhead=none, headclip=false];
    p_sd -> bus [xlabel="src_data", tailclip=false];
    stretch -> p_ld [arrowhead=none, headclip=false];
    p_ld -> bus [xlabel="load\n(accepted src_valid)", tailclip=false];
    dst_ctl -> p_cap [arrowhead=none, headclip=false];
    p_cap -> bus [xlabel="capture\n(valid rise)", tailclip=false];
    p_dd -> bus [color="#1A7A1A", dir=none, tailclip=false];
    p_dd -> dst_port [color="#1A7A1A", xlabel="dst_data", tailclip=false, constraint=false];

    // ---- invisible center spine (group C) ----
    node [style=invis, shape=point, width=0.01, group=C];
    c0; c1; c2; c4;
    node [style=filled, shape=box, width=0.75, group=""];
    c0 -> c1 -> c2 -> c4 -> bus [style=invis, weight=10];

    // ---- rank pinning ----
    { rank=same; src_port; c0; dst_port; }
    { rank=same; stretch; c1; dst_ctl; }
    { rank=same; c2; vsync; }
    { rank=same; p_sd; p_ld; c4; p_cap; p_dd; }
    { rank=max; bus; }
    src_port -> c0 -> dst_port [style=invis];
    stretch -> c1 -> dst_ctl [style=invis, minlen=2];
    c2 -> vsync [style=invis];
    p_sd -> p_ld [style=invis, minlen=4];
    p_ld -> c4 -> p_cap [style=invis];
    p_cap -> p_dd [style=invis, minlen=2];
    vsync -> p_cap [style=invis];
}
