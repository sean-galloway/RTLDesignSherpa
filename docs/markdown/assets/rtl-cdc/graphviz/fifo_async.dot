// fifo_async block diagram - house style (vault/handbook/authoring/block-diagrams.md),
// mirroring the mem-ctrl whole-unit reference geography:
//   ports at the top (write left, read right) -> per-domain pointer logic ->
//   the dual-port storage bar at the bottom.
// Flows:
//   write data   - down the LEFT edge, Write Port -> storage (wr_clk)
//   read data    - back UP the RIGHT edge, storage -> Read Port (rd_clk)
//   pointers     - the only signals that cross the clock-domain boundary,
//                  Gray (or Johnson) coded, through an N-flop synchronizer
//                  clocked by the DESTINATION domain; they cross in the center.
//   flags        - dashed feedback to the port they gate.
// Column grid, left to right: write-data lane | WO write counter (its
// address runs straight down) | WI rd-ptr sync + full flags | RI wr-ptr sync +
// empty flags | RO read counter | read-data lane. Inner columns hug the
// domain boundary so the two Gray pointers cross in the center.
// Source of truth: rtl/cdc/fifo_async.sv (instance names quoted in labels).
digraph fifo_async {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.75", splines=ortho, newrank=true,
           label="fifo_async - dual-clock FIFO, pointer-synchronized",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external interfaces (white) ----
    wr_port [group=WO, label="Write Port\nwr_clk domain", fillcolor="white"];
    rd_port [group=RO, label="Read Port\nrd_clk domain", fillcolor="white"];

    subgraph cluster_wr {
        label="wr_clk domain"; style=dashed; fontsize=10;
        wr_cnt  [group=WO, label="Write Pointer Counter\ncounter_bingray\n(Johnson: counter_johnson)"];
        rd_sync [group=WI, label="Read Pointer Sync + Decode\nglitch_free_n_dff_arn on wr_clk\n+ gray2bin (Johnson: johnson2bin)"];
        full    [group=WI, label="Full / Almost-Full Flags\nfifo_control - write half"];
    }

    subgraph cluster_rd {
        label="rd_clk domain"; style=dashed; fontsize=10;
        rd_cnt  [group=RO, label="Read Pointer Counter\ncounter_bingray\n(Johnson: counter_johnson)"];
        wr_sync [group=RI, label="Write Pointer Sync + Decode\nglitch_free_n_dff_arn on rd_clk\n+ gray2bin (Johnson: johnson2bin)"];
        empty   [group=RI, label="Empty / Almost-Empty Flags\nfifo_control - read half"];
    }

    // ---- the boundary bar: storage written on wr_clk, read on rd_clk ----
    mem [group=C, label="Dual-Port Storage  mem[DEPTH]  (MEM_STYLE: SRL / BRAM / AUTO)\nwritten on wr_clk at the left, read on rd_clk at the right\n(REGISTERED=1 or BRAM: rd_data flopped on rd_clk)",
         width=17.4, height=0.9];

    // ---- push / pop into the counters ----
    wr_port -> wr_cnt [label="write"];
    rd_port -> rd_cnt [label="read"];

    // ---- the pointer crossings (the only CDC paths) ----
    wr_cnt -> wr_sync [headlabel="wr ptr (Gray)", labelangle=-60, labeldistance=5, penwidth=1.8];
    rd_cnt -> rd_sync [headlabel="rd ptr (Gray)", labelangle=60, labeldistance=5, penwidth=1.8];

    // ---- compare in each domain: local pointer vs synchronized remote ----
    wr_cnt  -> full  [label="wr ptr (local)"];
    rd_sync -> full  [label="rd ptr (binary)"];
    rd_cnt  -> empty [label="rd ptr (local)"];
    wr_sync -> empty [label="wr ptr (binary)"];

    // ---- flags back to the ports (feedback: dashed) ----
    full  -> wr_port [style=dashed, constraint=false, xlabel="wr_full,\nwr_almost_full"];
    empty -> rd_port [style=dashed, constraint=false, xlabel="rd_empty,\nrd_almost_empty"];

    // ---- storage connections via point scaffolds (left to right: write
    //      data, write address, read address, read data) ----
    p_wd  [shape=point, width=0.01];
    p_wa  [shape=point, width=0.01, group=WO];
    p_ra  [shape=point, width=0.01, group=RO];
    p_rdd [shape=point, width=0.01];
        
    wr_port -> p_wd [arrowhead=none, headclip=false];
    p_wd -> mem [xlabel="wr_data", tailclip=false];
    wr_cnt -> p_wa [arrowhead=none, headclip=false];
    p_wa -> mem [xlabel="write address", tailclip=false];
    rd_cnt -> p_ra [arrowhead=none, headclip=false];
    p_ra -> mem [xlabel="read address", tailclip=false];
    p_rdd -> mem [dir=none, tailclip=false];
    p_rdd -> rd_port [xlabel="rd_data", tailclip=false, constraint=false];

    // ---- invisible center spine (group C): one tiny node per rank on the
    //      domain boundary, chained down to the bar, so the storage bar
    //      centers under the boundary instead of drifting to one side ----
    node [style=invis, shape=point, width=0.01, group=C];
    c0; c1; c2; c3; c4;
    node [style=filled, shape=box, width=0.75, group=""];
    c0 -> c1 -> c2 -> c3 -> c4 -> mem [style=invis, weight=10];

    // ---- rank pinning ----
    { rank=same; wr_port; c0; rd_port; }
    { rank=same; wr_cnt; c1; rd_cnt; }
    { rank=same; rd_sync; c2; wr_sync; }
    { rank=same; full; c3; empty; }
    { rank=same; p_wd; p_wa; c4; p_ra; p_rdd; }
    { rank=max; mem; }
    wr_port -> c0 -> rd_port [style=invis];
    wr_cnt -> c1 -> rd_cnt [style=invis];
    rd_sync -> c2 -> wr_sync [style=invis];
    full -> c3 -> empty [style=invis];
    p_wd -> p_wa [style=invis, minlen=2];
    p_wa -> c4 -> p_ra [style=invis];
    p_ra -> p_rdd [style=invis, minlen=2];
    full -> p_wa [style=invis];
    empty -> p_ra [style=invis];
}
