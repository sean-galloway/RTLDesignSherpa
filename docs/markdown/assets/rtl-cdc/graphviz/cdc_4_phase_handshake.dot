// cdc_4_phase_handshake block diagram - house style
// (vault/handbook/authoring/block-diagrams.md, "Dual-clock / CDC blocks";
// fifo_async.dot is the approved template).
// Flows:
//   data      - src_data drops down the LEFT edge into the held data bus
//               (r_src_data_hold, clk_src); dst_data climbs the RIGHT edge
//               from r_dst_data (clk_dst). The bus itself crosses with no
//               synchronizer: the handshake keeps it stable.
//   control   - the req and ack levels are the only synchronized crossings;
//               they cross in the center (heavy X) and land on a synchronizer
//               in the DESTINATION domain, whose level goes back up to that
//               domain's control FSM. Each level rises and falls once per
//               transfer (return to zero), so each crosses twice.
// Column grid: lane | SO src FSM | SI ack sync | spine | DI req sync | DO dst FSM | lane
// Source of truth: rtl/cdc/cdc_4_phase_handshake.sv
digraph cdc_4_phase_handshake {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.75", splines=ortho, newrank=true,
           label="cdc_4_phase_handshake - level (RZ) req/ack, two crossings each way per transfer",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external interfaces (white) ----
    src_port [group=SO, label="Source Port\nclk_src domain", fillcolor="white"];
    dst_port [group=DO, label="Destination Port\nclk_dst domain", fillcolor="white"];

    subgraph cluster_src {
        label="clk_src domain"; style=dashed; fontsize=10;
        src_ctl  [group=SO, label="Source Control\nS_IDLE / S_WAIT_ACK /\nS_WAIT_ACK_CLR"];
        ack_sync [group=SI, label="Ack Synchronizer\nr_ack_sync (SYNC_STAGES on clk_src)\nlevel, no edge detect"];
    }

    subgraph cluster_dst {
        label="clk_dst domain"; style=dashed; fontsize=10;
        dst_ctl  [group=DO, label="Destination Control\nD_IDLE / D_WAIT_READY /\nD_WAIT_REQ_CLR"];
        req_sync [group=DI, label="Req Synchronizer\nr_req_sync (SYNC_STAGES on clk_dst)\nlevel, no edge detect"];
    }

    // ---- the boundary bar: the held data bus both clocks touch ----
    bus [group=C, label="Held Data Bus  [DATA_WIDTH]  (crosses unsynchronized, stable for the whole handshake)\nr_src_data_hold loaded on clk_src at the left, captured into r_dst_data on clk_dst at the right",
         width=13.0, height=0.8];

    // ---- port handshakes (one edge per pair, combined label) ----
    src_port -> src_ctl [dir=both, label="src_valid / src_ready,\nsrc_timeout"];
    dst_port -> dst_ctl [dir=both, label="dst_valid / dst_ready"];

    // ---- the crossings (the only synchronized CDC paths) ----
    src_ctl -> req_sync [headlabel="req level\n(r_req_src)", labelangle=-60, labeldistance=5, penwidth=1.8];
    dst_ctl -> ack_sync [headlabel="ack level\n(r_ack_dst)", labelangle=60, labeldistance=5, penwidth=1.8];

    // ---- events back up to each domain's control ----
    src_ctl -> ack_sync [dir=back, xlabel="ack (synced)"];
    dst_ctl -> req_sync [dir=back, xlabel="req (synced)"];

    // ---- bar connections via point scaffolds (left to right: src_data,
    //      hold enable, capture enable, dst_data) ----
    p_sd  [shape=point, width=0.01];
    p_ld  [shape=point, width=0.01, group=SO];
    p_cap [shape=point, width=0.01, group=DO];
    p_dd  [shape=point, width=0.01];

    src_port -> p_sd [arrowhead=none, headclip=false];
    p_sd -> bus [xlabel="src_data", tailclip=false];
    src_ctl -> p_ld [arrowhead=none, headclip=false];
    p_ld -> bus [xlabel="load hold\n(src_valid)", tailclip=false];
    dst_ctl -> p_cap [arrowhead=none, headclip=false];
    p_cap -> bus [xlabel="capture\n(req seen)", tailclip=false];
    p_dd -> bus [dir=none, tailclip=false];
    p_dd -> dst_port [xlabel="dst_data", tailclip=false, constraint=false];

    // ---- invisible center spine (group C) ----
    node [style=invis, shape=point, width=0.01, group=C];
    c0; c1; c2; c4;
    node [style=filled, shape=box, width=0.75, group=""];
    c0 -> c1 -> c2 -> c4 -> bus [style=invis, weight=10];

    // ---- rank pinning ----
    { rank=same; src_port; c0; dst_port; }
    { rank=same; src_ctl; c1; dst_ctl; }
    { rank=same; ack_sync; c2; req_sync; }
    { rank=same; p_sd; p_ld; c4; p_cap; p_dd; }
    { rank=max; bus; }
    src_port -> c0 -> dst_port [style=invis];
    src_ctl -> c1 -> dst_ctl [style=invis, minlen=2];
    ack_sync -> c2 -> req_sync [style=invis];
    p_sd -> p_ld [style=invis, minlen=2];
    p_ld -> c4 -> p_cap [style=invis];
    p_cap -> p_dd [style=invis, minlen=2];
    ack_sync -> p_ld [style=invis];
    req_sync -> p_cap [style=invis];
}
