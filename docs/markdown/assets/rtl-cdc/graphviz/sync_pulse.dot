// sync_pulse block diagram - house style (vault/handbook/authoring/block-diagrams.md),
// CDC mapping per the fifo_async template:
//   source port top-left, destination port top-right, white;
//   the pulse becomes a LEVEL (toggle) in the source domain, and that one
//   level is the only signal crossing the boundary (heavy, center);
//   the destination synchronizes it and turns each edge back into a pulse,
//   which climbs the right edge to the output.
// Source of truth: rtl/cdc/sync_pulse.sv.
digraph sync_pulse {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           label="sync_pulse - toggle-based single-pulse crossing",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external interfaces (white) ----
    src_port [group=SO, label="Pulse In\ni_src_clk domain", fillcolor="white"];
    dst_port [group=DO, label="Pulse Out\ni_dst_clk domain", fillcolor="white"];

    subgraph cluster_src {
        label="i_src_clk domain"; style=dashed; fontsize=10;
        tog [group=SO, label="Toggle Register\nr_src_toggle\nflips on each i_pulse"];
    }

    subgraph cluster_dst {
        label="i_dst_clk domain"; style=dashed; fontsize=10;
        syn  [group=DI, label="Toggle Synchronizer\nr_sync[SYNC_STAGES]\n(2-4 flops on i_dst_clk)"];
        edet [group=DO, label="Edge Detect\nr_sync_prev XOR\nlast sync stage"];
    }

    // ---- flows ----
    src_port -> tog [label="i_pulse"];
    tog -> syn [xlabel="toggle level", penwidth=1.8];
    syn -> edet [xlabel="sync level", minlen=3];
    edet -> dst_port [xlabel="o_pulse\n(one i_dst_clk cycle)"];

    // ---- rank pinning ----
    { rank=same; src_port; dst_port; }
    { rank=same; tog; }
    { rank=same; syn; edet; }
    src_port -> dst_port [style=invis, minlen=4];
    tog -> syn [style=invis];
}
