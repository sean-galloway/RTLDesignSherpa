// counter_bingray block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// One flow, top-down: enable -> increment -> (inline bin-to-Gray -> Gray
// register | binary register) -> the output bar. The binary register feeds
// back UP the right edge into the increment on its own route. counter_bin_next leaves
// combinationally, before the register. clk/rst_n are dashed sideband.
// Source of truth: rtl/cdc/counter_bingray.sv (Gray computed inline, not via bin2gray).
digraph counter_bingray {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="counter_bingray - binary counter with registered Gray output";

    en_in  [label="Enable Input\nenable", fillcolor="white"];
    clk_in [label="Clock / Reset\nclk, rst_n", fillcolor="white"];

    inc    [label="Increment (next state)\nw_counter_bin = enable ? counter_bin + 1 : counter_bin"];
    b2g    [label="Binary-to-Gray (inline)\nw_counter_gray = w_counter_bin ^ (w_counter_bin >> 1)"];
    breg   [label="Binary Register\ncounter_bin (flop, reset 0)"];
    greg   [label="Gray Register\ncounter_gray (flop, reset 0)"];
    out    [label="Outputs\ncounter_bin_next (combinational)   |   counter_gray   |   counter_bin",
            fillcolor="white", width=8.5];

    p_nx   [shape=point, width=0.01];
    p_fb   [shape=point, width=0.01];

    en_in -> inc  [xlabel="enable"];
    inc   -> breg [xlabel="next binary"];
    inc   -> b2g  [xlabel="next binary"];
    b2g   -> greg [xlabel="next Gray"];

    // combinational next-state output, down the left edge
    inc  -> p_nx [arrowhead=none, headclip=false];
    p_nx -> out  [xlabel="counter_bin_next", tailclip=false];
    breg -> out  [xlabel="counter_bin"];
    greg -> out  [xlabel="counter_gray"];

    // feedback: current binary back UP the right edge into the increment
    breg -> p_fb [arrowhead=none, headclip=false, constraint=false];
    p_fb -> inc  [xlabel="counter_bin\n(current)", tailclip=false, constraint=false];

    // sideband: clock/reset between the Gray path and the feedback lane,
    // one rank above the registers
    clk_in -> greg [style=dashed, xlabel="clk, rst_n"];
    clk_in -> breg [style=dashed];

    { rank=same; breg; greg; }
    { rank=same; p_nx; b2g; clk_in; }
    p_nx -> b2g [style=invis];
    b2g -> clk_in [style=invis];
    greg -> breg [style=invis];
}
