// gray2bin block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Purely combinational. One flow, top-down: Gray in, binary out. Each binary
// bit is the XOR-reduction of the Gray bits at and above it, so the MSB passes
// through and each lower bit adds one more term (a prefix XOR from the top).
// Source of truth: rtl/cdc/gray2bin.sv.
digraph gray2bin {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="gray2bin - Gray code to binary (combinational)";

    gray_in [label="Gray Input\ngray[WIDTH-1:0]", fillcolor="white"];
    xorred  [label="Prefix XOR Reduction\nbinary[i] = ^(gray >> i)  (XOR of gray[WIDTH-1:i])\nbinary[WIDTH-1] = gray[WIDTH-1]; depth grows toward bit 0"];
    bin_out [label="Binary Output\nbinary[WIDTH-1:0]", fillcolor="white", width=4.5];

    gray_in -> xorred  [xlabel="gray[WIDTH-1:0]"];
    xorred  -> bin_out [xlabel="binary[WIDTH-1:0]"];
}
