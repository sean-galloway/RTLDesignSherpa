// arbiter_matrix block diagram - house style
// (vault/handbook/authoring/block-diagrams.md). Template: arbiter_round_robin.
// Flows:
//   requests  - top-down the center: Requests -> gate -> matrix pick
//               (trapezium) -> grant register -> outputs bar
//   priority  - the priority matrix register feeds the pick from the right;
//               the winner id climbs the RIGHT edge into the matrix update
//               (winner drops to lowest priority) and back into the register
//   sideband  - block_arb, grant_ack: dashed
// CLIENTS=1 collapses to grant = gated request; noted in the title.
// Source of truth: rtl/common/arbiter_matrix.sv.
digraph arbiter_matrix {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.65", splines=ortho, newrank=true,
           label="arbiter_matrix - least-recently-granted pick from a priority matrix (CLIENTS=1: grant = gated request)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external inputs (white) ----
    prm  [label="Parameters (fixed at build)\lWAIT_GNT_ACK: 1 = a grant holds until grant_ack;\l    the matrix updates on the ack, and the next\l    grant is picked against the updated matrix\l    0 = a new pick and update every cycle\l", fillcolor="white"];
    ack  [label="Grant Acknowledge\ngrant_ack[CLIENTS]", fillcolor="white"];
    blk  [label="Block Input\nblock_arb", fillcolor="white"];
    req  [group=C, label="Requests\nrequest[CLIENTS]", fillcolor="white"];

    // ---- logic ----
    gate [group=C, label="Request Gate\nrequests forced to 0 while block_arb"];
    mreg [label="Priority Matrix\nr_matrix (flop), CLIENTS x (CLIENTS-1) / 2 bits\nbit [i][j] = 1: client i outranks client j\nreset all 1s (lower index first)"];
    pick [group=C, label="Matrix Pick (combinational)\nclient i wins if no requester outranks it",
          shape=invtrapezium, width=7.4, height=0.75, fixedsize=true, fillcolor="#BFD7EE", fontsize=11];
    greg [group=C, label="Grant Register\ngrant, grant_id, grant_valid (flop)\nlast_grant = previous grant"];
    mupd [group=M, label="Matrix Update (next state)\nwinner's row cleared, its column set:\nthe winner drops to lowest priority"];

    // ---- the boundary bar: outputs ----
    outs [group=C, label="Grant Outputs\ngrant[CLIENTS] (one-hot)   |   grant_id   |   grant_valid   |   last_grant",
          fillcolor="white", width=7.5];

    // ---- main flow ----
    req  -> gate [xlabel="request"];
    gate -> pick [xlabel="gated requests"];
    mreg -> pick [xlabel="priority order"];
    pick -> greg [xlabel="winner (one-hot), winner id", penwidth=1.8];
    greg -> outs [xlabel="grant, grant_id, grant_valid, last_grant"];

    // ---- matrix feedback: winner id up the right edge ----
    greg -> mupd [xlabel="winner id"];
    mupd -> mreg [xlabel="next matrix"];

    // ---- sideband (dashed) ----
    blk -> gate [style=dashed, xlabel="block_arb"];
    ack -> greg [style=dashed, xlabel="grant_ack (hold / release)"];

    // ---- rank pinning ----
    { rank=same; prm; ack; blk; req; }
    { rank=same; gate; mreg; }
    { rank=same; pick; mupd; }
    { rank=same; greg; }
    { rank=max; outs; }
    prm -> ack -> blk -> req [style=invis];
    gate -> mreg [style=invis, minlen=1];
    pick -> mupd [style=invis, minlen=2];
}
