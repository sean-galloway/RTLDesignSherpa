// arbiter_single_client block diagram - house style
// (vault/handbook/authoring/block-diagrams.md). The degenerate one-client
// member of the arbiter family: there is nothing to pick between, so there
// is NO trapezium (rule 9 needs a genuine many-to-one pick). What is left
// is the request gate, the optional grant/ack hold, and one grant flop.
// Flows:
//   request - top-down the center: Request -> gate (block_arb) -> grant
//             register -> outputs bar.
//   ack     - grant_ack is a dashed return into the ACK tracker in the left
//             column; the tracker exists only when WAIT_GNT_ACK=1 (dashed,
//             rule 8) and tells the register whether it may grant.
// Source of truth: rtl/common/arbiter_single_client.sv.
digraph arbiter_single_client {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           label="arbiter_single_client - one client, no pick: gate, optional ack hold, one grant flop",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    prm  [label="Parameters (fixed at build)\lWAIT_GNT_ACK: 1 = hold the grant until grant_ack,\l    then drop it for one cycle before re-granting\l    0 = grant_valid is the gated request, one\l    cycle later; grant_ack is ignored\l", fillcolor="white"];
    ack  [group=L, label="Grant Acknowledge\ngrant_ack", fillcolor="white"];
    blk  [label="Block Input\nblock_arb", fillcolor="white"];
    req  [group=C, label="Request\nrequest", fillcolor="white"];
    clk  [label="Clock / Reset\nclk, rst_n", fillcolor="white"];

    gate [group=C, label="Request Gate (combinational)\nw_req = request & !block_arb"];
    ackt [group=L, label="ACK Tracker  (WAIT_GNT_ACK=1 only)\nr_pending_ack (flop)\nw_can_grant = !pending | ack received", style="filled,dashed"];
    greg [group=C, label="Grant Register (flop)\ngrant_valid <= w_req & w_can_grant\n(held while pending, cleared on ack)"];

    outs [group=C, label="Outputs\ngrant (= grant_valid)   |   grant_valid   |   grant_id (always 0)",
          fillcolor="white", width=6.0];

    req  -> gate [xlabel="request"];
    blk  -> gate [style=dashed, xlabel="block_arb"];
    gate -> greg [xlabel="w_req", penwidth=1.8];
    greg -> outs [xlabel="grant_valid"];

    ack  -> ackt [style=dashed, xlabel="grant_ack"];
    ackt -> greg [style=dashed, xlabel="can grant / hold"];
    clk  -> greg [style=dashed, xlabel="clk, rst_n"];

    { rank=same; prm; ack; req; blk; }
    prm -> ack [style=invis];
    { rank=same; gate; }
    { rank=same; ackt; clk; }
    { rank=same; outs; }
    ack -> req [style=invis, minlen=3];
    req -> blk [style=invis, minlen=2];
    ackt -> clk [style=invis, minlen=6];
    gate -> ackt [style=invis];
    prm -> outs [style=invis, minlen=2];
}
