// find_last_set block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Purely combinational. The highest set bit wins: a genuine many-to-one pick,
// so it is the wide-edge-up trapezium (handbook rule 9, rtl-common ruling).
// There is no valid output: no bit set and bit 0 set both give index 0.
// Source of truth: rtl/common/find_last_set.sv.
digraph find_last_set {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="find_last_set - index of the highest set bit (combinational)";

    din  [label="Data Input\ndata[WIDTH-1:0]", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    pick [label="Highest-Index Pick\nscan from bit WIDTH-1 down; first set bit wins",
          shape=invtrapezium, fillcolor="#BFD7EE", width=4.4, height=0.75, fixedsize=true, style="filled", fillcolor="#FFF2CC"];
    dout [label="Index Output\nindex[$clog2(WIDTH)-1:0]\n(no bit set: 0 - no valid flag; see leading_one_trailing_one)", fillcolor="white", width=4.8, style="rounded,filled", fillcolor="#E2EFDA"];

    din  -> pick [xlabel="candidates (data bits)"];
    pick -> dout [penwidth=1.8, xlabel="highest set index"];
}
