// encoder block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Purely combinational one-hot to binary. Not drawn as a trapezium: the input
// is a one-hot code, not a set of contenders; the loop's highest-index-wins
// behaviour on a multi-hot input is stated in the label, not designed in.
// Source of truth: rtl/common/encoder.sv.
digraph encoder {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="encoder - one-hot to binary index (combinational)";

    din  [label="One-Hot Input\ndecoded[N-1:0]", fillcolor="white"];
    enc  [label="One-Hot Encode\ndata = i for the set bit i\n(no bit set: 0; several set: the highest index)"];
    dout [label="Binary Output\ndata[$clog2(N)-1:0]", fillcolor="white", width=4.0];

    din -> enc  [xlabel="decoded (one-hot)"];
    enc -> dout [xlabel="index"];
}
