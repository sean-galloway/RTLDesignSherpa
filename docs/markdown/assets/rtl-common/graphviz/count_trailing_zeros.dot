// count_trailing_zeros block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Purely combinational. A count, not a pick: no trapezium. The output is one
// bit wider than an index so that the all-zero input can report WIDTH.
// Source of truth: rtl/common/count_trailing_zeros.sv.
digraph count_trailing_zeros {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="count_trailing_zeros - zero count below the lowest set bit (combinational)";

    din  [label="Data Input\ndata[WIDTH-1:0]", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    scan [label="Trailing-Zero Scan\nscan from bit 0 up, counting zeros until the first 1\n(all zeros: count = WIDTH)", style="filled", fillcolor="white"];
    dout [label="Count Output\nctz[$clog2(WIDTH):0]  (one bit wider than an index)", fillcolor="white", width=4.8, style="rounded,filled", fillcolor="#E2EFDA"];

    din  -> scan [xlabel="data"];
    scan -> dout [xlabel="zero count"];
}
