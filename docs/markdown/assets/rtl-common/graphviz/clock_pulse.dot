// clock_pulse block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Free-running counter 0 .. WIDTH-1; a registered compare emits a one-clock
// pulse once per WIDTH clocks. Counter feedback climbs the right edge.
// Source of truth: rtl/common/clock_pulse.sv.
digraph clock_pulse {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="clock_pulse - one-clock pulse every WIDTH clocks";

    clk_in [label="Clock / Reset\nclk, rst_n", fillcolor="white"];
    nxt    [label="Increment / Wrap (combinational)\nr_counter < WIDTH-1 ? r_counter + 1 : 0"];
    creg   [label="Period Counter\nr_counter (flop, reset 0)"];
    preg   [label="Pulse Register\npulse (flop, reset 0)\npulse <= (r_counter == WIDTH-1)"];
    out    [label="Output\npulse (high one clock in every WIDTH)", fillcolor="white", width=4.0];
    p_fb   [shape=point, width=0.01];

    nxt  -> creg [xlabel="next count"];
    creg -> preg [xlabel="r_counter"];
    preg -> out  [xlabel="pulse"];
    creg -> p_fb [arrowhead=none, headclip=false, constraint=false];
    p_fb -> nxt  [xlabel="r_counter\n(current)", tailclip=false, constraint=false];
    clk_in -> creg [style=dashed, xlabel="clk, rst_n"];
    { rank=same; clk_in; nxt; }
    clk_in -> nxt [style=invis, minlen=2];
}
