// dataint_ecc_hamming_encode_secded block diagram - house style.
// The mirror of the approved SECDED decoder: purely combinational, one column.
// Data bits are placed into the non-power-of-two positions, the Hamming check
// bits are computed into the power-of-two positions, then the overall parity
// bit is appended as the MSB.
// Source of truth: rtl/common/dataint_ecc_hamming_encode_secded.sv.
digraph dataint_ecc_hamming_encode_secded {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="dataint_ecc_hamming_encode_secded - SECDED encode (combinational)";

    din  [label="Data Input\ndata[WIDTH-1:0]", fillcolor="white"];
    plc  [group=C, label="Data Placement (combinational)\ndata[k] -> position bit_position(k):\nevery position that is not a power of two\n(power-of-two positions held for check bits)"];
    chk  [group=C, label="Hamming Check Bits (combinational)\nParityBits check bits; bit at position 2^i - 1 =\nXOR of every position whose (index+1) has bit i set"];
    ovp  [group=C, label="Overall Parity (combinational)\nencoded_data[TotalWidth-1] =\nXOR of all lower TotalWidth-1 bits (the SECDED bit)"];
    bar  [label="Codeword Output\nencoded_data[TotalWidth-1:0] = { overall parity, Hamming word }\nTotalWidth = WIDTH + ParityBits + 1", fillcolor="white", width=6.5];

    din -> plc [xlabel="data"];
    plc -> chk [xlabel="positioned word\n(check positions 0)"];
    chk -> ovp [xlabel="Hamming word\n(data + check bits)"];
    ovp -> bar [xlabel="encoded_data", penwidth=1.8];
}
