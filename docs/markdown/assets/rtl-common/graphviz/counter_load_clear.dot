// counter_load_clear block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Two registers: the match value (loaded by load) and the count. The count
// wraps to 0 at the match value; done flags the match. Count feedback climbs
// the right edge into its next-state logic.
// Source of truth: rtl/common/counter_load_clear.sv.
digraph counter_load_clear {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="counter_load_clear - counter that wraps at a loadable match value";

    clk_in [label="Clock / Reset\nclk, rst_n (both registers)", fillcolor="white"];
    ld_in  [label="Load Input\nload, loadval", fillcolor="white"];
    ic_in  [label="Count Control\nincrement, clear", fillcolor="white"];
    mreg   [label="Match Register\nr_match_val (flop, reset 0)\nload: takes loadval"];
    nxt    [label="Count Next State (combinational)\nclear: 0 (wins over increment)\nincrement: count == match ? 0 : count + 1\nelse: hold"];
    creg   [label="Count Register\ncount (flop, reset 0)"];
    cmp    [label="Match Compare (combinational)\ndone = (count == r_match_val)"];
    out    [label="Outputs\ncount   |   done", fillcolor="white", width=4.5];
    p_a    [shape=point, width=0.01];
    p_b    [shape=point, width=0.01];

    ld_in -> mreg [xlabel="loadval"];
    ic_in -> nxt  [xlabel="increment, clear"];
    mreg  -> nxt  [xlabel="match value"];
    mreg  -> cmp  [xlabel="match value"];
    nxt   -> creg [xlabel="next count"];
    creg  -> cmp  [xlabel="count"];
    cmp   -> out  [xlabel="done"];
    creg  -> out  [xlabel="count"];
    creg -> p_a  [arrowhead=none, headclip=false];
    p_a  -> p_b  [arrowhead=none, headclip=false, tailclip=false, constraint=false];
    p_b  -> nxt  [xlabel="count (current)", tailclip=false];
    clk_in -> mreg [style=dashed, xlabel="clk, rst_n"];
    { rank=same; clk_in; ld_in; ic_in; }
    clk_in -> ld_in [style=invis];
    ld_in -> ic_in [style=invis, minlen=3];
    { rank=same; mreg; nxt; p_b; }
    mreg -> nxt [style=invis, minlen=2];
    nxt -> p_b [style=invis];
    { rank=same; creg; p_a; }
    creg -> p_a [style=invis, minlen=2];
}
