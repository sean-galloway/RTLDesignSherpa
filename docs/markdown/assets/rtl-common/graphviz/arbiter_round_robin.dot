// arbiter_round_robin block diagram - house style
// (vault/handbook/authoring/block-diagrams.md). The first real many-to-one
// pick in the repo's diagrams, so rule 9 applies: the decision is the flat
// wide-edge-up trapezium, every arrow into it names the request class, and
// the winner leaves the narrow edge on the heavy pen.
// Flows:
//   requests  - top-down the center: Requests port -> gate -> (masked AND
//               unmasked copies) -> trapezium -> grant register -> outputs bar
//   last grant - register feedback climbs the RIGHT edge into the mask select
//   block_arb, grant_ack - dashed sideband; the ACK tracker is dashed as
//               optional (built only when WAIT_GNT_ACK=1)
// CLIENTS=1 collapses to grant = gated request (no mask, no encoder); noted
// in the title rather than drawn.
// Source of truth: rtl/common/arbiter_round_robin.sv.
digraph arbiter_round_robin {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.65", splines=ortho, newrank=true,
           label="arbiter_round_robin - mask-based round-robin pick (CLIENTS=1: grant = gated request)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external inputs (white) ----
    blk  [label="Block Input\nblock_arb", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    req  [group=C, label="Requests\nrequest[CLIENTS]", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    ack  [label="Grant Acknowledge\ngrant_ack[CLIENTS]", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    // ---- request path ----
    gate [group=C, label="Request Gate\nw_requests_gated = block_arb ? 0 : request", style="filled", fillcolor="white"];
    mask [label="Round-Robin Mask Select\nwin-mask LUT indexed by the last winner\n(clients above it keep priority)", style="filled", fillcolor="white"];
    pick [group=C, label="Priority Encoder - arbiter_priority_encoder\nmasked first, else unmasked",
          shape=invtrapezium, width=6.4, height=0.75, fixedsize=true, fillcolor="#BFD7EE", fontsize=11, style="filled", fillcolor="#FFF2CC"];
    ackt [label="ACK Tracker  (WAIT_GNT_ACK=1 only)\nr_pending_ack, r_pending_client\nholds the grant until grant_ack", style="filled,dashed", peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];
    greg [group=C, label="Grant Register\ngrant, grant_id, grant_valid flopped together\nr_last_grant_id / r_last_valid kept for the mask", peripheries=2, style="filled", fillcolor="#D6E4F0"];

    // ---- the boundary bar: outputs ----
    outs [group=C, label="Grant Outputs\ngrant[CLIENTS] (one-hot)   |   grant_id   |   grant_valid   |   last_grant",
          fillcolor="white", width=7.5, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    // ---- main flow ----
    req  -> gate [xlabel="request"];
    gate -> pick [xlabel="unmasked requests"];
    gate -> mask [xlabel="gated requests"];
    mask -> pick [xlabel="masked requests"];
    pick -> greg [xlabel="winner, winner_valid", penwidth=1.8];
    greg -> outs [xlabel="grant, grant_id, grant_valid"];

    // ---- last-winner feedback up the right edge ----
    p_fb [shape=point, width=0.01];
    greg -> p_fb [arrowhead=none, headclip=false, constraint=false];
    p_fb -> mask [xlabel="last grant_id", tailclip=false, constraint=false];

    // ---- sideband (dashed) ----
    blk  -> gate [style=dashed, color="#777777", xlabel="block_arb (forces no requests)"];
    ack  -> ackt [style=dashed, color="#777777", xlabel="grant_ack"];
    ackt -> greg [style=dashed, color="#777777", xlabel="can grant / hold"];

    // ---- rank pinning ----
    // Columns: left = sideband (block_arb, grant_ack, ACK tracker);
    // center = the request flow; right = mask select with the last-winner
    // feedback climbing the right edge into it.
    { rank=same; ack; blk; req; }
    { rank=same; gate; }
    { rank=same; mask; }
    { rank=same; ackt; pick; }
    { rank=same; greg; p_fb; }
    { rank=max; outs; }
    ack -> blk -> req [style=invis, minlen=2];
    ackt -> pick [style=invis, minlen=2];
    gate -> mask [style=invis, minlen=0];
    greg -> p_fb [style=invis, minlen=3];
    mask -> p_fb [style=invis];
}
