// counter_bin block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Enable-gated binary counter that wraps at MAX and toggles its MSB on each
// wrap (the FIFO lap bit). next-state -> register -> outputs; next-state also
// leaves combinationally. Register feedback climbs the right edge.
// Source of truth: rtl/common/counter_bin.sv.
digraph counter_bin {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="counter_bin - modulo-MAX counter with a wrap (lap) bit in the MSB";

    en_in  [label="Enable Input\nenable", fillcolor="white"];
    clk_in [label="Clock / Reset\nclk, rst_n", fillcolor="white"];
    nxt    [label="Next State (combinational)\nenable = 0: hold\nlow bits == MAX-1: low bits to 0, MSB inverted\nelse: counter_bin_curr + 1"];
    creg   [label="Counter Register\ncounter_bin_curr (flop, reset 0)\nlow WIDTH-1 bits count 0 .. MAX-1; MSB = lap bit"];
    out    [label="Outputs\ncounter_bin_curr   |   counter_bin_next (combinational)", fillcolor="white", width=5.5];
    p_fb   [shape=point, width=0.01];
    p_nx   [shape=point, width=0.01];

    en_in -> nxt  [xlabel="enable"];
    nxt   -> creg [xlabel="counter_bin_next"];
    creg  -> out  [xlabel="counter_bin_curr"];
    nxt   -> p_nx [arrowhead=none, headclip=false];
    p_nx  -> out  [xlabel="counter_bin_next", tailclip=false];
    p_b  [shape=point, width=0.01];
    creg -> p_fb [arrowhead=none, headclip=false];
    p_fb -> p_b  [arrowhead=none, headclip=false, tailclip=false, constraint=false];
    p_b  -> nxt  [xlabel="counter_bin_curr (current)", tailclip=false];
    { rank=same; nxt; p_b; }
    nxt -> p_b [style=invis];
    clk_in -> creg [style=dashed, constraint=false];
    { rank=same; p_nx; clk_in; creg; p_fb; }
    p_nx -> clk_in [style=invis];
    clk_in -> creg [style=invis, minlen=2];
    creg -> p_fb [style=invis, minlen=2];
}
