// counter_freq_invariant block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Microsecond counter that stays correct across clock frequencies: freq_sel
// picks a cycles-per-microsecond divide factor from a build-time LUT; a
// prescaler (counter_load_clear) counts that many clocks; each prescaler wrap
// advances the microsecond counter. A change of freq_sel (or sync_reset_n low)
// clears both.
// Source of truth: rtl/common/counter_freq_invariant.sv.
digraph counter_freq_invariant {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="counter_freq_invariant - microsecond counter for a selectable clock frequency";

    sel_in [label="Frequency Select\nfreq_sel", fillcolor="white"];
    rst_in [label="Sync Reset\nsync_reset_n", fillcolor="white"];
    clk_in [label="Clock / Reset\nclk, rst_n", fillcolor="white"];
    prm    [label="Parameters (fixed at build)\lMIN_FREQ_MHZ .. MAX_FREQ_MHZ, NUM_FREQ_ENTRIES:\l    the clock range the LUT covers, and its size\lFREQ_STRATEGY: 0 = entries spaced linearly\l    from MIN to MAX; 1 = doubling from MIN,\l    capped at MAX\lDEBUG_LUT: 1 = print the LUT at time 0\l", fillcolor="white"];
    lut    [label="Divide-Factor LUT (combinational, built at elaboration)\nw_div_table[freq_sel] = clock MHz = cycles per microsecond"];
    chg    [label="Change Detect\nr_prev_freq_sel, r_clear_pulse (flops)\nclear = freq_sel changed or !sync_reset_n"];
    pre    [label="Prescaler\ncounter_load_clear - prescaler_counter\ncounts 0 .. factor-1 every clk; done each microsecond"];
    ucnt   [label="Microsecond Counter\no_counter, tick (flops)\n+1 and tick on prescaler done (if sync_reset_n)"];
    out    [label="Outputs\no_counter (microseconds)   |   tick (one clock per microsecond)", fillcolor="white", width=6.0];

    p_s    [shape=point, width=0.01];
    sel_in -> p_s  [arrowhead=none, headclip=false, xlabel="freq_sel"];
    p_s    -> lut  [tailclip=false];
    lut    -> pre  [xlabel="division factor - 1\n(loadval)"];
    pre    -> ucnt [xlabel="done (1 us elapsed)"];
    ucnt   -> out  [xlabel="o_counter, tick"];
    p_s    -> chg  [tailclip=false, xlabel="freq_sel (compare to last)"];
    rst_in -> chg  [xlabel="sync_reset_n"];
    chg    -> pre  [style=dashed, xlabel="clear"];
    chg    -> ucnt [style=dashed, xlabel="clear"];
    clk_in -> chg  [style=dashed, xlabel="clk, rst_n"];
    { rank=same; prm; sel_in; rst_in; clk_in; }
    prm -> sel_in [style=invis, minlen=2];
    sel_in -> rst_in [style=invis, minlen=2];
    rst_in -> clk_in [style=invis];
    { rank=same; lut; chg; }
    lut -> chg [style=invis, minlen=2];
}
