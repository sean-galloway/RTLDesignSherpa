// fifo_sync block diagram - house style (vault/handbook/authoring/block-diagrams.md).
// Geography mirrors fifo_async (rtl-cdc), minus the clock crossing:
//   ports at the top (write left, read right) -> pointer counters -> one
//   shared flag block in the center -> the storage bar at the bottom.
// Flows:
//   write data  - down the LEFT edge into storage
//   read data   - back UP the RIGHT edge from storage
//   pointers    - both counters feed fifo_control directly (one clock, no
//                 synchronizer, no X): the center column holds the compare.
//   flags       - dashed feedback to the port they gate.
// One clock, so no dashed domain region: the title names the clock.
// Column grid (group=): WD lane | WO write counter | C flags + bar | RO read
// counter | RD lane. The lane anchors (aw/ar) are invisible nodes in the port
// rank, so the data lanes drop straight instead of jogging at the bar.
// Source of truth: rtl/common/fifo_sync.sv (instance names quoted in labels).
digraph fifo_sync {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.70", splines=ortho, newrank=true,
           label="fifo_sync - single-clock FIFO (everything on clk, rst_n)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external interfaces (white) ----
    wr_port [group=WO, label="Write Port\nwrite, wr_data", fillcolor="white"];
    rd_port [group=RO, label="Read Port\nread, rd_data", fillcolor="white"];

    wr_cnt [group=WO, label="Write Pointer Counter\ncounter_bin - write_pointer_inst\n(AW+1 bits, wraps at DEPTH)"];
    rd_cnt [group=RO, label="Read Pointer Counter\ncounter_bin - read_pointer_inst\n(AW+1 bits, wraps at DEPTH)"];
    flags  [group=C, label="Full / Empty Flags\nfifo_control - fifo_control_inst\n(REGISTERED=1: flags flopped)"];

    // ---- the boundary bar: storage, written and read on clk ----
    mem [group=C, label="Storage  mem[DEPTH]  (MEM_STYLE: SRL / BRAM / AUTO)\nwritten at the left, read at the right, both on clk\n(REGISTERED=0: rd_data muxed off the array; REGISTERED=1: rd_data flopped)",
         width=12.5, height=0.9];

    // ---- push / pop into the counters ----
    wr_port -> wr_cnt [xlabel="write & !wr_full"];
    rd_port -> rd_cnt [xlabel="read & !rd_empty"];

    // ---- both pointers into the one flag block (no crossing) ----
    wr_cnt -> flags [xlabel="wr ptr next", penwidth=1.8];
    rd_cnt -> flags [xlabel="rd ptr next", penwidth=1.8];

    // ---- flags back to the ports (feedback: dashed) ----
    flags -> wr_port [style=dashed, constraint=false, xlabel="wr_full,\nwr_almost_full"];
    flags -> rd_port [style=dashed, constraint=false, xlabel="rd_empty,\nrd_almost_empty"];

    // ---- outer lane anchors + storage scaffolds ----
    aw    [group=WD, shape=point, width=0.01, style=invis];
    ar    [group=RD, shape=point, width=0.01, style=invis];
    p_wd  [group=WD, shape=point, width=0.01];
    p_wa  [group=WO, shape=point, width=0.01];
    p_ra  [group=RO, shape=point, width=0.01];
    p_rdd [group=RD, shape=point, width=0.01];

    wr_port -> p_wd [arrowhead=none, headclip=false];
    p_wd -> mem [xlabel="wr_data", tailclip=false];
    wr_cnt -> p_wa [arrowhead=none, headclip=false];
    p_wa -> mem [xlabel="write address", tailclip=false];
    rd_cnt -> p_ra [arrowhead=none, headclip=false];
    p_ra -> mem [xlabel="read address", tailclip=false];
    p_rdd -> mem [dir=none, tailclip=false];
    p_rdd -> rd_port [xlabel="rd_data", tailclip=false, constraint=false];
    aw -> p_wd [style=invis, weight=10];
    ar -> p_rdd [style=invis, weight=10];

    // ---- invisible center spine (group C) keeps the bar centered ----
    node [style=invis, shape=point, width=0.01, group=C];
    c0; c1; c3;
    node [style=filled, shape=box, width=0.75, group=""];
    c0 -> c1 -> flags -> c3 -> mem [style=invis, weight=10];

    // ---- rank pinning ----
    { rank=same; aw; wr_port; c0; rd_port; ar; }
    { rank=same; wr_cnt; c1; rd_cnt; }
    { rank=same; p_wd; p_wa; c3; p_ra; p_rdd; }
    { rank=max; mem; }
    aw -> wr_port [style=invis, minlen=2];
    wr_port -> c0 -> rd_port [style=invis, minlen=3];
    rd_port -> ar [style=invis, minlen=2];
    wr_cnt -> c1 -> rd_cnt [style=invis, minlen=3];
    p_wd -> p_wa -> c3 -> p_ra -> p_rdd [style=invis];
}
