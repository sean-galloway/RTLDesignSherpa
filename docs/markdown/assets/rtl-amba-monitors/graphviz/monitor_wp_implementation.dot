// Whitepaper ch1 "An implementation, end to end" - house style
// (vault/handbook/authoring/block-diagrams.md).
// The monitored three-port AXI4 read bridge fixture the cost numbers come
// from. Flows:
//   observed traffic - left-to-right THROUGH the bridge at the top; the
//                      monitors tap it passively (dashed) and never drive it
//   monitor packets  - top-down the center: taps -> arbiter tree -> group
//   drains           - the group splits: error FIFO down the LEFT to the host
//                      (AXI-Lite reads, irq_out), write FIFO down the RIGHT as
//                      AXI bursts into the memory ring
//   config           - host APB crosses the boundary bar into the group
//                      (dashed sideband, upward)
//   boundary bar     - what lies outside the monitor system: host and memory
// Source of truth: rtl/amba/ocelus/{monbus_arbiter,monbus_group_core}.sv,
// rtl/amba/axi4/axi4_*_monlite wrappers, projects/components for the fixture.
digraph monitor_wp_implementation {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.60", splines=ortho, newrank=true,
           label="A monitored three-port AXI4 read bridge: per-port lite monitors, arbiter tree, one group, two drains",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- the design under watch: traffic passes through, untouched ----
    req [label="Requestors\n(three read masters)", style="rounded,filled", fillcolor="#E2EFDA"];
    brg [label="AXI4 Read Bridge (the DUT)\n3 slave ports -> 1 master port\n826 LUTs unmonitored", width=4.2, style="filled,bold", fillcolor="#DDEBF7"];
    fab [label="Memory fabric", style="rounded,filled", fillcolor="#E2EFDA"];

    // ---- per-port lite monitors (protocol plane) ----
    mon0 [label="axi_monitor_lite\nport 0 tap", style="rounded,filled", fillcolor="#E2EFDA"];
    mon1 [label="axi_monitor_lite\nport 1 tap", style="rounded,filled", fillcolor="#E2EFDA"];
    mon2 [label="axi_monitor_lite\nport 2 tap", style="rounded,filled", fillcolor="#E2EFDA"];

    // ---- aggregation (output plane) ----
    arb [label="Arbiter Tree\nmonbus_arbiter (round robin)",
         shape=invtrapezium, width=7.0, height=0.75, fixedsize=true,
         style="filled", fillcolor="#FFF2CC", fontsize=11];

    // ---- the group (output plane) ----
    grp [label="Monbus Group\nmonbus_group_core\nfilter: per-protocol type + event masks\nsteer: err_select per packet type",
         width=4.6, peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];

    // ---- two drains ----
    efifo [group=L, label="Error FIFO\n192-bit {timestamp, packet}\nirq_out while non-empty", shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    wfifo [group=R, label="Write FIFO\n3-beat records (raw)\nor 1 beat (compressed)", shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    flush [group=R, label="Flush engine\nbursts at cfg_flush_watermark\nor flush timeout", style="filled", fillcolor="white"];

    // ---- boundary bar: outside the monitor system ----
    bar [label="Outside the monitor system\nhost: AXI-Lite reads of the error FIFO behind irq_out   |   memory ring [cfg_base_addr, cfg_limit_addr]",
         width=9.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    // ---- observed traffic through the bridge (horizontal, top) ----
    req -> brg [xlabel="AR / R: observed traffic"];
    brg -> fab [xlabel="AR / R, untouched"];

    // ---- passive taps (dashed sideband; monitors never drive the bus) ----
    brg -> mon0 [style=dashed, xlabel="passive tap"];
    brg -> mon1 [style=dashed, label="passive tap"];
    brg -> mon2 [style=dashed, xlabel="passive tap"];

    // ---- monitor packets down the center ----
    mon0 -> arb [xlabel="monbus packets"];
    mon1 -> arb [label="monbus packets"];
    mon2 -> arb [xlabel="monbus packets"];
    arb -> grp [label="one merged stream", penwidth=1.8];

    // ---- drains ----
    grp -> efifo [xlabel="err_select = 1\n(errors, timeouts)"];
    grp -> wfifo [xlabel="else (not dropped)"];
    wfifo -> flush [label="beats"];

    // ---- crossings of the bar via point scaffolds ----
    p_e [shape=point, width=0.01, group=L];
    p_w [shape=point, width=0.01, group=R];
    efifo -> p_e [arrowhead=none, headclip=false];
    p_e -> bar [xlabel="AXI-Lite reads + irq_out", tailclip=false];
    flush -> p_w [arrowhead=none, headclip=false];
    p_w -> bar [xlabel="AXI bursts into the ring", tailclip=false];

    // ---- config: host APB crosses the bar up into the group (sideband) ----
    p_c [shape=point, width=0.01];
    bar -> p_c [arrowhead=none, headclip=false, style=dashed];
    p_c -> grp [style=dashed, xlabel="config APB: masks, thresholds,\nring bounds, flush policy", tailclip=false];

    // ---- rank pinning ----
    { rank=same; req; brg; fab; }
    req -> fab [style=invis, minlen=2];
    { rank=same; mon0; mon1; mon2; }
    mon0 -> mon1 [style=invis]; mon1 -> mon2 [style=invis];
    { rank=same; efifo; wfifo; }
    efifo -> wfifo [style=invis, minlen=4];
    sp [style=invis, label="", fixedsize=true, width=2.5, height=0.02];
    { rank=same; p_e; sp; p_w; }
    p_e -> sp [style=invis]; sp -> p_w [style=invis];
    { rank=max; bar; }
}
