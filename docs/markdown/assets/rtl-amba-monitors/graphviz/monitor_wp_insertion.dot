// Whitepaper ch4 "Where to insert monitoring" - house style
// (vault/handbook/authoring/block-diagrams.md). Three placements side by side,
// each with the same geography: masters (white) at the top, the fabric in the
// middle, slaves (white bar) at the bottom; requests run top-down. What changes
// is WHERE the monitoring sits and what it can attribute. Monitor packets leave
// each monitor toward the arbiter tree; that is stated in the monitor's label
// rather than drawn, so no sideband crosses another panel.
// The *_monlite wrappers sit in-path on a port and tap the FUB side of their
// base module (owner ruling 2026-10-13).
// Source of truth: chapter text; projects/components/utility-ip/misc/rtl/
// axi4_intf_master_observer.sv for the mid-fabric observer.
digraph monitor_wp_insertion {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.20", ranksep="0.50", splines=ortho, newrank=true,
           label="Insertion points: resolution against area -- per port (default), mid-fabric, root of tree",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.10,0.05"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---------------- per port ----------------
    subgraph cluster_port {
        label="Per port (default)\nevery transaction, by ID, with latency\n~1,100 LUTs per port (677 in bridge)";
        labelloc=b; style=dashed; fontsize=10;
        am1 [label="Master 1", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
        am2 [label="Master 2", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
        amon1 [label="*_monlite\non port 1\n(emits monbus\npackets)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
        amon2 [label="*_monlite\non port 2\n(emits monbus\npackets)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
        afab [label="Fabric", peripheries=2, style="filled", fillcolor="#D6E4F0"];
        aslv [label="Slaves", fillcolor="white", width=2.0, style="rounded,filled", fillcolor="#E2EFDA"];
        am1 -> amon1 [label="requests"];
        am2 -> amon2 [label="requests"];
        amon1 -> afab; amon2 -> afab;
        afab -> aslv [label="to the slaves"];
    }

    // ---------------- mid-fabric ----------------
    subgraph cluster_mid {
        label="Mid-fabric\nthe traffic on one internal link\nlocalizes fabric-made ordering /\nID collisions; one observer per link";
        labelloc=b; style=dashed; fontsize=10;
        bm1 [label="Master 1", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
        bm2 [label="Master 2", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
        bfab [label="Fabric", peripheries=2, style="filled", fillcolor="#D6E4F0"];
        bobs [label="Pass-through observer\naxi4_intf_master_\nobserver (own APB)\n(emits monbus packets)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
        bslv [label="Slaves", fillcolor="white", width=2.0, style="rounded,filled", fillcolor="#E2EFDA"];
        bm1 -> bfab [label="requests"]; bm2 -> bfab;
        bfab -> bobs [label="one internal link"];
        bobs -> bslv [label="passed through"];
    }

    // ---------------- root of tree ----------------
    subgraph cluster_root {
        label="Root of tree\nthe aggregate once; ports not told apart\n677 LUTs vs ~2,000 per port\n(3-port bridge)";
        labelloc=b; style=dashed; fontsize=10;
        cm1 [label="Master 1", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
        cm2 [label="Master 2", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
        cfab [label="Fabric", peripheries=2, style="filled", fillcolor="#D6E4F0"];
        cmon [label="One monitor\non the aggregate\n(emits monbus packets)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
        cslv [label="Slaves", fillcolor="white", width=2.0, style="rounded,filled", fillcolor="#E2EFDA"];
        cm1 -> cfab [label="requests"]; cm2 -> cfab;
        cfab -> cmon [label="aggregate"];
        cmon -> cslv [label="to the slaves"];
    }

    { rank=same; am1; am2; bm1; bm2; cm1; cm2; }
    { rank=same; amon1; amon2; bfab; cfab; }
    { rank=same; afab; bobs; cmon; }
    { rank=same; aslv; bslv; cslv; }
    am1 -> am2 [style=invis]; am2 -> bm1 [style=invis]; bm1 -> bm2 [style=invis];
    bm2 -> cm1 [style=invis]; cm1 -> cm2 [style=invis];
}
