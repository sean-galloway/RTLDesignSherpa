// Whitepaper ch5 "Timestamp policy" - house style
// (vault/handbook/authoring/block-diagrams.md).
//   left  - as built: the group's free-running counter (r_ts_counter) leaves as
//           mon_time_out, reaches every wrapper as i_mon_time, rides beside each
//           packet as the 64-bit monbus_timestamp_t, and the group writes its low
//           60 bits into beat 0 of every three-beat record
//   right - the tweak: the same 64-bit field, filled {global_us[47:0], local_cyc[15:0]}
//   dashed - the other open direction: an external time source drives i_mon_time
// Source of truth: rtl/amba/ocelus/monbus_group_core.sv (r_ts_counter,
// mon_time_out, beat 0 = {tag[3:0]=4'h0, source_ts[59:0]}).
digraph monitor_wp_timestamp {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.55", splines=ortho, newrank=true,
           label="Timestamp policy: the group's local counter today, the hybrid time base as the tweak",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    subgraph cluster_now {
        label="As built: one local time base per group"; labelloc=b; style=dashed; fontsize=10;
        ctr  [label="Group Counter (flop)\nmonbus_group_core r_ts_counter\nfree-running, +1 every clock"];
        wrp  [label="Wrappers\nevery *_mon / *_monlite: i_mon_time"];
        pkt  [label="Packet + Timestamp\n128-bit packet beside a\n64-bit monbus_timestamp_t"];
        rec  [label="Record Beat 0 (written by the group)\n{tag[3:0] = 4'h0, ts[59:0]}"];
    }

    // the other open direction, outside both regions: not built
    ext  [label="Open direction (not prototyped)\nexternal time source: PTP or a\nchip-level counter drives i_mon_time\ninstead of the group counter", style="filled,dashed", fillcolor="white"];

    subgraph cluster_hyb {
        label="Tweak: hybrid time base, same 64-bit field (not prototyped)"; labelloc=b; style=dashed; fontsize=10;
        gus  [label="System microsecond count\n(shared across subsystems)", fillcolor="white"];
        cyc  [label="Wrapper cycle count\n(per wrapper)", fillcolor="white"];
        hyb  [label="monbus_timestamp_t\n{global_us[47:0], local_cyc[15:0]}\nnothing in the packet layout moves", width=5.2];
    }

    note [label="Within one group every packet is on one clock; across groups there is no shared time base\n-- the hybrid's global upper bits give cross-subsystem correlation with no host-side re-basing",
          fillcolor="white", width=9.0];

    ctr -> wrp [xlabel="mon_time_out\n-> i_mon_time", penwidth=1.8];
    ext -> wrp [style=dashed];
    wrp -> pkt [label="timestamp per packet"];
    pkt -> rec [label="low 60 bits"];

    gus -> hyb [label="ts[63:16]"];
    cyc -> hyb [label="ts[15:0]"];

    rec -> note [style=invis];
    hyb -> note [style=invis];

    { rank=same; ctr; ext; gus; cyc; }
    ctr -> ext [style=invis]; ext -> gus [style=invis, minlen=2]; gus -> cyc [style=invis];
    { rank=max; note; }
}
