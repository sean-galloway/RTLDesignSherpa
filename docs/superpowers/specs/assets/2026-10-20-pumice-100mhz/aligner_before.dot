// aligner_before: dfi_clk capture with full-flag in push cone (-2.8 ns)
digraph aligner_before {
    rankdir=LR;
    graph [splines=ortho, nodesep=0.45, ranksep=0.75, compound=true, fontname="Helvetica"];
    node  [fontname="Helvetica", fontsize=9, style=filled, fillcolor="white", color="black", penwidth=1.1, margin="0.10,0.05"];
    edge  [fontname="Helvetica", fontsize=8, color="#333333", arrowsize=0.7];

    aligner_capture [label="mc_dfi_rd_aligner capture\nr_age shift reg + r_outstanding + r_credit (dfi_clk)", shape=box, peripheries=2, fillcolor="#D6E4F0"];
    push_gate [label="push = word_valid && credit && !full", shape=box];
    cdc_fifo [label="rd CDC FIFO push\n(gaxi_fifo_async wr side)", shape=cylinder, fillcolor="#E8DFF5"];

    cone_note [label="WNS −2.8 ns (362 paths) dfi_clk\n— r_age/outstanding → full → push", shape=note, fontsize=8, fillcolor="white"];

    { rank=same; aligner_capture; cone_note; }

    aligner_capture -> push_gate;

    push_gate -> before_spacer [xlabel="push"];
    before_spacer [shape=point, width=0.15, style=invis];
    before_spacer -> cdc_fifo;

    cdc_fifo -> before_spacer [dir=back, style=dashed, color="#777777"];
    before_spacer -> push_gate [dir=back, style=dashed, color="#777777", xlabel="full flag (loop)"];

    aligner_capture -> cone_note [color="#D00000", penwidth=2.2];
}
