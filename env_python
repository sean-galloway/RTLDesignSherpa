#!/bin/bash
# Load project-specific environment for Python + RTL tools

# Ensure this is sourced: `source env_python` (don't just run it)

# REPO_ROOT comes from where THIS FILE LIVES, not from where you are standing.
#
# It used to be `git rev-parse --show-toplevel`, i.e. the root of whatever repo
# the shell happened to be in. A script that locates itself by asking where the
# caller stands finds the wrong thing the moment you stand somewhere else, and
# there was no check that the answer was this repo at all. Two measured failures
# (tooling TASK-023):
#
#   - Sourced from the RTLDesignSherpa-DV tree, REPO_ROOT became the DV root and
#     the venv activated was DV's -- holding a stale 0.6.7 snapshot that
#     self-reports __version__ 0.6.1. Nothing errored. Every *_ROOT below also
#     pointed into the wrong tree. This is the mechanism behind a real
#     misdiagnosis of 9 test failures as a code defect.
#   - Sourced from a directory that is not a git repo at all (/tmp), git failed,
#     REPO_ROOT was set to the EMPTY STRING, and every path below resolved from
#     `/`. The venv activate silently failed and the shell ran on system python.
#
# BASH_SOURCE[0] is this file, because this file is sourced. That is the only
# answer that does not depend on the caller.
_rtlds_self="${BASH_SOURCE[0]:-$0}"
export REPO_ROOT="$(cd "$(dirname "$_rtlds_self")" && pwd)"

export APB_XBAR_ROOT=$REPO_ROOT/projects/components/fabric-gen-ip/apbx-xbar
export BCH_ROOT=$REPO_ROOT/projects/components/bch
export BRIDGE_ROOT=$REPO_ROOT/projects/components/fabric-gen-ip/bridge
export CONVERTERS_ROOT=$REPO_ROOT/projects/components/utility-ip/converters
export DELTA_ROOT=$REPO_ROOT/projects/components/noc-ip/delta
export MISC_ROOT=$REPO_ROOT/projects/components/utility-ip/misc
export AMBER_ROOT=$REPO_ROOT/projects/components/cache-ip/amber-mesi-l1
export KESTREL_ROOT=$REPO_ROOT/projects/components/riscv-ip/kestrel-rv32i
export RAPIDS_ROOT=$REPO_ROOT/projects/components/dma-ip/rapids
export RETRO_ROOT=$REPO_ROOT/projects/components/retro_legacy_blocks
export STREAM_ROOT=$REPO_ROOT/projects/components/dma-ip/stream

# NexysA7 characterization roots. These are referenced by .f filelists, so they
# must be defined here (not only by the per-flow Makefiles) or the filelists
# resolve under `make` but break for any standalone consumer -- cocotb tests via
# filelist_utils, bin/filelist_registry.py, or a bare verilator run.
#
# NOTE: the flow Makefiles also export a bare FRAMEWORK_ROOT, whose value
# depends on which flow is driving (stream_char_framework vs ddr2_char_framework).
# That name is deliberately NOT defined here: one global value would be silently
# wrong for the other flow. Filelists should use the unambiguous names below.
export STREAM_CHAR_ROOT=$REPO_ROOT/projects/fpga-systems/Genesys2/dma-ip/stream
export STREAM_CHAR_FRAMEWORK_ROOT=$REPO_ROOT/projects/fpga-systems/Genesys2/dma-ip/stream
export DDR2_CHAR_FRAMEWORK_ROOT=$REPO_ROOT/projects/fpga-systems/NexysA7/mem-ctrl-ip/pumice/ddr2_char_framework
export TIMING_CHAR_ROOT=$REPO_ROOT/projects/asic-trials/timing_characterization

# Activate the venv, and FAIL if there isn't one.
#
# WORKTREE POLICY: a worktree shares the main checkout's venv. A worktree is the
# same codebase at a different commit, and this venv is ~1GB of tools -- one per
# worktree is not a tradeoff anyone would choose. The main checkout is found from
# `--git-common-dir`, which is the one git query that asks about THIS repo rather
# than about the caller. Two worktrees existed when this was written and neither
# had a venv, so before this they both silently ran on system python.
_rtlds_venv="$REPO_ROOT"
if [ ! -f "$REPO_ROOT/venv/bin/activate" ]; then
    _rtlds_common="$(cd "$REPO_ROOT" 2>/dev/null && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd)"
    if [ -n "$_rtlds_common" ] && [ -f "$(dirname "$_rtlds_common")/venv/bin/activate" ]; then
        _rtlds_venv="$(dirname "$_rtlds_common")"
        echo "[env_python] worktree: sharing the main checkout's venv ($_rtlds_venv/venv)"
    fi
fi
if [ -f "$_rtlds_venv/venv/bin/activate" ]; then
    source "$_rtlds_venv/venv/bin/activate"
else
    # Loudly, and non-zero. Continuing here is what handed sessions a working
    # system python with none of the tooling in it -- a shell that looks fine
    # and fails later, somewhere unrelated.
    echo "[env_python] ERROR: no venv found for $REPO_ROOT" >&2
    echo "[env_python]   expected $REPO_ROOT/venv/bin/activate" >&2
    echo "[env_python]   create it with: python3 -m venv venv && source venv/bin/activate" >&2
    echo "[env_python]                   pip install -r requirements.txt" >&2
    unset _rtlds_self _rtlds_common
    return 1 2>/dev/null || exit 1
fi
# Exported because it is NOT always $REPO_ROOT/venv (see the worktree policy).
export RTLDS_VENV_ROOT="$_rtlds_venv"
unset _rtlds_self _rtlds_common _rtlds_venv

# Add Verible binaries to PATH
export PATH="$PATH:/home/seang/github/verible-v0.0-3999-g93adb37c/bin/"

# Configure Verible style waivers (for parameter/localparam naming)
export VERIBLE_WAIVER_FILES="$REPO_ROOT/tools/lint/verible_style_waivers.txt"

# Add REPO-specific tools to PATH
export PATH="$REPO_ROOT/bin:$PATH"
export PATH="$REPO_ROOT/bin/vcd2wavedrom2:$PATH"
export PATH="$REPO_ROOT/bin/rtl_generators/axi:$PATH"
export PATH="$RTLDS_VENV_ROOT/venv/bin/yowasp-yosys:$PATH"  # optional: should this be in $REPO_ROOT/bin?

# Add Python modules to PYTHONPATH
export PYTHONPATH="$REPO_ROOT:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/bin:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/bin/rtl_generators:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/bin/val_project:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/bin/vcd2wavedrom2:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/bin/rtl_generators/axi:$PYTHONPATH"

# Shared FPGA board/UART layer: board registry, UART port discovery, the AXI
# bridge, the generic sequence container. Host tools and run_<test>.py scripts
# import these by bare module name (uart_link, board, boards, sequence,
# uart_axi_bridge). This is the ONE authority for where that layer lives -- a
# flow must not re-derive it.
export PYTHONPATH="$REPO_ROOT/projects/fpga-systems/bin:$PYTHONPATH"

# Add project DV directories for self-contained project imports
export PYTHONPATH="$REPO_ROOT/projects/components/fabric-gen-ip/apbx-xbar/dv:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/projects/components/bch/dv:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/projects/components/fabric-gen-ip/bridge/dv:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/projects/components/utility-ip/converters/dv:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/projects/components/noc-ip/delta/dv:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/projects/components/utility-ip/misc/dv:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/projects/components/dma-ip/rapids/dv:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/projects/components/retro_legacy_blocks/dv:$PYTHONPATH"
export PYTHONPATH="$REPO_ROOT/projects/components/dma-ip/stream/dv:$PYTHONPATH"

# Where install_tools.sh put the toolchain. Override with RTLDS_TOOLS_PREFIX
# when tools live elsewhere -- install_tools.sh --prefix used to print three
# export lines to paste by hand, and the ORDER mattered (the pinned Verilator
# must be prepended last so it beats oss-cad-suite's). Setting one variable
# removes that footgun; the ordering below is the script's problem, not yours.
export RTLDS_TOOLS_PREFIX="${RTLDS_TOOLS_PREFIX:-/mnt/data/tools}"

# OSS CAD Suite (yosys 0.62+, SymbiYosys, solvers) — formal verification
#
# These two blocks used to be nested inside each other, with the sv2v test
# duplicated verbatim and the oss-cad-suite export sitting AFTER an inner fi --
# so the suite only reached PATH on a machine that also had sv2v. Flat now.
if [ -d "$RTLDS_TOOLS_PREFIX/oss-cad-suite/bin" ]; then
    export PATH="$RTLDS_TOOLS_PREFIX/oss-cad-suite/bin:$PATH"
fi

# sv2v (SystemVerilog to Verilog transpiler) — formal verification preprocessing
if [ -f "$RTLDS_TOOLS_PREFIX/sv2v" ]; then
    export PATH="$RTLDS_TOOLS_PREFIX:$PATH"
fi

# Verilator: use the oss-cad-suite build (5.045), already on PATH above.
#
# This USED to pin 5.020 with the note "newer versions have bugs with cocotb
# VCD/FST generation". That no longer reproduces, and the pin had started
# costing more than it bought:
#   - 5.020 cannot build the Genesys 2 stream harness at all once
#     projects/components/utility-ip/misc/rdl/obs/obs_regs.rdl grew. It emits invalid C++ for
#     the PeakRDL hwif struct port copy:
#       error: cannot convert 'V..._in_t__struct__0' to 'CData'
#     The same observers + the same regblock build fine STANDALONE on 5.020,
#     so it is not the register block; it is something about the harness that
#     was never root-caused.
#   - 5.045 builds and runs that harness (perf suite pass, monitor run clean).
#   - The FST claim was tested directly on 5.045 with WAVES=1: valid dump,
#     8842 signals, 2985 timesteps, fst2vcd exit 0, no corruption.
#
# To go back for one shell (e.g. to reproduce something against the old tool):
#   VERILATOR_PIN=5.020 source env_python
#
# NOTE: Do NOT set VERILATOR_ROOT — the perl wrapper auto-detects it
# relative to its own location. Setting it wrong breaks verilator_bin lookup.
unset VERILATOR_ROOT 2>/dev/null
if [ "${VERILATOR_PIN:-}" = "5.020" ]; then
    export PATH="$RTLDS_TOOLS_PREFIX/verilator-5.020/bin:$PATH"
fi

# Do NOT let ccache cache Verilator's precompiled header.
#
# verilated.mk sets `CCACHE_SLOPPINESS ?= pch_defines,time_macros`. The
# pch_defines part tells ccache to ignore predefined-macro differences when
# hashing, which makes the PCH *generation* step cacheable -- so ccache can
# hand back a Vtop__pch.h.fast.gch that was built under a different macro set.
# gcc then rejects it ("not used because `__cpp_templ' not defined") and, since
# there is no plain header to fall back on, the build dies with
#   fatal error: Vtop__pch.h.fast: No such file or directory
# It fails deterministically for every test sharing that cache entry, and looks
# exactly like an RTL/testbench break in a regression log.
#
# `?=` means this export wins. Dropping pch_defines makes the PCH compile
# uncacheable (always built by the real compiler, always valid); the ordinary
# .cpp -> .o compiles stay cached, so the speedup is retained.
export CCACHE_SLOPPINESS=time_macros

# Set default simulation tool
export SIM=verilator

# Optional: Print summary (can be toggled off later)
echo "[env_python] Environment configured for REPO_ROOT=$REPO_ROOT"

# ============================================================================
# Test Aliases - Convenient shortcuts for running pytest with common options
# ============================================================================

# ptw - Pytest With Waves (generates VCD waveforms)
# Usage: ptw test_cam_tag.py
#        ptw test_counter.py::test_counter
alias ptw='WAVES=1 REG_LEVEL=GATE python3 -m pytest -v -s'

# ptwp - Pytest With Waves (generates VCD waveforms)
# Usage: ptwp test_cam_tag.py
#        ptwp test_counter.py::test_counter
alias ptwp='WAVES=1 REG_LEVEL=GATE python3 -m pytest -v -s -n logical'

# ptg - Pytest Gate level (quick smoke tests)
# Usage: ptg test_*.py
alias ptg='REG_LEVEL=GATE python3 -m pytest -v'

# ptf - Pytest Func level (default functional tests)
# Usage: ptf test_*.py            (add -n <N> only to override; the area
#        Makefiles derive workers per host -- see make/tests.mk, TOOL-008 R1)
alias ptf='REG_LEVEL=FUNC python3 -m pytest -v'

# ptfull - Pytest Full regression
# Usage: ptfull test_*.py         (add -n <N> only to override)
alias ptfull='REG_LEVEL=FULL python3 -m pytest -v'

# ptwg - Pytest With Waves, Gate level (quick waveform debug)
# Same as ptw (for convenience)
alias ptwg='ptw'


