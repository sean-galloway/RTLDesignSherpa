#!/usr/bin/env bash
# The repository's pre-commit hook. ONE file -- git installs exactly one
# .git/hooks/pre-commit, so a second tracked hook does not add a check, it
# REPLACES every check in the one it overwrites.
#
# That is not hypothetical. This file used to carry only the filelist contract
# and was installed by symlink. On 2026-08-28 a second hook appeared at
# tools/hooks/pre-commit carrying the task-ID and declaration-order checks, and
# `make setup-hooks` COPIED it over the symlink. From then until 2026-09-02 the
# filelist checks did not run locally at all. Nobody noticed, because CI still
# ran them -- the local check was silently gone, not visibly broken.
#
# So: add new checks HERE. Do not add another hook file.
#
# Install (git does not track .git/hooks, so it is per clone):
#     make setup-hooks
# which symlinks this file. A symlink cannot drift from the tracked copy the
# way the old `cp` could.
#
# Bypass with `git commit --no-verify`. CI runs the same checks and will not be.

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 0

# tomllib needs 3.11+; prefer a python that has it.
PY=$(command -v python3.12 || command -v python3.11 || command -v python3)

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
fail=0

# --- task-tracker integrity (vault/Tasks/) ------------------------------------
# Duplicate IDs make every [[LINK]] ambiguous. COMMON-021 (and, until they
# were renumbered to 019/020 on 2026-09-06, PUMICE-010/-011) each ended up
# naming two unrelated tasks this way.
if echo "$STAGED" | grep -q '^vault/Tasks/.*\.md$'; then
    echo "[pre-commit] Checking task-tracker IDs..."
    if ! "$PY" "$REPO_ROOT/bin/check_task_ids.py"; then
        echo "" >&2
        echo "[pre-commit] BLOCKED: task-tracker ID problem." >&2
        echo "  Next free ID:  bin/check_task_ids.py --next <area>" >&2
        fail=1
    fi
fi

# --- SystemVerilog declaration order -----------------------------------------
# SystemVerilog allows forward references; some formal and synthesis flows
# do not.
STAGED_SV=$(echo "$STAGED" | grep '\.sv$' || true)
if [ -n "$STAGED_SV" ]; then
    echo "[pre-commit] Checking declaration order in $(echo "$STAGED_SV" | wc -l) staged .sv file(s)..."
    if ! "$PY" "$REPO_ROOT/bin/check_sv_decl_order.py" --staged; then
        echo "" >&2
        echo "[pre-commit] BLOCKED: signal(s) used before declaration." >&2
        fail=1
    fi
fi

# --- a test must not elaborate another protocol family's RTL -----------------
# test_axil5_master_rd.py drove axil4_master_rd for five days, green the whole
# time, while axil5_master_rd was never simulated.
if echo "$STAGED" | grep -qE '(^|/)test_[^/]*\.py$'; then
    echo "[pre-commit] Checking test/DUT protocol families..."
    if ! out=$("$PY" "$REPO_ROOT/bin/check_test_dut_family.py" 2>&1); then
        echo "$out" >&2
        fail=1
    fi
fi

# --- a doc example must name ports the module actually has -------------------
# Twenty-eight pages carried instantiations with invented ports. Every qc round
# had the RTL and the example in the SAME bundle unit and missed them; two were
# INTRODUCED by a humanize round. A script finds them in under a second, so a
# script owns this, not a reviewer.
if echo "$STAGED" | grep -qE '^docs/markdown/.*\.md$|\.sv$'; then
    echo "[pre-commit] Checking doc instantiation examples..."
    if ! out=$("$PY" "$REPO_ROOT/bin/check_doc_examples.py" 2>&1); then
        echo "$out" | tail -12 >&2
        fail=1
    fi
fi

# --- a staged .sv must PARSE -------------------------------------------------
# Commit 1d25191f shipped SIXTEEN files Verilator cannot parse: the reset-macro
# converter replaced the wrong `end` with the macro's closing paren. Ten test
# failures surfaced a week later in ONE file; the other fifteen live in trees
# no test references at all. Cheapest possible defect, and nothing looked.
if [ -n "$STAGED_SV" ]; then
    if command -v verilator >/dev/null 2>&1; then
        echo "[pre-commit] Checking staged .sv parse..."
        if ! out=$("$PY" "$REPO_ROOT/bin/check_sv_parses.py" 2>&1); then
            echo "$out" >&2
            fail=1
        fi
    else
        echo "[pre-commit] skipping .sv parse check (no verilator on PATH)" >&2
    fi
fi

# --- a changed port list must not break the module's consumers ---------------
# Adding `ow_mant_interp` to math_bf16_fast_reciprocal left one of its three
# consumers unconnected. PINMISSING is an ERROR under the flags cocotb passes,
# so all five of that consumer's tests failed to BUILD -- they never simulated.
# The FUNC subset never elaborated it, so raw pytest was green; only the FULL
# matrix caught it, fifteen minutes later.
if [ -n "$STAGED_SV" ]; then
    if command -v verilator >/dev/null 2>&1; then
        echo "[pre-commit] Checking consumers of changed port lists..."
        # Capture the output but PRINT IT EITHER WAY. The script emits a
        # "no consumer was checked" note for a port change nothing lints, and
        # swallowing that on success made it invisible -- a warning shown only
        # when something else fails is not a warning. Four dangling pins went
        # in during the RLB arc with that note being printed into a variable
        # and discarded.
        out=$("$PY" "$REPO_ROOT/bin/check_port_consumers.py" 2>&1) || fail=1
        [ -n "$out" ] && echo "$out" >&2
    else
        echo "[pre-commit] skipping port-consumer check (no verilator on PATH)" >&2
    fi
fi

# --- a copy of a shared include must not diverge from the canonical -----------
# reset_defs.svh decides whether every flop in the repo resets asynchronously.
# When it was made unconditionally async, eight tracked copies kept the old
# conditional -- one of them live in timing_characterization, whose flops would
# have elaborated SYNCHRONOUS while the rest of the tree was async. Both trees
# compiled and both passed; nothing diffed them.
if echo "$STAGED" | grep -qE '\.svh$'; then
    echo "[pre-commit] Checking shared-include copies..."
    if ! out=$("$PY" "$REPO_ROOT/bin/check_shared_include_copies.py" 2>&1); then
        echo "$out" >&2
        fail=1
    fi
fi

# --- filelist contract -------------------------------------------------------
# The fast local mirror of .github/workflows/filelist-checks.yml. CI is the
# authority; this saves the round trip.
if echo "$STAGED" | grep -qE '\.(f|sv|svh|sby|toml)$|(^|/)test_[^/]*\.py$'; then
    if ! "$PY" -c 'import tomllib' 2>/dev/null && ! "$PY" -c 'import tomli' 2>/dev/null; then
        echo "[pre-commit] skipping filelist checks (no tomllib/tomli on $PY)" >&2
    else
        echo "[pre-commit] Checking the filelist contract..."
        for check in --check --audit; do
            if ! out=$("$PY" bin/filelist_registry.py "$check" 2>&1); then
                echo "[pre-commit] filelist_registry.py $check FAILED" >&2
                echo "$out" | tail -20 >&2
                fail=1
            fi
        done
        if ! out=$("$PY" bin/filelist_registry.py --blindspots --ratchet 2>&1); then
            echo "$out" >&2
            echo "[pre-commit] run 'python3 bin/filelist_registry.py --blindspots' for the full list" >&2
            fail=1
        fi
    fi
fi

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "[pre-commit] BLOCKED. Bypass with 'git commit --no-verify' if you must;" >&2
    echo "             CI runs the same checks and cannot be bypassed." >&2
    exit 1
fi
exit 0
