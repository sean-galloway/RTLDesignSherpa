// peakrdl_to_cmdrsp write transaction with stall (replaces an ASCII sketch).
// Source of truth: rtl/peakrdl_to_cmdrsp.sv against the PeakRDL default cpuif
// (req masked by stall, rd_ack / wr_ack combinational from the masked req),
// cycle values taken from a Verilator run of the adapter with that cpuif model.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph p2c_write_stall_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="peakrdl_to_cmdrsp write with a two-cycle write stall, response\nbackpressured once", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="150" BORDER="0" ALIGN="RIGHT"><B>aclk cycle</B></TD><TD WIDTH="62" BORDER="0"><B>0</B></TD><TD WIDTH="62" BORDER="0"><B>1</B></TD><TD WIDTH="62" BORDER="0"><B>2</B></TD><TD WIDTH="62" BORDER="0"><B>3</B></TD><TD WIDTH="62" BORDER="0"><B>4</B></TD><TD WIDTH="62" BORDER="0"><B>5</B></TD><TD WIDTH="62" BORDER="0"><B>6</B></TD><TD WIDTH="62" BORDER="0"><B>7</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">cmd state</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">IDLE</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">IDLE</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">STALLED</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">STALLED</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">WAIT_ACK</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">IDLE</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">IDLE</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">IDLE</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">cmd_valid</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="6" WIDTH="372" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">cmd_ready</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="248" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">cmd_pwrite, paddr</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">1, 0x010</TD><TD COLSPAN="6" WIDTH="372" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">regblk_req_stall_wr</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="5" WIDTH="310" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">regblk_req</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">regblk_addr</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="4" WIDTH="248" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">0x010</TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">regblk_wr_ack</TD><TD COLSPAN="4" WIDTH="248" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">rsp_valid</TD><TD COLSPAN="5" WIDTH="310" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">rsp_ready</TD><TD COLSPAN="5" WIDTH="310" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="8" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Cycle 1: the command is accepted and registered; regblk_req pulses, but the stall masks it<BR ALIGN="LEFT"/>inside the regblock, so there is no ack. regblk_req stays LOW while the FSM is in STALLED.<BR ALIGN="LEFT"/>Cycle 3: the stall has cleared, so the FSM moves to WAIT_ACK; cycle 4 re-issues the request<BR ALIGN="LEFT"/>from the registered command and the regblock acks it. rsp_valid holds from cycle 5 until<BR ALIGN="LEFT"/>rsp_ready accepts it in cycle 6.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
