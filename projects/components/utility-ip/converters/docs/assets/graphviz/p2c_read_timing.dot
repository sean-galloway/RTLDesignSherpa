// peakrdl_to_cmdrsp read transaction (replaces an ASCII sketch).
// Source of truth: rtl/peakrdl_to_cmdrsp.sv against the PeakRDL default cpuif
// (req masked by stall, rd_ack / wr_ack combinational from the masked req),
// cycle values taken from a Verilator run of the adapter with that cpuif model.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph p2c_read_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="peakrdl_to_cmdrsp read, no stall: one cycle from accept to rsp_valid", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="130" BORDER="0" ALIGN="RIGHT"><B>aclk cycle</B></TD><TD WIDTH="62" BORDER="0"><B>0</B></TD><TD WIDTH="62" BORDER="0"><B>1</B></TD><TD WIDTH="62" BORDER="0"><B>2</B></TD><TD WIDTH="62" BORDER="0"><B>3</B></TD><TD WIDTH="62" BORDER="0"><B>4</B></TD><TD WIDTH="62" BORDER="0"><B>5</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">cmd state</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">IDLE</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">IDLE</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">WAIT_ACK</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">IDLE</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">IDLE</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">IDLE</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">cmd_valid</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="248" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">cmd_ready</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="248" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">cmd_pwrite, paddr</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">0, 0x100</TD><TD COLSPAN="4" WIDTH="248" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">regblk_req</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">regblk_rd_ack</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">rsp_valid</TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">rsp_ready</TD><TD COLSPAN="6" WIDTH="372" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">rsp_prdata</TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">DATA</TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="6" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Cycle 1: the command is accepted and regblk_req rises in the same cycle; the regblock<BR ALIGN="LEFT"/>acks combinationally and the response register captures DATA. Cycle 2: regblk_req is held<BR ALIGN="LEFT"/>in WAIT_ACK, so the regblock sees the read a second time; that ack returns the FSM to IDLE<BR ALIGN="LEFT"/>and is not captured. rsp_valid is up in cycle 2 and the next command can be taken in cycle 3.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
