%%{init: {'theme': 'neutral'}}%%
stateDiagram-v2
    state "Command FSM (apb_state_t)" as CMD {
        [*] --> IDLE
        IDLE --> WRITE: AW + W
        IDLE --> READ: AR
        WRITE --> WRITE: next cmd
        READ --> READ: next cmd
        WRITE --> IDLE: last cmd
        READ --> IDLE: last cmd
    }
    state "Response FSM (rsp_state_t)" as RSP {
        [*] --> RSP_IDLE
        RSP_IDLE --> RSP_ACTIVE: first rsp packet of a transaction
        RSP_ACTIVE --> RSP_ACTIVE: pack R slices / fold PSLVERR
        RSP_ACTIVE --> RSP_IDLE: last rsp (R beat with rlast, or the one B)
    }
