// Converter downsize timing (replaces an ASCII sketch). Source of truth:
// rtl/axi_data_dnsize.sv, single-buffer mode (wide_ready = !r_wide_buffered ||
// (narrow_ready && last narrow beat); narrow_valid = r_wide_buffered).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph conv_downsize_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Downsize 8:1, single buffer: WIDE1 is accepted during the last narrow\nbeat, no gap", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="110" BORDER="0" ALIGN="RIGHT"><B>aclk cycle</B></TD><TD WIDTH="50" BORDER="0"><B>0</B></TD><TD WIDTH="50" BORDER="0"><B>1</B></TD><TD WIDTH="50" BORDER="0"><B>2</B></TD><TD WIDTH="50" BORDER="0"><B>3</B></TD><TD WIDTH="50" BORDER="0"><B>4</B></TD><TD WIDTH="50" BORDER="0"><B>5</B></TD><TD WIDTH="50" BORDER="0"><B>6</B></TD><TD WIDTH="50" BORDER="0"><B>7</B></TD><TD WIDTH="50" BORDER="0"><B>8</B></TD><TD WIDTH="50" BORDER="0"><B>9</B></TD><TD WIDTH="50" BORDER="0"><B>10</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">s_valid</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="7" WIDTH="350" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="100" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">s_data</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">WIDE0</TD><TD COLSPAN="7" WIDTH="350" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">WIDE1</TD><TD COLSPAN="2" WIDTH="100" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">s_ready</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="7" WIDTH="350" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="100" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">m_valid</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="10" WIDTH="500" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">m_data</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">D0</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">D1</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">D2</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">D3</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">D4</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">D5</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">D6</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">D7</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">E0</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">E1</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">m_ready</TD><TD COLSPAN="11" WIDTH="550" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="11" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">WIDE0 is taken into the buffer at the end of cycle 0 and drains one narrow beat per cycle.<BR ALIGN="LEFT"/>s_ready is low while the buffer holds a beat, except in the last narrow beat (D7, cycle 8),<BR ALIGN="LEFT"/>where the buffer is replaced atomically: WIDE1 is accepted as D7 leaves and E0 follows at once.<BR ALIGN="LEFT"/>(s_valid is drawn low between wide beats only to show where they are accepted.)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
