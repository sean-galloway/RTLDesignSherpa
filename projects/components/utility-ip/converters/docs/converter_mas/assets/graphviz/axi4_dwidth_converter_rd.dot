// axi4_dwidth_converter_rd - MAS figure (read-path width converter).
// House style: vault/handbook/authoring/block-diagrams.md (rtl-amba lanes:
// address down the center, R climbing the right lane via dir=back).
// UPSIZE and DOWNSIZE are one build-time choice; each stage box states
// both modes. The AR side records each issued master burst per ID; the
// reassembly layer uses that record to feed whole bursts to the R data
// primitive (dashed sideband between the lanes) and frees the ID's slot,
// which in turn throttles AR issue (dashed back).
// Source of truth: rtl/axi4_dwidth_converter_rd.sv.
digraph axi4_dwidth_converter_rd {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.60", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="axi4_dwidth_converter_rd - AXI4 read path, S_AXI_DATA_WIDTH -> M_AXI_DATA_WIDTH (on aclk)";

    s    [label="Slave Port (s_axi_*, S_AXI_DATA_WIDTH)\nAR   |   R", fillcolor="white", width=7.5];

    ask  [label="AR Skid\ngaxi_skid_buffer - ar_skid", group=A];
    rsk  [label="R Skid\ngaxi_skid_buffer - r_skid", group=R];

    ar   [label="AR Rewrite\nUPSIZE: arlen = ceil((lane + len+1) / ratio) - 1,\naddress aligned down to the wide word\nDOWNSIZE: split into master bursts of <= 256 beats\nissue held while this ID's record slot is busy", group=A];
    rec  [label="Per-ID Burst Record (flops)\nrasm_rec_*: {final, master beats,\nnarrow length, start lane}, one per ID", group=M];
    rdat [label="R Data Path\nDOWNSIZE: axi_data_upsize - u_r_upsize\n(RRESP severity fold; last only on the final split)\nUPSIZE: axi_data_dnsize - u_r_dnsize\n(TRACK_BURSTS=1, start lane from the record)\nrid / ruser carried alongside", group=R];
    rasm [label="R Reassembly (BUG-009)\nshared beat pool (linked lists,\nRASM_MAX_OUTSTANDING x RASM_DEPTH beats);\nbuffers interleaved master R per ID, then\nfeeds one whole master burst at a time", group=R];

    m    [label="Master Port (m_axi_*, M_AXI_DATA_WIDTH)\nAR   |   R (may interleave across IDs)", fillcolor="white", width=7.5];

    s    -> ask  [xlabel="AR: id, addr, len, size ..."];
    ask  -> ar   [xlabel="slave burst"];
    ar   -> rec  [style=dashed, xlabel="record per issued AR"];
    ar   -> m    [minlen=2, xlabel="AR: rewritten / split bursts"];

    s    -> rsk  [dir=back, xlabel="R: id, data, resp, last"];
    rsk  -> rdat [dir=back, xlabel="slave-width beats"];
    rdat -> rasm [dir=back, xlabel="one contiguous\nmaster burst"];
    rasm -> m    [dir=back, xlabel="R: master beats", penwidth=1.8];

    rec  -> rasm [style=dashed, dir=both, xlabel="framing /\nslot free"];

    { rank=same; ask; rsk; }
    { rank=same; ar; rdat; }
    sp [label="", width=0.8, style=invis];
    { rank=same; rec; sp; rasm; }
    ask -> rsk [style=invis];
    rec -> sp -> rasm [style=invis];
}
