// peakrdl_integration - the CSR path a real deployment uses (replaces
// the ASCII sketch in MAS 3.5.8). Request down the center, response
// back up on the same hop (one dir=both edge per pair, the rtl-amba
// variant ruling). apb4_to_peakrdl's two children are drawn inside it.
// Source of truth: rtl/axi4_to_apb4_shim.sv, rtl/apb4_to_peakrdl.sv,
// rtl/peakrdl_to_cmdrsp.sv.
digraph peakrdl_integration {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.55", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="CSRs behind the APB shim - AXI4 master to a PeakRDL register block";

    m    [label="AXI4 Master\n(CPU, DMA, fabric port)", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    shim [label="AXI4 to APB Bridge\naxi4_to_apb4_shim (see Figure 3.6)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    apb  [label="APB Bus\n(other APB slaves may share it)", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    subgraph cluster_a2p {
        label="apb4_to_peakrdl"; labelloc=b; labeljust=r; style=dashed; fontsize=10;
        cdc  [label="APB to cmd/rsp\napb4_slave_cdc", peripheries=2, style="filled", fillcolor="#D6E4F0"];
        adp  [label="cmd/rsp to Passthrough cpuif\npeakrdl_to_cmdrsp (see Figure 3.8)", peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    }
    rb   [label="PeakRDL-Generated Register Block (passthrough cpuif)", fillcolor="white", width=5.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    m    -> shim [dir=both, label="  AXI4 request down /\nB, R up"];
    shim -> apb  [dir=both, label="  APB transfer /\nPRDATA, PSLVERR"];
    apb  -> cdc  [dir=both, label="  APB transfer /\nresponse"];
    cdc  -> adp  [dir=both, label="  cmd packet /\nrsp packet"];
    adp  -> rb   [dir=both, label="  regblk_* request /\nack, err, rd_data", penwidth=1.8];
}
