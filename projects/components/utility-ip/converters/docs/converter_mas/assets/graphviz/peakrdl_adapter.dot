// peakrdl_adapter - MAS Figure 3.8 (peakrdl_to_cmdrsp).
// House style: vault/handbook/authoring/block-diagrams.md.
// The command enters top-left and goes down through the request mux to
// the PeakRDL passthrough cpuif (the boundary bar); the ack / read data
// climbs back up the right through the response capture to the rsp
// port, top-right. The command FSM sits on the left; stall from the
// register block is dashed feedback into it.
// Source of truth: rtl/peakrdl_to_cmdrsp.sv.
digraph peakrdl_adapter {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.55", ranksep="0.65", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="peakrdl_to_cmdrsp - cmd/rsp stream to a PeakRDL passthrough cpuif (on aclk)";

    cmd  [label="Command Port\ncmd_valid / cmd_ready (= CMD_IDLE)\ncmd_pwrite, cmd_paddr, cmd_pwdata, cmd_pstrb", fillcolor="white", group=C, style="rounded,filled", fillcolor="#E2EFDA"];
    rspp [label="Response Port\nrsp_valid / rsp_ready\nrsp_prdata, rsp_pslverr", fillcolor="white", group=R, style="rounded,filled", fillcolor="#E2EFDA"];

    fsm  [label="Command FSM + Capture (flops)\nCMD_IDLE -> CMD_WAIT_ACK on accept\nCMD_IDLE -> CMD_STALLED if stalled; retry\nr_cmd_*: the command, pstrb expanded\nto bit enables (strb_to_biten)", group=L, peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    mux  [label="Request Mux (combinational)\nCMD_IDLE: present the live command\nelse: replay the captured one\nregblk_req = WAIT_ACK or (IDLE and cmd_valid)", group=C, style="filled", fillcolor="white"];
    rcap [label="Response Capture (flops)\nRSP_IDLE -> RSP_VALID on rd_ack / wr_ack\nr_rsp_prdata, r_rsp_pslverr = rd_err / wr_err", group=R, peripheries=2, style="filled", fillcolor="#D6E4F0"];

    bar  [label="PeakRDL Register Block (passthrough cpuif)\nregblk_req, req_is_wr, addr, wr_data, wr_biten   |   req_stall_wr / rd   |   rd_ack, rd_err, rd_data, wr_ack, wr_err",
          fillcolor="white", width=10.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    cmd  -> mux  [xlabel="live command"];
    cmd  -> fsm  [style=dashed, color="#777777", xlabel="cmd_valid,\ncapture"];
    fsm  -> mux  [xlabel="captured command,\nstate"];
    mux  -> bar  [xlabel="register request", penwidth=1.8];
    fsm  -> bar  [style=dashed, color="#777777", dir=back, xlabel="stall_wr / stall_rd,\nack"];

    rspp -> rcap [color="#1A7A1A", dir=back, xlabel="response"];
    rcap -> bar  [color="#1A7A1A", dir=back, xlabel="ack, err, rd_data"];

    { rank=same; cmd; rspp; }
    { rank=same; fsm; rcap; }
    cmd -> rspp [style=invis];
    fsm -> mux [style=invis];
}
