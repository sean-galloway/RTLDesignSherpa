// Converter upsize timing (replaces an ASCII sketch). Source of truth:
// rtl/axi_data_upsize.sv (accumulator, registered r_wide_valid, narrow_ready =
// !r_wide_valid || wide_ready).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph conv_upsize_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Upsize 8:1, m_ready held high: one wide beat per 8 narrow beats, no\ns_ready bubble", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="110" BORDER="0" ALIGN="RIGHT"><B>aclk cycle</B></TD><TD WIDTH="50" BORDER="0"><B>0</B></TD><TD WIDTH="50" BORDER="0"><B>1</B></TD><TD WIDTH="50" BORDER="0"><B>2</B></TD><TD WIDTH="50" BORDER="0"><B>3</B></TD><TD WIDTH="50" BORDER="0"><B>4</B></TD><TD WIDTH="50" BORDER="0"><B>5</B></TD><TD WIDTH="50" BORDER="0"><B>6</B></TD><TD WIDTH="50" BORDER="0"><B>7</B></TD><TD WIDTH="50" BORDER="0"><B>8</B></TD><TD WIDTH="50" BORDER="0"><B>9</B></TD><TD WIDTH="50" BORDER="0"><B>10</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">s_valid</TD><TD COLSPAN="11" WIDTH="550" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">s_data</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D0</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D1</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D2</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D3</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D4</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D5</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D6</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D7</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D8</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D9</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">D10</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">s_ready</TD><TD COLSPAN="11" WIDTH="550" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">m_valid</TD><TD COLSPAN="8" WIDTH="400" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="100" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">m_data</TD><TD COLSPAN="8" WIDTH="400" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">WIDE0<BR/>(D7..D0)</TD><TD COLSPAN="2" WIDTH="100" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">m_ready</TD><TD COLSPAN="11" WIDTH="550" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="11" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">D7 completes the group at the end of cycle 7, so the registered wide beat is valid in cycle 8.<BR ALIGN="LEFT"/>In that same cycle s_ready stays high (the wide side is ready) and D8 starts the next group;<BR ALIGN="LEFT"/>s_ready drops only if the wide side stalls with a completed group waiting.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
