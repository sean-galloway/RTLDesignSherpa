// DELTA AXIS handshake (replaces an ASCII sketch). Protocol figure: the
// standard AXI4-Stream valid/ready rule stated in section 1.4 of this chapter
// (the draft NoC has no RTL of its own yet).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph delta_axis_handshake {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="AXIS handshake: a beat transfers only in a cycle where tvalid and tready\nare both 1", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="110" BORDER="0" ALIGN="RIGHT"><B>clk cycle</B></TD><TD WIDTH="66" BORDER="0"><B>0</B></TD><TD WIDTH="66" BORDER="0"><B>1</B></TD><TD WIDTH="66" BORDER="0"><B>2</B></TD><TD WIDTH="66" BORDER="0"><B>3</B></TD><TD WIDTH="66" BORDER="0"><B>4</B></TD><TD WIDTH="66" BORDER="0"><B>5</B></TD><TD WIDTH="66" BORDER="0"><B>6</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">tvalid</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="264" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="132" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">tready</TD><TD COLSPAN="2" WIDTH="132" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="264" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">tdata, tuser, tdest</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">D0</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">D1</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">D1</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">D2</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">transfer</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">D0</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">stall</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">D1</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">D2</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="7" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Cycle 0: tready high but nothing offered. Cycle 2: the receiver drops tready, so D1 does<BR ALIGN="LEFT"/>not transfer and the source holds tvalid and the data stable. D1 transfers in cycle 3 and<BR ALIGN="LEFT"/>D2 in cycle 4. A source may not wait for tready before asserting tvalid.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
