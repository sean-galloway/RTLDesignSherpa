// onyx ACE CCU whole-unit block diagram, PLANNED -- house style per
// vault/handbook/authoring/block-diagrams.md. No onyx RTL exists; this draws
// only the expected manager shape that HAS ch02/04 lists in prose. Module
// boundaries, signal names and widths stay open until D1 / D3 / D4 / D5.
digraph onyx_planned {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.50", ranksep="0.55", splines=ortho,
           label="onyx ACE CCU - manager shape (planned; per HAS 2.4, open until D1 / D3 / D4 / D5)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    req   [label="Requesting cache\n(one cache-side ACE port, D2 subset)", fillcolor="white", group=C];
    peers [label="Peer caches\n(snoop targets)", fillcolor="white"];

    fe   [label="Front-End Decode (one per cache-side port)\nread-side vs write-side, uniform internal request\n(split and buffering: D1, D2)", group=C];
    dec  [label="Coherence Decision Layer\nwhich snoops to send, CRRESP interpretation,\nmemory-read elision (D6), directory-lite state (D3)", group=C];
    ser  [label="Serializer / PoS\norders same-address transactions\n(scoreboard vs in-order: D5; sizing: D10.8)", group=C];
    fan  [label="Fanout / Gather Engine\nAC out, CR / CD in, completion tracking\n(D4, N3, N4)"];
    mem  [label="Memory-Side AXI4 Master\nreads / writes when adjudication needs memory,\nWriteBack / Evict drains (AWID policy: D5)", group=C];
    tap  [label="MonBus Taps (*_monlite, D9)\ncache-side, snoop and memory-side paths\n(observed, nothing driven back)", style="filled,dashed"];

    bar  [label="Fabric edge - memory (AXI4; one master, or a striped set per D1)  |  MonBus out",
          fillcolor="white", width=8, height=0.5, fontsize=11, group=C];

    req  -> fe   [dir=both, xlabel="AR / AW / W in,\nR / B out"];
    fe   -> dec  [xlabel="request"];
    dec  -> ser  [xlabel="request + snoop decision"];
    ser  -> fan  [xlabel="snoop job"];
    ser  -> mem  [xlabel="memory read / write"];
    fan  -> peers [dir=both, xlabel="AC / CR, CD"];
    fan  -> mem  [dir=both, xlabel="CD drain /\nmemory read data"];
    fe   -> fan  [dir=back, xlabel="chosen data -> requester", constraint=false];
    mem  -> bar  [dir=both, xlabel="AXI4 read / write"];
    tap  -> bar  [xlabel="MonBus packets"];

    { rank=same; req; peers; }
    { rank=same; fan; tap; }
    req -> peers [style=invis];
    ser -> tap [style=invis];
}
