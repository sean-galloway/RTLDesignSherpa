// jet MESI L1 (non-blocking) whole-unit block diagram, PLANNED -- house
// style per vault/handbook/authoring/block-diagrams.md. No jet RTL exists;
// this draws only the expected shape that HAS ch02/04 states in prose. Block
// depths and the exact module split wait on decisions J1 (MSHR
// organization) and J5 (victim buffering).
digraph jet_planned {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.50", ranksep="0.60", splines=ortho,
           label="jet non-blocking MESI L1 - whole unit (planned; shape per HAS 2.4, depths open until J1 / J5)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    cpu  [label="CPU / STREAM\nGAXI master", fillcolor="white"];
    peer [label="Peer cache (pair rig) or onyx CCU (ACE rig)\nACE snoop master", fillcolor="white"];

    core [label="Cache Core (inherited unchanged from amber)\nl1_core: GAXI front end, control, tag / data arrays,\nreplacement engine"];
    snp  [label="Snoop Responder (inherited from amber)\nAC in, CR / CD out\nnew: also inspects the MSHR file and victim buffer (J4)"];

    mshr [label="MSHR File (planned, J1 / J2)\noutstanding-miss table, merge logic, hazard logic"];
    vic  [label="Victim Buffer (planned, J5)\ndeeper than amber's depth 1: holds dirty victims\nwhose fills have not returned"];
    mon  [label="Cache-Event Observer (inherited from amber)\nl1_monlite, extended with the J7 measurement classes\n(observed, nothing driven back)", style="filled,dashed"];

    fab  [label="Fabric Master Stack\nAXI4 (pair rig) / ACE (onyx rig)\nmultiple outstanding transactions"];

    bar  [label="Rig edge - memory (pair rig) or onyx CCU (ACE rig)  |  MonBus out",
          fillcolor="white", width=8, height=0.5, fontsize=11];

    cpu  -> core [dir=both, xlabel="request / response"];
    core -> mshr [dir=both, xlabel="misses out /\nfill data in"];
    core -> vic  [xlabel="dirty victims"];
    mshr -> fab  [dir=both, xlabel="fill reads /\nread data"];
    vic  -> fab  [xlabel="write-backs"];
    fab  -> bar  [dir=both, xlabel="AXI4 / ACE"];

    peer -> snp  [dir=both, xlabel="AC / CR, CD"];
    core -> snp  [dir=both, style=dashed, xlabel="port B"];
    snp  -> mshr [style=dashed, xlabel="inspect (J4)"];
    snp  -> vic  [style=dashed, xlabel="inspect (J4)"];
    core -> mon  [style=dashed, xlabel="cache events"];
    mon  -> bar  [xlabel="MonBus packets"];

    { rank=same; cpu; peer; }
    { rank=same; core; snp; }
    { rank=same; mon; mshr; vic; }
    cpu -> peer [style=invis];
    core -> snp [style=invis];
    mon -> mshr -> vic [style=invis];
}
