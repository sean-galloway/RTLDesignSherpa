// render: no-key (conceptual / software figure, not the hardware element key)
// Delta 2x2 mesh with HIVE virtual tiles -- house style per
// vault/handbook/authoring/block-diagrams.md. HAS ch02 (virtual tile
// addressing). A topology map, not a flow: the four compute engines are boxes
// in their mesh position, mesh links are undirected; the two virtual tiles hang
// off the mesh edge with the TDEST that reaches them. hive PRD 0.3
// (2026-11-25) shrank the mesh from 4x4 (tiles 0-15) to 2x2; the virtual tile
// IDs 16 and 17 are unchanged.
graph delta_virtual_tiles {
    graph [compound=true, bgcolor="white", fontname="Helvetica", fontsize=11, nodesep="0.45", ranksep="0.45",
           splines=line, label="Delta 2x2 physical mesh (compute engines 0-3) and the two HIVE virtual tiles", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled, fillcolor="#D6E4F0", color="black",
           width=1.3, height=0.6, fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, color="black"];
    subgraph cluster_mesh { label="Delta mesh (fabric-gen-ip/delta) - compute engines, XY rows and columns"; style=dashed; fontsize=10;
        { rank=same; T0 [label="T0 engine 0\nrow 0"]; T1 [label="T1 engine 1\nrow 0"]; }
        T0 -- T1;
        { rank=same; T2 [label="T2 engine 2\nrow 1"]; T3 [label="T3 engine 3\nrow 1"]; }
        T2 -- T3;
        T0 -- T2;
        T1 -- T3;
    }
    v16 [label="Virtual tile 16\nRAPIDS DMA engine", width=2.1, height=0.6, fillcolor="white"];
    v17 [label="Virtual tile 17\nHIVE-C master controller", width=2.3, height=0.6, fillcolor="white"];
    T2 -- v16 [ltail=cluster_mesh, label="  edge-attached,\l  TDEST=16\l", minlen=2];
    T3 -- v17 [ltail=cluster_mesh, label="  edge-attached,\l  TDEST=17\l", minlen=2];
    { rank=same; v16; v17; }
}
