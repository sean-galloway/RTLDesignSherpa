// ALU-INFER datapath (definition level) -- element key v3 per
// vault/handbook/authoring/block-diagrams.md.  Context view: gatling issues
// invocations over the seam; the function table computes on the rtl/math
// blocks in the element format func_sel names; the tag FIFO retires in
// order.  The full block diagram is 02_alu_infer_block.dot.
digraph alu_infer {
    rankdir=TB;
    graph [bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="#333333", arrowsize=0.7];

    { rank=same; in; cfg; }
    in   [label="Issue seam (from gatling)\noperand lines A, B + imm\nvalid / ready (comb)", style="rounded,filled", fillcolor="#E2EFDA"];
    cfg  [label="func_sel {fmt, sub_op, opcode}\nacc_ctrl", style="rounded,filled", fillcolor="#E2EFDA"];

    funcs [label="Function table (math_bf16 / fp32 / fp8 blocks, int8 logic)\nelementwise | activations | PWL LUT | conversions\nformats: bf16 x2  int8 x4  fp32 x1  fp8 x4 lanes per 32-bit line"];
    acc   [label="Accumulator  (MAC, REDUCE)\nper-lane 32-bit bank, one-cycle loop", shape=box, peripheries=2, fillcolor="#D6E4F0"];
    fifo  [label="Tag FIFO + arrival join\nin-order retirement at natural latency", shape=cylinder, fillcolor="#E8DFF5"];

    out  [label="Result seam (to gatling)\nresult_line + result_flags, result_valid / ready (flopped)", style="rounded,filled", fillcolor="#E2EFDA", penwidth=2.2];

    in    -> funcs [penwidth=1.8, xlabel="lanes"];
    in    -> acc   [xlabel="A, B"];
    funcs -> fifo  [penwidth=1.8, xlabel="result + tag"];
    acc   -> fifo  [xlabel="view + tag"];
    fifo  -> out   [penwidth=1.8];

    cfg -> funcs [style=dashed, color="#777777", xlabel="row + format"];
    cfg -> acc   [style=dashed, color="#777777", xlabel="acc_ctrl"];
}
