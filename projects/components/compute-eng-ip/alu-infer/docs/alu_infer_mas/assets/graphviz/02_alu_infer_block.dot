// DERIVED from ../../assets/graphviz/02_alu_infer_block.dot (PRD-canonical) — keep in
// line by copying after regenerating the PRD figure; do not edit here.
// ALU-INFER full block diagram -- element key v3 per
// vault/handbook/authoring/block-diagrams.md: interfaces green rounded,
// combinational white, registered double-border blue, storage lavender
// cylinder, build-optional families dashed (EN_* parameters).
// Shape of the RTL (2026-10-20): decode routes each invocation to one of
// four result ports by latency class; every port carries the invocation's
// 8-bit tag to the tag FIFO, which retires in issue order.
digraph alu_infer_block {
    rankdir=TB;
    graph [bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.65", splines=ortho];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="#333333", arrowsize=0.7];

    // ---- Issue seam (from gatling) ----
    { rank=same; hsi; fsel; ops; actl; }
    hsi -> fsel -> ops -> actl [style=invis];
    ops  [label="op_line_a, op_line_b (LINE_W)\nthreshold_imm (16b)\nissue seam (comb)", style="rounded,filled", fillcolor="#E2EFDA"];
    fsel [label="func_sel (9b)\n{fmt, sub_op, opcode}", style="rounded,filled", fillcolor="#E2EFDA"];
    actl [label="acc_ctrl (2b)\nhold / acc / clear / drain", style="rounded,filled", fillcolor="#E2EFDA"];
    hsi  [label="valid / ready\nissue handshake", style="rounded,filled", fillcolor="#E2EFDA"];

    // ---- Decode and row families ----
    { rank=same; dec; rf32; rbf; rnar; rext; lut; }
    dec -> rf32 -> rbf -> rnar -> rext -> lut [style=invis];
    dec  [label="Decode\nalu_infer_decode\nlegal?  result port"];
    rbf  [label="bf16 rows\nadd/sub  mul  min/max\ncompare  relu  const"];
    rf32 [label="fp32 rows (EN_FP32)\nIEEE adder, mul\nmin/max  compare  relu", style="filled,dashed"];
    rnar [label="int8 + fp8 e4m3 rows\n(EN_INT8, EN_FP8)\nadd/sub mul min/max\ncompare relu", style="filled,dashed"];
    rext [label="Activations, PWL, conversions\n(EN_ACT, EN_PWL, EN_CVT)\nlibrary activations, slope*x+icpt,\nCVT / ALTFMT", style="filled,dashed"];
    lut  [label="PWL LUT\n256 x {slope, icpt}\nloaded in-band", shape=cylinder, style="filled,dashed", fillcolor="#E8DFF5"];

    // ---- Result ports ----
    { rank=same; err; p2; p1; p0; acc; }
    err -> p2 -> p1 -> p0 -> acc [style=invis];
    p0   [label="Port 0: combinational\nselect by opcode + fmt\nlands at the issue edge"];
    p1   [label="Port 1: adders\nbf16 / fp32\nADDER_LATENCY", shape=box, peripheries=2, fillcolor="#D6E4F0"];
    p2   [label="Port 2: multipliers\nbf16 / fp32\nMUL_LATENCY", shape=box, peripheries=2, fillcolor="#D6E4F0"];
    acc  [label="Port 3: accumulator\nMAC_LATENCY operand stages,\none-cycle accumulate loop,\n32b bank per 8-bit lane", shape=box, peripheries=2, fillcolor="#D6E4F0"];
    err  [label="err_opcode\nstatus pulse (comb)", style="rounded,filled", fillcolor="#E2EFDA"];

    fifo [label="Tag FIFO + arrival join  alu_infer_pipe\nPIPE_DEPTH entries, 8-bit tag per issue,\neach port joins its entry by tag", shape=cylinder, fillcolor="#E8DFF5"];
    out  [label="result_valid / result_ready, result_line, result_flags\nretire in issue order (flopped)", style="rounded,filled", fillcolor="#E2EFDA", penwidth=2.2];

    // ---- Flow ----
    ops -> rbf  [penwidth=1.8];
    ops -> rf32;
    ops -> rnar;
    ops -> rext;
    ops -> acc  [xlabel="A, B, imm"];
    rbf  -> p1  [xlabel="sum"];
    rbf  -> p2  [xlabel="product"];
    rbf  -> p0  [penwidth=1.8];
    rf32 -> p1;
    rf32 -> p2;
    rf32 -> p0;
    rnar -> p0;
    rext -> p0;
    lut  -> rext [dir=both, style=dashed, color="#777777"];

    p0   -> fifo [penwidth=1.8, xlabel="line, flags, tag"];
    p1   -> fifo [xlabel="sum, tag"];
    p2   -> fifo [xlabel="product, tag"];
    acc  -> fifo [xlabel="view, tag"];
    fifo -> out  [penwidth=1.8];

    // ---- Sideband ----
    hsi  -> dec [style=dashed, color="#777777"];
    fsel -> dec [style=dashed, color="#777777"];
    dec  -> err [style=dashed, color="#777777"];
    dec  -> p0  [style=dashed, color="#777777", xlabel="route"];
    actl -> acc [style=dashed, color="#777777"];
}
