// ALU-RV32F execution unit (definition level) — house style per
// vault/handbook/authoring/block-diagrams.md (FP datapath mapping:
// operands on top, unpack/classify, parallel unit rows in one rank,
// normalize/round then special-case select, white output bar; flags are a
// dashed sideband to fcsr; the operation select is a mode port, not a pick —
// no trapezium).
digraph alu_rv32f {
    rankdir=TB;
    graph [bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // Operand ports and mode select (white)
    pa [label="FP operand A", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    pb [label="FP operand B", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    pc [label="FP operand C\n(fused family only)", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    op [label="op select + rm (RNE;\nother modes raise NV)", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    // Field split
    unpack [label="Unpack + classify\nsign, exponent, mantissa;\nNaN / inf / zero / denormal flags", style="filled", fillcolor="white"];

    // Parallel unit rows (one rank); rtl/math blocks underneath
    uadd  [label="FADD / FSUB\nrtl/math fp32 adder", style="filled", fillcolor="white"];
    umul  [label="FMUL\nrtl/math fp32 multiplier", style="filled", fillcolor="white"];
    ufma  [label="FMADD family\nrtl/math fp32 FMA", style="filled", fillcolor="white"];
    udiv  [label="FDIV (non-pipelined)\nrtl/math fp32 divider\n(Goldschmidt)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    usqrt [label="FSQRT (non-pipelined)\nrtl/math fp32 sqrt\n(NR reciprocal-sqrt)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    usm   [label="FSGNJ / FMV / FMIN / FMAX\nFCVT / FCLASS / FEQ / FLT / FLE\nsmall rows", style="filled", fillcolor="white"];

    // Post-processing chain
    norm [label="Normalize + round (RNE)\nGRS per IEEE 754-2008", style="filled", fillcolor="white"];
    sel  [label="Result + special-case select\nNaN / inf / zero overrides", style="filled", fillcolor="white"];

    // Boundary bar (white) and flag sideband
    out   [label="Result 32b (fp32 or int)\nto reservation station / commit", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    flags [label="{NV, DZ, OF, UF, NX} per-op flag bundle\n(merged in program order at commit)", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    // Main flow
    pa -> unpack [headlabel="A"];
    pb -> unpack [headlabel="B"];
    pc -> ufma   [headlabel="C", label="(fused only)"];
    unpack -> uadd  [label="fields"];
    unpack -> umul  [label="fields"];
    unpack -> ufma  [label="fields"];
    unpack -> udiv  [label="fields"];
    unpack -> usqrt [label="fields"];
    unpack -> usm   [label="fields"];
    uadd  -> norm [label="sum"];
    umul  -> norm [label="product"];
    ufma  -> norm [label="fused"];
    udiv  -> norm [label="quotient"];
    usqrt -> norm [label="root"];
    usm   -> sel  [label="exact result"];
    norm  -> sel  [label="rounded + GRS"];
    sel   -> out  [label="result"];

    // Sideband
    op -> uadd  [style=dashed, color="#777777", label="row"];
    op -> usm   [style=dashed, color="#777777", label="row"];
    sel -> flags [style=dashed, color="#777777", label="flag bundle"];
}
