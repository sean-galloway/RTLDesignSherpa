// Byte-granular RAPIDS variant of rapids_beats_mas/assets/graphviz/04_axi_write_engine.dot
// rtl/fub/axi_write_engine.sv
// axi_write_engine_beats microarchitecture (rtl/fub_beats/axi_write_engine_beats.sv).
// Request: scheduler requests -> data mask -> round-robin pick -> AW issue -> m_axi_wr (center).
// Write data: drained from the SRAM down the left lane, sequenced by the W-phase FIFO.
// Response: B re-enters at the bar and climbs the right lane to the commit logic.
// Drawn to the block-diagrams v2 element key (2026-10-19 trial): shape and fill name the element class.
digraph axi_write_engine {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.45", splines=ortho,
           label="axi_write_engine - data-aware round-robin AXI write engine (byte-granular RAPIDS) (single clock: clk, rst_n)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // element classes (block-diagrams v2 key)
    //   interface : shape=box, style="rounded,filled,bold", fill #E2EFDA
    //   combo     : shape=box, fill white
    //   registered: shape=box, peripheries=2, fill #D6E4F0
    //   storage   : shape=cylinder, fill #E8DFF5
    //   pick      : shape=invtrapezium, fill #FFF2CC
    //   child     : shape=box3d (fill of its class)

    sram  [label="SRAM Controller (drain side)\ndata_avail, {strb, data} in; drain_req out", shape=box, style="rounded,filled,bold", fillcolor="#E2EFDA", group=L];
    sched [label="Scheduler Side (8 channels)\nwrite requests in; issue, commit, error out", shape=box, style="rounded,filled,bold", fillcolor="#E2EFDA", group=C];

    effav [label="Effective Data Available\nSRAM avail - drains still in flight\n(the last 2 cycles' AW sizes)", group=M];
    outst [label="Outstanding Counters\n+1 at AW, -1 at B, per channel", peripheries=2, fillcolor="#D6E4F0", group=R];

    mask  [label="Data-Aware Request Mask\nvalid && avail >= burst &&\nbelow AW_MAX_OUTSTANDING", group=C];
    rreq  [label="Request Register\nr_arb_request (timing cut)", peripheries=2, fillcolor="#D6E4F0", group=C];
    arb   [label="Channel Arbiter\narbiter_round_robin (WAIT_GNT_ACK = 1)", shape=invtrapezium, width=3.8, height=0.5, fillcolor="#FFF2CC", group=C];
    aw    [label="AW Issue Register\nchannel, AWLEN (capped at 4 KB);\ndrain_req, issue strobe", peripheries=2, fillcolor="#D6E4F0", group=C];

    wph   [label="W-Phase Queue\ngaxi_fifo_sync, {channel, beats} in AW order", shape=cylinder, fillcolor="#E8DFF5", group=M];
    bph   [label="B-Phase Queues\ngaxi_fifo_sync x 8, per channel", shape=cylinder, fillcolor="#E8DFF5", group=R];

    wseq  [label="W Sequencer\nchannel, beats remaining\n(WLAST at 1)", peripheries=2, fillcolor="#D6E4F0", group=M];
    cmt   [label="Commit Register\ncommit strobe, beats; BRESP != OKAY\n-> sticky sched_wr_error", peripheries=2, fillcolor="#D6E4F0", group=R];

    wmux  [label="W Output\nSRAM beat, or the beat held\n(flops) on a channel-reset abort", group=L];

    bar [label="Module Boundary - m_axi_wr\nW out   |   AW out (to the interconnect)   |   B in (from memory)", shape=box, style="rounded,filled,bold", fillcolor="#E2EFDA", width=10.0, group=C];

    sched -> mask [label="write requests (8 ch)"];
    sram  -> effav [style=dashed, xlabel="data_avail"];
    effav -> mask [label="effective avail"];
    outst -> mask [style=dashed, xlabel="room left"];
    mask  -> rreq [label="eligible channels"];
    rreq  -> arb  [label="requests (1 cycle later)"];
    arb   -> aw   [label="grant (channel id)", penwidth=1.8];
    aw    -> wph  [xlabel="burst record"];
    aw    -> bph  [xlabel="expected B"];
    wph   -> wseq [label="next burst"];
    wseq  -> wmux [xlabel="beat count, WLAST"];
    sram  -> wmux [label="drain beats"];
    wmux  -> bar  [label="W: data, strb, last"];
    aw    -> bar  [xlabel="AW: id, addr, len", penwidth=1.8];
    bph   -> cmt  [label="expected burst"];
    cmt   -> bar  [dir=back, label="B: id, resp"];
    sched -> cmt  [dir=back, style=dashed, constraint=false, xlabel="commit strobe,\nbeats; error"];

    { rank=same; sram; sched; }
    sram -> sched [style=invis];
    { rank=same; effav; outst; }
    { rank=same; wph; bph; }
    wph -> bph [style=invis];
    { rank=same; wseq; cmt; }

    // ---- key ----------------------------------------------------------------
    subgraph cluster_key {
        label="Key"; style=solid; color="#808080"; fontsize=10;
        k_if   [label="Interface /\nboundary", shape=box, style="rounded,filled,bold", fillcolor="#E2EFDA", fontsize=9];
        k_comb [label="Combinational", fontsize=9];
        k_reg  [label="Registered\n(flops)", peripheries=2, fillcolor="#D6E4F0", fontsize=9];
        k_fsm  [label="FSM", shape=box, style="filled,diagonals", peripheries=2, fillcolor="#FCE4D6", fontsize=9];
        k_mem  [label="Storage\n(FIFO / RAM / CAM)", shape=cylinder, fillcolor="#E8DFF5", fontsize=9];
        k_pick [label="Arbiter /\npick", shape=invtrapezium, fillcolor="#FFF2CC", fontsize=9];
        k_opt  [label="Optional\n(build-dependent)", style="filled,dashed", fontsize=9];
        k_edge [label="solid: flow\lheavy: main path / winner\ldashed: sideband\l", shape=note, fontsize=9];
        { rank=same; k_if; k_comb; k_reg; k_fsm; k_mem; k_pick; k_opt; k_edge; }
        k_if -> k_comb -> k_reg -> k_fsm -> k_mem -> k_pick -> k_opt -> k_edge [style=invis];
    }
    bar -> k_mem [style=invis, weight=10];
}
