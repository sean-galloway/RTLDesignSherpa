// src_data_path_axis (rtl/macro/src_data_path_axis.sv): the egress re-packer.
// Memory beats are popped from the source SRAM; the start offset is dropped
// and bytes are re-packed from lane 0, with a partial last beat.
// Return-flow figure: data climbs from the SRAM (bar, bottom) to m_axis (top).
digraph egress_shifter {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.50", ranksep="0.50", splines=ortho,
           label="src_data_path_axis egress re-packer - memory beats to packed stream beats with a partial last beat\n(single clock: clk, rst_n)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    axis  [label="Network Out - m_axis_*\ntdata, tstrb, tlast, tid = channel", fillcolor="white", group=C, style="rounded,filled", fillcolor="#E2EFDA"];
    rec   [label="Packet Records (from the scheduler)\nsched_rd_pkt_*: {bytes, src offset} per channel", fillcolor="white", group=R, style="rounded,filled", fillcolor="#E2EFDA"];
    outr  [label="Output Register (flops)\ntstrb = low min(bytes_left, lanes) lanes;\ntlast when bytes_left reaches 0", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    pq    [label="Record Queue (flops, 4 per channel)\nhead: offset, bytes; mem beats =\nceil((offset + bytes) / lanes); popped on\nthe packet's last stream beat", group=R, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    form  [label="Re-Pack (combinational)\nfirst pop (offset != 0): hold = beat >> offset*8, no output\nlater pops: out = hold | beat << (lanes - offset)*8\nflush: last beat popped, bytes left -> out = hold", width=5.0, group=C, style="filled", fillcolor="white"];
    hold  [label="Hold (flops, per channel)\nbytes above the offset\nof the last popped beat", group=L, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    drain [label="Drain Stage (as in RAPIDS Beats)\nround-robin reservations of cfg_drain_size beats;\npops when output free, no flush, record known", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    bar   [label="Source SRAM - src_sram_controller (drain_data, DW wide)", fillcolor="white", width=7.5, group=C, shape=cylinder, style="filled", fillcolor="#E8DFF5"];

    rec   -> pq    [label="record push"];
    axis  -> outr  [dir=back, label="packed stream beat", penwidth=1.8];
    outr  -> form  [dir=back, label="re-packed bytes", penwidth=1.8];
    pq    -> form  [xlabel="offset, bytes left"];
    form  -> hold  [dir=both, xlabel="held bytes in;\nnew hold out"];
    form  -> drain [dir=back, label="popped memory beat", penwidth=1.8];
    drain -> bar   [dir=back, label="drain beats (by channel)", penwidth=1.8];

    { rank=same; axis; rec; }
    axis -> rec [style=invis];
    { rank=same; form; hold; }
}
