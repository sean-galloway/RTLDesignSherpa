// scheduler (rtl/fub/scheduler.sv): bytes in, beats out, per enabled direction.
digraph scheduler_byte_math {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.50", ranksep="0.40", splines=ortho,
           label="scheduler - bytes in, beats out (per enabled direction)", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    in    [label="Descriptor (from the descriptor engine)\nlength in bytes, src_addr, dst_addr", fillcolor="white", group=C, style="rounded,filled", fillcolor="#E2EFDA"];
    math  [label="Offset and Beat Count (combinational)\noffset = addr[OFF_W-1:0]  (OFF_W = log2(BYTE_LANES), 5 at 256-bit)\nbeats = length == 0 ? 0 : (offset + length + BYTE_LANES - 1) >> OFF_W  (33-bit)", group=C, style="filled", fillcolor="white"];
    gate  [label="Record Gate, CH_FETCH_DESC (combinational)\nw_pkt_ok: each enabled direction's record queue has room\n(or length == 0); otherwise stay in CH_FETCH_DESC", group=C, style="filled", fillcolor="white"];
    load  [label="Working Registers (flops), loaded leaving CH_FETCH_DESC\nr_*_beats_remaining = beats;  address = byte address", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    adv   [label="Advance on each done strobe (flops)\naddr = (addr & ~(BYTE_LANES-1)) + beats_done * BYTE_LANES;\nremaining -= beats_done", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    ext   [label="TYPE=EXT: rows counted in beats;\naddresses beat-aligned and lengths\nbeat multiples (by design)", fillcolor="white", group=R, style="rounded,filled", fillcolor="#E2EFDA"];
    bar   [label="Outputs\nsched_*_beats = remaining, sched_*_addr = working address (to the engines)   |   sched_*_pkt_valid pulse with {length, offset} (to the data path)", fillcolor="white", width=11.0, group=C, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    in   -> math [label="length, address"];
    math -> gate [label="beats, offset"];
    gate -> load [label="record accepted"];
    load -> adv  [label="beats remaining, address"];
    adv  -> bar  [xlabel="beat command\n(CH_XFER_DATA)", penwidth=1.8];
    gate -> bar  [style=dashed, color="#777777", constraint=false, xlabel="packet record"];
    math -> ext  [style=dashed, color="#777777", xlabel="EXT"];
    { rank=same; math; ext; }
}
