// Byte-granular RAPIDS scheduler_group_array (rtl/macro/scheduler_group_array.sv)
// with SHARED_ENGINES = 1 (the default): 8 schedulers, ONE descriptor engine,
// ONE ctrlrd engine and ONE ctrlwr engine for the array. Each engine picks
// among the schedulers round-robin and owns its AXI master (no AXI-side
// arbiters). The SHARED_ENGINES = 0 structure (per-channel engines inside
// scheduler groups, AXI-side arbiters) is figure 11_shared_master_arbitration.
// Flow geography:
//   kick / descriptors - kick enters top-left, the descriptor engine fetches
//                        and hands descriptors up to the schedulers
//   control ops        - schedulers -> ctrl engines, down the middle and right
//   data path          - schedulers -> boundary bar, center lane
digraph scheduler_group_array {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.30", ranksep="0.75", splines=ortho,
           label="scheduler_group_array, SHARED_ENGINES = 1 - 8 schedulers, ONE of each engine\narbitration on the scheduler side; each engine owns its AXI master (clk, rst_n)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    kick  [label="Kick (8 channels)\napb_valid / apb_addr", fillcolor="white", group=L, style="rounded,filled", fillcolor="#E2EFDA"];
    cfgin [label="Scheduler Configuration\ncfg_channel_enable / reset, timeouts", fillcolor="white", group=C, style="rounded,filled", fillcolor="#E2EFDA"];

    sch   [label="Schedulers - 8 x scheduler (one per channel)\ndescriptors in; data-path commands, packet records\nand control requests out", width=7.5, group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];

    deng  [label="descriptor_engine_shared\nround-robin AR issue,\nARID = channel; R routed\nby RID to the channel FIFO", width=4.4, group=L, style="filled", fillcolor="white"];
    crd   [label="ctrlrd_engine_shared\nround-robin pick,\none ctrlrd_engine,\nARID = owner", group=G1, style="filled", fillcolor="white"];
    cwr   [label="ctrlwr_engine_shared\nround-robin pick,\none ctrlwr_engine,\nAWID = owner", group=R, style="filled", fillcolor="white"];
    mon   [label="Observers + MonBus\n(sideband)\ndesc-port monitor +\nbus meter; monbus_arbiter\n12:1: 8 schedulers,\ndesc monitor, 3 engines", style="filled,dashed", group=M, peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];

    bar [label="Array Boundary\nm_axi_desc AR / R (256-bit)  |  sched_*, sched_*_pkt_* (data path)\nm_axi_ctrlrd AR / R  |  m_axi_ctrlwr AW / W / B  |  mon_*",
         fillcolor="white", width=11.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    // kick and descriptors, left lane
    p_k [shape=point, width=0.01, group=L];
    kick -> p_k [arrowhead=none];
    p_k  -> deng [xlabel="kick address\n(per channel)"];
    sch  -> deng [dir=back, xlabel="descriptors\n(per channel)"];
    p_d  [shape=point, width=0.01, group=L];
    deng -> p_d  [dir=back, headclip=false, penwidth=1.8];
    p_d  -> bar  [xlabel="AR out,\nR back", tailclip=false, penwidth=1.8];

    // configuration, center
    cfgin -> sch [label="cfg (per channel)"];

    // control requests, middle and right
    sch -> crd [xlabel="CTRL_READ\nrequests (8)"];
    sch -> cwr [xlabel="CTRL_WRITE\nrequests (8)"];
    p_cr [shape=point, width=0.01, group=G1];
    crd  -> p_cr [dir=back, headclip=false, penwidth=1.8];
    p_cr -> bar  [xlabel="AR out,\nR back", tailclip=false, penwidth=1.8];
    p_cw [shape=point, width=0.01, group=R];
    cwr  -> p_cw [dir=back, headclip=false, penwidth=1.8];
    p_cw -> bar  [xlabel="AW + W out,\nB back", tailclip=false, penwidth=1.8];

    // data path, center lane
    p_cmd [shape=point, width=0.01, group=C];
    sch   -> p_cmd [dir=back, headclip=false];
    p_cmd -> bar   [xlabel="data-path commands +\npacket records;\nstrobes back", tailclip=false];

    // monitor
    mon -> bar [dir=both, style=dashed, color="#777777", xlabel="observes desc\nAR / R; mon_* out"];

    // rank pinning
    { rank=same; kick; cfgin; }
    kick -> cfgin [style=invis];
    { rank=same; p_k; }
    { rank=same; deng; p_cmd; crd; cwr; mon; }
    deng -> p_cmd -> crd -> cwr -> mon [style=invis];
    { rank=same; p_d; p_cr; p_cw; }
}
