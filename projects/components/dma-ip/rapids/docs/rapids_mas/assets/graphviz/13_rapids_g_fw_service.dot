// render: no-key (decision-tree / process-flow vocabulary, not the element key)
// rapids-g firmware, step(): the executive's dispatch into the policy table
// (rapids TASK-037). Blue actions, every arrow labeled. Each row box lists its
// events in priority order; the first that holds picks the handler, which does
// one step and returns to the poll.
// Verified against rtl/fw_g/sched_g.S (step, ptab, row_xfer, row_complete,
// row_idle, row_next, row_fetch, fetch_error, fetch_start, judge_head,
// ext_start, ext_refill, fw_fault).
digraph rapids_g_fw_step {
    graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.3", ranksep="0.9", splines=ortho, newrank=true,
           label=<<B>rapids-g firmware: step(channel), one handler from the policy table</B>>,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.14,0.08"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    rd  [label="step(channel)\nfrom the poll: attention,\nno open head\l\lread STATUS; jalr through\nptab on the one-hot state\n(4 instructions)"];
    ret [shape=ellipse, fillcolor="white", label="return to the poll\n(next pass:\nthe slot's next step)"];

    hx [label="XFER_DATA row\l not armed (never): fw_fault\l GEN_NEED: ext_start (CMD GEN_OK, then set up\l     and prefill the run bases)\l EXT, bases not all out: ext_refill (top up both\l     FIFOs from one STATUS snapshot)\l then: return to the poll\l"];
    hc [label="COMPLETE row\l armed: nothing (the hardware leaves COMPLETE)\l not armed (never): fw_fault\l then: return to the poll\l"];
    hn [label="IDLE / NEXT_DESC row\l disabled, head staged, or no head: nothing\l head declined: fetch_start (CMD FETCH_DESC)\l head open: judge_head (stage armed, or decline)\l then: return to the poll\l"];
    hf [label="FETCH_DESC row\l tile_bad or invalid: fetch_error (CMD CH_ERROR)\l start pending: nothing\l valid (never): fw_fault\l then: return to the poll\l"];
    he [label="CH_ERROR, or not a state\l nothing (a channel reset leaves CH_ERROR)\l then: return to the poll\l"];
    ff [label="fw_fault: a state the policy never creates\l firmware error packet carrying STATUS,\l then CMD CH_ERROR; return to the poll\l"];

    rd -> hx;   // labeled by the row box title (its state)
    rd -> hc;   // labeled by the row box title (its state)
    rd -> hn;   // labeled by the row box title (its state)
    rd -> hf;   // labeled by the row box title (its state)
    rd -> he;   // labeled by the row box title (its state)
    hx -> ret;   // labeled by the box last line
    hc -> ret;   // labeled by the box last line
    hn -> ret;   // labeled by the box last line
    hf -> ret;   // labeled by the box last line
    he -> ret;   // labeled by the box last line
    ff -> ret;   // labeled by the box last line

    { rank=same; hx; hc; hn; hf; he; ff; }
}
