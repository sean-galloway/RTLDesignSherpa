// Channel arbitration for a shared AXI port - plain round-robin, no priority (one per shared port, per half) -- generated by the RAPIDS doc arbitration template.
digraph rapids_beats_channel_arbitration {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.55", splines=ortho,
           label="Channel arbitration onto a shared AXI port\nplain round-robin, no priority; one arbiter per shared port, per half", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    c0 [label="Channel 0"];
    c1 [label="Channels 1 .. 6"];
    c7 [label="Channel 7"];
    arb [label="Round-Robin Arbiter - arbiter_round_robin (CLIENTS = 8)\nwinner = next requester after the last grant; grant held until acked", shape=invtrapezium, width=6.4, height=0.8, fillcolor="#BFD7EE"];
    bar [label="Shared AXI address channel\ndescriptor AR (u_desc_ar_arbiter), ctrl-read AR, ctrl-write AW,\nread-engine AR, write-engine AW", fillcolor="white", width=6.4];

    c0 -> arb [label="request (ch 0)"];
    c1 -> arb [label="request (ch 1-6)"];
    c7 -> arb [label="request (ch 7)"];
    arb -> bar [label="grant: one channel (grant_id)", penwidth=1.8];
    { rank=same; c0; c1; c7; }
    c0 -> c1 -> c7 [style=invis];
}
