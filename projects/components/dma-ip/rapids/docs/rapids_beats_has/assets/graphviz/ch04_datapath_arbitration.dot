// Data-path AXI arbitration inside the read and write engines - plain round-robin (no priority boost) -- generated by the RAPIDS doc arbitration template.
digraph rapids_beats_datapath_arbitration {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.55", splines=ortho,
           label="Data-path AXI arbitration inside the read and write engines\nplain round-robin, no priority boost", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    c0 [label="Channel 0"];
    c1 [label="Channels 1 .. 6"];
    c7 [label="Channel 7"];
    arb [label="Round-Robin Arbiter - arbiter_round_robin\n(one in each read / write engine)\ngrant held until AXI accepts the AR / AW", shape=invtrapezium, width=6.4, height=0.8, fillcolor="#BFD7EE"];
    bar [label="AXI Data Master\nm_axi_rd (source half: AR)   |   m_axi_wr (sink half: AW + W)", fillcolor="white", width=6.4];

    c0 -> arb [label="burst request (ch 0)"];
    c1 -> arb [label="burst request (ch 1-6)"];
    c7 -> arb [label="burst request (ch 7)"];
    arb -> bar [label="granted channel issues one burst", penwidth=1.8];
    { rank=same; c0; c1; c7; }
    c0 -> c1 -> c7 [style=invis];
}
