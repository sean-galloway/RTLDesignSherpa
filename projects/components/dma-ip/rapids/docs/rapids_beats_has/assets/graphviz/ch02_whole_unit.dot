// RAPIDS Beats whole unit (rapids_beats_top), in the house block-diagram form.
// Flow geography:
//   sink write data   - enters s_axis top-left, drops down the LEFT lane to memory
//   command / control - APB kick down the CENTER: regs -> scheduler groups ->
//                       descriptor/control arbiter -> memory (heavy)
//   source read data  - re-enters at the bar and climbs the RIGHT lane to m_axis
// Scheduler commands reach the two engines one rank down (no same-rank edges).
// Verified against rtl/top_beats/rapids_beats_top.sv, rtl/macro_beats/*.sv.
digraph rapids_beats_whole_unit {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.75", splines=ortho,
           label="RAPIDS Beats whole unit - rapids_beats_top / rapids_beats_cxs_top (single clock: clk, rst_n)\nsink: AXIS -> memory down the left; source: memory -> AXIS up the right; descriptors and control down the center",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external ports (white) ----
    s_axis [label="Network In\ns_axis_* (AXIS top) or s_cxs_* (CXS top)\ntid / CXSSRCID = channel", fillcolor="white", group=L, style="rounded,filled", fillcolor="#E2EFDA"];
    s_apb  [label="Host Configuration - s_apb_*\n(APB4 slave)", fillcolor="white", group=C, style="rounded,filled", fillcolor="#E2EFDA"];
    m_axis [label="Network Out\nm_axis_* (AXIS top) or m_cxs_* (CXS top)\ntid / CXSSRCID = channel", fillcolor="white", group=R, style="rounded,filled", fillcolor="#E2EFDA"];

    // ---- rank 1 ----
    // ---- network planes (rtl/plane): the top's module names pick AXIS or CXS ----
    plane_rx [label="Sink Network Plane (RX)\nrapids_plane_axis_rx | rapids_plane_cxs_rx\nendpoint + monitor-lite (packets to\nthe sink half's MonBus, client 1)", group=L, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    plane_tx [label="Source Network Plane (TX)\nrapids_plane_axis_tx | rapids_plane_cxs_tx\nendpoint + monitor-lite (packets to\nthe source half's MonBus, client 1)", group=R, peripheries=2, style="filled", fillcolor="#D6E4F0"];

    ingress [label="Sink Ingress\nsnk_data_path_axis_beats\n(tid picks the channel FIFO)", group=L, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    regs    [label="Registers + Config Mapping\napb4_slave -> rapids_regs (PeakRDL)\n-> rapids_config_block x 2 (src, snk)\ncfg_* sideband to every block", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    egress  [label="Source Egress (round-robin channel pick)\nsrc_data_path_axis_beats",
             shape=trapezium, width=3.4, height=0.6, group=R, style="filled", fillcolor="#FFF2CC"];

    // ---- rank 2 ----
    snk_sram [label="Sink SRAM Buffer\nsnk_sram_controller_beats\n(8 per-channel FIFOs)", height=0.9, group=L, shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    sga      [label="Scheduler Group Arrays\nscheduler_group_array_beats x 2 (sink, source)\neach 8 x scheduler_group_beats:\ndescriptor_engine_beats + scheduler_beats\n+ ctrlrd_engine + ctrlwr_engine", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    src_sram [label="Source SRAM Buffer\nsrc_sram_controller_beats\n(8 per-channel FIFOs)", height=0.9, group=R, shape=cylinder, style="filled", fillcolor="#E8DFF5"];

    // ---- rank 3 ----
    wr_eng [label="AXI Write Engine\naxi_write_engine_beats\n(round-robin over channels)", group=L, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    arb    [label="Descriptor / Control Arbiters\narbiter_round_robin x 3 per half",
            shape=invtrapezium, width=4.2, fillcolor="#BFD7EE", group=C, style="filled", fillcolor="#FFF2CC"];
    mon    [label="Monitor Bus\nmonbus_arbiter tree (group,\narray, half, core) ->\nmonbus_axil4_group_1wr", style="filled,dashed", peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];
    rd_eng [label="AXI Read Engine\naxi_read_engine_beats\n(round-robin over channels)", group=R, peripheries=2, style="filled", fillcolor="#D6E4F0"];

    // ---- boundary bar ----
    mem [label="System Memory / AXI interconnect\nm_axi_wr (AW, W / B)  |  m_axil_mon, mon_irq, mon_err_rec_count  |  src_/snk_ m_axi_desc, m_axi_ctrlrd, m_axi_ctrlwr  |  m_axi_rd (AR / R)",
         fillcolor="white", width=17.0, fontsize=11, group=C, shape=cylinder, style="filled", fillcolor="#E8DFF5"];

    // ---- sink write data, down the left ----
    s_axis   -> plane_rx [label="network packets in"];
    plane_rx -> ingress  [label="packet beats (AXIS)"];
    ingress  -> snk_sram [label="fill beats\n(per channel)"];
    snk_sram -> wr_eng   [label="drain beats"];

    // ---- command / control, down the center ----
    s_apb -> regs [label="register R/W"];
    regs  -> sga  [label="kick: descriptor address\n(CHn_DESC_ADDR + KICK_ENABLE)"];
    sga   -> arb  [label="desc fetch / ctrl RD / ctrl WR\n(8 channels)"];
    sga   -> wr_eng [xlabel="write cmd: addr,\nbeats (sink half)"];
    sga   -> rd_eng [xlabel="read cmd: addr,\nbeats (source half)"];
    sga   -> mon    [style=dashed, color="#777777", xlabel="monitor\npackets"];

    // ---- source read data, up the right ----
    m_axis   -> plane_tx [dir=back, label="network packets out"];
    plane_tx -> egress   [dir=back, label="packet beats, tlast"];
    egress   -> src_sram [dir=back, label="drain beats"];
    src_sram -> rd_eng   [dir=back, label="R data\n(per channel)"];

    // ---- bar crossings via point scaffolds (one node pair per crossing) ----
    p_wr  [shape=point, width=0.01, group=L];
    p_cmd [shape=point, width=0.01, group=C];
    p_dr  [shape=point, width=0.01];
    p_ar  [shape=point, width=0.01, group=R];
    p_rd  [shape=point, width=0.01];
    sp1 [style=invis, label="", fixedsize=true, width=1.2, height=0.02];
    sp2 [style=invis, label="", fixedsize=true, width=1.2, height=0.02];
    sp3 [style=invis, label="", fixedsize=true, width=0.9, height=0.02];
    { rank=same; p_wr; p_cmd; sp1; p_dr; sp2; p_ar; sp3; p_rd; }
    p_wr -> p_cmd -> sp1 -> p_dr -> sp2 -> p_ar -> sp3 -> p_rd [style=invis];

    wr_eng -> p_wr  [arrowhead=none, headclip=false];
    p_wr   -> mem   [xlabel="Write to memory\n(AW + W, B back)", tailclip=false];
    arb    -> p_cmd [arrowhead=none, headclip=false, penwidth=1.8];
    p_cmd  -> mem   [xlabel="descriptor fetch, control\nread / write (AR, AW, W)", penwidth=1.8, tailclip=false];
    sga    -> p_dr  [dir=back, xlabel="descriptors, ctrl\nread data (R), B", headclip=false];
    p_dr   -> mem   [dir=none, tailclip=false];
    mon    -> mem   [style=dashed, color="#777777", xlabel="capture writes,\nerror drain, mon_irq"];
    rd_eng -> p_ar  [arrowhead=none, headclip=false];
    p_ar   -> mem   [xlabel="Read request (AR)", tailclip=false];
    rd_eng -> p_rd  [dir=back, headclip=false];
    p_rd   -> mem   [dir=none, xlabel="Read from\nmemory (R)", tailclip=false];

    // ---- rank pinning ----
    { rank=same; s_axis; s_apb; m_axis; }
    s_axis -> s_apb -> m_axis [style=invis];
    { rank=same; plane_rx; plane_tx; }
    plane_rx -> plane_tx [style=invis];
    { rank=same; ingress; regs; egress; }
    ingress -> regs -> egress [style=invis];
    { rank=same; snk_sram; sga; src_sram; }
    snk_sram -> sga -> src_sram [style=invis];
    { rank=same; wr_eng; arb; mon; rd_eng; }
    wr_eng -> mon -> arb -> rd_eng [style=invis];
}
