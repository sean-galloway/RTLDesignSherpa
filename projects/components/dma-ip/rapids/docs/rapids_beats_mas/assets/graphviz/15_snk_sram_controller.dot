// snk_sram_controller_beats - naming wrapper over STREAM sram_controller (single clock: clk, rst_n)
// STREAM rtl/fub/sram_controller.sv: 8 independent per-channel units behind
// an ID decode on the fill side and an ID mux on the drain side; the
// per-channel availability vectors are flopped on the way out. snk_sram_controller_beats only renames the ports.
digraph snk_sram_controller_beats {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.50", ranksep="0.55", splines=ortho,
           label="snk_sram_controller_beats - naming wrapper over STREAM sram_controller (single clock: clk, rst_n)", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    fill  [label="Fill Side - sink ingress (snk_data_path_axis_beats)\nfill_alloc_req / size / id; fill_valid / id / data", fillcolor="white", group=C, style="rounded,filled", fillcolor="#E2EFDA"];
    dec   [label="Fill Decode (combinational)\nalloc_id and sram_id select the channel;\nready muxed back from that channel", group=C, style="filled", fillcolor="white"];
    units [label="Per-Channel Units - 8 x sram_controller_unit\neach: stream_alloc_ctrl (space) + gaxi_fifo_sync (SRAM_DEPTH beats)\n+ stream_drain_ctrl (data) + stream_latency_bridge (see its figure)", width=6.5, height=0.9, group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    mux   [label="Drain Mux (combinational)\nsram_id selects the channel's data", group=C, style="filled", fillcolor="white"];
    stat  [label="Availability Registers (flops)\nspace_free[8], data_avail[8], valid[8]\n(one cycle late, for timing)", group=R, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    drain [label="Drain Side - AXI write engine (axi_write_engine_beats)\ndrain_req / size per channel  |  data_avail, valid per channel  |  drain + id -> data", fillcolor="white", width=8.0, group=C, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    fill  -> dec   [label="alloc request; fill beats (one bus)", penwidth=1.8];
    dec   -> units [label="per-channel alloc + write enable", penwidth=1.8];
    units -> mux   [label="per-channel beats", penwidth=1.8];
    mux   -> drain [label="selected channel's beats", penwidth=1.8];
    units -> stat  [style=dashed, color="#777777", xlabel="space, data counts"];
    stat  -> drain [style=dashed, color="#777777", xlabel="data_avail[8],\nvalid[8]"];
    fill  -> stat  [dir=back, style=dashed, color="#777777", constraint=false, xlabel="space_free[8]"];
    p_dr  [shape=point, width=0.01, group=L];
    { rank=same; p_dr; mux; }
    p_dr -> mux [style=invis];
    units -> p_dr [dir=back, style=dashed, color="#777777", xlabel="drain_req + size\n(per channel)"];
    p_dr -> drain [dir=none, style=dashed, color="#777777"];
}
