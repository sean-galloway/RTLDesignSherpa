// Same figure as rapids_beats_has/assets/graphviz/ch02_top_integration.dot (kept in step by hand).
// rapids_beats_top / rapids_beats_cxs_top integration: what the top adds
// around rapids_core_beats. The tops are generated (bin/gen_plane_tops.py)
// from rapids_beats_top_base + two network planes; the plane module names
// pick AXIS or CXS.
// Center: APB register path (request flow) into the core.
// Left: sink ingress drops through the RX plane into the core; right: source
// egress climbs out through the TX plane.
// Bottom bar: the memory-side masters and the monitor outputs.
// Verified against rtl/top_beats/rapids_beats_top_base.sv, rtl/plane/*.sv.
digraph rapids_beats_top_integration {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.55", splines=ortho,
           label="rapids_beats_top / rapids_beats_cxs_top - network planes, registers, configuration and monitor egress around rapids_core_beats\n(single clock: aclk, aresetn)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    s_axis [label="Network In\ns_axis_* (AXIS top) or\ns_cxs_* (CXS top, credits granted)", fillcolor="white", group=L, style="rounded,filled", fillcolor="#E2EFDA"];
    s_apb  [label="Host Configuration - s_apb_*\n(APB4 slave)", fillcolor="white", group=C, style="rounded,filled", fillcolor="#E2EFDA"];
    m_axis [label="Network Out\nm_axis_* (AXIS top) or\nm_cxs_* (CXS top, credits received)", fillcolor="white", group=R, style="rounded,filled", fillcolor="#E2EFDA"];

    plane_rx [label="Sink Network Plane (RX)\nrapids_plane_axis_rx | rapids_plane_cxs_rx\nendpoint + monitor-lite; its packets\njoin the core MonBus (client 1)", group=L, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    plane_tx [label="Source Network Plane (TX)\nrapids_plane_axis_tx | rapids_plane_cxs_tx\nendpoint + monitor-lite; its packets\njoin the core MonBus (client 1)", group=R, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    apb    [label="APB Slave + Register Adapter\napb4_slave -> peakrdl_to_cmdrsp", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    regs   [label="Register Block - rapids_regs (PeakRDL)\nSRC block 0x0000, SNK block 0x1000;\neach: kick 0x000-0x040, engine config 0x100+,\nMON regfile", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    meters [label="Data-Master Bus Meters (sideband)\naxi_bus_meter x 2: observe m_axi_rd R and\nm_axi_wr W, nothing driven back;\nperf counts read back through rapids_regs", style="filled,dashed", peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];
    cfg    [label="Configuration Mapping\nrapids_config_block x 2 (u_cfg_src, u_cfg_snk)\nhwif_out -> cfg_* per half", group=C, style="filled", fillcolor="white"];
    core   [label="RAPIDS Beats Core - rapids_core_beats\nsource half + sink half (see the whole-unit figure)", width=6.5, height=0.8, group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    mon    [label="Monitor Egress (USE_AXI_MONITORS=1 only)\nmonbus_axil4_axil4_group:\nerror FIFO + capture writer + irq", style="filled,dashed", peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];

    bar [label="Module Boundary\ns_axil_err, m_axil_mon, mon_irq  |  m_axi_wr (AW, W / B)  |  src_/snk_ m_axi_desc, m_axi_ctrlrd, m_axi_ctrlwr  |  m_axi_rd (AR / R)\nCXS top only: src_/snk_cxs_link_state, *_cxs_protocol_error, snk_cxs_unsupported (from the planes)",
         fillcolor="white", width=13.0, fontsize=11, group=C, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    // ---- register path, down the center ----
    s_apb -> apb  [label="APB transfer"];
    apb   -> regs [label="register req / rsp"];
    regs  -> cfg  [label="hwif_out (SRC, SNK)"];
    cfg   -> core [label="cfg_*, kick\n(descriptor address)", penwidth=1.8];

    // ---- network data, through the planes ----
    s_axis   -> plane_rx [xlabel="network packets in\n(AXIS beats, or CXS flits\nwith CXSSRCID = channel)"];
    plane_rx -> core     [xlabel="packet beats\n(AXIS, tid = channel)"];
    m_axis   -> plane_tx [dir=back, xlabel="network packets out\n(AXIS beats, or CXS flits\nwith CXSSRCID = channel)"];
    plane_tx -> core     [dir=back, xlabel="packet beats\n(AXIS, tid = channel)"];

    // ---- core status back up to the registers ----
    regs -> core [dir=back, style=dashed, color="#777777", constraint=false, xlabel="status:\nidle, state,\nerrors"];

    // ---- monitor egress ----
    core -> mon [style=dashed, color="#777777", xlabel="merged MonBus\n(core_mon_*)"];

    // ---- boundary crossings (one scaffold per crossing) ----
    p_wr  [shape=point, width=0.01, group=L];
    p_ctl [shape=point, width=0.01, group=C];
    p_ar  [shape=point, width=0.01];
    p_r   [shape=point, width=0.01, group=R];
    s1 [style=invis, label="", fixedsize=true, width=1.0, height=0.02];
    s2 [style=invis, label="", fixedsize=true, width=0.6, height=0.02];
    { rank=same; p_wr; p_ctl; s1; p_ar; s2; p_r; }
    p_wr -> p_ctl -> s1 -> p_ar -> s2 -> p_r [style=invis];

    core -> p_wr  [arrowhead=none, headclip=false];
    p_wr -> bar   [xlabel="Write to memory\n(AW + W, B back)", tailclip=false];
    core -> p_ctl [arrowhead=none, headclip=false, dir=both, arrowtail=normal];
    p_ctl -> bar  [xlabel="descriptor fetch, control rd / wr\n(AR, AW, W out; R, B back)", tailclip=false];
    core -> p_ar  [arrowhead=none, headclip=false];
    p_ar -> bar   [xlabel="Read request (AR)", tailclip=false];
    core -> p_r   [dir=back, headclip=false];
    p_r  -> bar   [dir=none, xlabel="Read from\nmemory (R)", tailclip=false];
    mon  -> bar   [style=dashed, color="#777777", xlabel="error drain, capture\nwrites, mon_irq"];

    { rank=same; s_axis; s_apb; m_axis; }
    s_axis -> s_apb -> m_axis [style=invis];
    { rank=same; plane_rx; regs; plane_tx; meters; }
    plane_rx -> regs -> plane_tx -> meters [style=invis];
    { rank=same; p_wr; mon; }
}
