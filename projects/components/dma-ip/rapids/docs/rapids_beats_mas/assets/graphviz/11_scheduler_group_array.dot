// scheduler_group_array_beats (rtl/macro_beats/scheduler_group_array_beats.sv):
// 8 scheduler groups, three round-robin arbiters onto shared AXI masters,
// responses routed back by ID, a descriptor-port monitor and bus meter, and
// a 9:1 monbus_arbiter.
digraph scheduler_group_array_beats {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.60", splines=ortho,
           label="scheduler_group_array_beats - one half's 8 channels and shared control masters (single clock: clk, rst_n)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    kick  [label="Kick + Configuration (8 channels)\napb_valid / apb_addr per channel, cfg_*", fillcolor="white", group=C];
    grp   [label="Scheduler Groups - 8 x scheduler_group_beats\n(see its figure): descriptor engine, scheduler,\nctrlrd engine, ctrlwr engine per channel", width=9.5, group=C];

    crarb [label="Ctrl-Read AR Pick\nround-robin, 8:1", shape=invtrapezium, width=2.4, fillcolor="#BFD7EE", group=G1];
    darb  [label="Descriptor AR Pick\nround-robin, 8:1", shape=invtrapezium, width=2.4, fillcolor="#BFD7EE", group=G2];
    cwarb [label="Ctrl-Write AW Pick\nround-robin, 8:1\n(one write in flight)", shape=invtrapezium, width=2.6, fillcolor="#BFD7EE", group=R];
    rsp   [label="Response Router\ndesc R and ctrlrd R by RID[2:0];\nctrlwr B to the channel in flight", group=RR];
    mon   [label="Observers + MonBus (sideband)
axi4_master_rd_monlite (USE_AXI_MONITORS=1)
and axi_bus_meter watch the descriptor port;
monbus_arbiter 9:1 merges 8 group streams
and the monitor into mon_*", style="filled,dashed", group=M];

    bar [label="Array Boundary\nm_axi_ctrlrd AR / R  |  sched_rd_*, sched_wr_* (data path)  |  m_axi_desc AR / R (256-bit)\nm_axi_ctrlwr AW / W / B  |  mon_*",
         fillcolor="white", width=15.2];

    kick  -> grp   [label="kick, cfg (per channel)"];
    grp   -> crarb [xlabel="ctrlrd AR (8)"];
    grp   -> darb  [label="desc AR (8)"];
    grp   -> cwarb [xlabel="ctrlwr AW + W (8)"];
    p_cr [shape=point, width=0.01, group=G1];
    crarb -> p_cr [arrowhead=none, penwidth=1.8];
    p_cr -> bar [xlabel="AR", penwidth=1.8];
    p_d [shape=point, width=0.01, group=G2];
    darb -> p_d [arrowhead=none, penwidth=1.8];
    p_d -> bar [xlabel="AR", penwidth=1.8];
    p_cw [shape=point, width=0.01, group=R];
    cwarb -> p_cw [arrowhead=none, penwidth=1.8];
    p_cw -> bar [xlabel="AW + W", penwidth=1.8];
    { rank=same; p_cr; p_d; p_cw; mon; }
    grp   -> rsp   [dir=back, xlabel="R / B to the\nowning channel"];
    rsp   -> bar   [dir=back, xlabel="R (desc, ctrlrd), B"];
    mon   -> bar   [dir=both, style=dashed, xlabel="observes desc\nAR / R; mon_* out"];

    p_cmd [shape=point, width=0.01, group=X];
    { rank=same; p_cmd; crarb; darb; cwarb; }
    grp -> p_cmd [arrowhead=none];
    p_cmd -> bar [dir=both, xlabel="data-path commands;\nstrobes back"];
    crarb -> p_cmd [style=invis];
    p_cmd -> darb [style=invis];
    darb -> cwarb [style=invis];
    rsp -> mon [style=invis];
    p_cw -> mon [style=invis];
}
