// perf_profiler (stream/rtl/fub/perf_profiler.sv): watches each channel's idle
// signal, records start/end timestamps or elapsed times into a FIFO that
// software pops through the registers.
digraph perf_profiler {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.50", ranksep="0.50", splines=ortho,
           label="perf_profiler - per-channel activity capture (single clock: clk, rst_n; an observer, nothing driven back)", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    idle  [label="Channel Idle Taps\nchannel_idle[NUM_CHANNELS] (observed)", fillcolor="white"];
    cfg   [label="Configuration\ncfg_enable, cfg_mode (0 timestamp, 1 elapsed), cfg_clear", fillcolor="white"];
    ts    [label="Timestamp Counter (flops)\nfree-running while enabled, wraps at 2^32"];
    edge_ [label="Edge Detect (flops + combinational)\nidle -> active: start;  active -> idle: end"];
    start [label="Start Times (flops, per channel)\nelapsed mode only"];
    pick  [label="Channel Pick - priority encoder\nlowest channel with an event this cycle", shape=invtrapezium, width=4.5, fillcolor="#BFD7EE"];
    fifo  [label="Event FIFO - gaxi_fifo_sync\n{event type, channel, timestamp or elapsed}"];
    bar   [label="Register Read-Back\nperf_fifo_rd in  |  perf_fifo_data_low / _high, empty, full, count out", fillcolor="white", width=7.5];

    idle  -> edge_ [label="idle bits"];
    cfg   -> ts    [style=dashed, xlabel="enable, clear"];
    edge_ -> pick  [xlabel="start / end\nevents"];
    ts    -> start [label="timestamp"];
    edge_ -> start [style=dashed, label="capture on start"];
    start -> pick  [label="elapsed = now - start"];
    pick  -> fifo  [label="one event per cycle", penwidth=1.8];
    fifo  -> bar   [dir=both, label="entry out; pop in"];
    { rank=same; idle; cfg; }
    { rank=same; edge_; ts; }
}
