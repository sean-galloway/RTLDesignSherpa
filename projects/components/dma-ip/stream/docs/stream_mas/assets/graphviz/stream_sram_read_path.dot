// STREAM sram_controller read path (replaces an ASCII sketch). Event
// timeline, not to scale: one column per event. Source of truth:
// rtl/fub/sram_controller_unit.sv (drain accounting counter, stream_latency_bridge
// over the gaxi_fifo_sync read port) and sram_controller.sv (id decode,
// registered axi_wr_sram_valid).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph stream_sram_read_path {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="SRAM controller read path (channel FIFO out to AXI W data): reserve,\ndrain, release", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="170" BORDER="0" ALIGN="RIGHT"><B>event</B></TD><TD WIDTH="180" BORDER="0"><B>1</B></TD><TD WIDTH="180" BORDER="0"><B>2</B></TD><TD WIDTH="180" BORDER="0"><B>3</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">what happens</TD><TD COLSPAN="1" WIDTH="180" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white"><B>drain request</B></TD><TD COLSPAN="1" WIDTH="180" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white"><B>AW issued</B></TD><TD COLSPAN="1" WIDTH="180" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white"><B>write engine drains</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">axi_wr_drain_req[2]</TD><TD COLSPAN="1" WIDTH="180" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">1 cycle,<BR/>size = 2</TD><TD COLSPAN="2" WIDTH="360" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">0</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">drain_data_avail[2]</TD><TD COLSPAN="1" WIDTH="180" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">avail - 2 (reserved)</TD><TD COLSPAN="2" WIDTH="360" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">avail - 2</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">axi_wr_sram_drain, id = 2</TD><TD COLSPAN="2" WIDTH="360" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD><TD COLSPAN="1" WIDTH="180" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">2 beats</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">axi_wr_sram_data</TD><TD COLSPAN="2" WIDTH="360" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD><TD COLSPAN="1" WIDTH="180" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">D0, D1 from the<BR/>latency bridge</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">alloc_space_free[2]</TD><TD COLSPAN="2" WIDTH="360" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">unchanged</TD><TD COLSPAN="1" WIDTH="180" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">+1 per beat out</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="3" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The write engine reserves data before it issues the AW, so the W beats are already<BR ALIGN="LEFT"/>buffered. The latency bridge hides the FIFO&#x27;s 1-cycle read latency: it keeps the head<BR ALIGN="LEFT"/>beat (and a small prefetch) ready so valid and data are aligned when the engine drains.<BR ALIGN="LEFT"/>Each beat out returns one entry to the allocation side.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
