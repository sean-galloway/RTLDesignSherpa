// STREAM sram_controller write path (replaces an ASCII sketch). Event
// timeline, not to scale: one column per event. Source of truth:
// rtl/fub/sram_controller_unit.sv (stream_alloc_ctrl and the drain accounting
// counter, gaxi_fifo_sync, registered space_free / data_avail outputs).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph stream_sram_write_path {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="SRAM controller write path (AXI R data into the channel FIFO): reserve,\nfill, release", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="170" BORDER="0" ALIGN="RIGHT"><B>event</B></TD><TD WIDTH="150" BORDER="0"><B>1</B></TD><TD WIDTH="150" BORDER="0"><B>2</B></TD><TD WIDTH="150" BORDER="0"><B>3</B></TD><TD WIDTH="150" BORDER="0"><B>4</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">what happens</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white"><B>alloc request</B></TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white"><B>AR issued</B></TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white"><B>R beats arrive</B></TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white"><B>beats leave on<BR/>the W side</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">axi_rd_alloc_req</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">1 cycle, id = 2,<BR/>size = 4</TD><TD COLSPAN="3" WIDTH="450" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">0</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">axi_rd_sram_valid / ready</TD><TD COLSPAN="2" WIDTH="300" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">4 beats, id = 2;<BR/>ready while FIFO<BR/>has room</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">FIFO[2] occupancy</TD><TD COLSPAN="2" WIDTH="300" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">0</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">+1 per beat<BR/>(to 4)</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">-1 per beat out</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">alloc_space_free[2]</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">S - 4 (reserved)</TD><TD COLSPAN="2" WIDTH="300" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">S - 4</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">+1 per beat out</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="36">drain_data_avail[2]</TD><TD COLSPAN="2" WIDTH="300" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">0</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">+1 per beat in</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="36" FIXEDSIZE="FALSE" BGCOLOR="white">less any<BR/>drain reservation</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="4" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The read engine reserves space BEFORE it issues the AR, so the R beats always find room.<BR ALIGN="LEFT"/>Space comes back only when a beat leaves the controller on the write-engine side,<BR ALIGN="LEFT"/>not when it lands in the FIFO. Both counters reach the engines through registered outputs.<BR ALIGN="LEFT"/>Beat arrival time is set by the memory&#x27;s read latency, not by the controller.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
