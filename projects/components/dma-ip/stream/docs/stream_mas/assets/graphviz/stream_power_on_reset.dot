// STREAM power-on reset sequence (replaces an ASCII sketch). Phase
// timeline: one column per step group of the recommended sequence in
// ch01_overview/03_clocks_and_reset.md.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph stream_power_on_reset {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="STREAM power-on reset: steps 1-8 of the recommended sequence", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="120" BORDER="0" ALIGN="RIGHT"><B>step</B></TD><TD WIDTH="104" BORDER="0"><B>1-3</B></TD><TD WIDTH="104" BORDER="0"><B>4</B></TD><TD WIDTH="104" BORDER="0"><B>5</B></TD><TD WIDTH="104" BORDER="0"><B>6</B></TD><TD WIDTH="104" BORDER="0"><B>7</B></TD><TD WIDTH="104" BORDER="0"><B>8</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">phase</TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>assert</B></TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>hold</B></TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>release<BR/>APB</B></TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>release<BR/>core</B></TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>settle</B></TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>configure</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">aclk, pclk</TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">stable</TD><TD COLSPAN="5" WIDTH="520" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">running</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">presetn</TD><TD COLSPAN="2" WIDTH="208" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="416" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">aresetn</TD><TD COLSPAN="3" WIDTH="312" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="3" WIDTH="312" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">duration</TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">10 aclk<BR/>cycles</TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">on a pclk<BR/>rising edge</TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">on an aclk<BR/>rising edge</TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">5 aclk<BR/>cycles</TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">APB access</TD><TD COLSPAN="5" WIDTH="520" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">not allowed</TD><TD COLSPAN="1" WIDTH="104" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">allowed</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="6" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Both resets go low first and the clocks must be stable before the hold is counted.<BR ALIGN="LEFT"/>presetn is released before aresetn, each on its own clock edge; when pclk is aclk<BR ALIGN="LEFT"/>the two are typically tied together.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
