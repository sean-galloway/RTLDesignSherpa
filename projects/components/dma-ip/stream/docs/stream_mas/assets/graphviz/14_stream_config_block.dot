// stream_config_block (stream/rtl/top/stream_config_block.sv): maps PeakRDL
// hwif_out fields onto stream_core cfg_* inputs. Pure mapping; one direction.
digraph stream_config_block {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.55", splines=ortho,
           label="stream_config_block - register fields to engine configuration", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    regs [label="Register Block - stream_regs or stream_regs_16ch (PeakRDL)\nhwif_out: packed register fields (per-channel fields REG_NCH = 8 or 16 bits)", fillcolor="white", width=8.0, style="rounded,filled", fillcolor="#E2EFDA"];
    g1 [label="Global + Channel\nGLOBAL_EN, channel\nenable and reset", style="filled", fillcolor="white"];
    g2 [label="Scheduler + Descriptor\nEngine\ntimeouts, prefetch,\naddress windows", style="filled", fillcolor="white"];
    g3 [label="Monitors\ndescriptor, read and\nwrite monitor masks\nand thresholds", style="filled", fillcolor="white"];
    g4 [label="AXI Transfer +\nProfiler\nburst sizes, perf\nenable / mode / clear", style="filled", fillcolor="white"];
    bar [label="Engine Configuration (to stream_core and the monitor group)\ncfg_* signals, defaults applied for unimplemented fields", fillcolor="white", width=8.0, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    regs -> g1 [label="fields"]; regs -> g2 [label="fields"]; regs -> g3 [label="fields"]; regs -> g4 [label="fields"];
    g1 -> bar [label="cfg_*"]; g2 -> bar [label="cfg_*"]; g3 -> bar [label="cfg_*"]; g4 -> bar [label="cfg_*"];
    { rank=same; g1; g2; g3; g4; }
}
