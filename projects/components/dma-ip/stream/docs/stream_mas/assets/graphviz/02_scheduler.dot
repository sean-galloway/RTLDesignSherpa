// STREAM scheduler (stream/rtl/fub/scheduler.sv); derived from the RAPIDS beats figure without the control engines.
// scheduler_beats microarchitecture (stream/rtl/fub/scheduler.sv).
// Command flow down the center: descriptor -> descriptor register -> trackers ->
// engines (bar). Done / commit strobes and engine errors climb back on the right.
digraph stream_scheduler {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.45", splines=ortho,
           label="scheduler - one STREAM channel's transfer coordinator (single clock: clk, rst_n)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    cfg  [label="Configuration\ncfg_channel_enable, cfg_channel_reset,\ncfg_sched_timeout_cycles / _limit / _enable,\ncfg_rd_prefetch_enable", fillcolor="white", group=L, style="rounded,filled", fillcolor="#E2EFDA"];
    din  [label="Descriptor In (from descriptor_engine)\ndescriptor_valid / ready, 256-bit packet,\next chunk, descriptor_error", fillcolor="white", group=C, style="rounded,filled", fillcolor="#E2EFDA"];

    fsm  [label="Channel FSM (one-hot; see the\nFSM figure): IDLE, FETCH_DESC,\nXFER_DATA, COMPLETE, NEXT_DESC,\nERROR", group=L, peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    dreg [label="Descriptor Register + Decode\nsrc, dst, length (beats), chain fields; TYPE = EXT\nloads address generators (row / column runs)", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];

    rdt  [label="Read Tracker\nsrc address, read beats remaining", group=M, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    wrt  [label="Write Tracker\ndst address, beats issued / committed", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];

    wd   [label="Watchdog + Error Latch\nstrikes per stalled window;\nsticky sched_error", group=L, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    mon  [label="MonBus Packet Generator\nstate, completion, IRQ\nand error events", style="filled,dashed", group=L, style="filled,dashed", fillcolor="white"];

    bar [label="Engines and Status\nsched_rd_* (read engine)  |  sched_wr_* (write engine)\nerrors and write progress back  |  mon_* out",
         fillcolor="white", width=10.0, group=C, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    din  -> dreg [label="descriptor (valid / ready)"];
    cfg  -> fsm  [style=dashed, color="#777777", label="enable, reset"];
    fsm  -> dreg [style=dashed, color="#777777", xlabel="load in\nFETCH_DESC"];
    dreg -> rdt  [xlabel="src, length"];
    dreg -> wrt  [label="dst, length", penwidth=1.8];
    rdt  -> bar  [dir=both, label="read cmd down;\ndone strobe, beats\ndone back"];
    wrt  -> bar  [dir=both, penwidth=1.8, label="write cmd down;\nissue + commit\nstrobes back"];
    fsm  -> wd   [dir=back, style=dashed, color="#777777", xlabel="fatal -> CH_ERROR"];
    wd   -> bar  [dir=back, style=dashed, color="#777777", label="engine errors,\nwrite progress"];
    mon  -> bar  [style=dashed, color="#777777", label="mon_* packets"];

    { rank=same; cfg; din; }
    cfg -> din [style=invis];
    { rank=same; fsm; dreg; }
    fsm -> dreg [style=invis];
    { rank=same; rdt; wrt; }
    { rank=same; wd; mon; }
    rdt -> wd [style=invis];
}
