// stream_drain_ctrl - data accounting as a virtual FIFO (single clock: axi_aclk, axi_aresetn) -- virtual FIFO: pointers and flags, no data storage.
// fifo_sync geography: write side left, read side right, both pointers
// converge on fifo_control; outputs are the bottom bar.
digraph stream_drain_ctrl {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.50", ranksep="0.55", splines=ortho,
           label="stream_drain_ctrl - data accounting as a virtual FIFO (single clock: axi_aclk, axi_aresetn)", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    wport [label="Arrive (write side)\nwr_valid: one beat written into the buffer", fillcolor="white", group=L, style="rounded,filled", fillcolor="#E2EFDA"];
    rport [label="Claim (read side)\nrd_valid, rd_size: reserve N beats to drain", fillcolor="white", group=R, style="rounded,filled", fillcolor="#E2EFDA"];
    wptr  [label="Arrival Pointer - counter_bin\nwr_ptr += 1 per accepted beat", group=L, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    rptr  [label="Claim Pointer (flops)\nrd_ptr += rd_size per request (not empty)", group=R, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    ctl   [label="Count + Flags - fifo_control\ncount = wr_ptr - rd_ptr; full / almost full,\nempty / almost empty (REGISTERED option)", width=4.4, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    bar   [label="Outputs\ndata_available = count  |  wr_ready, wr_full, wr_almost_full  |  rd_ready, rd_empty, rd_almost_empty", fillcolor="white", width=7.5, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    wport -> wptr [label="handshake (wr_ready = not full)"];
    rport -> rptr [label="handshake (rd_ready = not empty)"];
    wptr  -> ctl  [label="next wr_ptr"];
    rptr  -> ctl  [label="next rd_ptr"];
    ctl   -> bar  [label="count, flags", penwidth=1.8];
    { rank=same; wport; rport; }
    wport -> rport [style=invis];
    { rank=same; wptr; rptr; }
    wptr -> rptr [style=invis];
}
