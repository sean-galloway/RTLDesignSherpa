// scheduler_group_array with SHARED_ENGINES = 1 (stream/rtl/macro/scheduler_group_array.sv).
// Top to bottom: the kick and the N schedulers, ONE descriptor_engine_shared
// (per-channel state and FIFOs, round-robin pick, issue slot, R path), then
// the descriptor AXI master. The per-channel structure (SHARED_ENGINES = 0)
// is described in the text.
digraph scheduler_group_array {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.55", splines=ortho, newrank=true,
           label="scheduler_group_array - SHARED_ENGINES = 1 (single clock: clk, rst_n)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    kick  [label="Kick (from stream_top)\napb_valid / apb_addr, per channel", fillcolor="white"];
    sch   [label="scheduler [0 .. N-1]\none channel FSM each", width=3.2];
    eng   [label="AXI Read / Write Engines (stream_core)\nsched_rd_* / sched_wr_* per channel", fillcolor="white"];

    subgraph cluster_eng {
        label="descriptor_engine_shared - one for every channel"; style=dashed; color="#555555"; fontsize=10;
        fifos [label="Per-Channel State and FIFOs\nstate, pending address, kick-in-progress, owed beat;\ndescriptor FIFO (+ EXT chunk-1 FIFO)", width=4.6];
        pick  [label="Round-Robin Pick\nchannels with an address to fetch\nand a free FIFO entry", shape=invtrapezium, width=4.0, fillcolor="#BFD7EE"];
        slot  [label="Issue Slot (flops)\npicked channel + address;\nrange check next cycle -> ARVALID"];
        rpath [label="R Path\nRID -> channel FIFO; EXT chunk 0 held,\nchunk-1 address = +32; chaining"];
        rep   [label="MonBus Reporter\ncompletion / error per channel", fillcolor="#E8E8E8"];
    }

    dmon  [label="Descriptor AXI Monitor\naxi4_master_rd_monlite (optional)", fillcolor="#E8E8E8"];
    marb  [label="monbus_arbiter\nN + 2 sources", fillcolor="#E8E8E8"];
    bar   [label="Module Boundary\ndesc_axi (256-bit, ARID = channel)   |   mon_*", fillcolor="white", width=6.5];

    kick  -> fifos [xlabel="kick"];
    fifos -> sch   [xlabel="descriptor"];
    sch   -> eng   [xlabel="transfers"];
    fifos -> pick  [xlabel="requests"];
    pick  -> slot  [xlabel="grant", penwidth=1.8];
    slot  -> dmon  [xlabel="AR", penwidth=1.8];
    dmon  -> rpath [xlabel="R"];
    rpath -> fifos [xlabel="push"];
    dmon  -> bar   [dir=both, penwidth=1.8];
    rep   -> marb;
    sch   -> marb  [style=dashed];
    marb  -> bar;

    { rank=same; kick; }
    { rank=same; slot; rpath; }
    { rank=same; dmon; marb; }
}
