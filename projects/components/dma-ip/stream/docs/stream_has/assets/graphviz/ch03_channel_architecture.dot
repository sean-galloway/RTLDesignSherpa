// STREAM channel resources: 8 independent scheduler groups, one shared set of
// masters, each shared master behind a round-robin pick (no priority logic).
digraph stream_channel_architecture {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.7", ranksep="1.1", splines=ortho,
           label="Independent channels, shared masters - every shared resource is a plain round-robin pick", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    grp [label="8 Independent Channels - 8 x scheduler_group\neach: descriptor_engine + scheduler, own state, own SRAM FIFO", width=10.5];
    darb [label="Descriptor Pick\nround-robin, 8:1", shape=invtrapezium, width=2.4, fillcolor="#BFD7EE"];
    rarb [label="Read Pick\nround-robin,\nSRAM space", shape=invtrapezium, width=2.4, fillcolor="#BFD7EE"];
    warb [label="Write Pick\nround-robin,\nSRAM data", shape=invtrapezium, width=2.4, fillcolor="#BFD7EE"];
    bar  [label="Shared Masters\nm_axi_desc (AR / R)   |   m_axi_rd (AR / R)   |   m_axi_wr (AW, W / B)", fillcolor="white", width=11.0];

    grp -> darb [xlabel="desc AR (8)"];
    grp -> rarb [xlabel="read requests (8)"];
    grp -> warb [xlabel="write requests (8)"];
    darb -> bar [xlabel="AR", penwidth=1.8];
    rarb -> bar [label="AR", penwidth=1.8];
    warb -> bar [xlabel="AW + W", penwidth=1.8];
    { rank=same; darb; rarb; warb; }
    darb -> rarb -> warb [style=invis];
}
