// STREAM whole unit (stream_top_ch8 / stream_top_ch16), house block-diagram form.
// Memory-to-memory DMA: the data loop is the center - R climbs from the bar
// through the read engine into the SRAM, then drops through the write engine
// back to the bar. Descriptor fetch takes the left lane; monitors the right.
// Verified against rtl/top/stream_top_ch8.sv, rtl/macro/stream_core.sv,
// rtl/macro/scheduler_group_array.sv.
digraph stream_whole_unit {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.60", splines=ortho,
           label="STREAM whole unit - stream_top_ch8 / stream_top_ch16 (core on aclk; APB on pclk when CDC_ENABLE = 1)\nread data climbs from m_axi_rd into the SRAM and drops back down to m_axi_wr (the data loop, center); descriptors on the left lane",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    s_apb [label="Host Configuration - s_apb_*\n(APB4 slave)", fillcolor="white", group=C, style="rounded,filled", fillcolor="#E2EFDA"];
    regs  [label="Registers + Config Mapping\napb4_slave_cdc (CDC_ENABLE = 1) or apb4_slave\n-> peakrdl_to_cmdrsp -> stream_regs[_16ch] (PeakRDL)\n-> stream_config_block; cfg_* sideband to every block", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    sram  [label="SRAM Buffer - sram_controller\nNUM_CHANNELS per-channel FIFOs (sram_controller_unit)", height=0.9, width=3.6, group=C, shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    sga   [label="Scheduler Group Array - scheduler_group_array\nNUM_CHANNELS (8 or 16) x scheduler\n(read and write run concurrently per descriptor)", group=C, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    wr    [label="AXI Write Engine\naxi_write_engine (round-robin\nover channels; data-aware)", group=L, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    arb   [label="Shared Descriptor Engine\ndescriptor_engine_shared (round-robin\npick, ARID = channel; SHARED_ENGINES=1)", width=3.4, fillcolor="#BFD7EE", group=A, peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    mon   [label="Observers + MonBus (sideband)\ndesc / rd / wr monitor-lites (USE_AXI_MONITORS),\nbus meters, latency histograms, monbus_arbiter ->\nmonbus_axil4_axil4_group", style="filled,dashed", group=M, peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];
    rd    [label="AXI Read Engine\naxi_read_engine (round-robin\nover channels; space-aware)", group=R, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    perf  [label="Performance Profiler (sideband)\nperf_profiler: per-channel active\ntimestamps / elapsed times, read\nback through the registers", style="filled,dashed", group=R, peripheries=2, style="filled,dashed", fillcolor="#D6E4F0"];

    mem [label="System Memory / AXI interconnect\nm_axi_desc (AR / R, 256-bit)  |  m_axi_wr (AW, W / B)  |  m_axi_rd (AR / R)  |  m_axil_mon, s_axil_err, stream_irq",
         fillcolor="white", width=15.0, group=C, shape=cylinder, style="filled", fillcolor="#E8DFF5"];

    s_apb -> regs [label="register R/W"];
    regs  -> sga  [label="kick: descriptor address (per channel)"];
    sga   -> arb  [dir=both, label="kick address down,\ndescriptor up (per channel)"];
    sga   -> wr   [xlabel="write cmd: dst addr, beats"];
    sga   -> rd   [xlabel="read cmd: src addr, beats"];
    sga   -> mon  [style=dashed, color="#777777", xlabel="monitor\npackets"];
    sram  -> wr   [label="drain beats", penwidth=1.8];

    p_wr  [shape=point, width=0.01, group=L];
    p_cmd [shape=point, width=0.01, group=A];
    p_dr  [shape=point, width=0.01];
    p_mn  [shape=point, width=0.01, group=M];
    p_ar  [shape=point, width=0.01, group=R];
    p_rd  [shape=point, width=0.01];
    sp1 [style=invis, label="", fixedsize=true, width=0.9, height=0.02];
    sp2 [style=invis, label="", fixedsize=true, width=0.9, height=0.02];
    { rank=same; p_dr; p_cmd; sp1; p_wr; p_ar; sp2; p_rd; p_mn; }
    p_dr -> p_cmd -> sp1 -> p_wr -> p_ar -> sp2 -> p_rd -> p_mn [style=invis];

    wr   -> p_wr  [arrowhead=none, headclip=false, penwidth=1.8];
    p_wr -> mem   [xlabel="Write to memory\n(AW + W, B back)", penwidth=1.8, tailclip=false];
    arb  -> p_cmd [arrowhead=none, headclip=false, penwidth=1.8];
    p_cmd -> mem  [xlabel="descriptor fetch (AR)", penwidth=1.8, tailclip=false];
    arb  -> p_dr  [dir=back, headclip=false, xlabel="descriptors (R,\nrouted by RID)"];
    p_dr -> mem   [dir=none, tailclip=false];
    mon  -> p_mn  [arrowhead=none, headclip=false, style=dashed, color="#777777"];
    p_mn -> mem   [style=dashed, color="#777777", xlabel="capture writes,\nerror drain, stream_irq", tailclip=false];
    rd   -> p_ar  [arrowhead=none, headclip=false];
    p_ar -> mem   [xlabel="Read request (AR)", tailclip=false];
    rd   -> p_rd  [dir=back, headclip=false];
    p_rd -> mem   [dir=none, xlabel="Read from\nmemory (R)", tailclip=false];

    // read data climbs from the read engine into the SRAM fill side
    sram -> rd [dir=back, label="R beats (fill)", penwidth=1.8];

    { rank=same; sga; perf; }
    sga -> perf [style=invis];
    { rank=same; arb; wr; rd; mon; }
    arb -> wr -> rd -> mon [style=invis];
    sga -> sram [style=invis, weight=5];
}
