// STREAM descriptor-chain overlap (replaces an ASCII sketch). Schematic
// timeline, not to scale. Source of truth: the chaining and read-ahead
// prefetch text of ch05_performance/01_throughput.md.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph stream_descriptor_chain_overlap {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Descriptor chaining: the next descriptor is fetched while the current\ntransfer runs", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="110" BORDER="0" ALIGN="RIGHT"><B>time</B></TD><TD WIDTH="52" BORDER="0"><B>t0</B></TD><TD WIDTH="52" BORDER="0"><B>t1</B></TD><TD WIDTH="52" BORDER="0"><B>t2</B></TD><TD WIDTH="52" BORDER="0"><B>t3</B></TD><TD WIDTH="52" BORDER="0"><B>t4</B></TD><TD WIDTH="52" BORDER="0"><B>t5</B></TD><TD WIDTH="52" BORDER="0"><B>t6</B></TD><TD WIDTH="52" BORDER="0"><B>t7</B></TD><TD WIDTH="52" BORDER="0"><B>t8</B></TD><TD WIDTH="52" BORDER="0"><B>t9</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="42">Desc 0</TD><TD COLSPAN="1" WIDTH="52" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0">Fetch</TD><TD COLSPAN="3" WIDTH="156" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0">Transfer 0</TD><TD COLSPAN="6" WIDTH="312" HEIGHT="42" FIXEDSIZE="FALSE" BORDER="0"> </TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="42">Desc 1</TD><TD COLSPAN="2" WIDTH="104" HEIGHT="42" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="52" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0">Fetch</TD><TD COLSPAN="1" WIDTH="52" HEIGHT="42" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="3" WIDTH="156" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0">Transfer 1</TD><TD COLSPAN="3" WIDTH="156" HEIGHT="42" FIXEDSIZE="FALSE" BORDER="0"> </TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="42">Desc 2</TD><TD COLSPAN="5" WIDTH="260" HEIGHT="42" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="52" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0">Fetch</TD><TD COLSPAN="1" WIDTH="52" HEIGHT="42" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="3" WIDTH="156" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0">Transfer 2</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="10" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Each fetch hides under the transfer before it, so transfers run back to back once the<BR ALIGN="LEFT"/>chain is primed. With read-ahead prefetch enabled the datapath also streams across<BR ALIGN="LEFT"/>the boundary; without it the read side refills at each boundary (about 13 cycles).<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
