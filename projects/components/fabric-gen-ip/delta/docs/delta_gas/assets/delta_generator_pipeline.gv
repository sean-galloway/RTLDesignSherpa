digraph delta_pipeline {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    args   [label="CLI args / API call\n--masters --slaves --data-width"];
    config [label="DeltaConfig\nwidths + feature flags"];
    obj    [label="DeltaFlatCrossbar\nbuilds ports & params"];
    decode [label="generate_request_decode()\nTDEST -> request_matrix"];
    arb    [label="generate_arbiter_logic()\npacket-atomic round-robin"];
    mux    [label="generate_crossbar_mux()\nTDATA/TVALID/TLAST/..."];
    bp     [label="generate_backpressure_logic()\ns_axis_tready routing"];
    wake   [label="generate_wakeup_logic()\nAMBA 5 TWAKEUP"];
    cnt    [label="generate_performance_counters()\noptional"];
    asst   [label="generate_assertions()\nFORMAL checks"];
    emit   [shape=invtrapezium, width=2.2, height=0.45, label="delta_generator\nemitter funnel", fillcolor="#E8F4E8"];
    rtl    [label="delta_axis_flat_<M>x<N>.sv"];
    tree   [label="complete_tree_generator.py\nsplitter/merger/tree primitives"];

    {rank=same; decode; arb; mux}
    {rank=same; wake; cnt; asst}

    args -> config [label="parse"];
    config -> obj [label="construct"];
    obj -> emit [label="module skeleton"];
    emit -> decode [label="emit"];
    emit -> arb [label="emit"];
    emit -> mux [label="emit"];
    emit -> bp [label="emit"];
    emit -> wake [label="emit (AMBA 5)"];
    emit -> cnt [label="emit (optional)"];
    emit -> asst [label="emit"];
    decode -> arb [label="request_matrix"];
    arb -> mux [label="grant_matrix"];
    mux -> bp [label="m_axis_tready"];
    emit -> rtl [label="complete module"];
    tree -> rtl [label="separate artifact", style=dashed];
}
