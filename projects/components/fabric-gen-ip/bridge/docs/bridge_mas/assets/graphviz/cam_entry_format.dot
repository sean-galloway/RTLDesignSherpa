// One bridge_cam entry, as instantiated by a CAM-tracked slave adapter.
// Fields from rtl/bridge_cam.sv (r_valid, r_tag_array, r_data_array,
// r_count_array); widths from rtl/generated/bridge_2x2_rw/ddr_adapter.sv
// (TAG_WIDTH = ID_WIDTH = 5, DATA_WIDTH = BRIDGE_ID_WIDTH = 1, DEPTH = 16,
// ALLOW_DUPLICATES = 1). Packed field layout (not a block diagram).
digraph cam_entry_format {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           label="bridge_cam entry - one per outstanding transaction, DEPTH = the slave's max_outstanding (default 16) per CAM\n(u_wr_cam and u_rd_cam in each CAM-tracked slave adapter)"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];

    entry [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7">
  <TR>
    <TD BGCOLOR="#D6E4F0"><B>valid</B></TD>
    <TD BGCOLOR="#D6E4F0"><B>tag</B></TD>
    <TD BGCOLOR="#D6E4F0"><B>data</B></TD>
    <TD BGCOLOR="#D6E4F0"><B>count</B></TD>
  </TR>
  <TR>
    <TD>1 bit</TD>
    <TD>TAG_WIDTH = ID_WIDTH<BR/>(XBAR_ID_WIDTH)</TD>
    <TD>DATA_WIDTH =<BR/>BRIDGE_ID_WIDTH</TD>
    <TD>$clog2(DEPTH) + 1</TD>
  </TR>
  <TR>
    <TD>r_valid[i]</TD>
    <TD>r_tag_array[i]</TD>
    <TD>r_data_array[i]</TD>
    <TD>r_count_array[i]</TD>
  </TR>
  <TR>
    <TD>entry occupied</TD>
    <TD>fabric AXI ID<BR/>{BRIDGE_ID, master id}<BR/>(AWID / ARID)</TD>
    <TD>issuing master's index<BR/>(xbar_bridge_id_aw / _ar);<BR/>returned as<BR/>bid_ / rid_bridge_id</TD>
    <TD>age among entries with<BR/>the same tag (0 = oldest,<BR/>retired first; ALLOW_DUPLICATES = 1)</TD>
  </TR>
  <TR>
    <TD BGCOLOR="#F2F2F2">1 bit</TD>
    <TD BGCOLOR="#F2F2F2">5 bits</TD>
    <TD BGCOLOR="#F2F2F2">1 bit</TD>
    <TD BGCOLOR="#F2F2F2">5 bits</TD>
  </TR>
</TABLE>>];

    note [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
  <TR><TD ALIGN="LEFT">Grey row: bridge_2x2_rw (4-bit master IDs, 2 masters) -&gt; 12 bits per entry.</TD></TR>
  <TR><TD ALIGN="LEFT">Allocate on the crossbar-side AW / AR handshake; look up and free on B, or on R with RLAST.</TD></TR>
  <TR><TD ALIGN="LEFT">No timestamp, transaction-type or metadata field exists.</TD></TR>
</TABLE>>];

    entry -> note [style=invis];
}
