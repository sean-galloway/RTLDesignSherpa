// One per-slave address arbiter in <bridge>_xbar (the AW one; the AR one is
// identical). Labels from rtl/generated/bridge_2x2_rw/bridge_2x2_rw_xbar.sv
// (<s>_aw_arb_*) and bridge_2x2_rw_qos/bridge_2x2_rw_qos_xbar.sv (QoS + aging).
// House style: vault/handbook/authoring/block-diagrams.md
digraph arbitration {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.60", splines=ortho, labelloc=t,
           label="Per-slave AW arbiter <s>_aw_arb (the AR arbiter is identical) - single clock aclk\nW, B and R have no arbiter: W follows the AW grant through the W owner FIFO"];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    m0 [label="Master 0 Path\n<m0>_aw_to_<s> && <m0>_awvalid", fillcolor="white"];
    mn [label="Master M-1 Path\n<mN>_aw_to_<s> && <mN>_awvalid", fillcolor="white"];
    legend [label="Parameters (TOML, fixed at generation)\larbitration = \"rr\" (default): round-robin pick\larbitration = \"qos\": effective priority = AWQOS + age\l    (age climbs one level per 2**qos_aging_shift waiting cycles,\l    saturates at 15, clears on grant); round-robin among equals\l", fillcolor="white"];
    { rank=same; m0; mn; legend; }
    m0 -> mn -> legend [style=invis];

    req [label="Request Vector\n<s>_aw_arb_req: one bit per master whose AW\nis valid and re-decodes to slave s"];
    qos [label="QoS Eligibility (arbitration = qos only)\nper requester AWQOS + age; only those at the\nbest effective priority stay eligible", style="filled,dashed"];
    { rank=same; rr; req; }
    rr -> req [style=invis];

    pick [label="Round-Robin Pick\n<s>_aw_arb_pick: first requester at or after\n<s>_aw_arb_rr", shape=invtrapezium, width=5.2, height=0.7, group=C];
    rr [label="Round-Robin Pointer (flop)\n<s>_aw_arb_rr: set one past\nthe winner at each AW handshake"];

    lock [group=C, label="Grant Lock (flops)\n<s>_aw_arb_locked / _lock: once AWVALID is up\nthe grant is held until the AW handshake\n(AXI forbids changing a presented request)"];

    bar [label="Grant - <m>_aw_gnt_<s> (one-hot) to the AW mux, the W owner FIFO and each master's AWREADY", fillcolor="white", width=8.5, group=C];

    m0 -> req [label="request (master 0)"];
    mn -> req [label="request (master M-1)"];
    req -> pick [label="requests"];
    req -> qos [style=dashed, label="requests + AWQOS"];
    qos -> pick [style=dashed, label="eligible set"];
    rr -> pick [style=dashed, label="start position"];
    pick -> lock [xlabel="winner", penwidth=1.8];
    lock -> bar [xlabel="held grant", penwidth=1.8];
    rr -> lock [style=dashed, dir=back, xlabel="winner at handshake"];
}
