// bridge_cam with PIPELINE_ALLOC = 1 and PIPELINE_FREE = 1, as every
// CAM-tracked slave adapter builds it (GitHub #119). From rtl/bridge_cam.sv
// (gen_alloc_pipe, gen_free_pipe, the eviction port) and the slave adapter
// wiring in bin/bridge_pkg/generators/slave_adapter_generator.py.
//
// Request (insert) flow: top-down, centre column -- the crossbar's accepted
// AW / AR reaches only the pending-insert register; the tag match, duplicate
// count and entry write happen the next cycle.
// Return (response) flow: enters at the slave-side bar, climbs the right
// edge -- the lookup routes the response this cycle; the free is registered.
digraph cam_pipeline {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="1.1", ranksep="0.70", splines=ortho, labelloc=t,
           label="bridge_cam, registered insert and registered free (u_wr_cam / u_rd_cam in a CAM-tracked slave adapter)"];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- crossbar side (top) ----
    xb_req  [label="Crossbar: AW / AR granted\n(accepted by this slave adapter)", fillcolor="white"];
    xb_rsp  [label="Crossbar: response routing\n(B / R steered to the issuing master)", fillcolor="white"];
    { rank=same; xb_req; xb_rsp; }

    // ---- request (insert) column ----
    pend    [label="Pending Insert Register\nbridge_cam - gen_alloc_pipe (PIPELINE_ALLOC = 1)"];
    count   [label="Tag Match + Duplicate Count\nbridge_cam - w_entry_matches / w_dup_count"];
    entries [label="CAM Entries (valid, tag, master index, count)\nbridge_cam - r_valid / r_tag_array / r_data_array / r_count_array",
             width=4.2];

    // ---- return (response) column ----
    lookup  [label="Lookup: count-0 match, or the pending entry\nbridge_cam - eviction port (combinational)"];
    pfree   [label="Pending Free Register\nbridge_cam - gen_free_pipe (PIPELINE_FREE = 1)"];

    { rank=same; pend; lookup; }
    { rank=same; count; pfree; }

    // ---- slave side (bottom bar) ----
    bar [label="Slave side: B, or the R beat with RLAST, returns with its ID", shape=box,
         fillcolor="white", width=7.0, height=0.3];

    // request flow: down the centre
    xb_req -> pend    [label="tag + master index\n(registered here only)", penwidth=1.8];
    pend   -> count   [label="next cycle: insert"];
    count  -> entries [xlabel="write new entry: count =\nmatches, -1 if the same\ntag retires this cycle"];

    // return flow: up the right edge
    lookup -> bar     [xlabel="response ID", dir=back];
    pfree  -> bar     [style=invis];
    lookup -> xb_rsp  [label="master index\n(same cycle)", penwidth=1.8];

    // sideband: dashed, short, labeled
    pend    -> lookup  [style=dashed, xlabel="pending entry\n(its response may\ncome next cycle)"];
    lookup  -> pfree   [style=dashed, label="entry to free +\nsame-tag decrements"];
    pfree   -> entries [style=dashed, xlabel="next cycle:\nfree + decrement"];
    entries -> lookup  [style=dashed, xlabel="stored entries,\nminus a pending free", constraint=false];
    entries -> bar     [style=invis];
}
