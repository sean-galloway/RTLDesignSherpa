digraph bridge_pipeline {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    toml [label="TOML config\n(bridge_*.toml)"];
    csv  [label="CSV connectivity\n(*_connectivity.csv)"];
    load [label="load_config()\nbridge_pkg/config_loader.py"];
    val  [label="validate_config()\nbridge_pkg/config_validator.py"];
    trans [label="_emit_bridge_variant()\ntranslates PortSpec →\nMasterConfig / SlaveInfo"];
    pkg  [label="PackageGenerator\n_pkg.sv"];
    mad  [label="AdapterGenerator\nmaster adapters"];
    sad  [label="SlaveAdapterGenerator\nslave adapters"];
    xbar [label="CrossbarGenerator\n_xbar.sv"];
    emit [shape=invtrapezium, width=2.2, height=0.45, label="BridgeModuleGenerator\nemitter funnel", fillcolor="#E8F4E8"];
    top  [label="<bridge>.sv\ntop module"];
    fl   [label="<bridge>.f\nfilelist"];
    cfg  [label="CfgRdlGenerator\n(optional regblock)"];
    tests [label="generate_tests()\n(optional cocotb)"];

    {rank=same; toml; csv}
    {rank=same; pkg; mad; sad; xbar}
    {rank=same; fl; cfg; tests}

    toml -> load [label="TOML table"];
    csv  -> load [label="connectivity matrix"];
    load -> val [label="PortSpec lists"];
    val  -> trans [label="validated config"];
    trans -> emit [label="MasterConfig / SlaveInfo"];

    emit -> pkg  [label="package"];
    emit -> mad  [label="masters"];
    emit -> sad  [label="slaves"];
    emit -> xbar [label="crossbar"];

    pkg  -> top [label="import"];
    mad  -> top [label="instantiate"];
    sad  -> top [label="instantiate"];
    xbar -> top [label="instantiate"];

    top -> fl [label="filelist entry", style=dashed];
    top -> cfg [label="when use_cfg_regblock", style=dashed];
    top -> tests [label="when --generate-tests", style=dashed];
}
