// Bridge APB completer-side write transfer (replaces an ASCII sketch). The bridge drives
// APB as a requester through axi4_to_apb4_shim -> apb4_master. Source of truth:
// rtl/amba/apb4/apb4_master.sv (IDLE -> SETUP -> ACCESS until PREADY; PADDR,
// PWRITE, PWDATA, PSTRB driven from the held command register in every state).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph bridge_apb_write_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="APB write from the bridge, zero wait states: SETUP, then ACCESS\ncompletes on PREADY", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="150" BORDER="0" ALIGN="RIGHT"><B>PCLK cycle</B></TD><TD WIDTH="86" BORDER="0"><B>0</B></TD><TD WIDTH="86" BORDER="0"><B>1</B></TD><TD WIDTH="86" BORDER="0"><B>2</B></TD><TD WIDTH="86" BORDER="0"><B>3</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">apb4_master state</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>IDLE</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>SETUP</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ACCESS</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>IDLE</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PSEL</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PENABLE</TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PWRITE</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">1</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PADDR</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">ADDR</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PWDATA, PSTRB</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">WDATA</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PREADY (slave)</TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PSLVERR (slave)</TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">sampled</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="4" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Two cycles per transfer is the floor. The slave completes the transfer by<BR ALIGN="LEFT"/>driving PREADY high in ACCESS; PSLVERR is sampled in that cycle and becomes<BR ALIGN="LEFT"/>BRESP (SLVERR on 1). With another beat queued, the next cycle is SETUP<BR ALIGN="LEFT"/>instead of IDLE, so burst beats run back to back, one transfer each.<BR ALIGN="LEFT"/>Outside SETUP/ACCESS the address and data pins hold the last command (x here).<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
