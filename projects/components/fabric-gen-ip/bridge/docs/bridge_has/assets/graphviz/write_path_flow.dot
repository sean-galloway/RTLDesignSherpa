// GENERATED by gen_paths.py - edit that script, not this file.
digraph write_path_flow {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.60", splines=ortho, labelloc=t,
           label="Write path - AW, W and B through one master adapter, the crossbar and one slave adapter\n(a single-master bridge has no arbiter: the decode alone grants)"];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    pw [label="Master Write Data\nW in", fillcolor="white", group=L];
    pc [label="Master Write Address\nAW in", fillcolor="white", group=C];
    pr [label="Master Write Response\nB out", fillcolor="white", group=R];
    { rank=same; pw; pc; pr; }
    pw -> pc -> pr [style=invis];
    mW [label="W Skid Buffer - axi4_slave_wr\n<master>_adapter; W packed by\naxi4_dwidth_converter_wr when\nthe slave width differs", group=L];
    others [label="Other Masters' AW\n(each through its own\nmaster adapter)", fillcolor="white"];
    mC [label="AW Skid Buffer + Write Decode\naxi4_slave_wr - <master>_adapter\ncomb_slave_select_aw: one-hot from each\nslave's window; no hit -> catch-all", group=C];
    mR [label="B Skid Buffer - axi4_slave_wr\n<master>_adapter", group=R];
    { rank=same; mW; others; mC; mR; }
    mW -> others -> mC -> mR [style=invis];
    wdest [label="W Destination FIFO - <bridge>_xbar\n(per master path, max_outstanding deep) pushed\nwith the decoded slave at AW accept,\npopped at WLAST", group=L];
    arb [label="AW Arbiter (one per slave) - <bridge>_xbar\nround-robin; grant locked from AWVALID to the AW handshake", shape=invtrapezium, width=6.4, height=0.7, group=C];
    rmux [label="B Response Mux - <bridge>_xbar\nB and BREADY routed to the\nmaster whose bridge_id came back", group=R];
    { rank=same; wdest; arb; rmux; }
    wdest -> arb -> rmux [style=invis];
    wown [label="W Owner FIFO + W Mux - <bridge>_xbar\n(per slave, max_outstanding deep) pushed with the\ngrant at slave-side AW accept, popped\nat WLAST; only the owner's W passes", group=L];
    pc3 [shape=point, width=0.01, label="", group=C];
    trk [label="Write Tracker - <slave>_adapter\nu_wr_cam: bridge_cam (tag AWID,\ndata bridge_id, max_outstanding deep); a bridge_id\nFIFO when there is one master.\nFull holds AWREADY low", group=R];
    { rank=same; wown; pc3; trk; }
    wown -> pc3 [style=invis];
    sW [label="W Skid Buffer - axi4_master_wr\n<slave>_adapter", group=L];
    sC [label="AW Skid Buffer - axi4_master_wr\n<slave>_adapter (or the protocol\nshim's write side)", group=C];
    sR [label="B Skid Buffer - axi4_master_wr\n<slave>_adapter", group=R];
    { rank=same; sW; sC; sR; }
    sW -> sC -> sR [style=invis];
    bar [label="Slave Write Port - <prefix>_aw* and w* out, b* in", fillcolor="white", width=11, group=C];
    pw -> mW [label="W beats"];
    mW -> wdest [label="W (slave width)"];
    wdest -> wown [label="W + its destination slave"];
    wown -> sW [label="W of the owning master"];
    sW -> bar [xlabel="Write data"];
    pc -> mC [label="AW"];
    mC -> arb [label="AW + slave select"];
    others -> arb [label="AW from other masters"];
    arb -> pc3 [dir=none, penwidth=1.8];
    pc3 -> sC [xlabel="granted AW + bridge_id", penwidth=1.8];
    sC -> bar [label="Write address", penwidth=1.8];
    pr -> mR [dir=back, label="B"];
    mR -> rmux [dir=back, label="B"];
    rmux -> trk [dir=back, label="B + bridge_id"];
    trk -> sR [dir=back, label="B + BID"];
    sR -> bar [dir=back, xlabel="Write response"];
    pc3 -> trk [style=dashed, xlabel="AWID + bridge_id at accept"];
}
