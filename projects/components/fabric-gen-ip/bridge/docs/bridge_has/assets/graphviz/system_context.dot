// Bridge system context (HAS 2.2): masters, the generated bridge, slaves.
// House style: vault/handbook/authoring/block-diagrams.md
digraph system_context {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.80", splines=ortho, labelloc=t,
           label="Bridge in an SoC - the only path between the masters and the slaves\n(each edge: requests down, responses up)"];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7, dir=both];

    cpu [label="CPU Core", fillcolor="white"];
    dma [label="DMA Engine", fillcolor="white"];
    gpu [label="GPU Engine", fillcolor="white"];
    acc [label="Accelerator", fillcolor="white"];
    { rank=same; cpu; dma; gpu; acc; }
    cpu -> dma -> gpu -> acc [style=invis, dir=none];

    br [label="Generated Bridge - <name>.sv\npresents a slave port to each master and a master port to each slave;\naddress decode, one arbiter per slave, width and protocol conversion,\nresponses routed back to the requesting master", width=8];

    ddr   [label="DDR Controller", fillcolor="white"];
    sram  [label="SRAM Buffer", fillcolor="white"];
    per   [label="Peripheral Block", fillcolor="white"];
    flash [label="Flash Controller", fillcolor="white"];
    { rank=same; ddr; sram; per; flash; }
    ddr -> sram -> per -> flash [style=invis, dir=none];

    cpu -> br [xlabel="AXI4"];
    dma -> br [xlabel="AXI4"];
    gpu -> br [xlabel="AXI4"];
    acc -> br [xlabel="AXI4"];

    br -> ddr [xlabel="AXI4"];
    br -> sram [xlabel="AXI4"];
    br -> per [xlabel="APB"];
    br -> flash [xlabel="AXI4"];
}
