// GENERATED by gen_paths.py - edit that script, not this file.
digraph read_path_flow {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.60", splines=ortho, labelloc=t,
           label="Read path - AR and R through one master adapter, the crossbar and one slave adapter\n(a single-master bridge has no arbiter: the decode alone grants)"];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    pc [label="Master Read Address\nAR in", fillcolor="white", group=C];
    pr [label="Master Read Data\nR out", fillcolor="white", group=R];
    { rank=same; pc; pr; }
    pc -> pr [style=invis];
    others [label="Other Masters' AR\n(each through its own\nmaster adapter)", fillcolor="white"];
    mC [label="AR Skid Buffer + Read Decode\naxi4_slave_rd - <master>_adapter\ncomb_slave_select_ar: one-hot from each\nslave's window; no hit -> catch-all", group=C];
    mR [label="R Skid Buffer - axi4_slave_rd\n<master>_adapter; R unpacked by\naxi4_dwidth_converter_rd when\nthe slave width differs", group=R];
    { rank=same; others; mC; mR; }
    others -> mC -> mR [style=invis];
    arb [label="AR Arbiter (one per slave) - <bridge>_xbar\nround-robin; grant locked from ARVALID to the AR handshake", shape=invtrapezium, width=6.4, height=0.7, group=C];
    rmux [label="R Response Mux - <bridge>_xbar\nR beats and RREADY routed to the\nmaster whose bridge_id came back", group=R];
    { rank=same; arb; rmux; }
    arb -> rmux [style=invis];
    pc3 [shape=point, width=0.01, label="", group=C];
    trk [label="Read Tracker - <slave>_adapter\nu_rd_cam: bridge_cam (tag ARID,\ndata bridge_id, 16 deep); a bridge_id\nFIFO when there is one master.\nEntry freed at the last R beat;\nfull holds ARREADY low", group=R];
    { rank=same; pc3; trk; }
    sC [label="AR Skid Buffer - axi4_master_rd\n<slave>_adapter (or the protocol\nshim's read side)", group=C];
    sR [label="R Skid Buffer - axi4_master_rd\n<slave>_adapter", group=R];
    { rank=same; sC; sR; }
    sC -> sR [style=invis];
    bar [label="Slave Read Port - <prefix>_ar* out, r* in", fillcolor="white", width=10.5, group=C];
    pc -> mC [label="AR"];
    mC -> arb [label="AR + slave select"];
    others -> arb [label="AR from other masters"];
    arb -> pc3 [dir=none, penwidth=1.8];
    pc3 -> sC [xlabel="granted AR + bridge_id", penwidth=1.8];
    sC -> bar [label="Read address", penwidth=1.8];
    pr -> mR [dir=back, label="R"];
    mR -> rmux [dir=back, label="R (master width)"];
    rmux -> trk [dir=back, label="R + bridge_id"];
    trk -> sR [dir=back, label="R + RID"];
    sR -> bar [dir=back, xlabel="Read data"];
    pc3 -> trk [style=dashed, xlabel="ARID + bridge_id at accept"];
}
