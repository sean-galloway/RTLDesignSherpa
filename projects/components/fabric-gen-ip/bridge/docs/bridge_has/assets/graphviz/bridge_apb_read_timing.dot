// Bridge APB completer-side read transfer (replaces an ASCII sketch). The bridge drives
// APB as a requester through axi4_to_apb4_shim -> apb4_master. Source of truth:
// rtl/amba/apb4/apb4_master.sv (IDLE -> SETUP -> ACCESS until PREADY; PADDR,
// PWRITE, PWDATA, PSTRB driven from the held command register in every state).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph bridge_apb_read_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="APB read from the bridge, one wait state: PRDATA is taken in the PREADY\ncycle", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="150" BORDER="0" ALIGN="RIGHT"><B>PCLK cycle</B></TD><TD WIDTH="86" BORDER="0"><B>0</B></TD><TD WIDTH="86" BORDER="0"><B>1</B></TD><TD WIDTH="86" BORDER="0"><B>2</B></TD><TD WIDTH="86" BORDER="0"><B>3</B></TD><TD WIDTH="86" BORDER="0"><B>4</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">apb4_master state</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>IDLE</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>SETUP</B></TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ACCESS</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>IDLE</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PSEL</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="3" WIDTH="258" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PENABLE</TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PWRITE</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="3" WIDTH="258" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">0</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PADDR</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="3" WIDTH="258" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">ADDR</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PREADY (slave)</TD><TD COLSPAN="3" WIDTH="258" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PRDATA, PSLVERR (slave)</TD><TD COLSPAN="3" WIDTH="258" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">RDATA</TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="2" WIDTH="172" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>wait state</I></FONT></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>captured<BR/>-&gt; R beat</I></FONT></TD><TD COLSPAN="1" WIDTH="86" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"> </TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="5" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The slave holds PREADY low for as many ACCESS cycles as it needs; PSEL,<BR ALIGN="LEFT"/>PENABLE and the address stay put meanwhile. PRDATA and PSLVERR are valid only<BR ALIGN="LEFT"/>in the PREADY cycle, where they become the R beat (RRESP SLVERR on PSLVERR=1).<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
