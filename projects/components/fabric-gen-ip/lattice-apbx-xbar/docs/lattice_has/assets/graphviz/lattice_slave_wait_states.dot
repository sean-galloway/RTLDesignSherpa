// Lattice slave-side wait states (replaces an ASCII sketch). The crossbar
// drives each slave port through apb4_master.
// Source of truth: the measured, asserted numbers in
// dv/tests/test_apbx_xbar_timing.py (M = 1: forward 5, downstream SETUP->ACCESS 1,
// response 3, SETUP->PREADY 9; M > 1: one more on the forward path, 10) and
// rtl/amba/apb4/apb4_slave.sv / apb4_master.sv.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph lattice_slave_wait_states {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Slave-side transfer with two wait states: the crossbar holds ACCESS\nuntil PREADY", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="170" BORDER="0" ALIGN="RIGHT"><B>pclk cycle</B></TD><TD WIDTH="78" BORDER="0"><B>0</B></TD><TD WIDTH="78" BORDER="0"><B>1</B></TD><TD WIDTH="78" BORDER="0"><B>2</B></TD><TD WIDTH="78" BORDER="0"><B>3</B></TD><TD WIDTH="78" BORDER="0"><B>4</B></TD><TD WIDTH="78" BORDER="0"><B>5</B></TD><TD WIDTH="78" BORDER="0"><B>6</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">apb4_master state</TD><TD COLSPAN="1" WIDTH="78" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><B>IDLE</B></TD><TD COLSPAN="1" WIDTH="78" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><B>SETUP</B></TD><TD COLSPAN="3" WIDTH="234" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ACCESS</B></TD><TD COLSPAN="2" WIDTH="156" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><B>IDLE</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">PSEL (to slave)</TD><TD COLSPAN="1" WIDTH="78" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="312" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="156" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">PENABLE (to slave)</TD><TD COLSPAN="2" WIDTH="156" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="3" WIDTH="234" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="156" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">PADDR, PWRITE, PWDATA</TD><TD COLSPAN="1" WIDTH="78" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="4" WIDTH="312" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">held</TD><TD COLSPAN="2" WIDTH="156" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">PREADY (from slave)</TD><TD COLSPAN="4" WIDTH="312" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="78" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="156" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">PRDATA, PSLVERR</TD><TD COLSPAN="4" WIDTH="312" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="78" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">captured</TD><TD COLSPAN="2" WIDTH="156" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="2" WIDTH="156" HEIGHT="30" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="2" WIDTH="156" HEIGHT="30" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>wait</I></FONT></TD><TD COLSPAN="1" WIDTH="78" HEIGHT="30" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>complete</I></FONT></TD><TD COLSPAN="2" WIDTH="156" HEIGHT="30" FIXEDSIZE="FALSE" BORDER="0"> </TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="7" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The slave holds PREADY low as long as it needs; there is no timeout. PRDATA and PSLVERR are<BR ALIGN="LEFT"/>captured in the PREADY cycle and return to the originating master, whose own PREADY rises<BR ALIGN="LEFT"/>3 cycles later (response path). Every wait state here is a wait state at the master port.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
