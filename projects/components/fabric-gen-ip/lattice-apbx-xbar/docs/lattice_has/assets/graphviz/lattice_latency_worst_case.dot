// Lattice latency with arbitration and slave wait states (replaces an
// ASCII sketch). Contention adds whole transfers ahead of this one.
// Source of truth: the measured, asserted numbers in
// dv/tests/test_apbx_xbar_timing.py (M = 1: forward 5, downstream SETUP->ACCESS 1,
// response 3, SETUP->PREADY 9; M > 1: one more on the forward path, 10) and
// rtl/amba/apb4/apb4_slave.sv / apb4_master.sv.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph lattice_latency_worst_case {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Arbitrated variant (M > 1) with a 2-wait-state slave: 6 + 1 + 2 + 3 = 12\nedges", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="150" BORDER="0" ALIGN="RIGHT"><B>pclk cycle</B></TD><TD WIDTH="44" BORDER="0"><B>1</B></TD><TD WIDTH="44" BORDER="0"><B>2</B></TD><TD WIDTH="44" BORDER="0"><B>3</B></TD><TD WIDTH="44" BORDER="0"><B>4</B></TD><TD WIDTH="44" BORDER="0"><B>5</B></TD><TD WIDTH="44" BORDER="0"><B>6</B></TD><TD WIDTH="44" BORDER="0"><B>7</B></TD><TD WIDTH="44" BORDER="0"><B>8</B></TD><TD WIDTH="44" BORDER="0"><B>9</B></TD><TD WIDTH="44" BORDER="0"><B>10</B></TD><TD WIDTH="44" BORDER="0"><B>11</B></TD><TD WIDTH="44" BORDER="0"><B>12</B></TD><TD WIDTH="44" BORDER="0"><B>13</B></TD><TD WIDTH="44" BORDER="0"><B>14</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">master PSEL</TD><TD COLSPAN="13" WIDTH="572" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="44" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">master PENABLE</TD><TD COLSPAN="1" WIDTH="44" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="12" WIDTH="528" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="44" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">slave PSEL</TD><TD COLSPAN="6" WIDTH="264" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="176" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="176" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">slave PENABLE</TD><TD COLSPAN="7" WIDTH="308" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="3" WIDTH="132" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="176" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">slave PREADY</TD><TD COLSPAN="9" WIDTH="396" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="44" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="176" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">master PREADY</TD><TD COLSPAN="12" WIDTH="528" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="44" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="44" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">path</TD><TD COLSPAN="6" WIDTH="264" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">forward (6, incl. grant)</TD><TD COLSPAN="1" WIDTH="44" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">SETUP-&gt;<BR/>ACCESS</TD><TD COLSPAN="2" WIDTH="88" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">wait (2)</TD><TD COLSPAN="1" WIDTH="44" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">slave<BR/>ready</TD><TD COLSPAN="3" WIDTH="132" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">response (3)</TD><TD COLSPAN="1" WIDTH="44" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"> </TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="14" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The registered arbiter grant adds one cycle to the forward path (6 instead of 5). The two<BR ALIGN="LEFT"/>slave wait states pass straight through to the master. With contention, each transfer the<BR ALIGN="LEFT"/>arbiter serves first adds about one back-to-back period (11 cycles) before cycle 1 of this<BR ALIGN="LEFT"/>timeline can make progress.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
