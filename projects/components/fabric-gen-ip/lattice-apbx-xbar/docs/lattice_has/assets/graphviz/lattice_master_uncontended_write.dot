// Lattice master-side uncontended write (replaces an ASCII phase sketch).
// Source of truth: the measured, asserted numbers in
// dv/tests/test_apbx_xbar_timing.py (M = 1: forward 5, downstream SETUP->ACCESS 1,
// response 3, SETUP->PREADY 9; M > 1: one more on the forward path, 10) and
// rtl/amba/apb4/apb4_slave.sv / apb4_master.sv.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph lattice_master_uncontended_write {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Uncontended write at a master port, single-master variant (M = 1):\nPREADY 9 edges after SETUP", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="150" BORDER="0" ALIGN="RIGHT"><B>pclk cycle</B></TD><TD WIDTH="50" BORDER="0"><B>1</B></TD><TD WIDTH="50" BORDER="0"><B>2</B></TD><TD WIDTH="50" BORDER="0"><B>3</B></TD><TD WIDTH="50" BORDER="0"><B>4</B></TD><TD WIDTH="50" BORDER="0"><B>5</B></TD><TD WIDTH="50" BORDER="0"><B>6</B></TD><TD WIDTH="50" BORDER="0"><B>7</B></TD><TD WIDTH="50" BORDER="0"><B>8</B></TD><TD WIDTH="50" BORDER="0"><B>9</B></TD><TD WIDTH="50" BORDER="0"><B>10</B></TD><TD WIDTH="50" BORDER="0"><B>11</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">master APB phase</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>SETUP</B></TD><TD COLSPAN="9" WIDTH="450" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ACCESS</B></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>IDLE</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PSEL</TD><TD COLSPAN="10" WIDTH="500" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PENABLE</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="9" WIDTH="450" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PADDR, PWRITE=1</TD><TD COLSPAN="10" WIDTH="500" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">ADDR, write</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PWDATA, PSTRB</TD><TD COLSPAN="10" WIDTH="500" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">WDATA</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">downstream PSEL</TD><TD COLSPAN="5" WIDTH="250" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="100" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="200" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">downstream PENABLE</TD><TD COLSPAN="6" WIDTH="300" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="200" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">PREADY</TD><TD COLSPAN="9" WIDTH="450" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="5" WIDTH="250" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>down<BR/>SETUP</I></FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>down<BR/>ACCESS</I></FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>rsp<BR/>skid</I></FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>rsp<BR/>mux</I></FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>PREADY</I></FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"> </TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="11" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The crossbar is not the 2-cycle APB minimum: the port converts APB to cmd/rsp (apb4_slave)<BR ALIGN="LEFT"/>and back (apb4_master), through registered skid buffers both ways. Forward path 5 edges<BR ALIGN="LEFT"/>(cycle 1 to the downstream SETUP in cycle 6), downstream ACCESS 1, response 3 (cycle 7 to<BR ALIGN="LEFT"/>cycle 10). A slave with wait states adds them between cycles 7 and 10.<BR ALIGN="LEFT"/>M &gt; 1: the registered arbiter grant adds one cycle, so PREADY lands in cycle 11.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
