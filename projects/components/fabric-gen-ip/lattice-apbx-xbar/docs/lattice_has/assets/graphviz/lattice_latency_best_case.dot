// Lattice best-case latency timeline (replaces an ASCII sketch).
// Source of truth: the measured, asserted numbers in
// dv/tests/test_apbx_xbar_timing.py (M = 1: forward 5, downstream SETUP->ACCESS 1,
// response 3, SETUP->PREADY 9; M > 1: one more on the forward path, 10) and
// rtl/amba/apb4/apb4_slave.sv / apb4_master.sv.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph lattice_latency_best_case {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Best case (M = 1, always-ready slave): 5 forward + 1 + 3 response = 9\nedges SETUP to PREADY", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="150" BORDER="0" ALIGN="RIGHT"><B>pclk cycle</B></TD><TD WIDTH="50" BORDER="0"><B>1</B></TD><TD WIDTH="50" BORDER="0"><B>2</B></TD><TD WIDTH="50" BORDER="0"><B>3</B></TD><TD WIDTH="50" BORDER="0"><B>4</B></TD><TD WIDTH="50" BORDER="0"><B>5</B></TD><TD WIDTH="50" BORDER="0"><B>6</B></TD><TD WIDTH="50" BORDER="0"><B>7</B></TD><TD WIDTH="50" BORDER="0"><B>8</B></TD><TD WIDTH="50" BORDER="0"><B>9</B></TD><TD WIDTH="50" BORDER="0"><B>10</B></TD><TD WIDTH="50" BORDER="0"><B>11</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">master PSEL</TD><TD COLSPAN="10" WIDTH="500" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">master PENABLE</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="9" WIDTH="450" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">slave PSEL</TD><TD COLSPAN="5" WIDTH="250" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="100" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="200" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">slave PENABLE</TD><TD COLSPAN="6" WIDTH="300" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="200" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">slave PREADY</TD><TD COLSPAN="6" WIDTH="300" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="200" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">master PREADY</TD><TD COLSPAN="9" WIDTH="450" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">path</TD><TD COLSPAN="5" WIDTH="250" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">forward (5)</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">SETUP-&gt;<BR/>ACCESS</TD><TD COLSPAN="3" WIDTH="150" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">response (3)</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">done</TD><TD COLSPAN="1" WIDTH="50" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"> </TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="11" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Measured on apbx_xbar_1to1 and asserted by test_apbx_xbar_timing: master SETUP in cycle 1,<BR ALIGN="LEFT"/>downstream PSEL in cycle 6, downstream ACCESS (and PREADY, zero-wait slave) in cycle 7,<BR ALIGN="LEFT"/>master PREADY in cycle 10. Back-to-back transfers repeat every 10 cycles, not 9: the next<BR ALIGN="LEFT"/>SETUP cannot share a cycle with this transfer&#x27;s ACCESS.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
