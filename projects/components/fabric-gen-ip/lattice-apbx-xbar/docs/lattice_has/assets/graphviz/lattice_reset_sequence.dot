// Lattice reset sequence (replaces an ASCII sketch). Phase timeline.
// Source of truth: ch04_interfaces/03_clock_reset.md and ALWAYS_FF_RST in
// rtl/amba/includes/reset_defs.svh (asynchronous assert in every build).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph lattice_reset_sequence {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Lattice reset: asynchronous assert, release synchronous to pclk, one\nidle cycle", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="150" BORDER="0" ALIGN="RIGHT"><B>step</B></TD><TD WIDTH="130" BORDER="0"><B>1</B></TD><TD WIDTH="130" BORDER="0"><B>2</B></TD><TD WIDTH="130" BORDER="0"><B>3</B></TD><TD WIDTH="130" BORDER="0"><B>4</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">phase</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>reset asserted</B></TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>released</B></TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>wait</B></TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ready</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">presetn</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="3" WIDTH="390" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">duration</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">&gt;= 2 pclk cycles</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">on a pclk<BR/>rising edge</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">1 pclk cycle</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">internal state</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">reset values<BR/>(cleared at once)</TD><TD COLSPAN="2" WIDTH="260" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">reset values</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">running</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">outputs</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">PREADY=0, PSEL=0,<BR/>PENABLE=0, grants=0</TD><TD COLSPAN="2" WIDTH="260" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">safe values</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">per traffic</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">transactions</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">aborted /<BR/>not allowed</TD><TD COLSPAN="2" WIDTH="260" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">not allowed</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">allowed</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="4" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Assertion is asynchronous and aborts anything in flight; the reset-safe values hold for as<BR ALIGN="LEFT"/>long as presetn is low. Release presetn synchronously to pclk, then leave one idle cycle.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
