// Lattice in a typical SoC (HAS 2.1): the 2to4 variant. House style:
// vault/handbook/authoring/block-diagrams.md
digraph lattice_system_context {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="1.0", splines=ortho, labelloc=t,
           label="Lattice in a typical SoC - apbx_xbar_2to4 between two APB masters and four peripherals\n(each edge: request down, PREADY / PRDATA / PSLVERR up)"];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7, dir=both];

    cpu [label="CPU\nAPB master 0 (m0_apb_*)", fillcolor="white"];
    dma [label="DMA\nAPB master 1 (m1_apb_*)", fillcolor="white"];
    { rank=same; cpu; dma; }
    cpu -> dma [style=invis, dir=none];

    x [label="Lattice - apbx_xbar_2to4 (pclk / presetn)\naddress decode per master (BASE_ADDR + 64 KB windows),\none round-robin arbiter per slave, response routing", width=6];

    u [label="UART\nslave 0 at\nBASE + 0x0_0000", fillcolor="white"];
    g [label="GPIO\nslave 1 at\nBASE + 0x1_0000", fillcolor="white"];
    t [label="Timer\nslave 2 at\nBASE + 0x2_0000", fillcolor="white"];
    p [label="SPI\nslave 3 at\nBASE + 0x3_0000", fillcolor="white"];
    { rank=same; u; g; t; p; }
    u -> g -> t -> p [style=invis, dir=none];

    cpu -> x [xlabel="APB4"];
    dma -> x [xlabel="APB4"];
    x -> u [xlabel="s0_apb_*"];
    x -> g [xlabel="s1_apb_*"];
    x -> t [xlabel="s2_apb_*"];
    x -> p [xlabel="s3_apb_*"];
}
