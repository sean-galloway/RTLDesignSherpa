// Lattice master-side contended transfer (replaces an ASCII phase sketch).
// Phase timeline: one column per phase, not per cycle.
// Source of truth: the measured, asserted numbers in
// dv/tests/test_apbx_xbar_timing.py (M = 1: forward 5, downstream SETUP->ACCESS 1,
// response 3, SETUP->PREADY 9; M > 1: one more on the forward path, 10) and
// rtl/amba/apb4/apb4_slave.sv / apb4_master.sv.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph lattice_master_contended {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Contended transfer (M > 1): the losing master waits in ACCESS for the\ngrant", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="170" BORDER="0" ALIGN="RIGHT"><B>phase</B></TD><TD WIDTH="128" BORDER="0"><B>1</B></TD><TD WIDTH="128" BORDER="0"><B>2</B></TD><TD WIDTH="128" BORDER="0"><B>3</B></TD><TD WIDTH="128" BORDER="0"><B>4</B></TD><TD WIDTH="128" BORDER="0"><B>5</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">master B port</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>SETUP</B></TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ACCESS, waiting</B></TD><TD COLSPAN="2" WIDTH="256" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ACCESS</B></TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>PREADY</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">PSEL</TD><TD COLSPAN="5" WIDTH="640" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">PENABLE</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="512" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">PREADY</TD><TD COLSPAN="4" WIDTH="512" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">target slave port</TD><TD COLSPAN="2" WIDTH="256" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">busy with A</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">B: SETUP, ACCESS</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">idle (B in the<BR/>response path)</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">idle</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">arbiter grant</TD><TD COLSPAN="2" WIDTH="256" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">A</TD><TD COLSPAN="3" WIDTH="384" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">B</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">duration</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">1 cycle</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">~11 cycles per<BR/>transfer ahead</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">grant (1, registered),<BR/>then B&#x27;s downstream<BR/>transfer</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">3 (response)</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">1 cycle</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="5" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Master B issues while master A owns the target slave. B sits in ACCESS with PREADY low until A&#x27;s<BR ALIGN="LEFT"/>downstream transfer completes and the round-robin arbiter grants B; from then on B sees the<BR ALIGN="LEFT"/>uncontended arbitrated timing. Each transfer queued ahead of B costs about one back-to-back<BR ALIGN="LEFT"/>period (11 cycles on an arbitrated variant), more if the slave inserts wait states.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
