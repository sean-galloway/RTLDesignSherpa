%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart LR
    %% refresh_ctrl is an ACCUMULATOR + drain quota, NOT a multi-state FSM.
    %% (The retired design had a WAIT_BANK_GNTS/DO_REFRESH/ZQCS FSM; there is no
    %% ZQCS for DDR2, and precharge-then-REF now lives in the arbiter.) See dgm 06.

    subgraph CNT["tREFI counter"]
        direction TB
        refi["r_refi_cnt: down-count from t_refi_i<br/>(only ticks when enable_i = init done)"]
        exp["expiry -> reload + pending++"]
        refi --> exp
    end

    subgraph ACC["Pending accumulator (JEDEC max 8 postponed)"]
        direction TB
        pend["r_pending<br/>+1 on tREFI expiry (sat 8)<br/>-1 on refresh_grant"]
        req["refresh_req_o = (r_pending > 0)"]
        pend --> req
    end

    subgraph DRN["Drain quota + REFpb rotor"]
        direction TB
        burst["r_burst_remaining =<br/>min(refresh_burst_i, r_pending)"]
        active["refresh_drain_active_o<br/>(keep granting REF back-to-back)"]
        rotor["bank rotor 0..N-1 in REFpb;<br/>refresh_kind = REFab / REFpb"]
        burst --> active
    end

    exp --> pend
    req --> burst
    active --> arb["pumice_cmd_arbiter:<br/>precharge active banks, then REF + grant"]
    rotor --> arb
    arb -->|refresh_grant| pend
    arb -->|refresh_grant| burst
    arb -->|refresh_grant| rotor
