%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart TD
    %% RETIRED: standalone page_predictor / happy-hybrid history table.
    %% The open-page decision is now INLINE in pumice_cmd_arbiter as a single
    %% ap-bit off page_policy_i. (page_predictor.sv is live but not in the
    %% default build; HAPPY_HYBRID hook is a TODO -> treated as OPEN in v1.)
    col(["arbiter picks a column op<br/>RD / WR for bank B (row-hit)"])
    col --> pol{page_policy_i?}

    pol -->|OPEN| open["w_ap = 0<br/>issue bare RD / WR<br/>(row stays open)"]
    pol -->|CLOSE| close["w_ap = 1<br/>issue RDA / WRA<br/>(auto-precharge every column op)"]
    pol -->|HAPPY_HYBRID| hybrid["v1: page_predictor hook TODO<br/>-> treated as OPEN (w_ap = 0)"]

    open --> emit["cmd_ap_o = w_ap = evt_ap_o<br/>flows to bank_timer set_ap_i"]
    close --> emit
    hybrid --> emit

    emit --> bt["bank_timer.r_ap_pending latches the bit;<br/>see diagram 10 for auto-precharge firing"]

    style open fill:#d4edda,stroke:#228B22
    style close fill:#fff3cd,stroke:#856404
    style hybrid fill:#e2e3f0,stroke:#556
