flowchart TD
    %% Auto-precharge in the live design. No lookahead queue peek anymore:
    %% the arbiter sets the ap bit (from page policy, diagram 09); bank_timer's
    %% r_ap_pending fires the internal precharge once preblk + tRAS elapse.
    issue(["pumice_cmd_arbiter issues a column op<br/>RD/WR to bank B with ap = w_ap"])
    issue --> approbe{"ap bit set?<br/>(policy CLOSE -> RDA/WRA)"}

    approbe -->|"no (OPEN)"| stayopen["row stays open;<br/>no auto-precharge"]
    approbe -->|"yes (RDA/WRA)"| latch["bank_timer.set_ap_i=1<br/>-> r_ap_pending = 1"]

    latch --> load["set_rd/set_wr also loads preblk:<br/>r_preblk = tRTP (RD) / tWR (WR)"]
    load --> wait["timers count down each cycle"]
    wait --> fire{"w_ap_fire = r_ap_pending && r_preblk==0 && r_ras==0 ?"}
    fire -->|no| wait
    fire -->|yes| pre["Internal auto-PRE:<br/>row_valid -> 0, r_ap_pending -> 0,<br/>reload r_rp = tRP"]

    pre --> reopen["bank now precharged;<br/>safe_act asserts after tRP (and tRC)"]

    style stayopen fill:#d4edda,stroke:#228B22
    style pre fill:#fff3cd,stroke:#856404
