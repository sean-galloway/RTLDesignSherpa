%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart LR
    subgraph WR_INTAKE["pumice_wr_intake"]
        slave_wr["axi4_slave_wr<br/>(AW/W/B protocol)"]
        aw_meta["aw_meta_fifo<br/>(gaxi_fifo_sync;<br/>err,id,addr)"]
        wd_fifo["wr_data_fifo<br/>(gaxi_fifo_sync;<br/>last,strb,data)"]
        b_fifo["b_fifo<br/>(resp,id)"]
        map_wr["addr_mapper<br/>(bank_lsb stack + hash,<br/>combinational)"]
    end

    subgraph RD_INTAKE["pumice_rd_intake"]
        slave_rd["axi4_slave_rd<br/>(AR/R protocol)"]
        map_rd["addr_mapper<br/>(combinational)"]
        order_fifo["order_fifo<br/>(source: SNARF/DFI, id)"]
        rd_data_fifo["rd_data_fifo<br/>(resp,last,id,data)"]
    end

    subgraph WR_CAM["pumice_wr_data_cam"]
        wr_entry["CAM entries<br/>valid,bank,row,col,id,age,<br/>ptr,pv,r_fdone,r_sched"]
        wr_sram["wr-data SRAM<br/>[N_SRAM_SLOTS*BL]<br/>+ strb + occupancy"]
    end

    subgraph RD_CAM["pumice_rd_cmd_cam"]
        rd_entry["CAM entries<br/>valid,issued,ready,bank,<br/>row,col,id,resp,age,ptr,pv"]
        rd_sram["rd SRAM<br/>[N_SRAM_SLOTS*BL]<br/>+ occupancy"]
    end

    S_AW[/"s_axi_aw*"/] --> slave_wr
    S_W[/"s_axi_w*"/] --> slave_wr
    S_AR[/"s_axi_ar*"/] --> slave_rd

    slave_wr -- "AW addr" --> map_wr
    slave_wr -- "AW id/err" --> aw_meta
    slave_wr -- "W beats" --> wd_fifo
    map_wr -- "rank,bank,row,col" --> aw_meta

    aw_meta -- "aw_push (ins_valid + bank,row,col,id)" --> wr_entry
    wd_fifo -- "wd fill (data,strb,last)" --> wr_sram

    slave_rd -- "AR addr" --> map_rd
    map_rd -- "rank,bank,row,col" --> order_fifo
    map_rd -- "snarf_probe (bank,row,col,id,len)" --> wr_entry

    wr_entry -- "snarf_hit" --> map_rd
    wr_sram -- "snarf_rd (data,last)" --> rd_data_fifo
    order_fifo -- "ar_push (miss: bank,row,col,id)" --> rd_entry

    rd_data_fifo --> R_OUT["R return"]
    R_OUT --> S_R[/"s_axi_r*"/]
    b_fifo --> S_B[/"s_axi_b*"/]

    wr_entry -- "oldest / sched_lu (bank,row)" --> SCHED[/"pumice_cmd_arbiter"/]
    rd_entry -- "oldest / sched_lu (bank,row)" --> SCHED
    SCHED -. "wr_commit_slot" .-> wr_entry
    SCHED -. "rd_issue_slot" .-> rd_entry

    wr_sram -- "cm_rd (commit-drain)" --> DFIW[/"to DFI wr path"/]
    DFIR[/"DFI rd return"/] -- "dfi_ret (data,resp,last)" --> rd_sram
    wr_entry -- "commit_done (id,resp)" --> b_fifo

    classDef intk fill:#e8f4e8,stroke:#228B22,stroke-width:2px
    classDef cam fill:#f0e8f4,stroke:#7B228B,stroke-width:2px
    classDef sched fill:#e0e8fa,stroke:#3366CC,stroke-width:2px

    class slave_wr,aw_meta,wd_fifo,b_fifo,map_wr,slave_rd,map_rd,order_fifo,rd_data_fifo intk
    class wr_entry,wr_sram,rd_entry,rd_sram cam
    class SCHED sched
