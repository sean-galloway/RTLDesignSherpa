%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart TB
    subgraph IN["Inputs (same cycle) — pumice_cmd_arbiter"]
        initin["init_sequencer<br/>init_done_i,<br/>init_cmd_valid/op/bank/row_i"]
        refin["refresh_ctrl<br/>refresh_req_i,<br/>refresh_drain_i"]
        bankrdy["pumice_bank_timers<br/>bank_act_ready_i,<br/>bank_rdwr_ready_i,<br/>bank_pre_ready_i,<br/>bank_row_active_i,<br/>bank_open_row_i"]
        globrdy["global_timers<br/>tfaw_ok_i, trrd_ok_i (per-rank),<br/>twtr_ok_i, trtw_ok_i, tccd_ok_i"]
        wrlu["wr CAM lookup<br/>wr_lu_hit/slot/col/id/age_i,<br/>wr_oldest_*_i"]
        rdlu["rd CAM lookup<br/>rd_lu_hit/slot/col/id/age_i,<br/>rd_oldest_*_i"]
        cfg["page_policy_i<br/>(inline auto-precharge)"]
    end

    subgraph PRIO["Priority tree (combinational, single-issue)"]
        p1["1. INIT<br/>!init_done_i -><br/>forward init_cmd_* verbatim"]
        p2["2. REFRESH<br/>refresh_req_i || refresh_drain_i:<br/>if any bank active -> PRE lowest<br/>(bank_pre_ready + not guarded)<br/>else -> REF (strobe refresh_grant_o)"]
        p3["3. COLUMN OPS (read-priority)<br/>3a READ row-hit:<br/>rd_lu_hit && bank_rdwr_ready<br/>&& tccd_ok && twtr_ok -> oldest age<br/>3b WRITE row-hit:<br/>wr_lu_hit && bank_rdwr_ready<br/>&& tccd_ok && trtw_ok -> oldest age"]
        p4["4. FALLBACK (rd-oldest first)<br/>bank closed & bank_act_ready<br/>& tfaw_ok & trrd_ok -> ACT<br/>else wrong row & bank_pre_ready -> PRE"]
    end

    subgraph AP["Inline open-page decision"]
        apbit["w_ap = (page_policy_i == PAGE_POLICY_CLOSE)<br/>RD->RDA / WR->WRA when w_ap"]
    end

    subgraph GUARD["2-cycle ACT/PRE guard"]
        g["r_guard0 | r_guard1<br/>(per bank)<br/>on fire ACT/PRE -> set guard,<br/>shift out over 2 cycles;<br/>guarded banks skipped in<br/>refresh PRE + fallback"]
    end

    subgraph OUTB["Outputs (on w_fire = w_valid && cmd_ready_i)"]
        cmd["cmd_valid_o / cmd_op_o /<br/>cmd_rank/bank/row/col_o / cmd_ap_o"]
        evt["evt_act/rd/wr/pre/ap_o +<br/>evt_rank/bank/row_o -> timers"]
        commit["wr_commit_valid/slot_o,<br/>rd_issue_valid/slot_o,<br/>refresh_grant_o"]
    end

    initin --> p1
    refin --> p2
    bankrdy --> p2
    bankrdy --> p3
    bankrdy --> p4
    globrdy --> p3
    globrdy --> p4
    wrlu --> p3
    rdlu --> p3
    wrlu --> p4
    rdlu --> p4

    p1 --> p2
    p2 --> p3
    p3 --> p4

    cfg --> apbit
    p3 --> apbit
    g -.skip guarded.-> p2
    g -.skip guarded.-> p4

    p1 --> cmd
    p2 --> cmd
    p3 --> cmd
    p4 --> cmd
    apbit --> cmd
    cmd --> evt
    cmd --> commit
    evt --> g
    cmd --> FIFO[/"cmd -> gaxi_fifo_sync<br/>-> DFI layer"/]

    classDef inblock fill:#f0f0f0,stroke:#666666,stroke-width:2px
    classDef prio fill:#e8f4e8,stroke:#228B22,stroke-width:2px
    classDef apb fill:#fef0e0,stroke:#B88B22,stroke-width:2px
    classDef guard fill:#f0e8f4,stroke:#7B228B,stroke-width:2px
    classDef outblock fill:#e0e8fa,stroke:#3366CC,stroke-width:2px

    class initin,refin,bankrdy,globrdy,wrlu,rdlu,cfg inblock
    class p1,p2,p3,p4 prio
    class apbit apb
    class g guard
    class cmd,evt,commit outblock
