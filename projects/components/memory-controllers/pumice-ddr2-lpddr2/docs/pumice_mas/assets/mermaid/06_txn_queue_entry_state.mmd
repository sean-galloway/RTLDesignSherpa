classDiagram
    note "txn_queue is RETIRED.\nTransaction state now lives as per-slot fields\nin the two CAMs (pumice_wr_data_cam / pumice_rd_cmd_cam).\nStreaming readers are beat-counter movers, NOT slot-state FSMs."

    class pumice_wr_data_cam_entry {
        r_valid : entry occupied
        r_bank / r_row / r_col : DRAM address
        r_id : AXI write ID
        r_age : insertion timestamp (wrap-safe)
        r_ptr / r_pv : wr-data SRAM slot + ptr_valid
        r_fdone : FILL COMPLETE (wd_last seen)
        r_sched : scheduled (set by commit_valid)
    }

    class pumice_rd_cmd_cam_entry {
        r_valid : entry occupied
        r_bank / r_row / r_col : DRAM address
        r_id : AXI read ID
        r_age : insertion timestamp (wrap-safe)
        r_ptr / r_pv : rd SRAM slot + ptr_valid
        r_issued : command issued (set by issue_valid)
        r_ready : all BL beats returned (dfi_ret_last)
        r_resp : DFI response (captured on last)
    }

    class wr_sram {
        r_sram[N_SRAM_SLOTS*BL] : burst data
        r_strb[N_SRAM_SLOTS*BL] : byte strobes
        r_sram_occ : slot occupancy
        movers : fill / commit-drain / snarf
    }

    class rd_sram {
        r_sram[N_SRAM_SLOTS*BL] : return data
        r_sram_occ : slot occupancy
        movers : return-fill / drain (oldest-first)
    }

    pumice_wr_data_cam_entry --> wr_sram : r_ptr indexes
    pumice_rd_cmd_cam_entry --> rd_sram : r_ptr indexes
