%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart LR
    subgraph IN["Event strobes from pumice_cmd_arbiter"]
        evt_act["evt_act_i<br/>(+ evt_act_rank_i)"]
        evt_rd["evt_rd_i"]
        evt_wr["evt_wr_i"]
    end

    subgraph CFG["Timing config (CSR)"]
        c["t_faw_i, t_rrd_i,<br/>t_wtr_global_i,<br/>t_rtw_i, t_ccd_i"]
    end

    subgraph PER_RANK["Per-rank trackers (NUM_RANKS copies)"]
        faw["r_faw_slots[rank][4]<br/>(tFAW: 4-deep sliding window;<br/>load smallest slot on ACT)"]
        rrd["r_trrd_cnt[rank]<br/>(tRRD: reload on ACT to rank)"]
    end

    subgraph GLOBAL["Global trackers (1 copy — shared DQ bus)"]
        wtr["r_twtr_cnt<br/>(tWTR: WR -> RD)"]
        rtw["r_trtw_cnt<br/>(tRTW: RD -> WR)"]
        ccd["r_tccd_cnt<br/>(tCCD: any col cmd)"]
    end

    subgraph OUT["Readiness back to arbiter"]
        o_faw["tfaw_window_ok_o[rank]"]
        o_rrd["trrd_window_ok_o[rank]"]
        o_wtr["twtr_global_ok_o"]
        o_rtw["trtw_window_ok_o"]
        o_ccd["tccd_window_ok_o"]
    end

    evt_act --> faw
    evt_act --> rrd
    evt_rd --> ccd
    evt_rd --> wtr
    evt_wr --> ccd
    evt_wr --> rtw
    c --> faw
    c --> rrd
    c --> wtr
    c --> rtw
    c --> ccd

    faw --> o_faw
    rrd --> o_rrd
    wtr --> o_wtr
    rtw --> o_rtw
    ccd --> o_ccd

    o_faw --> ARB[/"pumice_cmd_arbiter<br/>tfaw_ok_i / trrd_ok_i (per-rank)<br/>twtr_ok_i / trtw_ok_i / tccd_ok_i"/]
    o_rrd --> ARB
    o_wtr --> ARB
    o_rtw --> ARB
    o_ccd --> ARB

    classDef inblock fill:#f0f0f0,stroke:#666666,stroke-width:2px
    classDef cfgb fill:#f0e8f4,stroke:#7B228B,stroke-width:2px
    classDef perrank fill:#e8f4e8,stroke:#228B22,stroke-width:2px
    classDef glb fill:#fef0e0,stroke:#B88B22,stroke-width:2px
    classDef outblock fill:#e0e8fa,stroke:#3366CC,stroke-width:2px

    class evt_act,evt_rd,evt_wr inblock
    class c cfgb
    class faw,rrd perrank
    class wtr,rtw,ccd glb
    class o_faw,o_rrd,o_wtr,o_rtw,o_ccd outblock
