%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart TB
    subgraph GEARED["pumice_top_geared (rtl/top) — OPTIONAL host-width wrapper"]
        dwc["axi4_dwidth_converter_wr/_rd<br/>(formal IP; only when<br/>HOST_AXI_DATA_WIDTH != DW)"]

        subgraph TOP["pumice_top (rtl/top)"]
            csr["pumice_csr<br/>(PeakRDL cpuif;<br/>memtype, page_policy,<br/>timings, phases)"]

            subgraph CORE["pumice_core (rtl/top)"]

                subgraph IFC["pumice_axi4_ifc (rtl/macro)"]
                    wr_intake["pumice_wr_intake<br/>(axi4_slave_wr +<br/>AW-meta FIFO +<br/>wr-data FIFO + addr_mapper)"]
                    rd_intake["pumice_rd_intake<br/>(axi4_slave_rd +<br/>addr_mapper + snarf probe)"]
                    wr_cam["pumice_wr_data_cam<br/>(WR CAM + wr-data SRAM;<br/>fill / commit-drain / snarf)"]
                    rd_cam["pumice_rd_cmd_cam<br/>(RD CAM + rd SRAM;<br/>return-fill / drain)"]
                end

                subgraph SCHED["pumice_mem_cmd_scheduler (rtl/macro)"]
                    arb["pumice_cmd_arbiter<br/>(single pick core;<br/>open-page INLINE)"]
                    bank_timers["pumice_bank_timers<br/>-> bank_timer[rank][bank]<br/>(FSM-free JEDEC timers)"]
                    global_timers["global_timers<br/>(tFAW/tRRD per-rank,<br/>tWTR/tRTW/tCCD global)"]
                    refresh["refresh_ctrl<br/>(tREFI drain quota)"]
                    init_seq["init_sequencer<br/>(DDR2 + LPDDR2 MR init)"]
                    mode_reg["mode_register<br/>(CL/CWL/BL/AL decode)"]
                end

                subgraph DFI["pumice_dfi_layer (rtl/macro)"]
                    dfi_cdc["pumice_dfi_cdc<br/>(SINGLE CDC;<br/>async gaxi FIFOs)"]
                    dfi_cmd["pumice_dfi_cmd_path<br/>(+ dfi_cmd_formatter<br/>+ dfi_signal_pack)"]
                    dfi_wr["pumice_dfi_wr_serializer"]
                    dfi_rd["pumice_dfi_rd_aligner"]
                end
            end
        end
    end

    HOST[/"Host AXI4 Slave Port<br/>(HOST_AXI_DATA_WIDTH)"/] --> dwc
    dwc -- "DW-width AXI" --> wr_intake
    dwc -- "DW-width AXI" --> rd_intake

    wr_intake -- "aw_push / wd fill" --> wr_cam
    rd_intake -- "ar_push" --> rd_cam
    rd_intake -- "snarf_probe" --> wr_cam
    wr_cam -- "snarf_rd data" --> rd_intake

    wr_cam -- "oldest / sched_lu" --> arb
    rd_cam -- "oldest / sched_lu" --> arb
    arb -- "wr_commit" --> wr_cam
    arb -- "rd_issue" --> rd_cam

    arb -- "evt_* strobes" --> bank_timers
    bank_timers -- "bank_*_ready" --> arb
    arb -- "evt_act/rd/wr" --> global_timers
    global_timers -- "t*_ok" --> arb
    refresh <-- "req / grant" --> arb
    init_seq -- "init_cmd" --> arb
    init_seq -- "mr_seq" --> mode_reg
    mode_reg -- "cl/cwl/bl" --> arb

    arb -- "cmd stream<br/>(op,rank,bank,row,col,ap)" --> dfi_cdc
    wr_cam -- "cm_rd (commit-drain data)" --> dfi_cdc
    dfi_cdc -- "rd return data" --> rd_cam

    dfi_cdc --> dfi_cmd
    dfi_cdc --> dfi_wr
    dfi_rd --> dfi_cdc
    dfi_cmd -- "wr_fire" --> dfi_wr
    dfi_cmd -- "rd_fire" --> dfi_rd

    dfi_cmd --> DFIPIN[/"DFI v2.1 Master Port<br/>(to PHY)"/]
    dfi_wr --> DFIPIN
    dfi_rd <--> DFIPIN

    CPUIF[/"cpuif CSR Port<br/>(config)"/] --> csr
    csr -.config.-> arb
    csr -.config.-> refresh
    csr -.memtype / phases.-> dfi_cmd

    classDef ifc fill:#e8f4e8,stroke:#228B22,stroke-width:2px
    classDef sched fill:#f0e8f4,stroke:#7B228B,stroke-width:2px
    classDef dfi fill:#e0e8fa,stroke:#3366CC,stroke-width:2px
    classDef cfg fill:#f0f0f0,stroke:#666666,stroke-width:2px

    class wr_intake,rd_intake,wr_cam,rd_cam ifc
    class arb,bank_timers,global_timers,refresh,init_seq,mode_reg sched
    class dfi_cdc,dfi_cmd,dfi_wr,dfi_rd dfi
    class csr,dwc cfg
