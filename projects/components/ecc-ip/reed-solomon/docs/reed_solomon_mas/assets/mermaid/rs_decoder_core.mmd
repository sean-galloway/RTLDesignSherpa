flowchart TB
    subgraph IN["Intake"]
        in_valid["in_valid"]
        in_data["in_data[DATA_WIDTH-1:0]"]
        in_keep["in_keep[S-1:0]"]
        in_last["in_last"]
        in_eras["in_erasure[S-1:0]"]
    end

    subgraph DEC["rs_decoder_core"]
        subgraph STAGE_A["Stage A: receive"]
            blk_fifo["block FIFO\n{keep, data}"]
            synd_a["syndrome_unit\nreceive"]
            rec_a["erasure record half\n(ERASURE_SUPPORT only)"]
            dab["descriptor A->B skid\n{len, frame_err, all_zero, synd, [erasure]}"]
        end

        subgraph STAGE_B["Stage B: solve"]
            er_unit["rs_erasure_unit\n(ERASURE_SUPPORT only)"]
            kes["key_equation_solver\nriBM or Euclid"]
            b_fsm["B solve FSM\nIDLE / (TRANS) / SOLVE / (COMB) / PUSH"]
            dbc["descriptor B->C skid\n{len, frame_err, all_zero, correct, bad, deg, lambda, omega}"]
        end

        subgraph STAGE_C["Stage C: correct"]
            chien["chien_search"]
            forney["forney_evaluator"]
            c1["C1 pipeline register\n{rx, correction, hit, flags}"]
            rechk["syndrome_unit\nre-check"]
            out_fifo["output FIFO\n{last, keep, hit, correction, rx}"]
            status["status pipeline\nC1->C2 snapshot / C3 verdict"]
            c_fsm["C walk FSM\nIDLE / WALK"]
        end
    end

    subgraph OUT["Outlet"]
        out_valid["out_valid"]
        out_data["out_data[DATA_WIDTH-1:0]"]
        out_keep["out_keep[S-1:0]"]
        out_last["out_last"]
        out_status["out_status_*"]
    end

    in_valid --> blk_fifo
    in_data --> blk_fifo
    in_keep --> blk_fifo
    in_last --> dab
    in_data --> synd_a
    in_keep --> synd_a
    in_last --> synd_a
    in_eras --> rec_a
    rec_a --> dab
    synd_a --> dab
    blk_fifo --> c1
    dab --> b_fsm
    dab --> er_unit
    dab --> kes
    er_unit --> kes
    kes --> dbc
    er_unit --> dbc
    b_fsm --> dab
    b_fsm --> kes
    b_fsm --> er_unit
    b_fsm --> dbc
    dbc --> c_fsm
    dbc --> chien
    dbc --> forney
    chien --> forney
    chien --> c1
    forney --> c1
    c1 --> rechk
    c1 --> out_fifo
    rechk --> status
    c_fsm --> chien
    c_fsm --> forney
    c_fsm --> c1
    c_fsm --> status
    out_fifo --> out_data
    out_fifo --> out_valid
    out_fifo --> out_keep
    out_fifo --> out_last
    status --> out_status
