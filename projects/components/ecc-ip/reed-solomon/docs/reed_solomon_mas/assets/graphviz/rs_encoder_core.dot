// rs_encoder_core - MAS Figure 2.1.
// House style: vault/handbook/authoring/block-diagrams.md.
// One flow: data beats down the center into the output select, which
// passes them through (systematic) and then emits the parity the
// gf_lfsr_encoder holds. The phase counters form a control column on
// the left: they shift the LFSR during the drain and steer the select;
// frame_err leaves straight down that column.
// Source of truth: rtl/macro/rs_encoder_core.sv, rtl/fub/gf/gf_lfsr_encoder.sv.
digraph rs_encoder_core {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.55", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="rs_encoder_core - systematic RS encoder, S symbols per beat (on aclk)";

    in   [label="Input Beat\nin_valid / in_ready, in_data (S symbols),\nin_keep (low-aligned), in_last", fillcolor="white", group=C];

    ctl  [label="Phase Counters (flops)\nr_drain, r_count, r_drain_left\nin_ready = !r_drain and skid ready\nframe_err = in_last and count != k", group=L];
    p_in [shape=point, width=0.01, group=C];
    p_l  [shape=point, width=0.01, group=R];
    lfsr [label="Parity LFSR\ngf_lfsr_encoder - u_lfsr\ni_step: keep-count symbols divide by g(x)\ni_shift: S parity symbols out, zero feedback\n(2t m-bit stages, flops)", group=R];
    sel  [label="Output Select (combinational)\nDATA: input beat, out_last = 0\nDRAIN: ow_parity, partial keep on the\nlast parity beat, which sets out_last", group=C];
    skid [label="Output Skid\ngaxi_skid_buffer - u_out_skid\n{last, keep, data}, SKID_DEPTH", group=C];

    bar  [label="Outputs (registered through the skid)\nout_valid / out_ready, out_data, out_keep, out_last   |   frame_err (pulse)",
          fillcolor="white", width=8.0];

    // ---- main flow ----
    in   -> p_in [arrowhead=none, headclip=false];
    p_in -> sel  [tailclip=false, xlabel="data beat\n(passes unchanged)"];
    p_in -> p_l  [arrowhead=none, tailclip=false, headclip=false];
    p_l  -> lfsr [tailclip=false, xlabel="data symbols\n(i_step)"];
    lfsr -> sel  [xlabel="parity symbols"];
    sel  -> skid [xlabel="data, then parity"];
    skid -> bar  [xlabel="coded beats", penwidth=1.8];

    // ---- control ----
    in   -> ctl  [style=dashed, xlabel="keep, last"];
    ctl  -> sel  [style=dashed, xlabel="phase\n(DATA / DRAIN)"];
    ctl  -> lfsr [style=dashed, constraint=false, headlabel="i_shift: each\ndrain beat", labelangle=-15, labeldistance=7];
    skid -> ctl  [style=dashed, constraint=false, xlabel="skid ready"];
    ctl  -> bar  [xlabel="frame_err"];

    sp [label="", width=1.2, style=invis];
    { rank=same; ctl; p_in; p_l; }
    { rank=same; lfsr; sp; }
    ctl -> p_in -> p_l [style=invis];
    sp -> lfsr [style=invis];
}
