// rs_ribm_solver - MAS Figure 2.3 (key_equation_solver_ribm).
// House style: vault/handbook/authoring/block-diagrams.md.
// One flow: the syndromes are loaded into the 3t+1 processing-element
// array (one counted box, the "N identical stages" ruling), the array
// iterates 2t times, and the readout takes Lambda, Omega and the degree
// off it. The discrepancy Delta~_0 climbs the right edge into the
// iteration control, which broadcasts gamma, delta and swap back down
// (dashed). The erasure kill is build-dependent and dashed.
// Source of truth: rtl/fub/key_equation_solver_ribm.sv, rtl/fub/gf/ribm_pe.sv.
digraph rs_ribm_solver {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.55", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="key_equation_solver_ribm - reformulated inversionless Berlekamp-Massey, 2t iterations (on aclk)";

    in    [label="Solver Input\ni_start (load and run)\ni_synd: S_0 .. S_2t-1", fillcolor="white", group=C];
    er    [label="Erasure Count\ni_erasure_count f\n(ERASURE_SUPPORT=1 only)", fillcolor="white", style="filled,dashed", group=R];

    init  [label="Initial Values (combinational)\ncell i < 2t: S_i  |  2t <= i < 3t: 0  |  cell 3t: 1", group=C];
    ctl   [label="Iteration Control (flops)\nr_iter 0 .. 2t-1, r_gamma, r_k\nswap = (delta != 0) and (k >= 0)\nkill: delta = 0 for the last f iterations", group=R];
    arr   [label="PE Array (flops)\n(3t+1) x ribm_pe - g_pe[i].u_pe\nDelta_i <- gamma * Delta_i+1 ^ delta * Theta_i\nTheta_i <- swap ? Delta_i+1 : Theta_i\n(two gf_mul per PE, no carry across the array)", group=C, width=4.6];
    rd    [label="Readout + Degree Scan (combinational)\nLambda = cells t .. 3t,  Omega = cells 0 .. t-1\ndegree = highest nonzero Lambda_j;  deg_err = any of Lambda_t+1 .. 2t", group=C];

    bar   [label="Outputs (hold until the next i_start)\no_lambda (2t+1 coefficients)   |   o_omega (t, the HIGH half of S*Lambda)   |   o_deg, o_deg_err   |   o_done, o_busy",
           fillcolor="white", width=10.0];

    in    -> init  [xlabel="syndromes"];
    init  -> arr   [xlabel="i_start: load\nDelta~ = Theta~ = init"];
    arr   -> rd    [xlabel="Delta~ after 2t steps"];
    rd    -> bar   [xlabel="Lambda, Omega, degree", penwidth=1.8];

    // discrepancy climbs the right edge into control
    p_f1 [shape=point, width=0.01, group=F];
    p_f2 [shape=point, width=0.01, group=F];
    arr   -> p_f2 [arrowhead=none, headclip=false];
    p_f1  -> p_f2 [dir=none, tailclip=false, headclip=false, xlabel="Delta~_0\n(discrepancy)"];
    p_f1  -> ctl  [tailclip=false];

    ctl   -> arr   [style=dashed, xlabel="gamma, delta, swap\n(broadcast, every cycle)"];
    er    -> ctl   [style=dashed, xlabel="f"];
    ctl   -> bar   [xlabel="o_done after 2t"];

    { rank=same; in; er; }
    { rank=same; init; ctl; p_f1; }
    { rank=same; arr; p_f2; }
    in -> er [style=invis];
    init -> ctl -> p_f1 [style=invis];
}
