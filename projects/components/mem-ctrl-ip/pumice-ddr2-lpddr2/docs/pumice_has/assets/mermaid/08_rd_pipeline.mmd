flowchart LR
    %% Read path: pumice_rd_intake -> pumice_rd_cmd_cam (return-fill / oldest-drain,
    %% reorder buffer) -> pumice_dfi_rd_aligner -> AXI R. De-FSM'd streaming movers.
    ar[/"AXI4 AR<br/>(from SoC)"/]

    subgraph INTAKE["pumice_rd_intake"]
        direction TB
        slv["axi4_slave_rd"]
        amap["addr_mapper<br/>(axi_addr -> bank/row/col via bank_lsb)"]
        snarfp["snarf probe<br/>(hit in wr_data_cam? take forwarded data)"]
        slv --> amap --> snarfp
    end

    subgraph CAM["pumice_rd_cmd_cam (RD CAM + rd SRAM = reorder buffer)"]
        direction TB
        entry["CAM entry {bank,row,col} + age<br/>(insert in AR order)"]
        rfill["return-fill mover<br/>(DFI read return -> entry SRAM, issue order)"]
        drain["oldest-drain mover<br/>(oldest valid, gated data-ready -> AR-order release)"]
        entry --> rfill --> drain
    end

    ar --> slv
    amap --> entry
    entry -. bank/row/col + age .-> arb["pumice_cmd_arbiter<br/>(picks RD / RDA, read-priority; evt_rd -> issue_slot)"]
    arb -. issue_slot .-> entry

    dfi[/"DFI rddata / rddata_valid<br/>(from PHY)"/] --> cdc["pumice_dfi_cdc<br/>(single CDC)"]
    cdc --> align["pumice_dfi_rd_aligner<br/>(CL-align phase beats -> DFI word)"]
    align --> rfill

    drain --> r[/"AXI4 R channel<br/>(rlast on final beat)"/]
    snarfp -. write-forwarded read .-> r
