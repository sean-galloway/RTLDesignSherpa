%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart LR
    subgraph CFG["Config (CSR + init)"]
        refi["t_refi_i<br/>(refresh interval)"]
        burst["refresh_burst_i<br/>(drain quota; JEDEC max 8)"]
        mode["refpb_mode_i<br/>(0 = REFab, 1 = REFpb)"]
        en["enable_i<br/>(gated off during init)"]
    end

    subgraph FLOW["refresh_ctrl.sv — tREFI accumulator + drain quota"]
        cnt["r_refi_cnt<br/>(tREFI countdown;<br/>ticks only when enable_i)"]
        pend["r_pending<br/>(accumulator; +1 on tREFI expiry,<br/>saturate at 8; -1 on grant)"]
        drain["r_burst_remaining<br/>(drain quota;<br/>load min(burst, pending),<br/>-1 on grant)"]
        rotor["r_bank_rotor<br/>(REFpb only; ++ on grant,<br/>wrap 0..NUM_BANKS-1;<br/>stays 0 in REFab)"]
    end

    subgraph OUT["To pumice_cmd_arbiter"]
        req["refresh_req_o<br/>(pending > 0)"]
        drainact["refresh_drain_active_o<br/>(quota remaining && pending>0)"]
        kind["refresh_kind_o<br/>(REFab / REFpb)"]
        bank["refresh_bank_o<br/>(rotor; REFpb)"]
    end

    grant[/"refresh_grant_i<br/>(one refresh issued)"/]

    refi --> cnt
    en --> cnt
    cnt -- "expiry" --> pend
    burst --> drain
    pend --> drain
    mode --> kind
    mode --> rotor

    pend --> req
    drain --> drainact
    pend --> drainact
    rotor --> bank

    grant --> pend
    grant --> drain
    grant --> rotor

    req --> ARB[/"pumice_cmd_arbiter<br/>(priority 2: REFRESH)"/]
    drainact --> ARB
    kind --> ARB
    bank --> ARB

    NOTE["DARP (idle-aware age-priority selector) is RETIRED.<br/>Refresh is now a simple tREFI accumulator with a<br/>drain quota; REFpb uses a cyclic bank rotor."]

    classDef cfgb fill:#f0e8f4,stroke:#7B228B,stroke-width:2px
    classDef flow fill:#e8f4e8,stroke:#228B22,stroke-width:2px
    classDef outblock fill:#e0e8fa,stroke:#3366CC,stroke-width:2px
    classDef ret fill:#f0f0f0,stroke:#B03030,stroke-width:2px

    class refi,burst,mode,en cfgb
    class cnt,pend,drain,rotor flow
    class req,drainact,kind,bank outblock
    class NOTE ret
