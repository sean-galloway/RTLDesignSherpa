%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart TB
    subgraph CORE["pumice_core"]

        subgraph IFC["pumice_axi4_ifc"]
            wr_intake["pumice_wr_intake<br/>(axi4_slave_wr +<br/>AW-meta FIFO + wr-data FIFO +<br/>addr_mapper)"]
            rd_intake["pumice_rd_intake<br/>(axi4_slave_rd +<br/>addr_mapper + snarf probe)"]
            wr_data_cam["pumice_wr_data_cam<br/>(WR CAM + wr-data SRAM;<br/>fill / commit-drain / snarf)"]
            rd_cmd_cam["pumice_rd_cmd_cam<br/>(RD CAM + rd SRAM;<br/>return-fill / oldest-drain)"]
        end

        subgraph SCHED["pumice_mem_cmd_scheduler"]
            cmd_arbiter["pumice_cmd_arbiter<br/>(single pick core;<br/>open-page decision INLINE)"]
            bank_timers["pumice_bank_timers<br/>(stamps bank_timer per rank,bank;<br/>FSM-free JEDEC safe_* timers)"]
            global_timers["global_timers<br/>(tFAW/tRRD/tWTR/tRTW/tCCD)"]
            refresh_ctrl["refresh_ctrl<br/>(tREFI accumulator + drain)"]
            init_sequencer["init_sequencer<br/>(DDR2 + LPDDR2 JEDEC MR init)"]
            mode_register["mode_register<br/>(CL/CWL/BL/AL decode)"]
        end

        subgraph DFI["pumice_dfi_layer"]
            dfi_cdc["pumice_dfi_cdc<br/>(SINGLE clock-domain crossing;<br/>async gaxi FIFOs)"]
            dfi_cmd_path["pumice_dfi_cmd_path<br/>(+ dfi_cmd_formatter + dfi_signal_pack)"]
            dfi_wr_ser["pumice_dfi_wr_serializer"]
            dfi_rd_align["pumice_dfi_rd_aligner"]
        end

    end

    AXI[/"AXI4 Slave Port<br/>(from SoC; fixed DW)"/] --> wr_intake
    AXI --> rd_intake

    wr_intake --> wr_data_cam
    rd_intake --> rd_cmd_cam
    wr_data_cam -. snarf forward .-> rd_intake

    wr_data_cam --> cmd_arbiter
    rd_cmd_cam --> cmd_arbiter
    bank_timers <--> cmd_arbiter
    global_timers <--> cmd_arbiter
    refresh_ctrl <--> cmd_arbiter
    init_sequencer --> cmd_arbiter
    mode_register --> cmd_arbiter
    init_sequencer --> mode_register

    cmd_arbiter --> dfi_cdc
    wr_data_cam -. commit-drain wrdata .-> dfi_wr_ser
    dfi_rd_align -. return-fill rddata .-> rd_cmd_cam

    dfi_cdc --> dfi_cmd_path
    dfi_cdc <--> dfi_wr_ser
    dfi_cdc <--> dfi_rd_align
    dfi_cmd_path --> DFI[/"DFI v2.1 Master Port<br/>(to PHY)"/]
    dfi_wr_ser --> DFI
    dfi_rd_align --> DFI
