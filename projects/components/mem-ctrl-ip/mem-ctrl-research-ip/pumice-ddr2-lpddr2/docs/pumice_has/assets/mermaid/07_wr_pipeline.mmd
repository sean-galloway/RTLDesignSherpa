%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart LR
    %% Write path: pumice_wr_intake -> pumice_wr_data_cam (fill/commit-drain/snarf)
    %% -> pumice_dfi_wr_serializer -> DFI. De-FSM'd streaming movers.
    aw[/"AXI4 AW + W<br/>(from SoC)"/]

    subgraph INTAKE["pumice_wr_intake"]
        direction TB
        slv["axi4_slave_wr<br/>+ AW-meta FIFO + wr-data FIFO"]
        amap["addr_mapper<br/>(axi_addr -> bank/row/col via bank_lsb)"]
        slv --> amap
    end

    subgraph CAM["pumice_wr_data_cam (WR CAM + wr-data SRAM)"]
        direction TB
        fill["fill mover<br/>(burst data -> SRAM slot on insert)"]
        entry["CAM entry {bank,row,col} + age<br/>r_fdone gates schedulability"]
        snarf["snarf mover<br/>(read-your-write forward: unscheduled,<br/>same-id, same-BL -> rd path)"]
        commit["commit-drain mover<br/>(oldest-per-row -> DFI wrdata beats)"]
        fill --> entry
        entry --> snarf
        entry --> commit
    end

    aw --> slv
    amap --> fill
    entry -. bank/row/col + age .-> arb["pumice_cmd_arbiter<br/>(picks WR / WRA; evt_wr -> commit_slot)"]
    arb -. commit_slot .-> commit

    commit --> ser["pumice_dfi_wr_serializer<br/>(DFI word -> phase beats, wrdata_en)"]
    ser --> cdc["pumice_dfi_cdc<br/>(single CDC)"]
    cdc --> dfi[/"DFI wrdata / wrdata_en<br/>(to PHY)"/]

    snarf -. forwarded data .-> rdp["pumice_rd_intake<br/>(R return)"]
