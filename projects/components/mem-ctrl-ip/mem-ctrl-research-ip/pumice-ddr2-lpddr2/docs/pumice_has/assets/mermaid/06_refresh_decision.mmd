%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart TD
    %% refresh_ctrl (rtl/fub/refresh_ctrl.sv): tREFI countdown -> pending
    %% accumulator (max 8) -> drain quota. The arbiter does precharge-then-REF.
    en{"enable_i<br/>(init done)?"}
    en -->|no| hold["Hold r_refi_cnt = t_refi_i<br/>(no ticks until init completes)"]
    en -->|yes| tick["r_refi_cnt counts down from t_refi_i"]

    tick --> exp{r_refi_cnt == 0?}
    exp -->|no| tick
    exp -->|yes| accum["r_pending++ (saturate at 8)<br/>reload r_refi_cnt = t_refi_i"]

    accum --> req["refresh_req_o = (r_pending > 0)"]
    req --> drain["Drain quota:<br/>load min(refresh_burst_i, r_pending)<br/>refresh_drain_active_o high"]

    drain --> kind{refpb_mode_i?}
    kind -->|"0 = REFab (DDR2)"| refab["refresh_kind = REFab<br/>refresh_bank = 0"]
    kind -->|"1 = REFpb (LPDDR2)"| refpb["refresh_kind = REFpb<br/>bank rotor 0..NUM_BANKS-1 per grant"]

    refab --> arb
    refpb --> arb

    subgraph ARB["pumice_cmd_arbiter (priority 2: refresh)"]
        direction TB
        anyact{any bank active?}
        anyact -->|yes| pre["Issue PRE to an active bank<br/>(one per cycle)"]
        anyact -->|no| ref["Issue REF (w_ref_safe: guards clear + tRFC met) + pulse refresh_grant"]
        pre --> anyact
    end

    arb["arbiter sees refresh_req / drain_active"] --> ARB
    ref --> dec["refresh_grant -> r_pending--<br/>burst_remaining-- ; bank rotor advances"]
    dec --> req
