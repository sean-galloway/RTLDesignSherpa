%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart LR
    subgraph IN["Inputs (per-bank, from pumice_bank_timers fan-out)"]
        sets["set_act_i / set_rd_i /<br/>set_wr_i / set_pre_i<br/>(rank/bank-gated evt_* strobes)"]
        setap["set_ap_i<br/>(broadcast; auto-precharge bit)"]
        rowi["row_i<br/>(captured on ACT)"]
        cfg["t_rcd_i / t_ras_i / t_rc_i /<br/>t_rp_i / t_wr_i / t_rtp_i"]
    end

    subgraph CORE["bank_timer.sv internals — NO STATE MACHINE"]
        subgraph TIMERS["Preset / decrement countdown timers"]
            rcd["r_rcd (tRCD)<br/>reload on set_act"]
            ras["r_ras (tRAS)<br/>reload on set_act"]
            rc["r_rc (tRC)<br/>reload on set_act"]
            rp["r_rp (tRP)<br/>reload on set_pre / ap_fire"]
            preblk["r_preblk (tRTP/tWR)<br/>reload on set_rd / set_wr"]
        end
        row_valid["r_row_valid<br/>(1 = row open)"]
        open_row["r_open_row<br/>(active row)"]
        ap_pend["r_ap_pending<br/>(auto-precharge queued)"]
        apfire["w_ap_fire =<br/>r_ap_pending &&<br/>(r_preblk==0) && (r_ras==0)<br/>-> closes row, loads tRP"]
    end

    subgraph OUT["Combinational safe_* (single register stage behind timers)"]
        safe_act["safe_act_o =<br/>!r_row_valid && rp==0 && rc==0"]
        safe_rd["safe_rd_o =<br/>row_valid && rcd==0 && !ap_pending"]
        safe_wr["safe_wr_o = safe_rd_o"]
        safe_pre["safe_pre_o =<br/>row_valid && ras==0<br/>&& preblk==0 && !ap_pending"]
        row_out["row_valid_o / open_row_o<br/>-> arbiter row-hit compare"]
        state_out["state_o (IDLE/ACTIVATING/<br/>ACTIVE/PRECHARGING;<br/>DERIVED, observability only)"]
    end

    sets --> rcd
    sets --> ras
    sets --> rc
    sets --> rp
    sets --> preblk
    sets --> row_valid
    rowi --> open_row
    setap --> ap_pend
    cfg --> rcd
    cfg --> ras
    cfg --> rc
    cfg --> rp
    cfg --> preblk

    ap_pend --> apfire
    preblk --> apfire
    ras --> apfire
    apfire --> row_valid
    apfire --> rp

    row_valid --> safe_act
    rp --> safe_act
    rc --> safe_act
    row_valid --> safe_rd
    rcd --> safe_rd
    ap_pend --> safe_rd
    safe_rd --> safe_wr
    row_valid --> safe_pre
    ras --> safe_pre
    preblk --> safe_pre
    ap_pend --> safe_pre
    row_valid --> row_out
    open_row --> row_out
    row_valid --> state_out
    rcd --> state_out
    rp --> state_out

    classDef inblock fill:#f0f0f0,stroke:#666666,stroke-width:2px
    classDef tmr fill:#fef0e0,stroke:#B88B22,stroke-width:2px
    classDef reg fill:#e8f4e8,stroke:#228B22,stroke-width:2px
    classDef outblock fill:#e0e8fa,stroke:#3366CC,stroke-width:2px

    class sets,setap,rowi,cfg inblock
    class rcd,ras,rc,rp,preblk tmr
    class row_valid,open_row,ap_pend,apfire reg
    class safe_act,safe_rd,safe_wr,safe_pre,row_out,state_out outblock
