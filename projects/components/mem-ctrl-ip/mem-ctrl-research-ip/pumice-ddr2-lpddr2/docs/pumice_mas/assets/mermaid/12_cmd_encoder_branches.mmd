%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart TB
    subgraph IN["Inputs (from CDC cmd FIFO / CSR)"]
        cmd["cmd_valid_i, cmd_op_i<br/>(OP_NOP/ACT/RD/RDA/WR/WRA/<br/>PRE/PREA/REF/REFPB/MRS)"]
        addr["cmd_rank_i, cmd_bank_i,<br/>cmd_row_i, cmd_col_i, cmd_len_i"]
        memtype["memtype_i<br/>(MEMTYPE_DDR2 / MEMTYPE_LPDDR2)"]
        phases["rd_phase_i, wr_phase_i"]
    end

    subgraph DDR2["DDR2 branch — ras_n/cas_n/we_n truth table"]
        ddr2_lut["opcode -> {ras_n, cas_n, we_n}<br/>ACT  {0,1,1}  addr=row<br/>RD   {1,0,1}  addr=col (A10=0)<br/>RDA  {1,0,1}  addr=col|A10<br/>WR   {1,0,0}  addr=col (A10=0)<br/>WRA  {1,0,0}  addr=col|A10<br/>PRE  {0,1,0}  bank; PREA A10=1<br/>REF  {0,0,1}<br/>MRS  {0,0,0}  bank=MR idx, addr=MR data<br/>NOP  {1,1,1}"]
        ddr2_phase["phase placement:<br/>RD/RDA -> rd_phase_i<br/>WR/WRA -> wr_phase_i<br/>others -> phase 0<br/>other phases = NOP"]
    end

    subgraph LPDDR2["LPDDR2 branch — 20-bit CA word (JESD209-2F Table 60)"]
        lp_ca["w_lpddr2_ca[19:0] =<br/>{CA_falling[9:0], CA_rising[9:0]}<br/>ACT/RD/WR/PRE/REF/REFPB/MRS<br/>bit-exact per Table 60<br/>(auto-precharge in CA0f bit)"]
        lp_pack["rides flat on dfi_address[19:0];<br/>cs_n asserted on phase 0;<br/>ras_n/cas_n/we_n stay IDLE"]
    end

    subgraph ODT["ODT / mode (inside formatter + mode_register)"]
        odt["dfi_odt_o decode<br/>(active-rank mask;<br/>rule from mode_register odt_o /<br/>memtype). NO standalone odt_ctrl."]
    end

    subgraph OUT["Multi-phase DFI bus out"]
        out["dfi_address_o, dfi_bank_o,<br/>dfi_ras_n_o, dfi_cas_n_o, dfi_we_n_o,<br/>dfi_cs_n_o, dfi_odt_o<br/>-> dfi_signal_pack (1-cycle reg)"]
    end

    cmd --> memtype
    addr --> memtype
    phases --> memtype
    memtype -->|DDR2| ddr2_lut
    memtype -->|LPDDR2| lp_ca
    ddr2_lut --> ddr2_phase
    lp_ca --> lp_pack
    ddr2_phase --> out
    lp_pack --> out
    memtype --> odt
    odt --> out

    NOTE["cmd_encoder is RETIRED.<br/>Encoding is now dfi_cmd_formatter (+ dfi_signal_pack)."]

    classDef inblock fill:#f0f0f0,stroke:#666666,stroke-width:2px
    classDef ddr2block fill:#e8f4e8,stroke:#228B22,stroke-width:2px
    classDef lpblock fill:#f0e8f4,stroke:#7B228B,stroke-width:2px
    classDef odtblock fill:#fef0e0,stroke:#B88B22,stroke-width:2px
    classDef outblock fill:#e0e8fa,stroke:#3366CC,stroke-width:2px
    classDef ret fill:#f0f0f0,stroke:#B03030,stroke-width:2px

    class cmd,addr,memtype,phases inblock
    class ddr2_lut,ddr2_phase ddr2block
    class lp_ca,lp_pack lpblock
    class odt odtblock
    class out outblock
    class NOTE ret
