flowchart LR
    subgraph DFI["pumice_dfi_layer (rd path)"]
        rd_align["pumice_dfi_rd_aligner<br/>on rd_fire drive dfi_rddata_en_o<br/>for t_rddata_en; capture valid<br/>DFI words -> rd_valid/data/resp/last"]
        cdc["pumice_dfi_cdc<br/>u_rd_fifo (async;<br/>data, resp, last)"]
    end

    subgraph RDCAM["pumice_rd_cmd_cam — SRAM + movers (NO slot-state FSM)"]
        retfill["RETURN-FILL mover<br/>r_ret_beat counter;<br/>u_issue_q FIFO-fed;<br/>dfi_ret -> SRAM[slot*BL+beat];<br/>dfi_ret_last sets r_ready + r_resp"]
        sram["rd SRAM<br/>r_sram[N_SRAM_SLOTS*BL]<br/>+ r_sram_occ"]
        drain["DRAIN mover<br/>r_dr_beat counter;<br/>oldest-first (w_dro_slot),<br/>gated on r_ready;<br/>evict slot + occ on last"]
    end

    subgraph INTK["pumice_rd_intake"]
        rd_data_fifo["rd_data_fifo<br/>(order_fifo picks<br/>SNARF vs DFI source)"]
        rout["R return -> s_axi_r*"]
    end

    dfi_pin[/"dfi_rddata_i / _valid_i"/]

    dfi_pin --> rd_align
    rd_align -- "prd (data,resp,last)" --> cdc
    cdc -- "dfi_ret" --> retfill
    retfill --> sram
    sram --> drain
    drain -- "drain (data,id,resp,last)" --> rd_data_fifo
    rd_data_fifo --> rout

    classDef dfi fill:#e0e8fa,stroke:#3366CC,stroke-width:2px
    classDef cam fill:#e8f4e8,stroke:#228B22,stroke-width:2px
    classDef intk fill:#f0f0f0,stroke:#666666,stroke-width:2px

    class rd_align,cdc dfi
    class retfill,sram,drain cam
    class rd_data_fifo,rout intk
