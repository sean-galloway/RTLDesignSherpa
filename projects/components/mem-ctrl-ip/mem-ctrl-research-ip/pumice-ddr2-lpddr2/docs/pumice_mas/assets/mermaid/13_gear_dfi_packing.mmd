%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart TB
    subgraph HOSTGEAR["Host-width gearing — pumice_top_geared (OPTIONAL)"]
        host["Host AXI @ HOST_AXI_DATA_WIDTH"]
        conv["axi4_dwidth_converter_wr/_rd<br/>(formal IP; only when<br/>HOST_AXI_DATA_WIDTH != DW;<br/>HOST==DW is a bit-identical bypass)"]
        core_axi["core AXI @ DW<br/>(DW = DRAM_BEAT_WIDTH * DFI_RATE)"]
    end

    subgraph INTERNAL["Internal geometry (fixed DW)"]
        geo["1 AXI beat == 1 DFI word == DFI_RATE DRAM beats<br/>1 AXI burst (BL/DFI_RATE beats) == 1 DRAM burst (BL beats)"]
    end

    subgraph DFILAYER["pumice_dfi_layer — DFI-word packing (DW -> DFI_RATE phases)"]
        wr_ser["pumice_dfi_wr_serializer<br/>on wr_fire wait t_phy_wrlat,<br/>stream DFI word/cycle from FIFO<br/>-> dfi_wrdata_o[DFI_DATA_WIDTH],<br/>dfi_wrdata_en_o, dfi_wrdata_mask_o"]
        cmd_fmt["dfi_cmd_formatter / dfi_signal_pack<br/>DFI word split across DFI_RATE phases;<br/>CMD on phase 0, RD/WR on rd_phase/wr_phase"]
        rd_align["pumice_dfi_rd_aligner<br/>on rd_fire drive dfi_rddata_en_o<br/>for t_rddata_en; capture DFI_RATE-phase<br/>valid words -> DFI word/cycle to FIFO"]
    end

    dfi_bus[/"DFI v2.1 pin bus (DFI_RATE phases)"/]

    host --> conv
    conv --> core_axi
    core_axi --> geo
    geo --> wr_ser
    geo --> cmd_fmt
    wr_ser --> dfi_bus
    cmd_fmt --> dfi_bus
    dfi_bus --> rd_align
    rd_align --> geo

    classDef gear fill:#f0e8f4,stroke:#7B228B,stroke-width:2px
    classDef geob fill:#fef0e0,stroke:#B88B22,stroke-width:2px
    classDef dfi fill:#e8f4e8,stroke:#228B22,stroke-width:2px

    class host,conv,core_axi gear
    class geo geob
    class wr_ser,cmd_fmt,rd_align dfi
