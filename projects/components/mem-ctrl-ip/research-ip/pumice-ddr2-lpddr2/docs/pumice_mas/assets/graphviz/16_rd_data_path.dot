// pumice read data path (common-ip FUBs) -- house style per
// vault/handbook/authoring/block-diagrams.md. Replaces the Mermaid
// 16_rd_data_path_pipeline figure, which still showed the pre-2026-09-08
// CAM-as-reorder-buffer. Read data is a return flow: it enters at the PHY bar
// and climbs the center column to the AXI R channel; tickets and fire
// strobes are dashed sideband; snarf data joins from the right.
digraph rd_data_path {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.50", ranksep="0.45", splines=ortho,
           label="pumice read data path - DFI aligner, CDC, ticketed return ring, AR-order R",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    p_r   [group=C, label="AXI R channel (s_axi_r*)\none RLAST per host burst", fillcolor="white"];

    rin   [group=C, label="R Source Select + R FIFO\nmc_rd_intake - u_order_fifo head picks snarf or DRAM,\nu_rd_data_fifo -> R (AR order)"];
    p_sn  [label="Snarf stream\nmc_wr_data_cam (read-your-writes)", fillcolor="white"];

    drain [group=C, label="Head Drain (AR order)\nmc_rd_return_ring - r_head + 2-deep prefetch skid\n(pops the head once r_ready[head] is set)"];
    ring  [group=C, label="Return Ring Storage\nmc_rd_return_ring - BRAM, one slot per ticket (RD_RET_DEPTH) + r_ready[ ]\nticket handed out at insert from r_tail, in AR order", width=7.5];
    fill  [group=C, label="Fill by Ticket (issue order)\nmc_rd_return_ring - u_issue_q ticket FIFO\nnext returned burst lands in the head ticket's slot"];
    p_tk  [label="Ticket ports\nalloc at insert -> mc_rd_cmd_cam\nissue ticket <- mc_rd_cmd_cam at issue", fillcolor="white"];

    cdc   [group=C, label="Read Data CDC FIFO\nmc_dfi_cdc - u_rd_fifo (gaxi_fifo_async)\n(dfi_clk -> ctl_clk)"];
    al    [group=C, label="Read Aligner\nmc_dfi_rd_aligner - FUB\ndfi_rddata_en t_rddata_en after the read; captures BL_WORDS words"];
    fire  [label="DFI Command Path\nmc_dfi_cmd_path\n(read fire)", fillcolor="white"];

    phy   [group=C, label="DDR PHY - dfi_rddata / dfi_rddata_valid in, dfi_rddata_en out (dfi_clk)",
           fillcolor="white", width=7.5, height=0.5, fontsize=11];

    // ---- the return climb ----
    p_r   -> rin   [dir=back, xlabel="R (id, data, resp, last)"];
    rin   -> drain [dir=back, xlabel="drain (data, resp, last)"];
    drain -> ring  [dir=back, xlabel="slot read"];
    ring  -> fill  [dir=back, xlabel="slot write"];
    fill  -> cdc   [dir=back, xlabel="read data (issue order)"];
    cdc   -> al    [dir=back, xlabel="read data"];
    al    -> phy   [dir=back, xlabel="Read from DDR"];

    // ---- joins and sideband ----
    p_sn  -> rin   [xlabel="snarf data"];
    p_tk  -> fill  [dir=both, style=dashed, xlabel="tickets"];
    fire  -> al    [style=dashed, xlabel="read fire"];

    { rank=same; p_r; p_sn; }
    { rank=same; ring; p_tk; }
    { rank=same; cdc; fire; }
    p_r -> p_sn [style=invis];
    ring -> p_tk [style=invis];
    cdc -> fire [style=invis];
}
