%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart LR
    subgraph CTL["aclk domain (controller)"]
        ifc["pumice_axi4_ifc<br/>(intakes + CAMs)"]
        sched["pumice_mem_cmd_scheduler<br/>(arbiter + timers +<br/>refresh + init)"]
        csr["pumice_csr<br/>(cpuif; config regs)"]
    end

    subgraph CDC["pumice_dfi_cdc — the SINGLE crossing"]
        cmd_fifo["u_cmd_fifo<br/>(gaxi_fifo_async;<br/>ctl -> dfi)"]
        wd_fifo["u_wd_fifo<br/>(gaxi_fifo_async;<br/>ctl -> dfi)"]
        rd_fifo["u_rd_fifo<br/>(gaxi_fifo_async;<br/>dfi -> ctl)"]
        istart_tok["u_istart_tok<br/>(init_start token;<br/>ctl -> dfi)"]
        icmp_tok["u_icmp_tok<br/>(init_complete token;<br/>dfi -> ctl)"]
    end

    subgraph DFIDOM["dfi_clk domain (PHY side)"]
        cmd_path["pumice_dfi_cmd_path<br/>(dfi_cmd_formatter +<br/>dfi_signal_pack)"]
        wr_ser["pumice_dfi_wr_serializer"]
        rd_align["pumice_dfi_rd_aligner"]
    end

    sched -- "cmd (op,rank,bank,row,col,ap)" --> cmd_fifo
    ifc -- "cm_rd wrdata (data,strb,last)" --> wd_fifo
    sched -- "dfi_init_start" --> istart_tok

    cmd_fifo -- "pcmd" --> cmd_path
    wd_fifo -- "pwd" --> wr_ser
    istart_tok -- "pinit_start (sticky)" --> cmd_path

    rd_align -- "prd (data,resp,last)" --> rd_fifo
    rd_fifo -- "rd return" --> ifc
    icmp_tok -- "init_complete (sticky)" --> sched

    cmd_path -- "wr_fire" --> wr_ser
    cmd_path -- "rd_fire" --> rd_align
    PHY[/"dfi_init_complete"/] --> icmp_tok

    cmd_path --> DFIPIN[/"DFI v2.1 pin bus"/]
    wr_ser --> DFIPIN
    DFIPIN --> rd_align

    classDef ctl fill:#e8f4e8,stroke:#228B22,stroke-width:2px
    classDef cdc fill:#fef0e0,stroke:#B88B22,stroke-width:2px
    classDef dfi fill:#e0e8fa,stroke:#3366CC,stroke-width:2px

    class ifc,sched,csr ctl
    class cmd_fifo,wd_fifo,rd_fifo,istart_tok,icmp_tok cdc
    class cmd_path,wr_ser,rd_align dfi
