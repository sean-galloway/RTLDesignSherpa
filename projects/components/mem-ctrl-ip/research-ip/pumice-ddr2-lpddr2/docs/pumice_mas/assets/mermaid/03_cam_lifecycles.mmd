stateDiagram-v2
    direction LR

    state "pumice_wr_data_cam entry" as WR_GROUP {
        [*] --> WR_INVALID
        WR_INVALID --> WR_FILLING : ins_valid captures bank/row/col/id
        WR_FILLING --> WR_FILLING : wd fill beat (r_fill_beat++)
        WR_FILLING --> WR_FILLED : wd_last sets r_fdone
        WR_FILLED --> WR_SCHED : commit_valid sets r_sched
        WR_SCHED --> WR_INVALID : commit-drain last beat evicts slot
        WR_FILLED --> WR_FILLED : snarf_rd read-your-write forward
    }

    state "pumice_rd_cmd_cam entry" as RD_GROUP {
        [*] --> RD_INVALID
        RD_INVALID --> RD_PENDING : ins_valid captures bank/row/col/id
        RD_PENDING --> RD_ISSUED : issue_valid sets r_issued
        RD_ISSUED --> RD_RETURNING : dfi_ret beat (r_ret_beat++)
        RD_RETURNING --> RD_READY : dfi_ret_last sets r_ready and r_resp
        RD_READY --> RD_INVALID : drain last beat evicts slot
    }

    note right of WR_GROUP
      r_fdone gates schedulability AND snarf.
      Snarf limited to unscheduled, same-id, same-BL.
      Fill / commit-drain / snarf are beat-counter
      movers (FIFO-fed), NOT a slot-state FSM.
    end note

    note right of RD_GROUP
      Drain is oldest-first, gated on r_ready
      (data staged in SRAM). Beat-counter mover
      only; no active/slot state latch.
    end note
