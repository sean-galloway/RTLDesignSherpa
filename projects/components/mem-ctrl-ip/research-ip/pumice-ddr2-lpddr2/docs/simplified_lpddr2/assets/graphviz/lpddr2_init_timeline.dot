// LPDDR2 power-up initialization timeline (replaces an ASCII sketch).
// Phase timeline, not to scale: one column per interval between the spec's
// named checkpoints. Source of truth: JESD209-2 power-up and initialization, as paraphrased in this chapter.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph lpddr2_init_timeline {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="LPDDR2 power-up initialization: checkpoints Ta to Tg", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="90" BORDER="0" ALIGN="RIGHT"><B>interval</B></TD><TD WIDTH="92" BORDER="0"><B>Ta-Tb</B></TD><TD WIDTH="92" BORDER="0"><B>Tb-Tc</B></TD><TD WIDTH="92" BORDER="0"><B>Tc-Td</B></TD><TD WIDTH="92" BORDER="0"><B>Td</B></TD><TD WIDTH="92" BORDER="0"><B>Td-Te</B></TD><TD WIDTH="92" BORDER="0"><B>Te-Tf</B></TD><TD WIDTH="92" BORDER="0"><B>Tf-Tg</B></TD><TD WIDTH="92" BORDER="0"><B>after Tg</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="42">phase</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white"><B>power<BR/>ramp</B></TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white"><B>CKE low,<BR/>clock on</B></TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white"><B>NOP<BR/>wait</B></TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white"><B>MRW<BR/>RESET</B></TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white"><B>NOP<BR/>hold</B></TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white"><B>DAI<BR/>poll</B></TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ZQ<BR/>init</B></TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white"><B>configure</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="42">supplies</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">ramping</TD><TD COLSPAN="7" WIDTH="644" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">in range</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="42">CK</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">stable</TD><TD COLSPAN="6" WIDTH="552" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">running</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="42">CKE</TD><TD COLSPAN="2" WIDTH="184" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="6" WIDTH="552" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="42">command</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">NOP</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">MRW<BR/>MR63</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">NOP</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">MRR MR0<BR/>(DAI)</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">MRW MR10<BR/>= 0xFF</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">MRW MR1,2,3</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="42">timing</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">tINIT0<BR/>&lt;= 20 ms</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">tINIT1 &gt;= 100 ns<BR/>tINIT2 &gt;= 5 tCK</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">tINIT3<BR/>&gt;= 200 us</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">tINIT4<BR/>&gt;= 1 us</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">tINIT5<BR/>&lt;= 10 us</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">tZQINIT<BR/>&gt;= 1 us</TD><TD COLSPAN="1" WIDTH="92" HEIGHT="42" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="8" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">CKE stays at or below 0.2 x VDDCA through the ramp. The clock must be stable for tINIT2 before<BR ALIGN="LEFT"/>CKE&#x27;s first rising edge; if MRRs will be issued during init it must sit in the boot range<BR ALIGN="LEFT"/>tCKb = 18-100 ns. Between Te and Tf only MRR and power-down entry/exit are legal; waiting<BR ALIGN="LEFT"/>out tINIT5 instead of polling DAI is allowed.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
