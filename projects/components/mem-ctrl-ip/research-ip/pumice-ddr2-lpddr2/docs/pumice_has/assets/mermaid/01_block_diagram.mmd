%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4e8', 'primaryTextColor': '#000', 'primaryBorderColor': '#228B22', 'lineColor': '#404040', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}}}%%
flowchart TB
    subgraph CORE["pumice_core"]

        subgraph AXI["mc_axi4_layer (common-ip)"]
            wr_intake["mc_wr_intake<br/>(axi4_slave_wr +<br/>AW-meta FIFO + wr-data FIFO +<br/>mc_addr_mapper)"]
            rd_intake["mc_rd_intake<br/>(axi4_slave_rd +<br/>mc_addr_mapper + snarf probe)"]
        end

        subgraph STOR["mc_storage_layer (common-ip)"]
            wr_data_cam["mc_wr_data_cam<br/>(WR CAM + wr-data SRAM;<br/>fill / commit-drain / snarf)"]
            rd_cmd_cam["mc_rd_cmd_cam<br/>(RD CAM + rd SRAM;<br/>return-fill / oldest-drain)"]
        end

        subgraph SCHED["pumice_scheduler_layer"]
            sched_core["mc_scheduler_layer core<br/>(pick machinery +<br/>bank/global timers)"]
            init_sequencer["init_sequencer<br/>(DDR2 + LPDDR2 JEDEC MR init)"]
            mode_register["mode_register<br/>(CL/CWL/BL/AL decode)"]
            refresh_ctrl["refresh_ctrl<br/>(tREFI accumulator + drain)"]
            page_policy["pumice_page_policy<br/>(open-page decision)"]
            cmd_hist["pumice_cmd_history_checker<br/>(optional DV scoreboard)"]
        end

        subgraph TRN["pumice_training_layer"]
            trn_shell["mc_training_layer shell"]
            zq_ctrl["pumice_zq_ctrl<br/>(periodic ZQ calibration)"]
            lp_cal["pumice_lp_cal<br/>(LPDDR2 MRR DQ calibration)"]
        end

        subgraph DFI["mc_dfi_2p1_layer (common-ip)"]
            dfi_cdc["mc_dfi_cdc<br/>(SINGLE clock-domain crossing;<br/>async gaxi FIFOs)"]
            dfi_cmd_path["mc_dfi_cmd_path<br/>(+ dfi_cmd_formatter + dfi_signal_pack)"]
            dfi_wr_ser["mc_dfi_wr_serializer"]
            dfi_rd_align["mc_dfi_rd_aligner"]
        end

    end

    AXI_PORT[/"AXI4 Slave Port<br/>(from SoC; fixed DW)"/] --> wr_intake
    AXI_PORT --> rd_intake

    wr_intake --> wr_data_cam
    rd_intake --> rd_cmd_cam
    wr_data_cam -. snarf forward .-> rd_intake

    wr_data_cam --> sched_core
    rd_cmd_cam --> sched_core
    init_sequencer --> sched_core
    mode_register --> sched_core
    refresh_ctrl --> sched_core
    page_policy --> sched_core
    cmd_hist -. audit .-> sched_core

    zq_ctrl --> trn_shell
    lp_cal --> trn_shell
    trn_shell --> sched_core

    sched_core --> dfi_cdc
    wr_data_cam -. commit-drain wrdata .-> dfi_wr_ser
    dfi_rd_align -. return-fill rddata .-> rd_cmd_cam

    dfi_cdc --> dfi_cmd_path
    dfi_cdc <--> dfi_wr_ser
    dfi_cdc <--> dfi_rd_align
    dfi_cmd_path --> DFI_PORT[/"DFI v2.1 Master Port<br/>(to PHY)"/]
    dfi_wr_ser --> DFI_PORT
    dfi_rd_align --> DFI_PORT
