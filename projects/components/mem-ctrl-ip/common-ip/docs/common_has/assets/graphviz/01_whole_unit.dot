// Family whole-unit uarch diagram - the DDR-MC course style per STYLE.md.
// Reference: design-a-ddr-memory-controller-i-top-level-diagram.webp
// Rank geography mirrors the reference:
//   channels -> packetizers (+cfg) -> pools -> merge/fwd + arbitration +
//   maintenance + reorder buffer -> scheduler trapezium (+timing ctl) ->
//   merge logic -> data path controls -> PHY bar.
// Vocabulary mapped onto the common-ip stack:
//   packetizers  = mc_axi4_layer intakes + burst chopper/splitter
//   pools/buffer = mc_storage_layer CAMs (wr_data_cam / rd_cmd_cam)
//   merge/forward= coalescing merge + wr2rd snarf forward
//   maintenance  = mc_training_layer clients (ZQ / DQ-cal) via the scheduler's
//                  generic maintenance slot
//   scheduler    = mc_scheduler_layer (prospect pool -> mc_cmd_arbiter)
//   timing ctl   = mc_bank_timers + mc_global_timers
//   data path ctl= mc_dfi_NpM_layer wr_serializer / rd_aligner
//   reorder buf  = mc_rd_return_ring (read return path - its own contract)
digraph whole_unit {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho,
           label="mem-ctrl-ip whole unit - the family stack in the classic DDR-MC course diagram form",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external interfaces (white) ----
    axi_wr [label="AXI Write Channel", fillcolor="white"];
    axi_rd [label="AXI Read Channel",  fillcolor="white"];
    phy    [label="DDR PHY  (DFI 2.1 / 3.1 / 4.0 - one revision per product)",
            fillcolor="white", rank=sink, width=8.0, fontsize=11];

    // ---- host side: mc_axi4_layer ----
    wr_pkt [label="Write Request Packetizer\nmc_axi4_layer - mc_wr_intake,\nmc_axi_burst_chopper, mc_wr_splitter"];
    rd_pkt [label="Read Request Packetizer\nmc_axi4_layer - mc_rd_intake"];
    cfg    [label="Configuration Registers\npumice_csr / scoria_csr / andesite_csr (PeakRDL)\nsideband config to all layers"];

    // ---- storage: mc_storage_layer ----
    wr_pool [label="DDR Write Command Pool\n+ Write Data Buffer\nmc_storage_layer - mc_wr_data_cam"];
    rd_pool [label="DDR Read Command Pool\nmc_storage_layer - mc_rd_cmd_cam"];
    merge_b [label="Merge Buffer\nfinal write coalescing\n(mc_axi4_layer)"];
    fwd_b   [label="Forward Buffer\nread-snoop wr2rd forward\n(mc_wr_data_cam snarf)"];

    // ---- maintenance: mc_training_layer ----
    maint [label="DDR Maintenance Command Queue\nmc_training_layer - ZQ cal, DQ cal,\nwrite-leveling interface"];

    // ---- scheduler: mc_scheduler_layer ----
    wr_arb [label="DDR Write Arbitration\nunified prospect pool (classify)"];
    rd_arb [label="DDR Read Arbitration\nunified prospect pool (classify)"];
    sched  [label="DDR Command Scheduler\nmc_scheduler_layer - mc_cmd_arbiter (FR-FCFS pick)",
            shape=invtrapezium, width=5.2, fillcolor="#BFD7EE", fontsize=11];
    tctl   [label="DDR Timing Control\nmc_bank_timers + mc_global_timers\n(tRCD/tRP/tRAS/tFAW/tRRD/... next-state)"];

    // ---- return merge + data path: mc_dfi_NpM_layer ----
    mlog  [label="Merge Logic\nmc_rd_return_ring reorder\n(AXI ID order)"];
    wr_dp [label="Write Data Path Control\nmc_dfi_2p1_layer - mc_dfi_wr_serializer"];
    rd_dp [label="Read Data Path Control\nmc_dfi_2p1_layer - mc_dfi_rd_aligner"];

    // ---- return path: mc_axi4_layer ----
    rbuf [label="Read Data\nReorder Buffer\nmc_axi4_layer -\nmc_rd_return_ring",
          height=1.6];

    // ---- host channels ----
    axi_wr -> wr_pkt [dir=both];
    axi_rd -> rd_pkt [dir=both];

    // ---- write flow (down the left and center) ----
    wr_pkt -> wr_pool;
    wr_pool -> wr_arb;
    wr_pool -> merge_b;
    wr_pool -> fwd_b;
    merge_b -> wr_dp;
    fwd_b   -> wr_dp;
    wr_arb -> sched [label="WR / RMW"];
    wr_dp -> phy [label="Write to DDR"];

    // ---- read flow (command down the center, data back up the right) ----
    rd_pkt -> rd_pool;
    rd_pool -> rd_arb;
    rd_arb -> sched [label="RD"];
    rd_pool -> rbuf [style=dashed, arrowhead=none, label="ticket at insert", tailport=e];
    rd_dp -> phy [dir=back, label="Read from DDR"];
    mlog -> rd_dp [dir=back];
    rbuf -> mlog [dir=back];
    rbuf -> axi_rd [constraint=false];

    // ---- maintenance + timing into the pick ----
    maint -> sched;
    tctl -> sched;

    // ---- scheduler to PHY ----
    sched -> phy [label="DDR Command"];

    // ---- rank pinning (mirrors the reference layout) ----
    { rank=same; axi_wr; axi_rd; }
    { rank=same; wr_pkt; cfg; rd_pkt; }
    wr_pkt -> cfg    [style=invis];
    cfg    -> rd_pkt [style=invis];
    { rank=same; wr_pool; rd_pool; }
    wr_pool -> rd_pool [style=invis];
    { rank=same; merge_b; fwd_b; wr_arb; maint; rd_arb; rbuf; }
    merge_b -> fwd_b  [style=invis];
    fwd_b   -> wr_arb [style=invis];
    wr_arb  -> maint  [style=invis];
    maint   -> rd_arb [style=invis];
    rd_arb  -> rbuf   [style=invis];
    { rank=same; sched; tctl; }
    sched -> tctl [style=invis];
    { rank=same; wr_dp; rd_dp; }
    wr_dp -> rd_dp [style=invis];
}
