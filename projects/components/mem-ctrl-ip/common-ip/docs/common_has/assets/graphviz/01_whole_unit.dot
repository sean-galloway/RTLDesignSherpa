// Family whole-unit uarch diagram - the DDR-MC course style per STYLE.md.
// Reference: design-a-ddr-memory-controller-i-top-level-diagram.webp
// Rank geography mirrors the reference:
//   channels -> packetizers (+cfg) -> pools -> merge/fwd + arbitration +
//   maintenance + reorder buffer -> scheduler trapezium (+timing ctl) ->
//   merge logic -> data path controls -> PHY bar.
// Vocabulary mapped onto the common-ip stack:
//   packetizers  = mc_axi4_plane intakes + burst chopper/splitter
//   pools/buffer = mc_storage_plane CAMs (wr_data_cam / rd_cmd_cam)
//   merge/forward= coalescing merge + wr2rd snarf forward
//   maintenance  = mc_training_plane clients (ZQ / DQ-cal) via the scheduler's
//                  generic maintenance slot
//   scheduler    = mc_scheduler_plane (prospect pool -> mc_cmd_arbiter)
//   timing ctl   = mc_bank_timers + mc_global_timers
//   data path ctl= mc_dfi_NpM_plane wr_serializer / rd_aligner
//   reorder buf  = mc_rd_return_ring (read return path - its own contract)
digraph whole_unit {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.60", splines=ortho,
           label="mem-ctrl-ip whole unit - the family stack in the classic DDR-MC course diagram form",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external interfaces (white) ----
    axi_wr [label="AXI Write Channel", fillcolor="white"];
    axi_rd [label="AXI Read Channel",  fillcolor="white"];
    phy    [label="DDR PHY  (DFI 2.1 / 3.1 / 4.0 - one revision per product)",
            fillcolor="white", rank=sink, width=8.0, fontsize=11];

    // ---- host side: mc_axi4_plane ----
    wr_pkt [label="Write Request Packetizer\nmc_axi4_plane - mc_wr_intake,\nmc_axi_burst_chopper, mc_wr_splitter"];
    rd_pkt [label="Read Request Packetizer\nmc_axi4_plane - mc_rd_intake"];
    cfg    [label="Configuration Registers\npumice_csr / scoria_csr / andesite_csr (PeakRDL)\nsideband config to all planes"];

    // ---- storage: mc_storage_plane ----
    wr_pool [label="DDR Write Command Pool\n+ Write Data Buffer\nmc_storage_plane - mc_wr_data_cam"];
    rd_pool [label="DDR Read Command Pool\nmc_storage_plane - mc_rd_cmd_cam"];
    merge_b [label="Merge Buffer\nfinal write coalescing\n(mc_axi4_plane)"];
    fwd_b   [label="Forward Buffer\nread-snoop wr2rd forward\n(mc_wr_data_cam snarf)"];

    // ---- maintenance: mc_training_plane ----
    maint [label="DDR Maintenance Command Queue\nmc_training_plane - ZQ cal, DQ cal,\nwrite-leveling interface"];

    // ---- scheduler: mc_scheduler_plane ----
    wr_arb [label="DDR Write Arbitration\nunified prospect pool (classify)"];
    rd_arb [label="DDR Read Arbitration\nunified prospect pool (classify)"];
    sched  [label="DDR Command Scheduler\nmc_scheduler_plane - mc_cmd_arbiter (FR-FCFS pick)",
            shape=invtrapezium, width=5.2, fillcolor="#BFD7EE", fontsize=11];
    tctl   [label="DDR Timing Control\nmc_bank_timers + mc_global_timers\n(tRCD/tRP/tRAS/tFAW/tRRD/... next-state)"];

    // ---- return merge: mc_axi4_plane side of the return path ----
    mlog [label="Merge Logic\nmc_rd_return_ring reorder\n(AXI ID order)"];

    // ---- the DFI plane as ONE container: command + write + read + CDC ----
    dfi [label="mc_dfi_2p1_plane (DFI 2.1 data path)\nmc_dfi_cmd_path + mc_dfi_wr_serializer + mc_dfi_rd_aligner + CDC\nwrite data in at the left, read data out at the right, command through the center",
         width=10.5, height=1.7, fontsize=10];

    // ---- return path: mc_axi4_plane ----
    rbuf [label="Read Data\nReorder Buffer\nmc_axi4_plane -\nmc_rd_return_ring",
          height=1.6];

    // ---- host channels ----
    axi_wr -> wr_pkt [dir=both];
    axi_rd -> rd_pkt [dir=both];

    // ---- write flow (down the left and center) ----
    wr_pkt -> wr_pool;
    wr_pool -> wr_arb;
    wr_pool -> merge_b;
    wr_pool -> fwd_b;
    merge_b -> dfi;
    fwd_b   -> dfi;
    wr_arb -> sched [label="WR / RMW"];

    // ---- read flow (command down the center, data back up the right) ----
    rd_pkt -> rd_pool;
    rd_pool -> rd_arb;
    rd_arb -> sched [label="RD"];
    rd_pool -> rbuf [style=dashed, arrowhead=none, label="ticket at insert", tailport=e];
    mlog -> dfi [dir=back];
    rbuf -> mlog [dir=back];
    rbuf -> axi_rd [constraint=false];

    // ---- maintenance + timing into the pick ----
    maint -> sched [label="REF / ZQ"];
    tctl -> sched [xlabel="timer window"];

    // ---- scheduler into the DFI plane ----
    sched -> dfi [penwidth=1.8];

    // ---- three PHY crossings via invisible port scaffolding (distinct node
    //      pairs per crossing => deterministic direction + label placement) ----
    p_wr  [shape=point, width=0.01];
    p_cmd [shape=point, width=0.01];
    p_rd  [shape=point, width=0.01];
    sp1   [style=invis, fixedsize=true, width=1.6, height=0.02];
    sp2   [style=invis, fixedsize=true, width=1.6, height=0.02];
    dfi -> p_wr  [arrowhead=none, headclip=false];
    dfi -> p_cmd [arrowhead=none, headclip=false, penwidth=1.8];
    p_wr  -> phy [label="Write to DDR", tailclip=false];
    p_cmd -> phy [label="DDR Command", penwidth=1.8, tailclip=false];
    phy -> p_rd  [arrowhead=none, headclip=false, constraint=false];
    p_rd  -> dfi [label="Read from DDR", tailclip=false, constraint=false];
    { rank=same; p_wr; sp1; p_cmd; sp2; p_rd; }
    p_wr -> sp1 [style=invis];
    sp1 -> p_cmd [style=invis];
    p_cmd -> sp2 [style=invis];
    sp2 -> p_rd [style=invis];

    // ---- rank pinning (mirrors the reference layout) ----
    { rank=same; axi_wr; axi_rd; }
    { rank=same; wr_pkt; cfg; rd_pkt; }
    wr_pkt -> cfg    [style=invis];
    cfg    -> rd_pkt [style=invis];
    { rank=same; wr_pool; rd_pool; }
    wr_pool -> rd_pool [style=invis];
    { rank=same; merge_b; fwd_b; wr_arb; maint; rd_arb; rbuf; }
    merge_b -> fwd_b  [style=invis];
    fwd_b   -> wr_arb [style=invis];
    wr_arb  -> maint  [style=invis];
    maint   -> rd_arb [style=invis];
    rd_arb  -> rbuf   [style=invis];
    { rank=same; sched; tctl; }
    sched -> tctl [style=invis];
    { rank=same; dfi; }
}
