// mc_dfi_3p1_plane block diagram -- GENERATED by gen_dfi_planes.py; edit the script.
// House style: vault/handbook/authoring/block-diagrams.md and common_has STYLE.md.
// Command down the center, write data down the left, read data back up the
// right; the DDR PHY (DFI pin bus) is the bar.
digraph mc_dfi_3p1_plane {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.55", splines=ortho,
           label="mc_dfi_3p1_plane - DFI 3.1 boundary:\nthe 2.1 pipeline + 3.1 command path + write-leveling crossing", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- controller-side ports (ctl_clk) ----
    p_wd  [label="Write data in (ctl_clk)\nfrom the write-data commit stream", fillcolor="white"];
    p_cmd [label="DDR Command in (ctl_clk)\nfrom mc_scheduler_plane", fillcolor="white"];
    p_rd  [label="Read data out (ctl_clk)\nto mc_rd_return_ring", fillcolor="white"];
    p_wl [label="Write-leveling handshake (ctl_clk)\nfrom the rock training plane", fillcolor="white"];
    wl_sync [label="Write-Leveling Handshake Sync\ncdc_synchronizer x4 + sync_pulse (strobe)\nreq / mode down, ack / prime_dq up"];

    // ---- the single CDC: mc_dfi_cdc (gaxi_fifo_async only) ----
    cdc_wd  [label="Write Data CDC FIFO\nmc_dfi_cdc - gaxi_fifo_async\n(ctl_clk -> dfi_clk)"];
    cdc_cmd [label="Command CDC FIFO\nmc_dfi_cdc - gaxi_fifo_async\n(ctl_clk -> dfi_clk);\ndfi_init start / complete tokens (to the PHY pins)"];
    cdc_rd  [label="Read Data CDC FIFO\nmc_dfi_cdc - gaxi_fifo_async\n(dfi_clk -> ctl_clk)"];

    // ---- dfi_clk datapath ----
    cmd_path [label="DFI 3.1 Command Path\nmc_dfi_3p1_cmd_path - FUB\nDDR3 / LPDDR3 pins, sub-command split,\nwrite / read fire strobes"];
    wr_ser   [label="Write Serializer\nmc_dfi_wr_serializer - FUB\nlaunch at t_phy_wrlat"];
    rd_al    [label="Read Aligner\nmc_dfi_rd_aligner - FUB\ndfi_rddata_en at t_rddata_en"];

    // ---- boundary bar (the PHY pins) + parked runtime-inputs legend ----
    bar    [label="DDR PHY (DFI 3.1 pin bus, dfi_clk) - command, dfi_wrdata, dfi_rddata, dfi_init, leveling", fillcolor="white", width=11, height=0.5, fontsize=11];
    legend [label="Runtime inputs (dfi_clk side, CSR-driven)\l  t_phy_wrlat: write serializer launch delay\l  t_rddata_en: read aligner enable delay\l  rd_phase / wr_phase: DFI phase of the column\l  gear: active DFI phases (masks the data enables)\l  n_subcmd / strides: sub-command split\l", fillcolor="white"];

    // ---- write data: down the left column ----
    p_wd   -> cdc_wd [xlabel="write data + strb + last"];
    cdc_wd -> wr_ser [xlabel="write data"];
    wr_ser -> bar    [xlabel="Write to DDR"];

    // ---- command: down the center column ----
    p_cmd    -> cdc_cmd  [penwidth=1.8, xlabel="DDR Command"];
    cdc_cmd  -> cmd_path [penwidth=1.8, xlabel="DDR Command"];
    cmd_path -> bar      [penwidth=1.8, xlabel="DDR Command"];
    cmd_path -> wr_ser   [style=dashed, xlabel="write fire"];
    cmd_path -> rd_al    [style=dashed, xlabel="read fire"];

    // ---- read data: back up the right column ----
    rd_al  -> bar    [dir=back, xlabel="Read from DDR"];
    cdc_rd -> rd_al  [dir=back, xlabel="read data"];
    p_rd   -> cdc_rd [dir=back, xlabel="read data + resp + last"];
    // ---- write-leveling handshake: straight dashed lanes, far-right margin ----
    p_wl    -> wl_sync [dir=both, style=dashed, xlabel="req, mode, strobe /\nack, prime_dq"];
    wl_sync -> bar     [dir=both, style=dashed, xlabel="dfi_phylvl_req / ack,\nwrlvl strobe, prime_dq"];

    // ---- ranks: three straight columns; legend parked at the bar rank ----
    { rank=same; p_wd; p_cmd; p_rd; p_wl; }
    { rank=same; cdc_wd; cdc_cmd; cdc_rd; wl_sync; }
    { rank=same; wr_ser; rd_al; }
    { rank=same; bar; legend; }
    p_wd -> p_cmd -> p_rd -> p_wl [style=invis];
    cdc_wd -> cdc_cmd -> cdc_rd -> wl_sync [style=invis];
    wr_ser -> rd_al [style=invis];
    bar -> legend [style=invis];
}
