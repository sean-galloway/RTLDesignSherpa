// mc_training_layer — shell and rock-wrapper contract.
// Per STYLE.md: white canvas, blue functional blocks, white external/context
// boxes, dashed = shell-only / optional, splines=ortho.
digraph mc_training_layer {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.30", ranksep="0.55", splines=ortho, compound=true,
           newrank=true,
           label="mc_training_layer — shell and rock-wrapper contract",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize="10", shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.07"];
    edge  [fontname="Helvetica", fontsize="9", color="black", arrowsize=0.7];

    // ---- external context (white) ----
    sched [label="Scheduler Maintenance Slot\nmc_scheduler_layer — maintenance req/grant",
           fillcolor="white", width=3.2];
    phy_cal [label="PHY Calibration Sideband\n(dfi_clk domain)", fillcolor="white"];

    // ---- shell blocks (blue) ----
    mux [label="One-Active trn_cmd Mux\nmc_training_layer — fixed-priority selector"];
    slot0 [label="Maintenance Slot 0\nmc_training_layer — generic slot port"];
    slot1 [label="Maintenance Slot 1\nmc_training_layer — generic slot port"];
    cdc [label="Calibration Sideband CDC\nmc_training_layer — sync_pulse + cdc_synchronizer\n(mc_clk -> dfi_clk)"];

    // ---- rock-wrapper supplied calibration FUBs (dashed border = wrapper area) ----
    subgraph cluster_rock {
        label="rock wrapper supplies its calibration FUBs\n(example: pumice_zq_ctrl, pumice_lp_cal)";
        labelloc=t;
        labeljust=c;
        style=dashed;
        color=black;
        fillcolor=none;
        fontname="Helvetica";
        fontsize=10;

        zq [label="ZQ Calibration Controller\npumice_zq_ctrl — ZQCS / ZQCL"];
        dq [label="DQ Calibration Sequencer\npumice_lp_cal — MRR readout"];
        wl [label="Write-Leveling Interface\nshell-only — write-leveling sequencer",
            style="filled,dashed"];

        zq -> dq -> wl [style=invis];
    }

    // ---- maintenance request/grant flow ----
    zq -> slot0 [label="maintenance req"];
    dq -> slot1 [label="maintenance req"];
    wl -> slot1 [label="maintenance req", style=dashed];

    slot0 -> mux [label="slot command"];
    slot1 -> mux [label="slot command"];

    mux -> sched [label="maintenance command"];
    sched -> mux [label="grant"];
    mux -> slot0 [label="grant"];
    mux -> slot1 [label="grant"];

    // ---- calibration sideband crossing ----
    // Rank order: FUBs -> CDC -> PHY cal (cal_expect down, cal_data up)
    zq -> cdc [style=dashed, arrowhead=none];
    dq -> cdc [style=dashed, arrowhead=none];
    wl -> cdc [style=dashed, arrowhead=none];
    cdc -> phy_cal [label="calibration expect"];

    cdc -> zq [constraint=false];
    cdc -> dq [constraint=false];
    cdc -> wl [style=dashed, constraint=false];
    phy_cal -> cdc [label="calibration data", constraint=false];

    // ---- rank pinning ----
    { rank=same; sched; }
    { rank=same; mux; }
    { rank=same; slot0; slot1; }
    { rank=same; zq; dq; wl; }

    sched -> mux [style=invis];
    mux -> slot0 [style=invis];
    slot0 -> slot1 [style=invis];
    slot0 -> zq [style=invis];
    slot1 -> dq [style=invis];
    slot1 -> wl [style=invis];
    zq -> cdc [style=invis];
    cdc -> phy_cal [style=invis];
}
