// DFI 3.1 PHY-facing layer internal block diagram — mc_dfi_3p1_layer.
// Follows the DDR-MC course style per common_has/assets/graphviz/STYLE.md.
digraph mc_dfi_3p1_layer {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.30", ranksep="0.55", splines=ortho,
           label="DFI 3.1 = 2p1 pipeline + generation command surface",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.07"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- external controller-side interface (white) ----
    ctl [label="Controller Domain\n(ctl_clk)", fillcolor="white", width=2.5];

    // ---- core layer blocks (blue) ----
    cdc [label="Clock-Domain Crossing\nmc_dfi_cdc — async FIFOs",
         width=2.4, height=0.9];
    wr  [label="Write Serializer\nmc_dfi_wr_serializer",
         width=2.1, height=0.8];
    cmd [label="DFI 3.1 Command Path\nmc_dfi_3p1_cmd_path",
         width=2.4, height=0.9];
    rd  [label="Read Aligner\nmc_dfi_rd_aligner",
         width=2.1, height=0.8];

    // ---- optional write-leveling handshake surface ----
    wrlvl [label="Write-Leveling Handshake Surface\ndfi_wrlvl_*",
           style="filled,dashed", width=2.6, height=0.8];
    wrlvl_note [label="unused on Genesys 2 PHY —\nleveling is the PHY's own",
                shape=none, color=none, fillcolor=none, fontsize=9];

    // ---- external PHY bar (white, last rank) ----
    phy [label="DDR PHY  (DFI 3.1 pin bus, dfi_clk domain)", fillcolor="white",
         rank=sink, width=6.5, fontsize=11];

    // ---- controller -> layer ----
    ctl -> cdc [dir=both, arrowhead=normal, label="CMD / WR / RD\n/ init tokens"];
    ctl -> wrlvl [style=dashed, arrowhead=normal, label="leveling request"];

    // ---- CDC -> dfi_clk blocks ----
    cdc -> cmd [label="command descriptor"];
    cdc -> wr  [label="WR data"];
    rd  -> cdc [label="RD data"];

    // ---- DFI 3.1 blocks -> PHY ----
    cmd -> phy [label="DDR Command"];
    wr  -> phy [label="Write to DDR"];
    rd  -> phy [dir=back, label="Read from DDR"];

    // ---- write-leveling handshake (dashed, PHY's own on Genesys 2) ----
    wrlvl -> phy [style=dashed, arrowhead=normal, label="dfi_wrlvl_*"];
    wrlvl -> phy [style=dashed, arrowhead=none, dir=back, label="dfi_phylvl_ack"];
    wrlvl -> wrlvl_note [style=dashed, arrowhead=none, color="gray"];

    // ---- rank pinning ----
    { rank=same; ctl; }
    { rank=same; cdc; }
    { rank=same; wr; cmd; rd; }
    wr -> cmd [style=invis];
    cmd -> rd [style=invis];
    { rank=same; wrlvl; wrlvl_note; }
    { rank=sink; phy; }

    // invisible edges to keep the CDC centered above cmd
    cdc -> wr [style=invis];
    cdc -> cmd [style=invis];
    cdc -> rd [style=invis];
}
