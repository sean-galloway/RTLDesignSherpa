// mc_dfi_4p0_plane block diagram -- GENERATED by gen_dfi_planes.py; edit the script.
// House style: vault/handbook/authoring/block-diagrams.md and common_has STYLE.md.
// Command down the center, write data down the left, read data back up the
// right; the DDR PHY (DFI pin bus) is the bar.
digraph mc_dfi_4p0_plane {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.55", splines=ortho,
           label="mc_dfi_4p0_plane - DFI 4.0 boundary:\nthe shared pipeline + DDR4 / LPDDR4 command path + DBI", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- controller-side ports (ctl_clk) ----
    p_wd  [label="Write data in (ctl_clk)\nfrom the write-data commit stream", fillcolor="white"];
    p_cmd [label="DDR Command in (ctl_clk)\nfrom mc_scheduler_plane", fillcolor="white"];
    p_rd  [label="Read data out (ctl_clk)\nto mc_rd_return_ring", fillcolor="white"];
    legend [label="Runtime inputs (dfi_clk side, CSR-driven)\l  t_phy_wrlat: write serializer launch delay\l  t_rddata_en: read aligner enable delay\l  rd_phase / wr_phase: DFI phase of the column\l  gear: active DFI phases (masks the data enables)\l  parity_en: CA parity on the command path\l  wr_dbi_en / rd_dbi_en: data bus inversion\l  cke_i: registered onto dfi_cke\l", fillcolor="white"];

    // ---- the single CDC: mc_dfi_cdc (gaxi_fifo_async only) ----
    cdc_wd  [label="Write Data CDC FIFO\nmc_dfi_cdc - gaxi_fifo_async\n(ctl_clk -> dfi_clk)"];
    cdc_cmd [label="Command CDC FIFO\nmc_dfi_cdc - gaxi_fifo_async\n(ctl_clk -> dfi_clk);\ndfi_init start / complete tokens (to the PHY pins)"];
    cdc_rd  [label="Read Data CDC FIFO\nmc_dfi_cdc - gaxi_fifo_async\n(dfi_clk -> ctl_clk)"];

    // ---- dfi_clk datapath ----
    cmd_path [label="DFI 4.0 Command Path\nmc_dfi_4p0_cmd_path - FUB\nACT_n, bank group, CA parity,\nwrite / read fire strobes"];
    wr_ser   [label="Write Serializer\nmc_dfi_wr_serializer - FUB\nlaunch at t_phy_wrlat; write DBI"];
    rd_al    [label="Read Aligner\nmc_dfi_rd_aligner - FUB\ndfi_rddata_en at t_rddata_en; read DBI"];

    bar [label="DDR PHY (DFI 4.0 pin bus, dfi_clk) - command + ACT_n / BG / parity / CKE, dfi_wrdata, dfi_rddata, dfi_init", fillcolor="white", width=9, height=0.5, fontsize=11];

    // ---- write data: down the left ----
    p_wd   -> cdc_wd [xlabel="write data + strb + DBI + last"];
    cdc_wd -> wr_ser [xlabel="write data"];
    wr_ser -> bar    [xlabel="Write to DDR"];

    // ---- command: down the center ----
    p_cmd    -> cdc_cmd  [penwidth=1.8, xlabel="DDR Command"];
    cdc_cmd  -> cmd_path [penwidth=1.8, xlabel="DDR Command"];
    cmd_path -> bar      [penwidth=1.8, label="DDR Command"];
    cmd_path -> wr_ser   [style=dashed, xlabel="write fire"];
    cmd_path -> rd_al    [style=dashed, xlabel="read fire"];

    // ---- read data: back up the right ----
    p_rd   -> cdc_rd [dir=back, xlabel="read data + DBI + resp + last"];
    cdc_rd -> rd_al  [dir=back, xlabel="read data"];
    rd_al  -> bar    [dir=back, xlabel="Read from DDR"];

    // ---- ranks ----
    { rank=same; p_wd; p_cmd; p_rd;  }
    { rank=same; cdc_wd; cdc_cmd; cdc_rd;  }
    { rank=same; wr_ser; rd_al; legend; }
    p_wd -> p_cmd -> p_rd [style=invis];
    cdc_wd -> cdc_cmd -> cdc_rd [style=invis];
    wr_ser -> rd_al -> legend [style=invis];
}
