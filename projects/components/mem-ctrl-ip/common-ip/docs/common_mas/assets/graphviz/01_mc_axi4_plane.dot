// mc_axi4_plane internal block diagram -- house style per
// vault/handbook/authoring/block-diagrams.md and STYLE.md (common_has).
// Plane scale: the boundary bar is the plane edge (storage / scheduler /
// DFI planes). Whole-unit idiom: the write chain is one straight column
// on the left, the read chain one straight column on the right, host
// responses ride the same hops back up (double-headed), and the read
// return rises on its own center lane into the ring, then up into the
// read intake. Every arrow is vertical; nothing wraps a margin.
digraph mc_axi4_plane {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.60", ranksep="0.55", splines=ortho,
           label="mc_axi4_plane - AXI4 host interface, intakes and read-return ring (aclk)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    // ---- host channels (white) ----
    axi_wr [label="AXI Write Channel\n(AW, W in / B out)", fillcolor="white", group=W];
    axi_rd [label="AXI Read Channel\n(AR in / R out)", fillcolor="white", group=R];

    // ---- request side ----
    wr_split [label="Write Burst Splitter\nmc_wr_splitter - FUB\n(one sub-burst per DRAM burst)", group=W];
    rd_chop  [label="Read Burst Chopper\nmc_axi_burst_chopper - FUB\n(one sub-burst per DRAM burst)", group=R];

    wr_intake [label="Write Intake\nmc_wr_intake - FUB\naddress map (mc_addr_mapper), AW-meta + W FIFOs,\none B per host burst on write done", group=W];
    rd_intake [label="Read Intake\nmc_rd_intake - FUB\naddress map, snarf probe, AR-order FIFO,\nR source select (snarf or DRAM)", group=R];

    ring [label="Read Return Ring\nmc_rd_return_ring - FUB\nticket per read in AR order,\nfilled in issue order, drained in AR order"];

    // ---- boundary bar: the plane edge ----
    bar [label="Plane edge - mc_storage_plane (wr / rd CAMs), mc_scheduler_plane (issue), DFI plane (read return)",
         fillcolor="white", width=13, height=0.5, fontsize=11];

    // ---- host channel hops: request down, response up on the same hop ----
    axi_wr   -> wr_split  [dir=both, xlabel="AW / W · B"];
    wr_split -> wr_intake [xlabel="AW / W (split)"];
    axi_rd   -> rd_chop   [dir=both, xlabel="AR · R"];
    rd_chop  -> rd_intake [xlabel="AR (split)"];

    // ---- write flow: down the left column, write done back up the same lane ----
    wr_intake -> bar [dir=both, xlabel="WR push + write data (write done back)"];

    // ---- read request: down the right column (snarf probe on a parallel dashed lane) ----
    rd_intake -> bar [xlabel="RD push"];
    rd_intake -> bar [dir=both, style=dashed, xlabel="snarf probe / hit + data"];

    // ---- read return: up the center lane into the ring (parked at the
    //      intake rank, between the columns), drained across to the intake.
    //      All three ring edges are constraint=false: their rank constraints
    //      would cycle (bar -> ring -> intake -> bar); the rank=same pin
    //      below is the single source of truth for the ring's rank.
    bar  -> ring [constraint=false, xlabel="read data (issue order)"];
    ring -> bar  [dir=both, constraint=false, style=dashed, xlabel="tickets"];
    ring -> rd_intake [constraint=false, style=dashed, xlabel="drain"];

    // ---- rank pinning (write column left, read column right, ring center) ----
    { rank=same; axi_wr; axi_rd; }
    { rank=same; wr_split; rd_chop; }
    { rank=same; wr_intake; ring; rd_intake; }
    axi_wr -> axi_rd [style=invis];
    wr_split -> rd_chop [style=invis];
    wr_intake -> ring -> rd_intake [style=invis];
}
