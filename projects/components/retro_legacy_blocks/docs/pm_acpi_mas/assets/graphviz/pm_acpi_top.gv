// PM/ACPI Top-Level Block Diagram
digraph pm_acpi_top {
    rankdir=LR;
    node [shape=box, style="rounded,filled", fillcolor=lightblue];

    apb_in [label="APB Slave\nInterface", shape=ellipse, fillcolor=lightgreen];
    events_in [label="Event Inputs\n(PWRBTN, SLPBTN,\nRTC, EXT_WAKE, GPE)", shape=ellipse, fillcolor=lightgreen];

    subgraph cluster_pm {
        label="apb4_pm_acpi";
        style=rounded;

        apb_if [label="APB\nInterface\n(+ optional CDC)", fillcolor=lightyellow];
        regs [label="Register File\n(strict decode,\nPSLVERR on unmapped,\nstatus mirrors)", fillcolor=lightyellow];
        sync [label="Input\nSynchronizers\n(SYNC_STAGES /\n3-flop buttons)", fillcolor=lightcyan];
        pm_timer [label="PM Timer\n(32-bit\n~3.571 MHz)", fillcolor=lightcyan];
        event_ctrl [label="Event Controller\n(GPE edge detect,\nsticky W1C status\nowned here)", fillcolor=lightcyan];
        sleep_ctrl [label="Power State FSM\n(S0/S1/S3,\nlatched wake)", fillcolor=lightcyan];
        int_gen [label="Interrupt\n(level OR of\nenabled status)", fillcolor=lightcyan];
    }

    int_out [label="pm_interrupt", shape=ellipse, fillcolor=pink];
    sleep_out [label="clock_gate_en[31:0]\npower_domain_en[7:0]", shape=ellipse, fillcolor=pink];
    rst_out [label="sys_reset_req\nperiph_reset_req", shape=ellipse, fillcolor=pink];
    apb_out [label="APB\nResponse", shape=ellipse, fillcolor=pink];

    apb_in -> apb_if;
    apb_if -> regs;
    apb_if -> apb_out;
    events_in -> sync;
    sync -> event_ctrl;
    regs -> event_ctrl [label="enables,\nW1C clear"];
    event_ctrl -> regs [label="status"];
    regs -> pm_timer;
    pm_timer -> regs;
    pm_timer -> event_ctrl [label="overflow"];
    regs -> sleep_ctrl [label="sleep_type,\nsleep_enable"];
    event_ctrl -> sleep_ctrl [label="wake"];
    sleep_ctrl -> sleep_out;
    regs -> rst_out;
    event_ctrl -> int_gen;
    int_gen -> int_out;
}
