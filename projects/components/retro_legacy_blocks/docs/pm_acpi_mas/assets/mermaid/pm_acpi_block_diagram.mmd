%%{init: {'theme': 'neutral'}}%%
flowchart LR
    subgraph APB_PM["APB PM/ACPI"]
        APB["APB Slave<br/>(+ optional CDC)"]
        CFG["pm_acpi_config_regs<br/>(strict decode, W1C mask)"]
        REGS["pm_acpi_regs<br/>(PeakRDL, status mirrors)"]

        subgraph CORE["pm_acpi_core"]
            SYNC["Input Synchronizers<br/>(SYNC_STAGES / 3-flop buttons)"]
            STS["Sticky W1C Status<br/>(ACPI/INT/PM1/WAKE/GPE)"]
            TMR["PM Timer<br/>(32-bit)"]
            GPE["GPE Edge Detect"]
            FSM["Power State FSM<br/>(S0/S1/S3/S5, latched wake,<br/>rail sequencer)"]
            INT["Interrupt<br/>(level OR of enabled status)"]
        end
    end

    BUS["APB Bus"] --> APB
    APB --> CFG
    CFG --> REGS
    CFG --> CORE

    PINS["PWR_BTN#, SLP_BTN#,<br/>rtc_alarm, ext_wake_n,<br/>gpe_events[31:0]"] --> SYNC
    SYNC --> GPE
    SYNC --> STS
    GPE --> STS
    TMR --> STS
    STS --> FSM
    STS --> INT
    INT --> IRQ["pm_interrupt"]
    FSM --> PWR["clock_gate_en / power_domain_en"]
