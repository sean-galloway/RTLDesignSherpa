// RTC Top-Level Block Diagram
//
// Two clock domains, drawn as two clusters, with every crossing between them
// labelled by the rtl/cdc primitive that carries it (rtl/rtc/README.md,
// "Clocks, resets and the crossings").
digraph rtc_top {
    rankdir=TB;
    newrank=true;
    nodesep=0.5;
    ranksep=0.7;
    node [shape=box, style="rounded,filled", fillcolor=lightblue];

    // Inputs
    apb_in  [label="APB Slave\nInterface", shape=ellipse, fillcolor=lightgreen];
    clk_32k [label="rtc_clk\n32.768 kHz", shape=ellipse, fillcolor=lightgreen];
    rtc_rst [label="rtc_resetn", shape=ellipse, fillcolor=lightgreen];

    subgraph cluster_rtc {
        label="apb4_rtc";
        style=rounded;

        subgraph cluster_apb {
            label="APB domain (pclk / presetn)";
            style="rounded,dashed";
            apb_if  [label="APB\nInterface", fillcolor=lightyellow];
            regs    [label="Register File\n(13-register decode,\nPSLVERR elsewhere)", fillcolor=lightyellow];
            stage   [label="Time-Set\nStaging\n(6 bytes)", fillcolor=lightyellow];
            shadow  [label="Time Shadow\n+ Seconds-Read Latch\n(minutes..year)", fillcolor=lightyellow];
            flags   [label="Sticky Flags\n(W1C, set wins)", fillcolor=lightyellow];
            int_gen [label="Interrupt\nGenerator", fillcolor=lightyellow];
            {rank=same; regs; stage; shadow; flags;}
        }

        subgraph cluster_ctr {
            label="Counter domain (rtc_clk, or pclk when clock_select=1)";
            style="rounded,dashed";
            rst_sync [label="reset_sync", fillcolor=lightcyan];
            divider  [label="Divider\n(1 Hz)", fillcolor=lightcyan];
            time_cnt [label="Time Counters\n(sec to year,\nbinary calendar)", fillcolor=lightcyan];
            alarm    [label="Alarm\nComparator", fillcolor=lightcyan];
            {rank=same; divider; time_cnt; alarm;}
        }
    }

    // Outputs
    irq     [label="rtc_alarm_irq\nrtc_second_irq", shape=ellipse, fillcolor=pink];
    apb_out [label="APB\nResponse", shape=ellipse, fillcolor=pink];

    // APB side
    apb_in -> apb_if;
    apb_if -> regs;
    apb_if -> apb_out;
    regs -> stage;
    shadow -> regs [label="time"];
    flags -> regs [label="status"];
    flags -> int_gen;
    int_gen -> irq;

    // Counter side
    clk_32k -> divider;
    rtc_rst -> rst_sync;
    rst_sync -> divider;
    divider -> time_cnt [label="1 Hz"];
    time_cnt -> alarm;

    // Crossings (pclk -> counter)
    regs -> alarm    [label="config + alarm + valid\n3-flop sync + filter", style=dashed, color=firebrick];
    stage -> time_cnt [label="time-set commit\n4-phase handshake, 48 b", style=dashed, color=firebrick];

    // Crossings (counter -> pclk)
    time_cnt -> shadow [label="snapshot: sync_pulse\nbackground: 3-flop + filter", style=dashed, color=navy];
    divider -> flags   [label="tick\n3-flop + edge", style=dashed, color=navy];
    alarm -> flags     [label="match\n3-flop + edge", style=dashed, color=navy];
}
