%%{init: {'theme': 'neutral'}}%%
flowchart TB
    TOP[apb4_rtc<br/>Top Level]
    TOP --> APB[apb4_slave]

    TOP --> CFG[rtc_config_regs<br/>Register Wrapper]
    CFG --> ADP[peakrdl_to_cmdrsp]
    CFG --> REGS["rtc_regs<br/>(PeakRDL)"]

    TOP --> CORE[rtc_core]
    CORE --> RSYNC["reset_sync<br/>(rtc_resetn onto the counter clock)"]
    CORE --> TIME["Divider + Time Counters<br/>(seconds to year, counter domain)"]
    CORE --> ALARM["Alarm Comparator<br/>(counter domain)"]
    CORE --> FLAGS["Sticky Flags + Interrupts<br/>(pclk domain)"]
    CORE --> CDC["Clock crossings"]
    CDC --> C1["glitch_free_n_dff_arn + filter<br/>config + alarm + valid bundle"]
    CDC --> C2["cdc_4_phase_handshake<br/>time-set commit"]
    CDC --> C3["sync_pulse + glitch_free_n_dff_arn<br/>time read"]
    CDC --> C4["glitch_free_n_dff_arn<br/>tick / alarm events"]
