// PIT 8254 reset timing (replaces an ASCII sketch). Phase timeline, one
// column per phase. Source of truth: ch01_overview/03_clocks_and_reset.md and
// ch03_interfaces/01_top_level.md (hold and settle counts), rtl/pit_8254/
// pit_core.sv and pit_counter.sv (ALWAYS_FF_RST: async assert) and pit_regs.sv
// (PeakRDL: plain always_ff, synchronous reset).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph pit_reset_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="PIT 8254 reset: asynchronous assert, synchronous release, then settle", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="170" BORDER="0" ALIGN="RIGHT"><B>step</B></TD><TD WIDTH="128" BORDER="0"><B>1</B></TD><TD WIDTH="128" BORDER="0"><B>2</B></TD><TD WIDTH="128" BORDER="0"><B>3</B></TD><TD WIDTH="128" BORDER="0"><B>4</B></TD><TD WIDTH="128" BORDER="0"><B>5</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">phase</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>assert</B></TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>hold</B></TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>release</B></TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>settle</B></TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ready</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">presetn (and pit_resetn)</TD><TD COLSPAN="2" WIDTH="256" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="3" WIDTH="384" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">duration</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">immediate</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">&gt;= 10 cycles of<BR/>slowest clock</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">on a clock edge</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">&gt;= 5 cycles of<BR/>slowest clock</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">core + counter flops</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">cleared at once<BR/>(async assert)</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">held in reset</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">leave reset at<BR/>the edge</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">idle<BR/>(NULL_COUNT=1)</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">idle until<BR/>programmed</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">PeakRDL register file</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">cleared on the next<BR/>clock edge (sync)</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">held in reset</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">leave reset at<BR/>the edge</TD><TD COLSPAN="2" WIDTH="256" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">reset values</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">APB access</TD><TD COLSPAN="4" WIDTH="512" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">not allowed</TD><TD COLSPAN="1" WIDTH="128" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">allowed</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="5" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Assertion needs no clock for the hand-written logic; the generated register file resets<BR ALIGN="LEFT"/>synchronously, so its clock must run during the hold. Release is synchronous to the clock.<BR ALIGN="LEFT"/>With CDC_ENABLE=1, presetn resets the pclk side and pit_resetn the pit_clk side; hold and<BR ALIGN="LEFT"/>release both, counting cycles of the slower clock.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
