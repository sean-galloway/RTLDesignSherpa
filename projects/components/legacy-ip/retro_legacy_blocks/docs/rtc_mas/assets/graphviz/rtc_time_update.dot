// RTC time update - house style (vault/handbook/authoring/block-diagrams.md).
// One flow, top-down: the counter clock is divided to the 1 Hz tick, which
// advances the seconds, and each counter carries into the next. The six
// fields leave at the bar. Counter domain only.
// Source of truth: rtl/rtc/rtc_core.sv (DIV_TARGET_RTC / DIV_TARGET_SYS,
// calendar arithmetic).
digraph rtc_time_update {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.50", splines=ortho, newrank=true,
           label="RTC time update - divider and calendar counters (counter domain, all flops on the counter clock)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    clk [group=C, fillcolor="white", label="Counter Clock\nrtc_clk 32.768 kHz, or pclk when clock_select=1 (rtc_clk_mux)", style="rounded,filled", fillcolor="#E2EFDA"];
    div [group=C, width=5.5, label="Divider (flop) - rtc_core\nrolls over at 32767 (rtc_clk) or 99 (clock_select=1 test mode)\nthe rollover is the 1 Hz tick; paused while time_set_mode is seen", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    sec [group=C, width=5.5, label="Seconds (flop) - rtc_core\n0 .. 59, carry out at 59", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    mnt [group=C, width=5.5, label="Minutes (flop) - rtc_core\n0 .. 59, carry out at 59", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    hdm [group=C, width=5.5, label="Hours, Date, Month, Year (flop) - rtc_core\nhours 0 .. 23, or 1 .. 12 with PM (one midnight carry)\ndate 1 .. days-in-month, February 29 when year % 4 = 0\nyear 0 .. 99 (base 2000), wraps 99 -> 00 with no century carry", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    ld  [group=L, label="Commit Load (flop) - rtc_core\ncdc_4_phase_handshake destination\nloads all six counters on one edge", peripheries=2, style="filled", fillcolor="#D6E4F0"];

    bar [group=C, fillcolor="white", width=8.0,
         label="Time Value Out\nsix fields, binary inside; BCD / 12-hour formatting at the register boundary\n-> snapshot crossing to the pclk shadow, and the alarm comparator", style="rounded,filled,bold", fillcolor="#E2EFDA"];

    clk -> div [penwidth=1.8, xlabel="counter clock"];
    div -> sec [penwidth=1.8, xlabel="1 Hz tick"];
    sec -> mnt [penwidth=1.8, xlabel="carry"];
    mnt -> hdm [penwidth=1.8, xlabel="carry"];
    hdm -> bar [penwidth=1.8, xlabel="seconds .. year"];
    ld  -> sec [style=dashed, color="#777777", xlabel="load all six counters\n(time-set commit)"];

    { rank=same; ld; div; }
}
