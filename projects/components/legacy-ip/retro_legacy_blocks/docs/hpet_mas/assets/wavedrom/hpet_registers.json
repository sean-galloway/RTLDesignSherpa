{
  "description": "HPET register bit-field layouts (WaveDrom reg format), at the PUBLISHED SPEC offsets and field positions. Matches the RTL decode in rtl/hpet/hpet_regs.sv.",
  "registers": [
    {
      "name": "HPET_ID",
      "offset": "0x000",
      "access": "RO",
      "description": "Identification and capabilities (read-only). Vendor/revision are fixed 0x01/0x01 in the generated RTL.",
      "diagram": {
        "reg": [
          {
            "bits": 8,
            "name": "rev_id",
            "attr": "REVISION_ID parameter"
          },
          {
            "bits": 5,
            "name": "num_tim_cap",
            "attr": "Timers - 1"
          },
          {
            "bits": 1,
            "name": "count_size_cap",
            "attr": "1 = 64-bit counter"
          },
          {
            "bits": 1,
            "name": "reserved",
            "attr": "Reserved",
            "type": 1
          },
          {
            "bits": 1,
            "name": "leg_rt_cap",
            "attr": "Reads 1 (legacy route implemented)"
          },
          {
            "bits": 16,
            "name": "vendor_id",
            "attr": "VENDOR_ID parameter, full 16 bits"
          }
        ],
        "config": {
          "hspace": 800,
          "bits": 32,
          "lanes": 1
        }
      }
    },
    {
      "name": "HPET_CONFIG",
      "offset": "0x010",
      "access": "RW",
      "description": "Global configuration",
      "diagram": {
        "reg": [
          {
            "bits": 1,
            "name": "hpet_enable",
            "attr": "Enable HPET"
          },
          {
            "bits": 1,
            "name": "legacy_replacement",
            "attr": "T0->IRQ0, T1->IRQ8"
          },
          {
            "bits": 30,
            "name": "reserved",
            "attr": "Reserved",
            "type": 1
          }
        ],
        "config": {
          "hspace": 800,
          "bits": 32,
          "lanes": 1
        }
      }
    },
    {
      "name": "HPET_STATUS",
      "offset": "0x020",
      "access": "RW (W1C)",
      "description": "Timer interrupt status (fixed 8-bit field regardless of NUM_TIMERS)",
      "diagram": {
        "reg": [
          {
            "bits": 1,
            "name": "T0",
            "attr": "Timer 0 IRQ"
          },
          {
            "bits": 1,
            "name": "T1",
            "attr": "Timer 1 IRQ"
          },
          {
            "bits": 1,
            "name": "T2",
            "attr": "Timer 2 IRQ"
          },
          {
            "bits": 1,
            "name": "T3",
            "attr": "Timer 3 IRQ"
          },
          {
            "bits": 1,
            "name": "T4",
            "attr": "Timer 4 IRQ"
          },
          {
            "bits": 1,
            "name": "T5",
            "attr": "Timer 5 IRQ"
          },
          {
            "bits": 1,
            "name": "T6",
            "attr": "Timer 6 IRQ"
          },
          {
            "bits": 1,
            "name": "T7",
            "attr": "Timer 7 IRQ"
          },
          {
            "bits": 24,
            "name": "reserved",
            "attr": "Reserved",
            "type": 1
          }
        ],
        "config": {
          "hspace": 800,
          "bits": 32,
          "lanes": 1
        }
      }
    },
    {
      "name": "HPET_PERIOD",
      "offset": "0x004",
      "access": "RO",
      "description": "GCAP_ID[63:32]: main counter period in femtoseconds. Software derives frequency as 1e15 / period.",
      "diagram": {
        "reg": [
          {
            "bits": 32,
            "name": "counter_clk_period",
            "attr": "Femtoseconds per tick"
          }
        ],
        "config": {
          "hspace": 800,
          "bits": 32,
          "lanes": 1
        }
      }
    },
    {
      "name": "HPET_COUNTER_LO",
      "offset": "0x0F0",
      "access": "RW",
      "description": "Main counter [31:0]",
      "diagram": {
        "reg": [
          {
            "bits": 32,
            "name": "counter[31:0]",
            "attr": "Counter lower 32 bits"
          }
        ],
        "config": {
          "hspace": 800,
          "bits": 32,
          "lanes": 1
        }
      }
    },
    {
      "name": "HPET_COUNTER_HI",
      "offset": "0x0F4",
      "access": "RW",
      "description": "Main counter [63:32]",
      "diagram": {
        "reg": [
          {
            "bits": 32,
            "name": "counter[63:32]",
            "attr": "Counter upper 32 bits"
          }
        ],
        "config": {
          "hspace": 800,
          "bits": 32,
          "lanes": 1
        }
      }
    },
    {
      "name": "TIMER_CONFIG",
      "offset": "0x100 + i*0x20",
      "access": "RW",
      "description": "Per-timer configuration (i = timer index)",
      "diagram": {
        "reg": [
          {
            "bits": 1,
            "name": "reserved",
            "attr": "Reserved",
            "type": 1
          },
          {
            "bits": 1,
            "name": "timer_int_type",
            "attr": "0=edge 1=level (storage only)"
          },
          {
            "bits": 1,
            "name": "timer_int_enable",
            "attr": "Interrupt enable"
          },
          {
            "bits": 1,
            "name": "timer_type",
            "attr": "0=One-shot, 1=Periodic"
          },
          {
            "bits": 1,
            "name": "per_int_cap",
            "attr": "RO cap: periodic supported"
          },
          {
            "bits": 1,
            "name": "size_cap",
            "attr": "RO cap: 64-bit capable"
          },
          {
            "bits": 1,
            "name": "timer_value_set",
            "attr": "Stored, no HW effect"
          },
          {
            "bits": 1,
            "name": "reserved",
            "attr": "Reserved",
            "type": 1
          },
          {
            "bits": 1,
            "name": "timer_32mode",
            "attr": "1 FORCES 32-bit (64-bit = clear)"
          },
          {
            "bits": 5,
            "name": "timer_int_route",
            "attr": "I/O APIC input (storage; legacy overrides)"
          },
          {
            "bits": 1,
            "name": "timer_fsb_en",
            "attr": "FSB enable (storage)"
          },
          {
            "bits": 1,
            "name": "fsb_int_del_cap",
            "attr": "RO cap: reads 0, no FSB"
          },
          {
            "bits": 16,
            "name": "reserved",
            "attr": "Reserved",
            "type": 1
          }
        ],
        "config": {
          "hspace": 800,
          "bits": 32,
          "lanes": 1
        }
      }
    },
    {
      "name": "TIMER_INT_ROUTE_CAP",
      "offset": "0x104 + i*0x20",
      "access": "RO",
      "description": "TN_CONF[63:32]: bitmap of legal I/O APIC inputs. Reads 0 -- general per-timer routing is not implemented; independent of leg_rt_cap, which reads 1.",
      "diagram": {
        "reg": [
          {
            "bits": 32,
            "name": "int_route_cap",
            "attr": "One bit per legal input; 0 = none"
          }
        ],
        "config": {
          "hspace": 800,
          "bits": 32,
          "lanes": 1
        }
      }
    },
    {
      "name": "TIMER_COMPARATOR_LO",
      "offset": "0x108 + i*0x20",
      "access": "RW",
      "description": "Per-timer comparator bits [31:0] (reads return hpet_core's live comparator, including the periodic advance)",
      "diagram": {
        "reg": [
          {
            "bits": 32,
            "name": "comparator[31:0]",
            "attr": "Comparator lower 32 bits"
          }
        ],
        "config": {
          "hspace": 800,
          "bits": 32,
          "lanes": 1
        }
      }
    },
    {
      "name": "TIMER_COMPARATOR_HI",
      "offset": "0x10C + i*0x20",
      "access": "RW",
      "description": "Per-timer comparator bits [63:32] (reads return hpet_core's live comparator, including the periodic advance)",
      "diagram": {
        "reg": [
          {
            "bits": 32,
            "name": "comparator[63:32]",
            "attr": "Comparator upper 32 bits"
          }
        ],
        "config": {
          "hspace": 800,
          "bits": 32,
          "lanes": 1
        }
      }
    }
  ],
