// HPET multi-timer example - a procedure plus a timeline, in the house
// decision-tree vocabulary (white milestones, blue actions, every arrow
// labeled). Setup on the left, the counter timeline on the right, so the
// figure stays inside the 0.7 .. 2.5 aspect band. Needs NUM_TIMERS >= 3
// (the default build has 2).
digraph multi_timer_concurrent {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.50", splines=ortho, newrank=true,
           label="HPET example: three timers on one counter (NUM_TIMERS >= 3)", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    s0 [group=A, label="Setup", fillcolor="white"];
    s1 [group=A, label="1. Halt and zero the counter\nWRITE(HPET_CONFIG, 0x0)\nWRITE(HPET_COUNTER_LO / HI, 0)"];
    s2 [group=A, label="2. Timer 0: comparator 100, one-shot\nWRITE(TIMER0_CONFIG, 0x4)"];
    s3 [group=A, label="3. Timer 1: comparator 200, periodic\nWRITE(TIMER1_CONFIG, 0xC)  (period 200)"];
    s4 [group=A, label="4. Timer 2: comparator 700, one-shot\nWRITE(TIMER2_CONFIG, 0x4)"];
    s5 [group=A, label="5. Start\nWRITE(HPET_CONFIG, 0x1)"];

    t0 [group=B, label="Timeline (one shared counter,\nevery timer compares independently)", fillcolor="white"];
    t1 [group=B, label="counter = 100\ntimer 0 fires, then stays disarmed\nHPET_STATUS[0] sets"];
    t2 [group=B, label="counter = 200, 400, 600\ntimer 1 fires each time;\ncomparator advances 400, 600, 800"];
    t3 [group=B, label="counter = 700\ntimer 2 fires, then stays disarmed\nHPET_STATUS[2] sets"];
    t4 [group=B, label="After 700\ntimer 1 keeps firing (800, 1000, ...);\nthe ISR clears each status bit (W1C)", fillcolor="white"];

    s0 -> s1 [xlabel="begin"];
    s1 -> s2 [xlabel="halted, zeroed"];
    s2 -> s3 [xlabel="timer 0 set"];
    s3 -> s4 [xlabel="timer 1 set"];
    s4 -> s5 [xlabel="timer 2 set"];
    s5 -> t0 [xlabel="counter runs", constraint=false];
    t0 -> t1 [xlabel="ticks"];
    t1 -> t2 [xlabel="ticks"];
    t2 -> t3 [xlabel="ticks"];
    t3 -> t4 [xlabel="ticks"];

    { rank=same; s0; t0; }
    { rank=same; s1; t1; }
    { rank=same; s2; t2; }
    { rank=same; s3; t3; }
    { rank=same; s4; t4; }
    s0 -> t0 [style=invis, minlen=4];
}
