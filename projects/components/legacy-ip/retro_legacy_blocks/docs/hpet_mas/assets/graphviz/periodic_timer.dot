// render: no-key (decision-tree / process-flow vocabulary, not the element key)
// HPET periodic timer operation - a procedure in the house decision-tree
// vocabulary (white questions, blue actions, every arrow labeled).
// Behavior per rtl/hpet/hpet_core.sv: the comparator advances by the period
// on each fire, a late timer catches up one boundary per cycle without
// firing, and only HPET_CONFIG.enable = 0 stops it (no per-timer run enable).
digraph periodic_timer {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.50", splines=ortho, newrank=true,
           label="HPET periodic timer (TN_CONF.TYPE = 1)", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    start [group=A, label="Timer programmed\ncomparator write sets the first fire\nAND the period; TN_CONF.TYPE = 1", fillcolor="white"];
    run   [group=A, label="Main counter runs\n+1 per tick while HPET_CONFIG.enable = 1"];
    match [group=A, label="counter >= comparator\nand armed?", fillcolor="white"];
    fire  [group=A, label="Timer fires\nHPET_STATUS[i] sets;\npin asserts if TN_CONF.INT_ENB = 1"];
    adv   [group=B, label="Comparator advances (hardware)\ncomparator += period; the match falls\nand the timer re-arms"];
    late  [group=B, label="Advanced value still\nat or below the counter?", fillcolor="white"];
    catch [group=B, label="Catch-up\nadvance one boundary per cycle,\nno fire, until ahead of the counter"];
    clr   [group=B, label="Software clears\nWRITE(HPET_STATUS, 1 << i)\n(the timer keeps running)"];
    stop  [group=B, label="Stop\nWRITE(HPET_CONFIG, 0x0) halts every timer;\nINT_ENB = 0 only masks the pin", fillcolor="white"];

    start -> run   [xlabel="HPET_CONFIG.enable = 1"];
    run   -> match [xlabel="every tick"];
    match -> run   [xlabel="no", constraint=false];
    match -> fire  [xlabel="yes"];
    fire  -> adv   [xlabel="same clock"];
    adv   -> late  [xlabel="next clock"];
    late  -> catch [xlabel="yes (missed periods\nare skipped)"];
    late  -> clr   [xlabel="no: waiting for the\nnext boundary"];
    catch -> clr   [xlabel="ahead: re-armed"];
    clr   -> stop  [xlabel="to stop"];
    clr   -> run   [xlabel="next period", constraint=false];

    { rank=same; start; adv; }
    { rank=same; run; late; }
    { rank=same; match; catch; }
    { rank=same; fire; clr; }
    start -> adv [style=invis, minlen=4];
}
