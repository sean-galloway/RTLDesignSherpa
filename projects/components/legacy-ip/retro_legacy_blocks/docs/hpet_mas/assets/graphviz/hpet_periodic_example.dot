// HPET periodic-mode example (replaces an ASCII sketch). Columns are
// counter values, not consecutive cycles ('...' elides the gaps).
// Source of truth: rtl/hpet/hpet_core.sv and hpet_config_regs.sv; cycle
// positions checked against the test_apb4_hpet gate simulation (CDC_ENABLE=0).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph hpet_periodic_example {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Periodic timer, comparator written 1000 (so period = 1000): sticky\nstatus from the first fire", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="170" BORDER="0" ALIGN="RIGHT"><B>r_main_counter</B></TD><TD WIDTH="58" BORDER="0"><B>0</B></TD><TD WIDTH="58" BORDER="0"><B>...</B></TD><TD WIDTH="58" BORDER="0"><B>1000</B></TD><TD WIDTH="58" BORDER="0"><B>1001</B></TD><TD WIDTH="58" BORDER="0"><B>...</B></TD><TD WIDTH="58" BORDER="0"><B>2000</B></TD><TD WIDTH="58" BORDER="0"><B>2001</B></TD><TD WIDTH="58" BORDER="0"><B>...</B></TD><TD WIDTH="58" BORDER="0"><B>3000</B></TD><TD WIDTH="58" BORDER="0"><B>3001</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">r_timer_comparator[0]</TD><TD COLSPAN="3" WIDTH="174" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">1000</TD><TD COLSPAN="3" WIDTH="174" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">2000</TD><TD COLSPAN="3" WIDTH="174" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">3000</TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">4000</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">w_timer_fire</TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">timer_int_status[0]</TD><TD COLSPAN="3" WIDTH="174" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="7" WIDTH="406" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">timer_irq[0] (int_enable=1)</TD><TD COLSPAN="3" WIDTH="174" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="7" WIDTH="406" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="2" WIDTH="116" HEIGHT="38" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>Fire 1</I></FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>advance</I></FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>Fire 2</I></FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>advance</I></FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>Fire 3</I></FONT></TD><TD COLSPAN="1" WIDTH="58" HEIGHT="38" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>advance</I></FONT></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="10" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">A comparator write loads both the comparator and the period, so writing 1000 gives<BR ALIGN="LEFT"/>period 1000. Each fire advances the comparator by the period at the closing edge.<BR ALIGN="LEFT"/>Status and irq do NOT pulse per fire: set at Fire 1, they hold through Fire 2 and 3<BR ALIGN="LEFT"/>until software clears HPET_STATUS (W1C).<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
