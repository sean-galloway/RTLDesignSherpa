// HPET one-shot example (replaces an ASCII sketch). Columns are counter
// values / cycles, not consecutive ('...' elides the gaps). T is the first
// cycle of a software write of 1 to HPET_STATUS[0].
// Source of truth: rtl/hpet/hpet_core.sv and hpet_config_regs.sv; cycle
// positions checked against the test_apb4_hpet gate simulation (CDC_ENABLE=0).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph hpet_oneshot_example {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="One-shot timer, comparator = 5000: fires once, status held until\nsoftware W1C", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="170" BORDER="0" ALIGN="RIGHT"><B>cycle</B></TD><TD WIDTH="62" BORDER="0"><B>0</B></TD><TD WIDTH="62" BORDER="0"><B>...</B></TD><TD WIDTH="62" BORDER="0"><B>5000</B></TD><TD WIDTH="62" BORDER="0"><B>5001</B></TD><TD WIDTH="62" BORDER="0"><B>5002</B></TD><TD WIDTH="62" BORDER="0"><B>...</B></TD><TD WIDTH="62" BORDER="0"><B>T</B></TD><TD WIDTH="62" BORDER="0"><B>T+1</B></TD><TD WIDTH="62" BORDER="0"><B>T+2</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">r_main_counter</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">0</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">...</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">5000</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">5001</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">5002</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">...</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">C</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">C+1</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">C+2</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">r_timer_comparator[0]</TD><TD COLSPAN="9" WIDTH="558" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">5000</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">w_timer_fire</TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="6" WIDTH="372" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">r_timer_armed</TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="6" WIDTH="372" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">timer_int_clear[0]</TD><TD COLSPAN="6" WIDTH="372" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">timer_int_status[0]</TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="248" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">timer_irq[0] (int_enable=1)</TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="248" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="2" WIDTH="124" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>fire<BR/>(once)</I></FONT></TD><TD COLSPAN="3" WIDTH="186" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>W1C<BR/>pulse</I></FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>cleared</I></FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="26" FIXEDSIZE="FALSE" BORDER="0"> </TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="9" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The comparator does not move (no auto-reload), the match stays true and the armed<BR ALIGN="LEFT"/>latch stays clear, so the timer never fires again until it is reprogrammed.<BR ALIGN="LEFT"/>The W1C pulse (one cycle, first cycle of the write) clears status and irq at the same<BR ALIGN="LEFT"/>edge; a fire in that cycle would win over the clear.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
