// HPET_STATUS mirror and W1C clear (replaces an ASCII sketch).
// Source of truth: rtl/hpet/hpet_core.sv and hpet_config_regs.sv; cycle
// positions checked against the test_apb4_hpet gate simulation (CDC_ENABLE=0).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph hpet_status_clear_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="HPET_STATUS: the mirror lags the core by one cycle; a W1C is a one-cycle\nclear pulse", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="210" BORDER="0" ALIGN="RIGHT"><B>clk cycle</B></TD><TD WIDTH="60" BORDER="0"><B>0</B></TD><TD WIDTH="60" BORDER="0"><B>1</B></TD><TD WIDTH="60" BORDER="0"><B>2</B></TD><TD WIDTH="60" BORDER="0"><B>3</B></TD><TD WIDTH="60" BORDER="0"><B>4</B></TD><TD WIDTH="60" BORDER="0"><B>5</B></TD><TD WIDTH="60" BORDER="0"><B>6</B></TD><TD WIDTH="60" BORDER="0"><B>7</B></TD><TD WIDTH="60" BORDER="0"><B>8</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">w_timer_fire[i]</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="7" WIDTH="420" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">timer_int_status[i] (core)</TD><TD COLSPAN="2" WIDTH="120" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="3" WIDTH="180" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="240" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">HPET_STATUS[i] (field mirror)</TD><TD COLSPAN="3" WIDTH="180" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="120" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="240" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">regblk_req, write to 0x020</TD><TD COLSPAN="5" WIDTH="300" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="120" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="120" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">timer_int_clear[i]</TD><TD COLSPAN="5" WIDTH="300" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="180" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="9" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The core owns the sticky bit; the field copies it every cycle (hw = w), one register stage<BR ALIGN="LEFT"/>later. A write of 1 to bit i clears the field directly and sends a one-cycle clear to the<BR ALIGN="LEFT"/>core in the first cycle of the 2-cycle request, so both read 0 from the next cycle on.<BR ALIGN="LEFT"/>A fire in the clear cycle wins.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
