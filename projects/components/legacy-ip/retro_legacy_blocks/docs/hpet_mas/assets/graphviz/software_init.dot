// HPET software initialization flow - a procedure, not a block diagram, drawn
// in the house decision-tree vocabulary (vault/handbook/authoring/block-diagrams.md,
// "Decision trees"): white start / question boxes, blue action boxes, every
// arrow labeled. Two columns keep the aspect ratio inside 0.7 .. 2.5.
// Register names and bit positions follow the published HPET map
// (rdl/hpet/hpet_regs.rdl): TN_CONF.INT_ENB = bit 2, TN_CONF.TYPE = bit 3.
digraph software_init {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.50", splines=ortho, newrank=true,
           label="HPET software initialization (published HPET register map)", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    start [label="Start\n(after reset: counter halted)", fillcolor="white"];
    halt  [group=A, label="1. Halt the counter\nWRITE(HPET_CONFIG, 0x0)"];
    zero  [group=A, label="2. Reset the main counter\nWRITE(HPET_COUNTER_LO, 0)\nWRITE(HPET_COUNTER_HI, 0)"];
    caps  [group=A, label="3. Read capabilities\nHPET_ID[12:8] + 1 = timers\nHPET_PERIOD = femtoseconds per tick"];

    comp  [group=B, label="4. Program timer N's comparator\nWRITE(TIMERn_COMPARATOR_LO / HI, ticks)\n(halted: the write re-arms; periodic: also the period)"];
    conf  [group=B, label="5. Program timer N's mode\nWRITE(TIMERn_CONFIG, INT_ENB | TYPE)\n0x4 = one-shot, 0xC = periodic"];
    more  [group=B, label="More timers?", fillcolor="white"];
    go    [group=B, label="6. Start the counter\nWRITE(HPET_CONFIG, 0x1)\n(| 0x2 for LegacyReplacement routing)"];
    done  [group=B, label="End\n(HPET running)", fillcolor="white"];

    start -> halt [xlabel="begin"];
    halt  -> zero [xlabel="halted"];
    zero  -> caps [xlabel="counter = 0"];
    caps  -> comp [xlabel="for each timer"];
    comp  -> conf [xlabel="comparator set"];
    conf  -> more [xlabel="mode set"];
    more  -> comp [xlabel="yes: next timer", constraint=false];
    more  -> go   [xlabel="no"];
    go    -> done [xlabel="enabled"];

    { rank=same; start; comp; }
    { rank=same; halt; conf; }
    { rank=same; zero; more; }
    { rank=same; caps; go; }
    start -> comp [style=invis, minlen=4];
}
