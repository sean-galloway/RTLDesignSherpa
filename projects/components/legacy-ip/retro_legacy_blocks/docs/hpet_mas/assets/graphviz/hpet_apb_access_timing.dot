// HPET APB access timing (replaces an ASCII sketch).
// Source of truth: rtl/amba/apb4/apb4_slave.sv (IDLE/BUSY/WAIT, registered PREADY),
// gaxi_skid_buffer (1-cycle cmd and rsp buffers), converters peakrdl_to_cmdrsp.sv
// (regblk_req held through CMD_WAIT_ACK), and the PeakRDL regblock in hpet_regs.sv
// (combinational ack, no stalls). Cycle positions measured from the
// test_apb4_gpio gate-level simulation (CDC_ENABLE=0): regblk_req at ACCESS+2/+3,
// rsp_valid at ACCESS+3, PREADY at ACCESS+5.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph hpet_apb_access_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="HPET APB access, CDC_ENABLE=0: one SETUP cycle, then PREADY in the 6th ACCESS cycle", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="150" BORDER="0" ALIGN="RIGHT"><B>pclk cycle</B></TD><TD WIDTH="60" BORDER="0"><B>0</B></TD><TD WIDTH="60" BORDER="0"><B>1</B></TD><TD WIDTH="60" BORDER="0"><B>2</B></TD><TD WIDTH="60" BORDER="0"><B>3</B></TD><TD WIDTH="60" BORDER="0"><B>4</B></TD><TD WIDTH="60" BORDER="0"><B>5</B></TD><TD WIDTH="60" BORDER="0"><B>6</B></TD><TD WIDTH="60" BORDER="0"><B>7</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="24">APB phase</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><B>SETUP</B></TD><TD COLSPAN="6" WIDTH="360" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ACCESS</B></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><B>IDLE</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="24">psel</TD><TD COLSPAN="7" WIDTH="420" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="24">penable</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="6" WIDTH="360" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="24">paddr / pwrite</TD><TD COLSPAN="7" WIDTH="420" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white">ADDR, dir</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="24">pwdata (write)</TD><TD COLSPAN="7" WIDTH="420" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white">WDATA</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="24">cmd_valid (to adapter)</TD><TD COLSPAN="3" WIDTH="180" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="240" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="24">regblk_req (held 2)</TD><TD COLSPAN="3" WIDTH="180" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="120" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="180" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="24">rsp_valid (from adapter)</TD><TD COLSPAN="4" WIDTH="240" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="180" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="24">pready</TD><TD COLSPAN="6" WIDTH="360" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="24">prdata (read)</TD><TD COLSPAN="6" WIDTH="360" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="white">RDATA</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BGCOLOR="#EEEEEE"><FONT COLOR="#555555">x</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT POINT-SIZE="9"><I>inside the slave</I></FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>PENABLE rise<BR/>seen</I></FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>cmd into<BR/>skid</I></FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>register<BR/>read/write</I></FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>response<BR/>captured</I></FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>rsp skid<BR/>to FSM</I></FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>PREADY,<BR/>PRDATA</I></FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="24" FIXEDSIZE="FALSE" BORDER="0"> </TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="8" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">One APB transfer = 1 SETUP + 6 ACCESS cycles (5 wait states). PREADY and PRDATA are registered and valid together for one cycle.<BR ALIGN="LEFT"/>The register access itself happens in cycle 3 (regblock acks in the same cycle as regblk_req); the other cycles are the<BR ALIGN="LEFT"/>apb4_slave FSM and its two 1-cycle skid buffers. pslverr is 0 for every mapped access.<BR ALIGN="LEFT"/>CDC_ENABLE=1 replaces apb4_slave with apb4_slave_cdc: each direction adds an async-FIFO crossing, so the ACCESS phase grows<BR ALIGN="LEFT"/>by a few cycles of each clock (ratio-dependent).<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
