// apb4_hpet whole-unit diagram - house style
// (vault/handbook/authoring/block-diagrams.md).
// Geography: the APB port and the PeakRDL register block at the top, the
// hpet_core function in the middle, the interrupt pins at the boundary bar.
//   register access - down the center; the response rides the same edges up
//   configuration   - register block down into the counter and the timers;
//                     live counter / comparator values ride back up the same edges
//   fire            - counter -> timer compare -> status / output -> pins
//   status / clear  - one dir=both lane on the left (W1C clear down, status up)
// Source of truth: rtl/hpet/apb4_hpet.sv, hpet_config_regs.sv, hpet_core.sv.
digraph hpet_whole_unit {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.65", splines=ortho, newrank=true,
           label="apb4_hpet - High Precision Event Timer, published HPET register map (CDC_ENABLE=1: registers and core on hpet_clk)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    apb  [group=C, label="APB4 Completer Port  s_apb_*  (12-bit address, 32-bit data)", fillcolor="white"];
    slv  [group=C, label="APB Completer\napb4_slave (CDC_ENABLE=0) or apb4_slave_cdc (CDC_ENABLE=1, pclk -> hpet_clk)"];
    cfg  [group=C, label="Register Block + Strobes\nhpet_config_regs: peakrdl_to_cmdrsp + hpet_regs (PeakRDL)\nHPET_ID / PERIOD / CONFIG / STATUS / COUNTER, TIMER[N] CONFIG / COMPARATOR\none-cycle write strobes, W1C clear pulse, timer_size = ~32MODE", width=8.0];

    cnt  [group=L2, label="Main Counter (flop)\nhpet_core - r_main_counter[63:0]\n+1 per core clock while HPET_CONFIG.enable"];
    tmr  [group=R, label="Timer Comparators (flop), NUM_TIMERS x\nhpet_core - comparator, period, armed latch\nfire = counter >= comparator (32 / 64 bit) & armed;\nperiodic: comparator += period"];
    irq  [group=C, label="Interrupt Status + Output (flop)\nhpet_core - sticky status set on fire;\noutput needs TN_CONF.INT_ENB"];
    leg  [group=C, label="Legacy Replacement Route (combinational)\nhpet_core - HPET_CONFIG.legacy_replacement:\ntimer 0 -> IRQ0, timer 1 -> IRQ8 (off timer_irq)"];

    bar  [group=C, label="Module Boundary\ntimer_irq[NUM_TIMERS-1:0]   |   legacy_irq0   |   legacy_irq8", fillcolor="white", width=8.0];

    apb -> slv [dir=both, penwidth=1.8, xlabel="APB transfer\n/ PREADY, PRDATA, PSLVERR"];
    slv -> cfg [dir=both, xlabel="cmd / rsp"];

    cfg -> cnt [dir=both, xlabel="counter write LO / HI, enable\n/ live counter"];
    cfg -> tmr [dir=both, xlabel="comparator write LO / HI, TN_CONF\n/ live comparators"];
    cnt -> tmr [xlabel="counter"];
    tmr -> irq [penwidth=1.8, xlabel="fire"];
    irq -> leg [xlabel="interrupt outputs"];
    leg -> bar [xlabel="timer_irq,\nlegacy_irq0 / 8"];

    p_st [shape=point, width=0.01, group=R2];
    cfg  -> p_st [dir=back, headclip=false, xlabel="timer_int_clear (W1C)\n/ timer_int_status"];
    p_st -> irq  [tailclip=false];

    { rank=same; cnt; tmr; }
    cnt -> tmr [style=invis, minlen=2];
    { rank=same; p_st; irq; }
    irq -> p_st [style=invis, minlen=3];
    tmr -> p_st [style=invis];
}
