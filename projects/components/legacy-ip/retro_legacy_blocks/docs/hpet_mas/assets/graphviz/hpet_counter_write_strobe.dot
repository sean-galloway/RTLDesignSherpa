// HPET counter-write strobe (replaces an ASCII sketch).
// Source of truth: rtl/hpet/hpet_core.sv and hpet_config_regs.sv; cycle
// positions checked against the test_apb4_hpet gate simulation (CDC_ENABLE=0).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph hpet_counter_write_strobe {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="HPET_COUNTER_LO write: swmod is a 2-cycle level, the core strobe is one\naligned pulse", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="190" BORDER="0" ALIGN="RIGHT"><B>clk cycle</B></TD><TD WIDTH="66" BORDER="0"><B>0</B></TD><TD WIDTH="66" BORDER="0"><B>1</B></TD><TD WIDTH="66" BORDER="0"><B>2</B></TD><TD WIDTH="66" BORDER="0"><B>3</B></TD><TD WIDTH="66" BORDER="0"><B>4</B></TD><TD WIDTH="66" BORDER="0"><B>5</B></TD><TD WIDTH="66" BORDER="0"><B>6</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">regblk_req (write, LO)</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="132" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="264" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">counter_lo.swmod</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="132" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="264" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">counter_lo.value (field)</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">N-1</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">N</TD><TD COLSPAN="3" WIDTH="198" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">NEW</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">NEW+1</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">NEW+2</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">counter_write_lo</TD><TD COLSPAN="2" WIDTH="132" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="264" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">r_main_counter (running)</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">N</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">N+1</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">N+2</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">NEW</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">NEW+1</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">NEW+2</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">NEW+3</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="7" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The request is held two cycles, so swmod is a 2-cycle level; a registered rising-edge<BR ALIGN="LEFT"/>detect turns it into one counter_write_lo pulse, aligned to the first cycle the field<BR ALIGN="LEFT"/>holds NEW. The core loads counter[31:0] at that edge (HI untouched). Afterwards the<BR ALIGN="LEFT"/>field mirrors the live counter one cycle behind.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
