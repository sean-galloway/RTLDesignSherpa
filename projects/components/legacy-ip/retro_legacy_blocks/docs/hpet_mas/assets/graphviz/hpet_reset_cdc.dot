// apb4_hpet CDC-mode reset sequence (replaces an ASCII sketch in
// ch01_overview/03_clocks_and_reset.md). Phase timeline, not to scale: one column
// per step group of the recommended sequence listed above the figure. With
// CDC_ENABLE=1 the APB completer resets on presetn and the register block and
// core on hpet_resetn (rtl/hpet/apb4_hpet.sv).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph hpet_reset_cdc {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="apb4_hpet reset, CDC_ENABLE=1: two independent resets, then a settle\nbefore the first access", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="110" BORDER="0" ALIGN="RIGHT"><B>step</B></TD><TD WIDTH="118" BORDER="0"><B>1</B></TD><TD WIDTH="118" BORDER="0"><B>2-3</B></TD><TD WIDTH="118" BORDER="0"><B>4</B></TD><TD WIDTH="118" BORDER="0"><B>5</B></TD><TD WIDTH="118" BORDER="0"><B>6</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">phase</TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>assert<BR/>both</B></TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>hold</B></TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>release</B></TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>CDC<BR/>settle</B></TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>access</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">presetn</TD><TD COLSPAN="2" WIDTH="236" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="3" WIDTH="354" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">hpet_resetn</TD><TD COLSPAN="2" WIDTH="236" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="3" WIDTH="354" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">duration</TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">&gt;= 10 pclk and<BR/>&gt;= 10 hpet_clk</TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">either order</TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">&gt;= 6 pclk</TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">APB access</TD><TD COLSPAN="4" WIDTH="472" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">not allowed</TD><TD COLSPAN="1" WIDTH="118" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">allowed</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="5" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Each reset is held for 10 cycles of its OWN clock, so the two hold times differ in<BR ALIGN="LEFT"/>wall time when the clocks do. The two releases need not be ordered or aligned, but<BR ALIGN="LEFT"/>both must be stable before the settle is counted.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
