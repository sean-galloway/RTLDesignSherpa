// render: no-key (decision-tree / process-flow vocabulary, not the element key)
// HPET timer mode change - a procedure in the house decision-tree vocabulary.
// The published map has NO per-timer run enable (TN_CONF has none), so a mode
// change halts the whole counter: a comparator write re-arms only while
// HPET_CONFIG.enable = 0 (rtl/hpet/hpet_core.sv, rule A3). TN_CONF.TYPE is
// bit 3; INT_ENB is bit 2.
digraph timer_mode_switch {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.50", splines=ortho, newrank=true,
           label="HPET timer mode change (one-shot <-> periodic)", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    start [group=A, label="Timer i running\nwant the other mode", fillcolor="white"];
    halt  [group=A, label="1. Halt the counter (every timer)\nWRITE(HPET_CONFIG, 0x0)"];
    clr   [group=A, label="2. Clear a pending interrupt\nWRITE(HPET_STATUS, 1 << i)"];
    mode  [group=A, label="New mode?", fillcolor="white"];
    toper [group=B, label="3a. Periodic\nWRITE(TIMERi_CONFIG, 0xC)  (TYPE | INT_ENB)\ncomparator = first fire AND period"];
    tones [group=B, label="3b. One-shot\nWRITE(TIMERi_CONFIG, 0x4)  (INT_ENB)\ncomparator = absolute fire time"];
    comp  [group=B, label="4. Write the comparator\nWRITE(TIMERi_COMPARATOR_LO / HI, value)\n(halted, so the write re-arms the timer)"];
    go    [group=B, label="5. Restart the counter\nWRITE(HPET_CONFIG, 0x1)"];
    done  [group=B, label="New mode active", fillcolor="white"];

    start -> halt [xlabel="begin"];
    halt  -> clr  [xlabel="halted"];
    clr   -> mode [xlabel="status clear"];
    mode  -> toper [xlabel="periodic"];
    mode  -> tones [xlabel="one-shot"];
    toper -> comp [xlabel="mode set"];
    tones -> comp [xlabel="mode set"];
    comp  -> go   [xlabel="armed"];
    go    -> done [xlabel="running"];

    { rank=same; start; toper; }
    { rank=same; halt; tones; }
    { rank=same; clr; comp; }
    { rank=same; mode; go; }
    start -> toper [style=invis, minlen=4];
    toper -> tones [style=invis];
}
