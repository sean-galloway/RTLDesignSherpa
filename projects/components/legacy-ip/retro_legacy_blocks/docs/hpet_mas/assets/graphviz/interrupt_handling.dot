// render: no-key (decision-tree / process-flow vocabulary, not the element key)
// HPET interrupt service flow - a procedure in the house decision-tree
// vocabulary (white questions, blue actions, every arrow labeled).
// HPET_STATUS is W1C per bit (rtl/hpet/hpet_config_regs.sv): a write clears
// only the bits written with 1, so a timer that fires after the read keeps
// its bit for the next pass.
digraph interrupt_handling {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.50", splines=ortho, newrank=true,
           label="HPET interrupt service routine", labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    start [group=A, label="Interrupt taken\n(timer_irq[i], or legacy_irq0 / 8)", fillcolor="white"];
    rd    [group=A, label="Read status\nstatus = READ(HPET_STATUS)"];
    any   [group=A, label="Any bit set\nin status?", fillcolor="white"];
    done  [group=A, label="Return from the ISR", fillcolor="white"];
    pick  [group=B, label="Lowest set bit i", fillcolor="white"];
    hnd   [group=B, label="Service timer i\n(callback; for a one-shot,\nre-program if needed)"];
    clr   [group=B, label="Clear only that bit\nWRITE(HPET_STATUS, 1 << i)"];
    nxt   [group=B, label="Remove bit i\nstatus &= ~(1 << i)"];

    start -> rd   [xlabel="enter"];
    rd    -> any  [xlabel="status read"];
    any   -> done [xlabel="no"];
    any   -> pick [xlabel="yes"];
    pick  -> hnd  [xlabel="timer i fired"];
    hnd   -> clr  [xlabel="serviced"];
    clr   -> nxt  [xlabel="bit i cleared"];
    nxt   -> rd   [xlabel="re-read: a timer may\nhave fired meanwhile", constraint=false];

    { rank=same; start; pick; }
    { rank=same; rd; hnd; }
    { rank=same; any; clr; }
    { rank=same; done; nxt; }
    start -> pick [style=invis, minlen=4];
}
