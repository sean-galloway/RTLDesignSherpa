// HPET timer fire timing (replaces an ASCII sketch).
// Source of truth: rtl/hpet/hpet_core.sv and hpet_config_regs.sv; cycle
// positions checked against the test_apb4_hpet gate simulation (CDC_ENABLE=0).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph hpet_fire_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Timer fire, comparator = 100: one-cycle fire, then status and irq\ntogether", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="170" BORDER="0" ALIGN="RIGHT"><B>r_main_counter</B></TD><TD WIDTH="66" BORDER="0"><B>99</B></TD><TD WIDTH="66" BORDER="0"><B>100</B></TD><TD WIDTH="66" BORDER="0"><B>101</B></TD><TD WIDTH="66" BORDER="0"><B>102</B></TD><TD WIDTH="66" BORDER="0"><B>103</B></TD><TD WIDTH="66" BORDER="0"><B>104</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">r_timer_comparator[i]</TD><TD COLSPAN="6" WIDTH="396" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">100</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">w_timer_match</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="5" WIDTH="330" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">r_timer_armed</TD><TD COLSPAN="2" WIDTH="132" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="264" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">w_timer_fire</TD><TD COLSPAN="1" WIDTH="66" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="66" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="4" WIDTH="264" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">timer_int_status[i]</TD><TD COLSPAN="2" WIDTH="132" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="264" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">timer_irq[i] (int_enable=1)</TD><TD COLSPAN="2" WIDTH="132" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="4" WIDTH="264" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="6" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Fire = match &amp; armed &amp; hpet_enable, combinational: a one-cycle pulse in the first<BR ALIGN="LEFT"/>matching cycle. The armed latch drops with it, so the match staying high cannot fire<BR ALIGN="LEFT"/>again. Status and the irq output are both set by the fire at the same edge; irq<BR ALIGN="LEFT"/>only if timer_int_enable[i] = 1. Both stay set until software W1C.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
