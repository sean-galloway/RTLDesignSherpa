// HPET register memory map (replaces an ASCII sketch in
// ch05_registers/01_register_map.md). Shaded rows are registers, grey rows
// reserved. Source of truth: rdl/hpet/hpet_regs.rdl (generated with
// NUM_TIMERS = 8: TIMER[NUM_TIMERS] @ 0x100 += 0x20, a 0x10-byte regfile per
// slot) and rtl/hpet/hpet_config_regs.sv (s_cpuif_addr = regblk_addr[8:0]).
// House style: vault/handbook/authoring/block-diagrams.md
digraph hpet_memory_map {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="HPET register map - one 4 KB APB window, 9-bit decode, all eight timer slots built", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    map [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="black"><TR><TD BORDER="0"> </TD><TD COLSPAN="2" BORDER="0" ALIGN="LEFT"><B>Global registers</B></TD><TD BORDER="0"> </TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x000</FONT></TD><TD BGCOLOR="#D6E4F0" WIDTH="230" HEIGHT="26"><B>HPET_ID</B></TD><TD BGCOLOR="#D6E4F0" WIDTH="60">RO</TD><TD BORDER="0" ALIGN="LEFT">GCAP_ID[31:0]: rev_id, num_tim_cap, count_size_cap, leg_rt_cap, vendor_id</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x004</FONT></TD><TD BGCOLOR="#D6E4F0" WIDTH="230" HEIGHT="26"><B>HPET_PERIOD</B></TD><TD BGCOLOR="#D6E4F0" WIDTH="60">RO</TD><TD BORDER="0" ALIGN="LEFT">GCAP_ID[63:32]: femtoseconds per main-counter tick</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x008 - 0x00F</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="230" HEIGHT="26"><FONT COLOR="#555555">reserved</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="60">-</TD><TD BORDER="0" ALIGN="LEFT">reads 0, writes ignored</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x010</FONT></TD><TD BGCOLOR="#D6E4F0" WIDTH="230" HEIGHT="26"><B>HPET_CONFIG</B></TD><TD BGCOLOR="#D6E4F0" WIDTH="60">RW</TD><TD BORDER="0" ALIGN="LEFT">GEN_CONF: hpet_enable[0], legacy_replacement[1]</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x014 - 0x01F</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="230" HEIGHT="26"><FONT COLOR="#555555">reserved</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="60">-</TD><TD BORDER="0" ALIGN="LEFT">reads 0, writes ignored</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x020</FONT></TD><TD BGCOLOR="#D6E4F0" WIDTH="230" HEIGHT="26"><B>HPET_STATUS</B></TD><TD BGCOLOR="#D6E4F0" WIDTH="60">RW / W1C</TD><TD BORDER="0" ALIGN="LEFT">GINTR_STA: one status bit per timer</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x024 - 0x0EF</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="230" HEIGHT="26"><FONT COLOR="#555555">reserved</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="60">-</TD><TD BORDER="0" ALIGN="LEFT">reads 0, writes ignored</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x0F0</FONT></TD><TD BGCOLOR="#D6E4F0" WIDTH="230" HEIGHT="26"><B>HPET_COUNTER_LO</B></TD><TD BGCOLOR="#D6E4F0" WIDTH="60">RW</TD><TD BORDER="0" ALIGN="LEFT">main counter [31:0]</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x0F4</FONT></TD><TD BGCOLOR="#D6E4F0" WIDTH="230" HEIGHT="26"><B>HPET_COUNTER_HI</B></TD><TD BGCOLOR="#D6E4F0" WIDTH="60">RW</TD><TD BORDER="0" ALIGN="LEFT">main counter [63:32]</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x0F8 - 0x0FF</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="230" HEIGHT="26"><FONT COLOR="#555555">reserved</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="60">-</TD><TD BORDER="0" ALIGN="LEFT">reads 0, writes ignored</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="2" BORDER="0" ALIGN="LEFT"><B>Timer slot i  (base = 0x100 + i x 0x20, i = 0 .. 7)</B></TD><TD BORDER="0"> </TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">base + 0x00</FONT></TD><TD BGCOLOR="#D6E4F0" WIDTH="230" HEIGHT="26"><B>TIMER[i]_CONFIG</B></TD><TD BGCOLOR="#D6E4F0" WIDTH="60">RW</TD><TD BORDER="0" ALIGN="LEFT">TN_CONF[31:0]; reads 0x30 out of reset</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">base + 0x04</FONT></TD><TD BGCOLOR="#D6E4F0" WIDTH="230" HEIGHT="26"><B>TIMER[i]_INT_ROUTE_CAP</B></TD><TD BGCOLOR="#D6E4F0" WIDTH="60">RO</TD><TD BORDER="0" ALIGN="LEFT">TN_CONF[63:32]; reads 0</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">base + 0x08</FONT></TD><TD BGCOLOR="#D6E4F0" WIDTH="230" HEIGHT="26"><B>TIMER[i]_COMPARATOR_LO</B></TD><TD BGCOLOR="#D6E4F0" WIDTH="60">RW</TD><TD BORDER="0" ALIGN="LEFT">comparator [31:0]</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">base + 0x0C</FONT></TD><TD BGCOLOR="#D6E4F0" WIDTH="230" HEIGHT="26"><B>TIMER[i]_COMPARATOR_HI</B></TD><TD BGCOLOR="#D6E4F0" WIDTH="60">RW</TD><TD BORDER="0" ALIGN="LEFT">comparator [63:32]</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">base + 0x10 - 0x1F</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="230" HEIGHT="26"><FONT COLOR="#555555">reserved (FSB route)</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="60">-</TD><TD BORDER="0" ALIGN="LEFT">not implemented; reads 0</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="2" BORDER="0" ALIGN="LEFT"><B>Slot bases</B></TD><TD BORDER="0"> </TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="2" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">0x100  0x120  0x140  0x160<BR/>0x180  0x1A0  0x1C0  0x1E0</FONT></TD><TD BORDER="0" ALIGN="LEFT">timers 0-7; slot 7 ends at 0x1FF</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="2" BORDER="0" ALIGN="LEFT"><B>Rest of the 4 KB window</B></TD><TD BORDER="0"> </TD></TR><TR><TD BORDER="0" ALIGN="RIGHT"><FONT FACE="Courier">0x200 - 0xFFF</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="230" HEIGHT="26"><FONT COLOR="#555555">alias of 0x000 - 0x1FF</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="60">-</TD><TD BORDER="0" ALIGN="LEFT">only PADDR[8:0] reaches the register block</TD></TR></TABLE>>];
}
