// HPET main counter start (replaces an ASCII sketch).
// Source of truth: rtl/hpet/hpet_core.sv and hpet_config_regs.sv; cycle
// positions checked against the test_apb4_hpet gate simulation (CDC_ENABLE=0).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph hpet_counter_enable_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Main counter start: the first increment lands one cycle after\nhpet_enable rises", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="150" BORDER="0" ALIGN="RIGHT"><B>hpet_clk cycle</B></TD><TD WIDTH="62" BORDER="0"><B>0</B></TD><TD WIDTH="62" BORDER="0"><B>1</B></TD><TD WIDTH="62" BORDER="0"><B>2</B></TD><TD WIDTH="62" BORDER="0"><B>3</B></TD><TD WIDTH="62" BORDER="0"><B>4</B></TD><TD WIDTH="62" BORDER="0"><B>5</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">hpet_enable</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="5" WIDTH="310" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">w_counter_incr</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="5" WIDTH="310" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="30">r_main_counter</TD><TD COLSPAN="2" WIDTH="124" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">N</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">N+1</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">N+2</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">N+3</TD><TD COLSPAN="1" WIDTH="62" HEIGHT="30" FIXEDSIZE="FALSE" BGCOLOR="white">N+4</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="1" WIDTH="62" HEIGHT="30" FIXEDSIZE="FALSE" BORDER="0"> </TD><TD COLSPAN="1" WIDTH="62" HEIGHT="30" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>enable seen,<BR/>count at edge</I></FONT></TD><TD COLSPAN="1" WIDTH="62" HEIGHT="30" FIXEDSIZE="FALSE" BORDER="0"><FONT POINT-SIZE="9"><I>first<BR/>increment</I></FONT></TD><TD COLSPAN="3" WIDTH="186" HEIGHT="30" FIXEDSIZE="FALSE" BORDER="0"> </TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="6" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">hpet_enable is the HPET_CONFIG field (a flop). In the cycle it reads 1 the counter<BR ALIGN="LEFT"/>adds one at the closing edge, so the new value shows the next cycle: 1-cycle latency.<BR ALIGN="LEFT"/>A software counter write in the same cycle wins over the increment<BR ALIGN="LEFT"/>(w_counter_incr = hpet_enable &amp; ~counter write).<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
