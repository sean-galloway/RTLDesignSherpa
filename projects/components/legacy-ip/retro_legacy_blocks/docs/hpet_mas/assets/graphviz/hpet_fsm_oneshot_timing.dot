// HPET one-shot state timeline (replaces an ASCII sketch). The 'state'
// row is the chapter's conceptual FSM; the RTL holds it as r_timer_armed
// plus the match.
// Source of truth: rtl/hpet/hpet_core.sv and hpet_config_regs.sv; cycle
// positions checked against the test_apb4_hpet gate simulation (CDC_ENABLE=0).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph hpet_fsm_oneshot_timing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Conceptual timer states, one-shot mode, comparator = 5", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="170" BORDER="0" ALIGN="RIGHT"><B>hpet_clk cycle</B></TD><TD WIDTH="60" BORDER="0"><B>0</B></TD><TD WIDTH="60" BORDER="0"><B>1</B></TD><TD WIDTH="60" BORDER="0"><B>2</B></TD><TD WIDTH="60" BORDER="0"><B>3</B></TD><TD WIDTH="60" BORDER="0"><B>4</B></TD><TD WIDTH="60" BORDER="0"><B>5</B></TD><TD WIDTH="60" BORDER="0"><B>6</B></TD><TD WIDTH="60" BORDER="0"><B>7</B></TD><TD WIDTH="60" BORDER="0"><B>8</B></TD><TD WIDTH="60" BORDER="0"><B>9</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">conceptual state</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>IDLE</B></TD><TD COLSPAN="5" WIDTH="300" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ARMED</B></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>FIRE</B></TD><TD COLSPAN="3" WIDTH="180" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ONE_SHOT_COMPLETE</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">hpet_enable</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="9" WIDTH="540" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">r_main_counter</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">0</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">0</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">1</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">2</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">3</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">4</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">5</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">6</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">7</TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">8</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">comparator</TD><TD COLSPAN="10" WIDTH="600" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white">5</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">r_timer_armed</TD><TD COLSPAN="7" WIDTH="420" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="180" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">w_timer_fire</TD><TD COLSPAN="6" WIDTH="360" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="3" WIDTH="180" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">timer_int_clear[0]</TD><TD COLSPAN="8" WIDTH="480" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">timer_int_status[0]</TD><TD COLSPAN="7" WIDTH="420" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="120" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="26">timer_irq[0] (int_enable=1)</TD><TD COLSPAN="7" WIDTH="420" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="120" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="60" HEIGHT="26" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="10" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">Fire at counter = 5. Status and irq rise together at the next edge and are sticky; a<BR ALIGN="LEFT"/>W1C write (pulse in cycle 8) clears both. The timer stays complete afterwards: the match<BR ALIGN="LEFT"/>is still true and the armed latch clear, so nothing fires again until the comparator is<BR ALIGN="LEFT"/>rewritten.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
