// apb4_uart_16550 whole-unit diagram - house style
// (vault/handbook/authoring/block-diagrams.md).
// Geography: the APB port, decode and PeakRDL register block at the top, the
// uart_16550_core function in the middle, serial / modem pins and the
// interrupt at the boundary bar.
//   register access - down the center, response back up the same dir=both edges
//   transmit        - down the LEFT: THR push -> TX FIFO -> TX shifter -> uart_tx
//   receive         - back UP the RIGHT: uart_rx -> synchronizer ->
//                     deserializer -> RX FIFO -> RBR / LSR in the register block
//   status          - modem MSR and interrupt IIR climb into the register block
// Source of truth: rtl/uart_16550/apb4_uart_16550.sv, uart_16550_config_regs.sv,
// uart_16550_core.sv, uart_16550_intr.sv, uart_16550_modem.sv.
digraph uart_whole_unit {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.60", splines=ortho, newrank=true,
           label="apb4_uart_16550 - 16550-compatible UART (CDC_ENABLE=0: all on pclk; CDC_ENABLE=1: decode, registers and core on uart_clk)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    apb [group=C, label="APB4 Completer Port  s_apb_*  (12-bit address, 32-bit data)", fillcolor="white"];
    slv [group=C, label="APB Completer\napb4_slave (CDC_ENABLE=0) or apb4_slave_cdc (CDC_ENABLE=1, pclk -> uart_clk)"];
    adp [group=C, label="Command / Response to Register-Block Adapter\npeakrdl_to_cmdrsp"];
    dec [group=C, label="Address Decode + Access Strobes\nuart_16550_config_regs\nunmapped offset: read 0 + PSLVERR, answered locally;  LCR.DLAB remaps 0x00 / 0x04 to DLL / DLM\nTHR push, RBR pop, LSR / MSR / IIR read events"];
    regs [group=C, label="Register Block (PeakRDL)\nuart_16550_regs\nRBR / THR, IER, IIR, FCR, LCR, MCR, LSR, MSR, SCR, DLL, DLM\nhwif_out configures every core block (divisor, LCR, FCR, MCR, IER)", width=8.0];

    txf  [group=L, label="TX FIFO / THR (flop array)\nuart_16550_core - r_tx_fifo\nFIFO_DEPTH bytes (FCR[0]=0: one byte)"];
    baud [group=C, label="Baud Generator (flop)\nuart_16550_core - r_baud_count\none tick every {DLM, DLL} clocks\n(16 ticks per bit)"];
    rxf  [group=R, label="RX FIFO / RBR (flop array)\nuart_16550_core - r_rx_fifo\nFIFO_DEPTH x {BI, FE, PE, byte}\n(FCR[0]=0: one entry)"];
    intr [group=X1, label="Interrupt Logic (combinational)\nuart_16550_intr\nRX data / timeout, THR empty,\nline status, MSR deltas;\nIER gating, IIR priority,\nirq = pending & MCR.OUT2"];

    txs  [group=L, label="Transmitter (flop FSM)\nuart_16550_core - r_tx_state\nstart, 5-8 data LSB first, parity,\n1 / 1.5 / 2 stop; LCR.break forces low"];
    rxd  [group=R, label="Receiver (flop FSM)\nuart_16550_core - r_rx_state\nmid-bit sample, PE / FE / BI\nper character, character timeout"];
    mdm  [group=X2, label="Modem Control (flop)\nuart_16550_modem\ninput synchronizers, MSR deltas,\nloopback substitution, AFE RTS"];

    dma  [group=C, label="DMA Request Logic (combinational)\nuart_16550_core\nFCR[3] mode, FIFO levels"];
    rxs  [group=R, label="RX Input Synchronizer (flop)\nuart_16550_core - SYNC_STAGES flops\n(MCR.loopback: TX bit replaces uart_rx)"];

    bar [group=C, label="Module Boundary\nuart_tx out   |   rxrdy_n, txrdy_n out   |   uart_rx in   |   irq out   |   dtr_n, rts_n, out1_n, out2_n out / cts_n, dsr_n, ri_n, dcd_n in",
         fillcolor="white", width=14.0];

    // ---- register access (center) ----
    apb -> slv  [dir=both, penwidth=1.8, xlabel="APB transfer\n/ PREADY, PRDATA, PSLVERR"];
    slv -> adp  [dir=both, xlabel="cmd / rsp"];
    adp -> dec  [dir=both, xlabel="cpuif request\n/ ack, read data, err"];
    dec -> regs [dir=both, xlabel="mapped (remapped) request\n/ ack, read data"];

    // ---- transmit (left, down) ----
    dec  -> txf [xlabel="THR byte + push"];
    txf  -> txs [xlabel="next character"];
    txs  -> bar [xlabel="uart_tx\n(marking in loopback)"];

    // ---- baud ticks (sideband, center) ----
    regs -> baud [style=dashed, xlabel="divisor"];
    baud -> txs [style=dashed, xlabel="tick"];
    baud -> rxd [style=dashed, xlabel="tick"];
    baud -> dma [style=invis];
    dma  -> bar [xlabel="rxrdy_n, txrdy_n"];

    // ---- receive (right, climbing) ----
    rxs  -> bar  [dir=back, xlabel="uart_rx"];
    rxd  -> rxs  [dir=back, xlabel="rx bit"];
    rxf  -> rxd  [dir=back, xlabel="character + tags"];
    regs -> rxf  [dir=back, xlabel="RBR byte, LSR\n(hwif_in)"];

    // ---- status and pins at the far right ----
    regs -> intr [dir=back, xlabel="IIR"];
    intr -> bar  [penwidth=1.8, xlabel="irq"];
    regs -> mdm  [dir=back, xlabel="MSR"];
    mdm  -> bar  [dir=both, xlabel="modem outputs\n/ modem inputs"];

    { rank=same; txf; baud; rxf; intr; }
    { rank=same; txs; rxd; mdm; }
    { rank=same; dma; rxs; }
    txf -> baud -> rxf -> intr [style=invis, minlen=2];
    txs -> rxd -> mdm [style=invis, minlen=2];
    dma -> rxs [style=invis, minlen=2];
}
