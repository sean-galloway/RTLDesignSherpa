// UART 16550 reset sequence (replaces an ASCII sketch). Phase timeline:
// one column per phase of the reset requirements in ch03_interfaces/05_system.md.
// Source of truth: those requirements and rtl/uart_16550/apb4_uart_16550.sv
// (reset header comment: presetn and uart_rstn are independent ports).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph uart_reset_sequence {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="UART 16550 reset sequence (CDC_ENABLE=0: one clock, pclk)", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="120" BORDER="0" ALIGN="RIGHT"><B>step</B></TD><TD WIDTH="150" BORDER="0"><B>1</B></TD><TD WIDTH="150" BORDER="0"><B>2</B></TD><TD WIDTH="150" BORDER="0"><B>3</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">phase</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>reset active</B></TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>recovery</B></TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>normal operation</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">presetn</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="300" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">hold for</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">&gt;= 2 pclk cycles</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">2 pclk cycles</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">pclk</TD><TD COLSPAN="3" WIDTH="450" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">running</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">outputs</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">reset states<BR/>(uart_tx=1, irq=0)</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">reset states</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">per registers</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">APB access</TD><TD COLSPAN="2" WIDTH="300" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">not allowed</TD><TD COLSPAN="1" WIDTH="150" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">allowed</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="3" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">pclk must run during the hold: the generated register file resets<BR ALIGN="LEFT"/>synchronously, on a clock edge. Program the divisor before use.<BR ALIGN="LEFT"/>CDC_ENABLE=1: assert uart_rstn together with presetn (or quiesce the<BR ALIGN="LEFT"/>APB side first); a one-sided reset during a transfer corrupts the<BR ALIGN="LEFT"/>async FIFOs.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
