// GPIO power-on reset sequence (replaces an ASCII sketch). Phase timeline:
// one column per step of the procedure in ch03_interfaces/04_system.md, not per
// clock. Source of truth: that procedure, plus rtl/gpio/gpio_regs.sv (PeakRDL,
// SYNCHRONOUS reset on the core clock) for the clocks-running requirement.
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph gpio_reset_sequence {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="GPIO power-on reset sequence, CDC_ENABLE=1
(with CDC_ENABLE=0 only presetn exists)", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="120" BORDER="0" ALIGN="RIGHT"><B>step</B></TD><TD WIDTH="130" BORDER="0"><B>1-3</B></TD><TD WIDTH="130" BORDER="0"><B>4-5</B></TD><TD WIDTH="130" BORDER="0"><B>6-7</B></TD><TD WIDTH="130" BORDER="0"><B>then</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">phase</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>both resets held</B></TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>gpio_rstn released</B></TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>presetn released</B></TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><B>ready</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">presetn</TD><TD COLSPAN="2" WIDTH="260" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="2" WIDTH="260" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">gpio_rstn</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="3" WIDTH="390" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">hold for</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">&gt;= 2 cycles<BR/>of each clock</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">2 gpio_clk cycles</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">2 pclk cycles</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">-</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">pclk, gpio_clk</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">running<BR/>(see note)</TD><TD COLSPAN="3" WIDTH="390" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">running</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="34">APB access</TD><TD COLSPAN="3" WIDTH="390" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">not allowed</TD><TD COLSPAN="1" WIDTH="130" HEIGHT="34" FIXEDSIZE="FALSE" BGCOLOR="white">allowed</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="4" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The GPIO domain leaves reset first, so its registers and<BR ALIGN="LEFT"/>synchronizers are stable before the APB side issues the<BR ALIGN="LEFT"/>first command across the CDC.<BR ALIGN="LEFT"/>Clocks must run during the hold: the PeakRDL register file<BR ALIGN="LEFT"/>(gpio_regs.sv) resets synchronously, on a core-clock edge;<BR ALIGN="LEFT"/>the rest of the block resets asynchronously.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
