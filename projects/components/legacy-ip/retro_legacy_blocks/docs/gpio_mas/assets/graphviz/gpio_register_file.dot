// gpio_regs register file - house style (vault/handbook/authoring/block-diagrams.md).
// The cpuif from peakrdl_to_cmdrsp is the port on top; the hardware side
// (gpio_config_regs glue and gpio_core) is the bottom bar. Software-written
// fields go down the left lane (hwif_out); hardware status climbs the right
// lane (hwif_in).
// Source of truth: rdl/gpio/gpio_regs.rdl, rtl/gpio/gpio_config_regs.sv.
digraph gpio_register_file {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.65", splines=ortho, newrank=true,
           label="gpio_regs - PeakRDL register block (core clock; synchronous reset inside the block)",
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    cpu [label="CPU Interface  s_cpuif_*  (from peakrdl_to_cmdrsp)\nreq, req_is_wr, addr[5:0], wr_data, wr_biten   |   rd_ack, rd_data, wr_ack, err", fillcolor="white"];
    rf  [label="Register Block (PeakRDL)\ngpio_regs\nRW: CONTROL, DIRECTION, OUTPUT, INT_ENABLE, INT_TYPE, INT_POLARITY, INT_BOTH\nWO: OUTPUT_SET / CLR / TGL      RO: INPUT, RAW_INT      W1C, sticky: INT_STATUS", width=8.0];
    bar [label="Hardware Side  (gpio_config_regs glue and gpio_core)\nhwif_out: field values + swmod write strobes   |   hwif_in: next values (+ we for GPIO_OUTPUT)", fillcolor="white", width=9.0];

    cpu -> rf [dir=both, penwidth=1.8, xlabel="register read / write\n/ ack, read data"];

    p_o [shape=point, width=0.01]; p_i [shape=point, width=0.01];
    rf -> p_o [arrowhead=none, headclip=false];
    p_o -> bar [xlabel="hwif_out: CONTROL, DIRECTION, INT_*,\nOUTPUT + swmod, SET / CLR / TGL + swmod,\nINT_STATUS value + swmod", tailclip=false];
    rf -> p_i [dir=back, headclip=false, xlabel="hwif_in: INPUT, RAW_INT,\nINT_STATUS set,\nOUTPUT write-back\n(we, after an atomic op)"];
    p_i -> bar [dir=none, tailclip=false];
    { rank=same; p_o; p_i; }
    p_o -> p_i [style=invis, minlen=10];
}
