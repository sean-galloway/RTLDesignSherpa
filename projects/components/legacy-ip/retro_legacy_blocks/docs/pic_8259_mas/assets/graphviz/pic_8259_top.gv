// PIC 8259 Top-Level Block Diagram
digraph pic_8259_top {
    rankdir=LR;
    node [shape=box, style="rounded,filled", fillcolor=lightblue];

    apb_in [label="APB Slave\nInterface", shape=ellipse, fillcolor=lightgreen];
    irq_in [label="irq_in[7:0]\nInterrupt\nRequests (async)", shape=ellipse, fillcolor=lightgreen];

    subgraph cluster_pic {
        label="apb4_pic_8259";
        style=rounded;

        apb_if [label="APB\nInterface\n(strict decode,\nPSLVERR)", fillcolor=lightyellow];
        regs [label="Control\nRegisters\n(ICW/OCW)", fillcolor=lightyellow];
        inta [label="PIC_INTA\n(acknowledge\nby read)", fillcolor=lightyellow];
        sync [label="Synchronizer\n(SYNC_STAGES)", fillcolor=lightcyan];
        irr [label="IRR\n(Request)", fillcolor=lightcyan];
        isr [label="ISR\n(In-Service)", fillcolor=lightcyan];
        imr [label="IMR\n(Mask)", fillcolor=lightcyan];
        priority [label="Priority\nResolver", fillcolor=lightcyan];
        vector [label="Vector\nGenerator", fillcolor=lightcyan];
    }

    int_out [label="int_out\n(to CPU)", shape=ellipse, fillcolor=pink];

    apb_in -> apb_if;
    apb_if -> regs;
    apb_if -> inta [label="read 0x02C"];
    irq_in -> sync;
    sync -> irr;
    irr -> priority;
    imr -> priority;
    isr -> priority;
    regs -> imr;
    regs -> isr [label="EOI"];
    regs -> priority [label="rotate /\nset priority"];
    priority -> int_out;
    priority -> vector;
    vector -> inta [label="vector, valid"];
    inta -> isr [label="set"];
    inta -> irr [label="clear (edge)"];
}
