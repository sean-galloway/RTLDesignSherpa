// kestrel_mem_loader - MAS Figure 2.1 (loader composition).
// House style: vault/handbook/authoring/block-diagrams.md.
// Two independent requesters, one column and one white port each (the
// cam_tag ruling): the host AXI4-Lite port on the left, the core's memory
// ports on the right. The two RAM arrays are the boundary bar; writes go
// down into it through the one write-port merge, and every read (AXIL
// readback, core fetch, core L/S) reads it straight back up its own
// column. The run register is sideband: it picks the write owner and
// drives core_rst_n.
// Source of truth: rtl/fub/kestrel_mem_loader.sv.
digraph kestrel_mem_loader {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.80", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="kestrel_mem_loader - AXI4-Lite loader and unified imem / dmem (on aclk)";

    host  [label="Host AXI4-Lite Port (s_axil_*)\naddr[17] = CTRL, addr[16] = dmem,\naddr[15:2] = word index", fillcolor="white", group=H];
    core  [label="Core Memory Ports (to kestrel_core)\nimem_addr -> imem_rdata\ndmem_req, addr, wstrb, wdata -> dmem_rdata\ncore_rst_n", fillcolor="white", group=K];

    skwr  [label="Write Leaf\naxil4_slave_wr\nAW / W / B skids (2 / 2 / 2)", group=H];
    skrd  [label="Read Leaf\naxil4_slave_rd\nAR / R skids (2 / 4)", group=R];
    hold  [label="Write Holding (flops)\nwr_addr_q, wr_addr_pending_q, b_pending_q\nCTRL address: run register write\nelse: loader write (load mode only;\ndropped in run mode, B still OKAY)", group=H];
    run   [label="Run Register\nrun_q (flop, sticky, reset = load mode)\ncore_rst_n = run_q", group=M];
    merge [label="Write Port Merge (one clocked write per array)\nper byte lane: loader when !run_q,\ncore when run_q and dmem_req and wstrb != 0", group=M];
    rdmux [label="AXIL Read Mux (combinational)\naddr[17]: {31'b0, run_q}\naddr[16]: dmem else imem\n(AR accepted when R can take the beat)", group=R];
    crd   [label="Core Read Ports (combinational)\nfetch and L/S each pick imem / dmem\nby address bit 16 (unified map)", group=K];

    bar   [label="Memory Arrays (distributed RAM, combinational read)\nimem[16384 words]   |   dmem[16384 words]",
           fillcolor="white", width=10.0];

    host  -> skwr  [dir=both, xlabel="AW, W down / B up"];
    skwr  -> hold  [xlabel="fub AW, W"];
    hold  -> merge [xlabel="loader write\n(addr, data, wstrb)"];
    merge -> bar   [xlabel="array writes", penwidth=1.8];

    host  -> skrd  [dir=both, xlabel="AR down / R up"];
    skrd  -> rdmux [dir=both, xlabel="addr / data"];
    rdmux -> bar   [dir=back, xlabel="readback"];

    core  -> crd   [dir=both, xlabel="fetch, L/S addresses /\nimem_rdata, dmem_rdata"];
    crd   -> bar   [dir=back, xlabel="reads"];
    core  -> merge [xlabel="dmem write\n(run mode)"];

    hold  -> run   [style=dashed, xlabel="CTRL write"];
    run   -> merge [style=dashed, xlabel="write owner"];
    core  -> run   [style=dashed, dir=back, xlabel="core_rst_n"];

    { rank=same; host; core; }
    { rank=same; skwr; skrd; }
    { rank=same; hold; run; }
    { rank=same; merge; rdmux; crd; }
    host -> core [style=invis, minlen=3];
    skwr -> skrd [style=invis];
    hold -> run [style=invis];
    merge -> rdmux -> crd [style=invis];
}
