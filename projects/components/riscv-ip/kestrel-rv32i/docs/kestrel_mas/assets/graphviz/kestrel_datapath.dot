// kestrel_datapath - MAS Figure 1.1 (kestrel_core, single-cycle RV32I).
// Brought to the 2026-10-20 RTL on 2026-10-21: misaligned accesses halt
// (no cross-word retry), mem_wait holds the machine for a registered-read
// memory, the register file is distributed RAM with no reset.
// House style: vault/handbook/authoring/block-diagrams.md.
// The memory ports are the boundary bar. Requests go DOWN to it: the
// fetch address from the PC (left edge) and the load/store beat from
// the L/S unit (center). Returns climb back UP on their own lanes:
// the instruction word up the right edge into decode / imm / regfile,
// the load data into the L/S path. The two register loops are the
// architectural feedback: next PC climbs the left edge into the PC,
// the writeback climbs into the register file. No pipeline, so no
// hazard or forwarding lanes. Halt is sideband.
// Source of truth: rtl/top/kestrel_core.sv and rtl/fub/kestrel_*.sv.
digraph kestrel_datapath {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.50", splines=ortho, newrank=true,
           labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    label="kestrel_core - single-cycle RV32I datapath (one instruction per clk; mem_wait holds every state element for a registered-read memory)";

    pc    [label="PC Register\npc (flop, RESET_ADDR)\nholds on halt or mem_wait;\nimem_addr_next = the value it takes next", group=L, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    dec   [label="Decode Truth Table (combinational)\nrv32i_decode - u_decode\ncontrol bundle, halt cause", group=C, style="filled", fillcolor="white"];
    immg  [label="Immediate Generator\nrv32i_imm_gen - u_imm_gen\nI / S / B / U / J by imm_sel", group=I, style="filled", fillcolor="white"];
    rf    [label="Register File\nkestrel_regfile - u_regfile\nx0..x31: 2 comb read, 1 write\n(distributed RAM, no reset; x0 kept 0 by writes)", group=R, shape=cylinder, style="filled", fillcolor="#E8DFF5"];

    srcm  [label="Operand Select (combinational)\nA = pc or rs1 (alu_src_a_pc)\nB = imm or rs2 (alu_src_b_imm)", group=C, style="filled", fillcolor="white"];
    cmp   [label="Branch Compare (combinational)\nrs1 vs rs2: eq / lt / ltu\nby funct3", group=I, style="filled", fillcolor="white"];
    alu   [label="ALU\nrv32i_alu - u_alu\nalu_y (also the L/S address)", group=C, style="filled", fillcolor="white"];
    npc   [label="Next-PC Select (combinational)\nJAL: pc + imm  |  JALR: (rs1 + imm) & ~1\ntaken branch: pc + imm  |  else pc + 4\nmisaligned target -> HALT_IALIGN", group=L, style="filled", fillcolor="white"];
    lsu   [label="Load / Store Path (combinational, Figure 4.1)\nword address from alu_y; offset = rs1[1:0] + imm[1:0]\nbyte-lane rotation, wstrb; load extend;\nmisaligned half / word halts (no strobes)", group=C, style="filled", fillcolor="white"];
    wb    [label="Writeback Select (combinational)\nCSR stub: 0 | LUI: imm | load data\n| JAL/JALR: pc + 4 | else alu_y", group=R, style="filled", fillcolor="white"];
    hlt   [label="Halt Register (sideband, Figure 4.2)\nhalt_q: a decode cause, a misaligned target or a\nmisaligned access freezes PC and retirement;\nRVFI retire ports built from the same signals", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    bar   [label="Memory and Trace Ports (combinational-read memories, or kestrel_mem_bram holding the core with mem_wait)\nimem_addr, imem_addr_next -> imem_rdata   |   dmem_req, dmem_addr, dmem_wstrb, dmem_wdata -> dmem_rdata   |   mem_wait in   |   halt, halt_cause, rvfi_*",
           fillcolor="white", width=15.4, shape=cylinder, style="filled", fillcolor="#E8DFF5"];

    // ---- fetch request down the left edge, instruction back up the right ----
    p_pc  [shape=point, width=0.01, group=L];
    pc    -> p_pc [arrowhead=none, headclip=false];
    p_pc  -> npc  [tailclip=false, xlabel="pc"];
    p_f   [shape=point, width=0.01, group=F];
    p_pc  -> p_f  [arrowhead=none, tailclip=false, headclip=false];
    p_f   -> bar  [tailclip=false, xlabel="imem_addr = pc\n(fetch)"];
    p_r   [shape=point, width=0.01, group=Q];
    insn  -> p_r  [color="#1A7A1A", dir=back, headclip=false, xlabel="imem_rdata\n(instruction)"];
    p_r   -> bar  [color="#1A7A1A", dir=none, tailclip=false];

    // ---- instruction word ----
    insn  [label="Instruction Word\ninsn = imem_rdata", fillcolor="white", group=Q, style="rounded,filled", fillcolor="#E2EFDA"];
    insn  -> dec  [xlabel="opcode, funct"];
    insn  -> immg [xlabel="imm fields"];
    insn  -> rf   [xlabel="rs1, rs2, rd"];

    // ---- execute ----
    dec   -> srcm [style=dashed, color="#777777", xlabel="selects"];
    immg  -> srcm [xlabel="imm"];
    rf    -> srcm [xlabel="rs1, rs2"];
    pc    -> srcm [xlabel="pc"];
    rf    -> cmp  [xlabel="rs1, rs2"];
    srcm  -> alu  [xlabel="A, B"];
    alu   -> lsu  [xlabel="address"];
    lsu   -> bar  [dir=both, xlabel="L/S beat down /\ndmem_rdata up", penwidth=1.8];
    lsu   -> wb   [xlabel="load data"];
    alu   -> wb   [xlabel="alu_y"];
    cmp   -> npc  [xlabel="branch taken"];
    pc    -> npc  [dir=back, xlabel="next_pc"];

    // ---- feedback loops ----
    npc   -> hlt  [style=dashed, color="#777777", xlabel="misaligned target"];
    lsu   -> hlt  [style=dashed, color="#777777", xlabel="misaligned access"];
    rf    -> wb   [dir=back, xlabel="rd_wdata (rd_wen_eff:\nnot halted, not waiting,\nnot a misaligned link / access)"];
    hlt   -> bar  [style=dashed, color="#777777", xlabel="halt, rvfi_*"];

    { rank=same; pc; insn; }
    { rank=same; dec; immg; rf; }
    { rank=same; srcm; cmp; }
    { rank=same; npc; lsu; wb; p_r; p_f; }
    p_f -> npc [style=invis];
    wb -> p_r [style=invis];
}
