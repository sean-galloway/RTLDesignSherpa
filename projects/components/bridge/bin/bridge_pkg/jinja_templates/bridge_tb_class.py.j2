{% set s_axi5 = slave.protocol.lower() == 'axi5' %}
{% if slave.has_read_channels() %}
        self.slave_rd[{{ loop.index0 }}] = {{ 'AXI5SlaveRead' if s_axi5 else 'AXI4SlaveRead' }}(
            self.dut, self.clock,
