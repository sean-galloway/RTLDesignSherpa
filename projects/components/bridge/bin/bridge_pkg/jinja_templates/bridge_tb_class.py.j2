        # PWAKEUP) at the port's user width. Driven by the APB4 BFM until
        # 2026-09-09, which left those pins unbound.
        self.slave_apb[{{ loop.index0 }}] = APB5Slave(
            entity=self.dut,
            title="APB5_S{{ loop.index0 }}",
            prefix="{{ slave.prefix }}",
            clock=self.clock,
            registers=list(preset),
            bus_width={{ slave.data_width }},
            addr_width={{ slave.addr_width }},
            # The generator emits the APB5 USER pins 1 bit wide (slave
            # adapter generator, PAUSER/PWUSER/PRUSER/PBUSER), whatever the
            # TOML says; the BFM must bind at that width.
            auser_width=1,
            wuser_width=1,
            ruser_width=1,
            buser_width=1,
            log=self.log,
        )
{% else %}
        self.slave_apb[{{ loop.index0 }}] = APBSlave(
            entity=self.dut,
            title="APB_S{{ loop.index0 }}",
            prefix="{{ slave.prefix }}",
            clock=self.clock,
            registers=list(preset),
            bus_width={{ slave.data_width }},
            addr_width={{ slave.addr_width }},
            log=self.log,
        )
{% endif %}
{% elif slave.protocol.lower() in ('axil', 'axil5') %}
        # AXIL slave — own MemoryModel pre-seeded with the slave-specific
        # pattern; AXIL4SlaveRead/Write auto-responds from it honoring
        # whatever ARADDR / AWADDR the bridge forwards (after burst
        # decomposition by axi4_to_axil4 shims, if any).
{% if slave.protocol.lower() == 'axil5' %}
        # This one is an AXI5-Lite port, so it uses the AXIL5 BFMs: the same
        # transaction logic with the optional sideband groups added, which is
        # what lets them bind to the bridge's awuser/awtrace/wpoison/... ports
        # instead of dying at signal resolution.
{% endif %}
        bytes_per_line = {{ slave.data_width }} // 8
        addr_range = {{ '0x%08x' % slave.addr_range }}
        # Cap MemoryModel size — see SLAVE_MEM_CAP_BYTES comment.
        mem_bytes = min(addr_range, self.SLAVE_MEM_CAP_BYTES)
        preset = self._build_preset({{ loop.index0 }}, addr_range, {{ slave.data_width }})
        self.slave_memory[{{ loop.index0 }}] = MemoryModel(
            num_lines=mem_bytes // bytes_per_line,
            bytes_per_line=bytes_per_line,
            preset_values=list(preset),
            log=self.log,
        )
{% if slave.has_read_channels() %}
        self.slave_rd[{{ loop.index0 }}] = {% if slave.protocol.lower() == 'axil5' %}AXIL5SlaveRead{% else %}AXIL4SlaveRead{% endif %}(
            self.dut, self.clock,
            prefix="{{ slave.prefix }}",
            log=self.log,
            data_width={{ slave.data_width }},
            addr_width={{ slave.addr_width }},
            multi_sig=True,
            memory_model=self.slave_memory[{{ loop.index0 }}],
            base_addr={{ '0x%08x' % slave.base_addr }},
{% if slave.protocol.lower() == 'axil5' %}
{{ axil5_bfm_features(slave) }}
{% endif %}
        )
{% endif %}
{% if slave.has_write_channels() %}
        self.slave_wr[{{ loop.index0 }}] = {% if slave.protocol.lower() == 'axil5' %}AXIL5SlaveWrite{% else %}AXIL4SlaveWrite{% endif %}(
            self.dut, self.clock,
            prefix="{{ slave.prefix }}",
            log=self.log,
            data_width={{ slave.data_width }},
            addr_width={{ slave.addr_width }},
            multi_sig=True,
            memory_model=self.slave_memory[{{ loop.index0 }}],
            base_addr={{ '0x%08x' % slave.base_addr }},
{% if slave.protocol.lower() == 'axil5' %}
{{ axil5_bfm_features(slave) }}
{% endif %}
        )
{% endif %}
{% else %}
        # AXI4 slave — full memory-backed BFM.
        bytes_per_line = {{ slave.data_width }} // 8
        addr_range = {{ '0x%08x' % slave.addr_range }}
        # Cap MemoryModel size — see SLAVE_MEM_CAP_BYTES comment.
        mem_bytes = min(addr_range, self.SLAVE_MEM_CAP_BYTES)
        preset = self._build_preset({{ loop.index0 }}, addr_range, {{ slave.data_width }})
        self.slave_memory[{{ loop.index0 }}] = MemoryModel(
            num_lines=mem_bytes // bytes_per_line,
