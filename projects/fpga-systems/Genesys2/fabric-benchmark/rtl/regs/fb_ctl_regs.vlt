`verilator_config
// PeakRDL's per-field always_comb blocks each write a different member of one
// field_combo struct; Verilator reports that as MULTIDRIVEN. Waived for the
// generated file only (same treatment as chargen_regs.vlt). Lives outside
// generated/ so regeneration does not remove it.
lint_off -rule MULTIDRIVEN -file "*/fb_ctl_regs.sv" -match "*'field_combo'*"   // PeakRDL's per-member writes only