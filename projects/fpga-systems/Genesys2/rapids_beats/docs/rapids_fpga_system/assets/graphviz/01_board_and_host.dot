// The rapids-beats FPGA system: what is on the bench, what talks to what.
digraph board_and_host {
    graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.6,
           label="rapids-beats on the Genesys 2: the bench", labelloc=t, labeljust=l];
    node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f4f4f4"];
    edge  [fontname="Helvetica", fontsize=9];

    subgraph cluster_host {
        label="Host PC"; style="rounded"; color="#404040";
        host_tools [label="host/run_characterization.py\nsmoke | single run | --suite sweeps\nresults JSON (with the BUILD record)", fillcolor="#e8f1ff"];
        host_report [label="host/report_tables.py\nhost/report_figures.py\nreports/perf README + PDF", fillcolor="#e8f1ff"];
        vivado [label="Vivado\nmake bitstream | make program\ntcl/build_ila.tcl + capture_ila_*.tcl", fillcolor="#e8f1ff"];
        host_tools -> host_report [label="perf/json/*.json"];
    }

    subgraph cluster_usb {
        label="Two USB chips on the board"; style="rounded"; color="#404040";
        ft232r [label="FT232R\nUART 115200-8N1\n(its own /dev/ttyUSB*, enumeration order varies:\nhost uses --port auto)", fillcolor="#fff4e0"];
        ft2232 [label="FT2232\nJTAG (serial 200300B818A0)\nprogram / ILA", fillcolor="#fff4e0"];
    }

    subgraph cluster_fpga {
        label="Genesys 2  --  Kintex-7 XC7K325T-2"; style="rounded"; color="#228B22";
        clk [label="200 MHz LVDS sysclk\nIBUFDS + MMCM\n-> 100 MHz aclk", fillcolor="#e9f7e9"];
        top [label="rapids_char_genesys2_top\npins, reset sync, 8 user LEDs\n(low 8 of the status bank)", fillcolor="#e9f7e9"];
        harness [label="rapids_char_harness\nUART->AXIL bridge, region decode,\nharness CSRs, apb4_master, kick sequencer,\ngenerators, checkers, RAMs, meters, observers", fillcolor="#e9f7e9"];
        dut [label="rapids_beats_top  (the DUT)\nsplit SOURCE + SINK beats DMA\n8 ch, 256-bit AXI4 + AXIS, 4 KB SRAM/ch", fillcolor="#d5ecd5", penwidth=2];
        clk -> top; top -> harness; harness -> dut [dir=both];
    }

    host_tools -> ft232r [label="ASCII  W addr data / R addr", dir=both];
    ft232r -> harness [label="UART", dir=both];
    vivado -> ft2232 [label="USB"];
    ft2232 -> top [label="JTAG: .bit, ILA"];
}
