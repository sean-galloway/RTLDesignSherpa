flowchart LR
    USB[USB / FTDI]
    UART["uart_axil_bridge<br/>W/R ASCII to AXI4-Lite"]
    subgraph FPGA["Genesys 2 xc7k325t (stream_genesys2_top)"]
        subgraph BR["bridge_stream_mon_axil (M to N)"]
            direction TB
            S0["stream_apb<br/>0x00000"]
            S1["harness_csr<br/>0x10000"]
            S2["desc_ram<br/>0x20000"]
            S3["stream_err<br/>0x30000"]
            S4["stream_tally<br/>0x40000<br/>(host count read)"]
            S7["slave_tally<br/>0xC0000<br/>(host count read)"]
            SC["comp_sram<br/>0x1A0000<br/>(capture memory)"]
        end
        subgraph HARN["stream_harness"]
            DUT["stream_top_ch8 (DUT)"]
            MOBS["axi4_intf_master_observer<br/>monitors + monbus group"]
            SOBS["axi4_intf_slave_observer<br/>monitors + monbus group"]
            SLAVES["dma_slave_monitors<br/>pattern-gen + CRC-check"]
            RESP["axi_response_delay<br/>latency model"]
            T1["u_stream_tally"]
            T2["u_slave_tally"]
        end
    end
    USB -->|UART| UART --> BR
    S0 -->|APB cfg| DUT
    S1 --> HARN
    S2 -->|256b desc| DUT
    DUT <-->|m_axi rd/wr| SLAVES
    SLAVES --- RESP
    DUT --- MOBS
    SLAVES --- SOBS
    MOBS -->|monbus records, DIRECT| T1
    SOBS -->|monbus records, DIRECT| T2
    T1 -.->|counts| S4
    T2 -.->|counts| S7
    DUT -->|in-core MonBus| SC
