        subgraph BR["bridge_stream_char_axil (1 to N)"]
            direction TB
            S0["stream_apb<br/>0x00000"]
            S1["harness_csr<br/>0x10000"]
            S2["desc_ram<br/>0x20000"]
            S3["stream_err<br/>0x30000"]
            S4["debug_sram<br/>0x40000"]
            S5["bridge_trace_sram<br/>0xC0000"]
        end
        subgraph HARN["stream_char_harness"]
