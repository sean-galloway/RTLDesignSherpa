digraph stream_harness {
  rankdir=LR; splines=polyline; nodesep=0.30; ranksep=1.05;
  graph [fontname="Helvetica", fontsize=10, bgcolor="#fbfbfd",
         label=<<B>Genesys 2 STREAM harness</B>  —  ONE RTL / ONE RDL / ONE bridge <B>bridge_stream_mon_axil</B> (4 masters, 13 slaves)<BR/>
                <I>flavours differ ONLY by generics + host programming. Address map identical in all three.</I><BR/>
                <FONT POINT-SIZE="9">source: rtl/bridges/configs/bridge_stream_mon_axil.toml + _connectivity.csv + build-{perf,obs,mon}/Makefile</FONT>>,
         labelloc=t];
  node [fontname="Helvetica", fontsize=9, shape=box, style="filled,rounded", penwidth=0.8];
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.6, color="#5a6472"];

  subgraph cluster_m {
    label="MASTERS"; style="filled,rounded"; fillcolor="#eef3fb"; color="#9db4d4"; fontsize=10;
    host   [label="host\lAXIL rw · 32b\l(UART bridge)\l", fillcolor="#d7e5f7"];
    sdesc  [label="stream_desc\lAXI4 rd · 256b\l(descriptor fetch)\l", fillcolor="#d7e5f7"];
    mwr    [label="monbus_wr\lAXIL wr · 64b\l(STREAM in-core mon)\l", fillcolor="#cfe4d4"];
    smwr   [label="slave_monbus_wr\lAXIL wr · 64b\l(slave observer)\l", fillcolor="#cfe4d4"];
  }

  xbar [label="bridge_stream_mon_axil\l──────────────\lvariants: no | mon\lmon_preset: all\lclock: aclk\l", shape=box3d,
        fillcolor="#fde8c8", color="#c99a44", fontsize=10, penwidth=1.4];

  subgraph cluster_s {
    label="SLAVES  (base + range)"; style="filled,rounded"; fillcolor="#f3f0f7"; color="#b9a9cf"; fontsize=10;
    stream_apb  [label="stream_apb  APB 32b\l0x00000000 +0x2000\l(STREAM regs; MON @0x1000)\l", fillcolor="#e8e2f2"];
    harness_csr [label="harness_csr  AXIL 32b\l0x00010000 +0x1000\l(BUILD_CONFIG, RESP_DELAY)\l", fillcolor="#e8e2f2"];
    desc_ram    [label="desc_ram  AXI4 256b\l0x00020000 +0x10000\l", fillcolor="#dfeadf"];
    stream_err  [label="stream_err  AXIL 32b\l0x00030000 +0x1000\l", fillcolor="#e8e2f2"];
    stream_tal  [label="stream_tally  AXIL 64b\l0x00040000 +0x40000\l", fillcolor="#f7dede"];
    dma_axil    [label="dma_axil  AXIL 32b\l0x00080000 +0x1000\l", fillcolor="#e8e2f2"];
    slave_err   [label="slave_err  AXIL 32b\l0x00090000 +0x1000\l", fillcolor="#e8e2f2"];
    slave_tal   [label="slave_tally  AXIL 64b\l0x000C0000 +0x40000\l", fillcolor="#f7dede"];
    st_cfg      [label="stream_tally_cfg  AXIL 64b\l0x00100000 +0x40000\l", fillcolor="#f7dede"];
    sl_cfg      [label="slave_tally_cfg  AXIL 64b\l0x00140000 +0x40000\l", fillcolor="#f7dede"];
    slvmon_apb  [label="slvmon_apb  APB 32b\l0x00180000 +0x1000\l", fillcolor="#e8e2f2"];
    obs_apb     [label="obs_apb  APB 32b\l0x00190000 +0x1000\l", fillcolor="#e8e2f2"];
    comp_sram   [label="comp_sram  AXIL 64b\l0x001A0000 +0x10000\l(COMPRESSED capture)\l", fillcolor="#cfe4d4"];
  }

  host -> xbar [label="all 13"];
  sdesc -> xbar [label="desc_ram only", style=dashed];
  mwr  -> xbar [label="stream_tally,\lcomp_sram\l", color="#3d7a52"];
  smwr -> xbar [label="slave_tally,\lcomp_sram\l", color="#3d7a52", style=dashed];

  xbar -> stream_apb; xbar -> harness_csr; xbar -> desc_ram; xbar -> stream_err;
  xbar -> stream_tal; xbar -> dma_axil; xbar -> slave_err; xbar -> slave_tal;
  xbar -> st_cfg; xbar -> sl_cfg; xbar -> slvmon_apb; xbar -> obs_apb; xbar -> comp_sram;
}
