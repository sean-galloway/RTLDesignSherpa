// Figure 1.1 -- the bench, in the house style for system diagrams
// (vault/handbook/authoring/block-diagrams.md): the host PC and its two USB
// links on top, the FPGA stack (pin top -> pin-level top -> harness -> DUT)
// down the center, and the board's own parts as the boundary bar. The UART
// command path is the heavy center column (one dir=both edge per hop: W/R
// down, reply up); JTAG programming is its own column on the right; clock,
// reset and LEDs cross the bar on the left.
// RTL: flows-rapids-beats/rtl/rapids_char_genesys2_top.sv, rapids_char_top.sv,
//      rapids_char_harness.sv.
digraph board_and_host {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.45", ranksep="0.55", splines=ortho, newrank=true,
           label="rapids-beats on the Genesys 2: the bench", labelloc=t];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    host   [group=C, label="Host PC - characterization program\nhost/run_characterization.py: smoke | single run | --suite\nresults JSON carries the BUILD record", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    vivado [group=J, label="Host PC - Vivado\nmake bitstream / make program\ntcl/build_ila.tcl, capture_ila_*.tcl", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];

    ft232  [group=C, label="UART Bridge Chip\nFT232R - its own /dev/ttyUSB*\n(plug-order dependent: host uses --port auto)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    ft2232 [group=J, label="JTAG Bridge Chip\nFT2232 - serial 200300B818A0\n(FPGA_JTAG_SERIAL picks it on a shared chain)", peripheries=2, style="filled", fillcolor="#D6E4F0"];

    ptop   [group=C, label="Board Pin Top\nrapids_char_genesys2_top\nIBUFDS + MMCM: 200 MHz LVDS -> 100 MHz aclk; reset sync", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    ctop   [group=C, label="Pin-level Top\nrapids_char_top\npins to harness ports, status rollup", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    harn   [group=C, label="Characterization Harness\nrapids_char_harness - u_harness (Figure 2.1)\nUART bridge, decode, CSRs, kick sequencer,\nstimulus, checkers, memory models, meters", peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    dut    [group=C, label="DUT\nrapids_beats_top - split SOURCE + SINK beats DMA\n8 ch, 256-bit AXI4 + AXIS, 4 KB SRAM per channel", penwidth=1.8, peripheries=2, style="filled", fillcolor="#D6E4F0"];

    bar    [group=C, label="Genesys 2 board parts:  200 MHz LVDS oscillator  |  CPU reset button (active low)  |  8 user LEDs  |  Kintex-7 XC7K325T-2 configuration (JTAG)",
            fillcolor="white", width=9.5, height=0.45, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    { rank=same; host; vivado; }
    { rank=same; ft232; ft2232; }
    host -> vivado [style=invis, minlen=3];
    { rank=sink; bar; }
    dut -> bar [style=invis, weight=10];
    host -> ft232 -> ptop -> ctop -> harn -> dut [style=invis, weight=20];

    // UART command path, center
    host  -> ft232 [dir=both, penwidth=1.8, xlabel="USB: ASCII W addr data / R addr\ndown, reply up"];
    ft232 -> ptop  [dir=both, penwidth=1.8, xlabel="UART 115200-8N1\nuart_tx_in / uart_rx_out"];
    ptop  -> ctop  [dir=both, xlabel="UART + aclk / aresetn"];
    ctop  -> harn  [dir=both, xlabel="UART bytes; LED status back"];
    harn  -> dut   [dir=both, xlabel="APB CSRs + kicks, AXIS in;\nAXI4 masters, AXIS out (Figure 2.1)"];

    // JTAG, right column
    vivado -> ft2232 [xlabel="USB"];
    pj [group=J, shape=point, style=invis, width=0.01, label=""];
    { rank=same; harn; pj; }
    ft2232 -> pj [dir=none];
    pj -> bar    [xlabel="JTAG: .bit program,\nILA readout"];

    // board parts, left
    pc [shape=point, style=invis, width=0.01, label=""];
    pl [shape=point, style=invis, width=0.01, label=""];
    { rank=same; pc; pl; dut; }
    pc -> pl -> dut [style=invis];
    ptop -> pc [dir=back];
    pc -> bar  [dir=back, xlabel="200 MHz LVDS sysclk,\ncpu_resetn"];
    ctop -> pl [dir=none];
    pl -> bar  [xlabel="led[7:0]: low 8 bits\nof the status bank"];
}
