// Figure 2.1 -- rapids_char_harness block map, in the house style
// (vault/handbook/authoring/block-diagrams.md). Every block is an instance or
// an inline register block in flows-rapids-beats/rtl/rapids_char_harness.sv.
//   - Host UART is the white port on top; the control path runs down the
//     center (bridge -> region decode -> apb4_master -> DUT s_apb).
//   - The boundary bar is the harness's memory models: what stands in for
//     system memory under every DUT AXI master.
//   - SINK forward data enters left (AXIS generator) and leaves down
//     (m_axi_wr); SOURCE read data comes back UP through the R-channel delay
//     on the right and leaves right (m_axis to the pattern check).
//   - Meters and observers are passive taps (dashed, nothing driven back).
//   - The run timer and CRC verdict (char_run_timer, utility-ip/misc, the same
//     module as the STREAM harness) sits on the far left of the meter row:
//     GO clears and starts it from the CSRs, the memory models' CRCs and beat
//     counts climb to it, and the generator / egress-check CRCs it pairs with
//     them are taps named in its label rather than two more crossing edges.
digraph harness_blocks {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.55", splines=ortho, newrank=true,
           label="rapids_char_harness: control down the center, SINK data left, SOURCE return right", labelloc=t];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    host  [group=C, label="Host UART\nFT232R, 115200-8N1, ASCII W / R lines", fillcolor="white"];
    uart  [group=C, label="UART to AXI4-Lite Master\nuart_axil_bridge - u_uart"];
    dec   [group=C, label="Region Decode on addr[19:16]\ninline in rapids_char_harness\n0 DUT-REG, 1 DESC-LOAD, 2 HARNESS CSR, 3 OBS"];

    csr   [group=L, label="Harness CSRs + Kick Sequencer\ninline: GEN_* CHK_* RESP_DELAY OBS_TARGET\nBUILD, ID; GO = arm window, start gen,\nreplay staged kicks at aclk;\nTIMER_* / CRC_*_MASK read back"];
    apbm  [group=C, label="APB Master\napb4_master - u_apb\nDUT window + every staged kick"];
    dload [group=RR, label="Descriptor Loader (DESC-LOAD)\ninline holding regs: 8 x 32 bits\nDESC_KICK = one 256-bit AXI4 write"];

    meter [group=LL, label="Bus Meters (always built)\naxi_bus_meter on m_axi_rd, m_axi_wr\naxis_bus_meter on s_axis, m_axis\nproductive / backpressure /\nstarvation / idle per cycle;\nfreeze at OBS_TARGET"];
    gen   [group=L, label="AXIS Stimulus\naxis4_master_injector - u_axis_gen\nseeded LFSR, GEN_MODE interleave"];

    tmr   [group=LL, label="Run Timer + CRC Verdict\nchar_run_timer - u_char_run_timer\n(utility-ip/misc; also in STREAM)\nGO clears, then starts; stop at OBS_TARGET\nSOURCE: RD_CRC vs u_axis_chk CRC\nSINK: u_axis_gen CRC vs WR_CRC\nPASS: every active channel equal"];
    obs   [group=LL, label="Interface Observers\n(USE_OBSERVERS=1)\naxi4_intf_master_observer\naxis4_intf_observer\nlatency histograms\nAPB: the OBS region\nthrough apb4_master", style="filled,dashed"];
    dut   [group=C, label="DUT - rapids_beats_top - u_dut\nSINK: s_axis -> SRAM -> m_axi_wr      SOURCE: m_axi_rd -> SRAM -> m_axis\ndescriptor + control-semaphore AXI4 masters per half; MonBus egress m_axil_mon", width=8.5, penwidth=1.8];

    wdly  [group=L, label="Write-Response Delay\naxi_response_delay\nu_wr_resp_delay\nRESP_DELAY[31:16] on B"];
    rdly  [group=R, label="Read-Data Delay\naxi_response_delay\nu_rd_resp_delay\nRESP_DELAY[15:0] on R"];
    chk   [group=RR, label="AXIS Egress Check\naxis4_slave_pattern_check\nu_axis_chk: CRC per channel;\nchk_ready_en = backpressure", fillcolor="white"];

    p_aw [shape=point, style=invis, width=0.01, label=""];
    p_ar [shape=point, style=invis, width=0.01, label=""];
    p_fe [shape=point, style=invis, width=0.01, label=""];
    p_mon [shape=point, style=invis, width=0.01, label=""];

    bar   [group=C, label="Harness memory models (stand in for system memory)\ndescriptor RAM x2 + control RAM x2 (sdpram_slave_axi4_axi4)  |  axi4_slave_wr_crc_check - u_wr_mem  |  axi4_slave_rd_injector - u_rd_mem  |  always-accept AXI4-Lite responder",
           fillcolor="white", width=11.5, height=0.5];

    { rank=same; csr; apbm; dload; }
    { rank=same; tmr; obs; meter; gen; }

    { rank=same; p_aw; wdly; s0; p_ar; s1; p_fe; s2; p_mon; rdly; chk; }
    s0 [shape=box, style=invis, width=1.0, label=""];
    s1 [shape=box, style=invis, width=1.0, label=""];
    s2 [shape=box, style=invis, width=1.0, label=""];

    csr -> apbm -> dload [style=invis];
    tmr -> obs -> meter -> gen [style=invis];

    p_aw -> wdly -> s0 -> p_ar -> s1 -> p_fe -> s2 -> p_mon -> rdly -> chk [style=invis, minlen=2];

    // ---- control flow, center column ----
    host -> uart  [dir=both, penwidth=1.8, xlabel="UART bytes: W / R down, reply up"];
    uart -> dec   [dir=both, xlabel="AXI4-Lite access (32-bit)"];
    dec  -> csr   [xlabel="HARNESS CSR"];
    dec  -> apbm  [xlabel="DUT-REG + OBS"];
    dec  -> dload [xlabel="DESC-LOAD"];
    apbm -> dut   [xlabel="s_apb: CSRs, kicks"];
    csr  -> gen   [style=dashed, xlabel="GO: start"];

    // ---- SINK forward data, left ----
    gen  -> dut   [penwidth=1.8, xlabel="s_axis: LFSR beats"];
    dut  -> p_aw  [dir=none];
    p_aw -> bar   [xlabel="m_axi_wr:\nAW + W"];
    dut  -> wdly  [dir=back, xlabel="B (delayed)"];
    wdly -> bar   [dir=back, xlabel="B"];

    // ---- requests and fetches, center ----
    dut  -> p_ar  [dir=none];
    p_ar -> bar   [xlabel="m_axi_rd:\nAR"];
    dut  -> p_fe  [dir=none];
    p_fe -> bar   [dir=both, xlabel="descriptor +\nsemaphore fetch\n(AXI4, both ways)"];
    dut  -> p_mon [dir=none, style=dashed];
    p_mon -> bar  [style=dashed, xlabel="MonBus m_axil_mon\n(USE_AXI_MONITORS=1)"];

    // ---- SOURCE return, right ----
    dut  -> rdly  [dir=back, penwidth=1.8, xlabel="R (delayed)"];
    rdly -> bar   [dir=back, xlabel="R: LFSR read data"];
    dut  -> chk   [penwidth=1.8, xlabel="m_axis"];
    dload -> bar  [xlabel="descriptor write\n(RAM port B)"];

    // ---- measurement (passive) ----
    meter -> csr  [style=dashed, dir=back, xlabel="GO arms the window"];
    csr  -> tmr   [style=dashed, dir=both, xlabel="GO, OBS_TARGET /\nresult"];
    tmr  -> bar   [style=dashed, dir=back, xlabel="RD / WR CRCs\n+ beat counts"];
    meter -> dut  [style=dashed, dir=back, xlabel="taps (observed,\nnothing driven back)"];
    obs  -> dut   [style=dashed, dir=back, xlabel="same\ntaps"];
}
