// rapids_char_harness block diagram (Figure 6.1 of rapids_beats_findings.md).
// Replaces assets/mmd/04_harness.mmd. House style
// (vault/handbook/authoring/block-diagrams.md, characterization harness: host
// on top, DUT in the center, harness memory models as the bar). Drawn as the
// report shows it; the current RTL also puts an axi_response_delay on the
// m_axi_rd R channel and the m_axi_wr B channel, plus bus meters and
// observers. Source of truth: flows-rapids-beats/rtl/rapids_char_harness.sv.
digraph rapids_char_harness {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, nodesep="0.45", ranksep="0.6", splines=ortho, newrank=true, labelloc=t, labeljust=c, pad="0.2", label="rapids_char_harness: host path, stimulus and checkers around the DUT"];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled, fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];
    host  [label="Host PC", fillcolor="white", style="rounded,filled", fillcolor="#E2EFDA"];
    uart  [label="uart_axil_bridge", peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    fan   [label="AXIL host fanout", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    csr   [label="Harness CSR / APB", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    gen   [label="axis4_master_injector", peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    rdp   [label="axi4_slave_rd_injector", peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    dut   [label="rapids_beats_top (DUT)", width=5, penwidth=1.8, peripheries=2, style="filled", fillcolor="#D6E4F0"];
    chk   [label="axis4_slave_pattern_check", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    wcrc  [label="axi4_slave_wr_crc_check", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    bar   [label="Harness Memories\ndescriptor RAM (SRC)   descriptor RAM (SNK)   control semaphore RAMs", fillcolor="white", width=7, style="rounded,filled,bold", fillcolor="#E2EFDA"];

    host -> uart [xlabel="UART"];
    uart -> fan -> csr;
    csr  -> dut  [xlabel="APB"];
    gen  -> dut  [xlabel="s_axis"];
    rdp  -> dut  [xlabel="m_axi_rd"];
    dut  -> chk  [xlabel="m_axis"];
    dut  -> wcrc [xlabel="m_axi_wr"];
    dut  -> bar  [xlabel="descriptor fetch,\ncontrol masters"];
    { rank=same; gen; csr; rdp; }
    { rank=same; chk; wcrc; }
}
