// Figure 4.1 -- meters, windows and observers on the stream side. House
// style (vault/handbook/authoring/block-diagrams.md): the four observed data
// links are the white boxes on top, each drops (dashed: a passive tap,
// nothing driven back) into its meter, and every count leaves through the
// harness CSR readback, the boundary bar. Which window clears and freezes
// a meter is stated in the meter's label; the two windows themselves are a
// legend box with no edges (one GO broadcast to all meters would be N
// identical edges).
// RTL: rapids_char_harness.sv u_meter_sin / u_meter_sout (axis_bus_meter),
// u_meter_rd / u_meter_wr (axi_bus_meter), u_obs_axis (axis4_intf_observer).
digraph axis_measurement {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.70", splines=ortho, newrank=true,
           label="Measuring the streams: meters, windows, the AXIS observer", labelloc=t];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    l_sin  [group=A, label="s_axis (SINK ingress)\nobserved, nothing driven back", fillcolor="white"];
    l_sout [group=Cc, label="m_axis (SOURCE egress)\nobserved, nothing driven back", fillcolor="white"];
    l_ax   [group=D, label="m_axi_wr W, m_axi_rd R\nobserved, nothing driven back", fillcolor="white"];

    win [label="Windows (armed by GO)\lsin window: opens on the first offered\l    beat, closes after the target-th\l    accepted beat (rapids ISSUE-001)\lshared window: open from GO, closes\l    when wr_prod reaches the target\l", fillcolor="white"];

    m_sin  [group=A, label="AXIS Meter - ingress\naxis_bus_meter\nu_meter_sin; buckets +\nbytes (tstrb) + packets\n(tlast); window: sin"];
    obs    [label="AXIS Observer (USE_OBSERVERS=1)\naxis4_intf_observer - u_obs_axis\nper-tid meters; event tap ->\nPROTOCOL_AXIS MonBus (dropped\nand counted, never stalling);\nport 0: sin window, port 1: shared", style="filled,dashed"];
    m_sout [group=Cc, label="AXIS Meter - egress\naxis_bus_meter\nu_meter_sout; buckets +\nbytes + packets;\nwindow: shared"];
    m_ax   [group=D, label="AXI Meters - write, read\naxi_bus_meter\nu_meter_wr, u_meter_rd\nbuckets; window: shared"];

    bar [label="Harness CSR readback\nOBS_SIN_*  |  observer APB window  |  OBS_SOUT_*  |  OBS_WR_*, OBS_RD_*\n-> results JSON -> report columns\nAXIS-in | AXIS-out | AXI4-wr | AXI4-rd",
         fillcolor="white", width=7];

    { rank=same; l_sin; l_sout; l_ax; }
    l_sin -> l_sout -> l_ax [style=invis];
    { rank=same; m_sin; obs; m_sout; m_ax; }
    m_sin -> obs -> m_sout -> m_ax [style=invis];
    bar -> win [style=invis];

    l_sin  -> m_sin  [style=dashed, xlabel="tap"];
    l_sin  -> obs    [style=dashed, xlabel="port 0"];
    l_sout -> obs    [style=dashed, xlabel="port 1"];
    l_sout -> m_sout [style=dashed, xlabel="tap"];
    l_ax   -> m_ax   [style=dashed, xlabel="taps"];

    m_sin  -> bar [xlabel="counts"];
    obs    -> bar [style=dashed, xlabel="per-tid stats"];
    m_sout -> bar [xlabel="counts"];
    m_ax   -> bar [xlabel="counts"];
}
