// The two AXIS4 links of the rapids-beats system and everything that stands on them.
digraph two_axis_links {
    graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.7,
           label="rapids-beats: the two AXIS4 links and what stands on them", labelloc=t, labeljust=l];
    node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f4f4f4"];
    edge  [fontname="Helvetica", fontsize=9];

    gen [label="axis4_master_injector\nAXIS master, no address channel\nper-channel LFSR (seed ^ ch) + CRC-32\nsequential or interleaved channel schedule\ncfg: seed, beats/ch, beats/pkt (tlast), mask, tdest", fillcolor="#e8f1ff"];
    chk [label="axis4_slave_pattern_check\nAXIS slave, tready = ready_en (backpressure knob)\ndemux by tid into a per-channel LFSR + CRC-32\nsticky data_error, per-channel CRCs,\naggregate beats and packets (tlast)", fillcolor="#e8f1ff"];

    subgraph cluster_dut {
        label="rapids_beats_top: two engines, two stream ports"; style="rounded"; color="#228B22";
        snk [label="rapids_snk_beats  (SINK)\ns_axis slave: tid -> channel, tlast -> fill_last\nsnk_data_path_axis: segment allocation, SRAM,\naxi_write_engine -> m_axi_wr\nAXIS slave monitor-lite (USE_AXI_MONITORS)", fillcolor="#d5ecd5", penwidth=2];
        src [label="rapids_src_beats  (SOURCE)\naxi_read_engine <- m_axi_rd, SRAM,\nsrc_data_path_axis: m_axis master,\ntid = channel, tlast on packet boundary\nAXIS master monitor-lite (USE_AXI_MONITORS)", fillcolor="#d5ecd5", penwidth=2];
    }

    subgraph cluster_meas {
        label="On the wires (passive)"; style="rounded"; color="#404040";
        msin [label="axis_bus_meter  sin\nown window: opens on the first offered beat,\ncloses after the target-th ingress beat", fillcolor="#e9f7e9"];
        msout [label="axis_bus_meter  sout\nshared window", fillcolor="#e9f7e9"];
        obs [label="axis4_intf_observer  (USE_OBSERVERS=1)\nport 0 = s_axis, port 1 = m_axis\nper-tid utilization, exact bytes (tstrb),\npackets (tlast), MonBus taps; own APB window", fillcolor="#e9f7e9", style="rounded,filled,dashed"];
    }

    mem [label="the memory side\naxi_response_delay -> axi4_slave_wr_crc_check (sink)\naxi_response_delay <- axi4_slave_rd_injector (source)", fillcolor="#f4f4f4"];

    gen -> snk [label="s_axis  256-bit, tid[7:0], tdest[3:0], tuser, tstrb, tlast", penwidth=2];
    src -> chk [label="m_axis  256-bit, tid = channel, tlast", penwidth=2];
    snk -> mem [label="m_axi_wr"]; mem -> src [label="m_axi_rd"];
    gen -> msin [style=dotted]; src -> msout [style=dotted];
    gen -> obs [style=dotted]; src -> obs [style=dotted];
}
