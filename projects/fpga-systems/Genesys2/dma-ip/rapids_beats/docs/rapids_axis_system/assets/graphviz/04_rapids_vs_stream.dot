// Side by side: what the STREAM harness and the rapids harness put around their DUTs.
digraph rapids_vs_stream {
    graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.4, ranksep=0.5,
           label="Two harnesses, one methodology: memory-to-memory (STREAM) versus stream-to-memory and memory-to-stream (rapids)",
           labelloc=t, labeljust=l];
    node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f4f4f4"];
    edge  [fontname="Helvetica", fontsize=9];

    subgraph cluster_stream {
        label="STREAM harness"; style="rounded"; color="#404040";
        s_src [label="axi4_dma_slaves: LFSR read source\nbehind m_axi_rd", fillcolor="#e8f1ff"];
        s_dut [label="stream_top_ch8\ndescriptor: src addr, dst addr, length\nm_axi_rd -> SRAM -> m_axi_wr", fillcolor="#d5ecd5", penwidth=2];
        s_snk [label="axi4_dma_slaves: write sink with CRC\nbehind m_axi_wr", fillcolor="#e8f1ff"];
        s_meas [label="two AXI meters + in-core monitors\nor AXI interface observers\n(master on the DUT, slave on the memory side)", fillcolor="#e9f7e9"];
        s_src -> s_dut -> s_snk; s_dut -> s_meas [style=dotted];
    }

    subgraph cluster_rapids {
        label="rapids harness"; style="rounded"; color="#228B22";
        r_gen [label="axis4_master_pattern_gen\n-> s_axis (SINK ingress)", fillcolor="#e8f1ff"];
        r_snk [label="rapids_snk_beats\ns_axis -> SRAM -> m_axi_wr", fillcolor="#d5ecd5", penwidth=2];
        r_wr [label="axi4_slave_wr_crc_check\nbehind m_axi_wr", fillcolor="#e8f1ff"];
        r_rd [label="axi4_slave_rd_pattern_gen\nbehind m_axi_rd", fillcolor="#e8f1ff"];
        r_src [label="rapids_src_beats\nm_axi_rd -> SRAM -> m_axis", fillcolor="#d5ecd5", penwidth=2];
        r_chk [label="axis4_slave_pattern_check\n<- m_axis (SOURCE egress)", fillcolor="#e8f1ff"];
        r_meas [label="four meters (two AXI, two AXIS) +\naxi4_intf_master_observer and axis4_intf_observer,\nor the in-core monitors including\ntwo AXIS monitor-lites", fillcolor="#e9f7e9"];
        r_gen -> r_snk -> r_wr; r_rd -> r_src -> r_chk;
        r_snk -> r_meas [style=dotted]; r_src -> r_meas [style=dotted];
    }

    diff [shape=plaintext, label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#e0e0e0"><b>what changes</b></td><td bgcolor="#e0e0e0"><b>STREAM</b></td><td bgcolor="#e0e0e0"><b>rapids</b></td></tr>
        <tr><td>data ports on the DUT</td><td>2 AXI4 masters</td><td>2 AXI4 masters + 1 AXIS slave + 1 AXIS master</td></tr>
        <tr><td>directions</td><td>one, memory to memory</td><td>two independent engines, each half-duplex</td></tr>
        <tr><td>stimulus start</td><td>the kick</td><td>GO starts the AXIS generator AND fires the kicks</td></tr>
        <tr><td>channel identity on the wire</td><td>AXI id</td><td>tid (plus tdest, tuser carried through)</td></tr>
        <tr><td>packet boundary</td><td>none (descriptor length)</td><td>tlast, beats per packet from the generator</td></tr>
        <tr><td>ingress window</td><td>shared window</td><td>own window, first beat to last (ISSUE-001)</td></tr>
        <tr><td>observers</td><td>AXI master + AXI slave</td><td>AXI master + AXIS (two ports, per-tid)</td></tr>
        <tr><td>measured bytes</td><td>from beats</td><td>exact, from tstrb; packets from tlast</td></tr>
      </table>>];
}
