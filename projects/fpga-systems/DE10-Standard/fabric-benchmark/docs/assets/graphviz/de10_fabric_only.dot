// DE10-Standard fabric benchmark - fabric-only mode (W2), the path in detail
// (PRD 4.1). PLANNED. stream reads the LFSR source and writes the CRC sink;
// no DDR3 controller and no HPS in the path. The endpoints accept the next
// transaction on the last beat of the current one (axi4_dma_slaves), so they
// add no bubbles, and the slave-side meters sit BEFORE the CDC crossings, so
// subtracting slave-side from master-side latency removes the crossings and
// the endpoints too. What is left is the fabric.
// House style: vault/handbook/authoring/block-diagrams.md.
digraph de10_fabric_only {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, nodesep="0.5", ranksep="0.45", splines=ortho, newrank=true, labelloc=t, labeljust=c, pad="0.2",
           label="Fabric-only mode (W2) - stream to the CRC endpoints, nothing but the fabric between (planned)"];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled, fillcolor="white", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    str [label="DMA mover\nstream - m_axi_desc, m_axi_rd, m_axi_wr", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    om  [label="Master-side meters\nobs_master, obs_desc", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    fab [label="FABRIC under test\nthe only thing measured", penwidth=2.2, width=5.5, style="rounded,filled,bold", fillcolor="#E2EFDA"];
    os  [label="Slave-side meters\nobs_slave (rd: LFSR source, wr: CRC sink)", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    dsc [label="Descriptor store\ndesc_ram rd 0x8000_0000", shape=cylinder, style="filled", fillcolor="#E8DFF5"];
    cr  [label="Read crossing\naxi4_cdc_rd", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    cw  [label="Write crossing\naxi4_cdc_wr", peripheries=2, style="filled", fillcolor="#D6E4F0"];
    src [label="LFSR source 0x9000_0000\naxi4_slave_rd_injector - never stalls", peripheries=2, style="filled,diagonals", fillcolor="#FCE4D6"];
    snk [label="CRC sink 0xA000_0000\naxi4_slave_wr_crc_check - never stalls", peripheries=2, style="filled", fillcolor="#D6E4F0"];

    str -> om  [xlabel="desc RD, data RD, data WR"];
    om  -> fab [xlabel="desc RD, data RD, data WR", penwidth=1.6];
    fab -> os  [xlabel="data RD, data WR"];
    fab -> dsc [xlabel="desc RD"];
    os  -> cr  [xlabel="data RD"];
    os  -> cw  [xlabel="data WR"];
    cr  -> src [xlabel="srcsnk_clk"];
    cw  -> snk [xlabel="srcsnk_clk"];
    { rank=same; os; dsc; }
    { rank=same; cr; cw; }
    { rank=same; src; snk; }

    note [label="Fabric = master-side meters minus slave-side meters;\lthe slave-side meters sit before the crossings, so the\lsubtraction removes the crossings and endpoints too.\l\lNot in this path:\l- DDR3 controller, f2sdram, axi4_to_axi3, HPS\l- the configuration path (quiet during the window)\lIn the path, identical both legs:\l- stream, the meters, desc_ram, the crossings, the endpoints\l", fillcolor="white", shape=note];
    { rank=same; str; note; }
}
