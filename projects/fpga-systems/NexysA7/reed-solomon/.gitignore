# Vivado build trees (per build; fpga/bitstream + fpga/reports keep .gitkeep)
build-*/fpga/build/
build-*/fpga/bitstream/*
!build-*/fpga/bitstream/.gitkeep
build-*/fpga/reports/*
!build-*/fpga/reports/.gitkeep
build-*/.flat_filelist.f
build-*/.decl_order_files.txt
build-*/.vivado-build.lock
.Xil/
*.log
*.jou
*.str
*.xpr.user

# Simulation build + log artifacts
build-*/dv/tests/local_sim_build/
build-*/dv/tests/logs/
build-*/dv/tests/__pycache__/
build-*/dv/tests/.pytest_cache/

# PeakRDL byproducts. The rule here used to be stated in this comment with no
# pattern under it, so regenerating dropped an untracked SECOND regmap beside
# the RTL -- the orphan-copy drift CLAUDE.md warns about. ONE regmap is kept,
# dv/tbclasses/rs_loop_regs_regmap.py, because that is the path the host and
# the cocotb harness both read. The regblock RTL stays tracked.
build-*/rtl/generated/*/docs/
build-*/rtl/generated/*/headers/
build-*/rtl/generated/*/*_regmap.py

# Bitstreams never live in git
*.bit
*.bin
*.mcs

# Waveforms
*.vcd
*.fst
*.ghw
*.vcd.hier
*.fst.hier

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Temporary files
*~
*.swp
*.swo
.DS_Store
Thumbs.db
