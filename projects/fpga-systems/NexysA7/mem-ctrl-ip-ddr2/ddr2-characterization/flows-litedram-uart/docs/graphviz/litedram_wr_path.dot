// LiteDRAM WRITE path, AXI user port -> LiteDRAMAXI2Native -> crossbar ->
// BankMachine -> Multiplexer -> DFI (the scheduler output). Every register
// stage drawn; what is combinational is labeled so. Generated by the
// session script gen_litedram_diagrams.py; render with
// bin/render_block_diagram.py. Source: mem-ctrl-ref/litedram (LiteX).
digraph litedram_wr_path {
    rankdir=TB;
    graph [splines=ortho, nodesep=1.5, ranksep=1.2, fontname="Helvetica", fontsize=12, bgcolor="white",
           label=<<B>LiteDRAM write path: AXI AW / W to the multiplexer's DFI command output (Nexys A7 build, DDR2 1:2, two DFI phases)</B>>, labelloc=t, labeljust=c];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled, fillcolor="white", color="black", penwidth=1.2, margin="0.14,0.07"];
    edge  [fontname="Helvetica", fontsize=9, color="#333333", arrowsize=0.7];

    in_ax  [label="AXI AW {addr, id, len, size}\nuser_port_axi_0 (64-bit data, 8-bit id)", style="rounded,filled", fillcolor="#E2EFDA"];
    out_r  [label="AXI B {id, resp}\nto the user port", style="rounded,filled", fillcolor="#E2EFDA"];
    in_w   [label="AXI W {data, strb, last}\nuser_port_axi_0", style="rounded,filled", fillcolor="#E2EFDA"];
    { rank=same; in_ax; in_w; out_r; }
    in_ax -> in_w [style=invis]; in_w -> out_r [style=invis];

    // ---- LiteDRAMAXI2NativeW (frontend/axi.py) -----------------------
    axbuf   [label="aw buffer\nstream.Buffer (aw_buffer, 1 deep)", peripheries=2, fillcolor="#D6E4F0"];
    b2b     [label="Burst to beats\naw_burst2beat: one native command per beat\n(beat counter, address increment by size)", peripheries=2, fillcolor="#D6E4F0"];
    gate    [label="Command request\ncmd_request = aw.valid AND can_write (W data present in w_buffer)"];
    portarb [label="Port arbiter  (RoundRobin(2) between the read and write halves; advances on cmd.last)", shape=invtrapezium, width=5.2, height=0.5, fillcolor="#FFF2CC", penwidth=1.6];
    idbuf   [label="id FIFO\nid_buffer SyncFIFO(16) {id}\n(one entry per AW, popped at the last W beat)", peripheries=2, fillcolor="#D6E4F0"];
    { rank=same; gate; idbuf; }
    gate -> idbuf [style=invis];
    wbuf    [label="W data FIFO\nw_buffer SyncFIFO(16, buffered) {data, strb}\nsent as port.wdata once the beat's command was accepted (w_buffer_send)", shape=cylinder, fillcolor="#E8DFF5"];
    respbuf [label="B FIFO\nresp_buffer SyncFIFO(16) {id, resp}\n(filled when the last W beat is taken)", peripheries=2, fillcolor="#D6E4F0"];
    { rank=same; axbuf; wbuf; }
    axbuf -> wbuf [style=invis];

    // ---- LiteDRAMCrossbar (core/crossbar.py) ---------------------------------
    xbar    [label="Crossbar: bank decode + per-bank RoundRobin(masters) with lock\n(ROW_BANK_COL: bank from the address; one master here, so the lock\nholds the bank for a burst; cmd.ready = granted AND bank.ready)  (comb)"];

    // ---- BankMachine x8 (core/bankmachine.py) ----------------------------------
    la      [label="Command lookahead FIFO, per bank\ncmd_buffer_lookahead SyncFIFO(16, buffered) {we, addr}", shape=cylinder, fillcolor="#E8DFF5"];
    head    [label="Command head, per bank\ncmd_buffer stream.Buffer (1 deep): the request being served", peripheries=2, fillcolor="#D6E4F0"];
    rowreg  [label="Open row, per bank\nrow / row_opened registers; row_hit = row == addr.row (comb)", peripheries=2, fillcolor="#D6E4F0"];
    { rank=same; head; rowreg; }
    head -> rowreg [style=invis];
    bfsm    [label="Bank FSM, per bank\nREGULAR -> (hit: RD/WR) | (miss: PRECHARGE -> tRP) | (closed: ACTIVATE -> tRCD) | AUTOPRECHARGE | REFRESH\nper-bank timers tRC, tRAS, tWTP (write-to-precharge); auto-precharge when the\nlookahead's next row differs from the head's row", style="filled,diagonals", peripheries=2, fillcolor="#FCE4D6"];
    breq    [label="Bank request\ncmd {ras, cas, we, a, ba} + is_read / is_write / is_cmd\n(comb from the FSM state and the head)"];

    // ---- Multiplexer (core/multiplexer.py) -------------------------------------
    chcmd   [label="choose_cmd  (RoundRobin(8) over bank ACT / PRE requests; ACT gated by ras_allowed = tRRD AND tFAW)", shape=invtrapezium, width=5.6, height=0.5, fillcolor="#FFF2CC", penwidth=1.6];
    chreq   [label="choose_req  (RoundRobin(8) over bank RD / WR requests of the current direction; gated by cas_allowed = tCCD)", shape=invtrapezium, width=5.6, height=0.5, fillcolor="#FFF2CC", penwidth=1.6];
    mfsm    [label="Direction FSM\nREAD <-> WRITE via RTW (read_latency - 1) / WTR (tWTR + write latency + tCCD);\nswitch when the current direction runs dry or its anti-starvation timer expires\n(read_time 32 / write_time 16); REFRESH when every bank granted", style="filled,diagonals", peripheries=2, fillcolor="#FCE4D6"];
    gtim    [label="Global timers\ntRRD, tFAW (window of 4), tCCD, tWTR down-counters", peripheries=2, fillcolor="#D6E4F0"];
    refr    [label="Refresher\ntREFI timer + postponer + sequencer (PRE all -> REF, tRFC), ZQCS", peripheries=2, fillcolor="#D6E4F0"];
    { rank=same; mfsm; gtim; refr; }
    mfsm -> gtim [style=invis]; gtim -> refr [style=invis];
    breq -> gtim [style=invis];
    steer   [label="Steerer: per DFI phase select {NOP, choose_cmd, choose_req, refresher}\nphase 0 carries ACT / PRE / REF, the rd / wr command phase carries RD / WR;\nphase registers (sync): cs_n, ras_n, cas_n, we_n, bank, address, rddata_en / wrdata_en", peripheries=2, fillcolor="#D6E4F0"];
    bar [label="DFI command output  (two phases per 75 MHz cycle -> a7ddrphy)",
         shape=box, style="rounded,filled", fillcolor="#E2EFDA", penwidth=2.2, width=13, height=0.45, fontsize=11];

    // ---- command flow ------------------------------------------------------
    in_ax   -> axbuf   [xlabel="aw (flopped)"];
    axbuf   -> b2b     [xlabel="one burst"];
    b2b     -> gate    [xlabel="one beat: {addr, last}"];
    axbuf   -> idbuf   [xlabel="id at the first beat", constraint=false, tailport=e, headport=w];
    gate    -> portarb [xlabel="cmd_request (comb)"];
    portarb -> xbar    [xlabel="native port cmd {addr, we=1, last}\n(comb through the arbiter)", penwidth=1.8];
    xbar    -> la      [xlabel="bank.cmd {row/col addr, we} to the decoded bank\n(comb; pushed into the FIFO)", penwidth=1.8];
    la      -> head    [xlabel="next request (flopped)"];
    head    -> bfsm    [xlabel="head {we, addr} (flopped)", penwidth=1.8];
    rowreg  -> bfsm    [xlabel="row_opened, row_hit (comb compare)", tailport=w, headport=e, constraint=false];
    bfsm    -> breq    [xlabel="state + head -> command (comb)", penwidth=1.8];
    breq    -> chcmd   [xlabel="ACT / PRE requests [8 banks]"];
    breq    -> chreq   [xlabel="RD / WR requests [8 banks]"];
    mfsm    -> chreq   [xlabel="want_reads / want_writes,\ncmd.ready gating"];
    gtim    -> chcmd   [xlabel="ras_allowed"];
    gtim    -> chreq   [xlabel="cas_allowed"];
    chcmd   -> steer   [xlabel="chosen ACT / PRE (comb)", penwidth=1.8];
    chreq   -> steer   [xlabel="chosen RD / WR (comb)", penwidth=1.8];
    refr    -> steer   [xlabel="REF / ZQCS"];
    steer   -> bar     [xlabel="DFI phases (flopped in the steerer)", penwidth=1.8];

    // ---- strobes back up -----------------------------------------------------
    bfsm -> rowreg [dir=back, constraint=false, style=dashed, color="#777777", tailport=n, headport=s, xlabel="row_open / row_close"];
    steer -> bfsm  [dir=back, constraint=false, style=dashed, color="#777777", tailport=w, headport=w, xlabel="cmd.ready (accepted this cycle)\n-> FSM advance, timer loads"];
    steer -> gtim  [dir=back, constraint=false, style=dashed, color="#777777", tailport=e, headport=s, xlabel="accept strobes -> timer loads"];
    refr -> bfsm   [dir=back, constraint=false, style=dashed, color="#777777", tailport=w, headport=e, xlabel="refresh_req / refresh_gnt"];

    // ---- write data down the left, B back up the right --------------------------
    in_w  -> wbuf   [xlabel="W beats (flopped into the FIFO)"];
    wbuf  -> bar    [xlabel="port.wdata {data, we=strb} -> DFI wrdata (phases)\nat write latency, gated by the bank's wdata_ready (flopped)", penwidth=1.8, tailport=s, headport=w];
    idbuf -> respbuf [xlabel="id at the last W beat", style=dashed, color="#777777"];
    out_r -> respbuf [dir=back, color="#1A7A1A", xlabel="B {id, resp}"];
    { rank=same; respbuf; head; }
    rowreg -> respbuf [style=invis];

    note [label="Per-beat commands: an AXI burst becomes N native commands (burst2beat); a write command is\lrequested only once its W data is in w_buffer, so command and data never run apart.\lRow policy: FR-FCFS within a bank is the head of an in-order FIFO -- a row hit at the head\lgoes first, else PRE / ACT; no reordering across the FIFO. Auto-precharge from a one-command\llookahead. Across banks: two round-robins (ACT/PRE and RD/WR) under global timers, direction\lbatches bounded by read_time 32 / write_time 16. The steerer's phase registers are the only\lregister between the bank FSMs and the DFI: bank FSM -> chooser -> phase select is one cone.\l", shape=note, fontsize=9];
    { rank=same; note; steer; }
    note -> steer [style=invis];
}
