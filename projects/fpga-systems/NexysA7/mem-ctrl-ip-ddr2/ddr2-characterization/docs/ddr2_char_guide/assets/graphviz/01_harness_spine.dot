// Figure 2.1 of the DDR2 Characterization Guide: the same figure as the
// pumice FPGA System book Figure 2.1 (NexysA7/mem-ctrl-ip-ddr2/docs/
// pumice_fpga_system/assets/graphviz/02_harness_blocks.dot). Replaces
// assets/mermaid/01_harness_spine.mmd. Keep the two in step.
// Figure 2.1 -- ddr2_char_harness block map, in the memory-controller house
// style (vault/handbook/authoring/block-diagrams.md, the reference is the
// mem-ctrl-ip whole-unit figure). Every block is an instance in
// build-perf/rtl/ddr2_char_harness.sv, ddr2_char_framework/rtl/ddr2_char_macro.sv,
// rtl/mem_char_framework/rtl/char_engine_block.sv or build-perf/rtl/ddr2_char_top.sv.
//   - Host UART on top; the register path fans out through the generated
//     1 -> 6 bridge.
//   - AXI traffic runs down the center from the generator array into pumice.
//   - At DFI the three flows split the reference's way: write data drops down
//     the left undelayed, the command goes down the center through
//     dfi_cmd_delay, and read data climbs back up the right through
//     dfi_rddata_delay. The PHY is the boundary bar.
//   - debug_sram and dfi_mon_ram have no writer on this build: host-access
//     memories only (dashed). obs_apb is an unused expansion slot.
digraph harness_blocks {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.35", ranksep="0.50", splines=ortho, newrank=true,
           label="ddr2_char_harness: register path, generator traffic into pumice, and the DFI tail", labelloc=t];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    host [group=C, label="Host UART (Nexys A7 USB, 115200-8N1)\nASCII W addr data / R addr", fillcolor="white"];
    uart [group=C, label="UART to AXI4-Lite Master\nuart_axil_bridge - u_uart"];
    brg  [group=C, label="Generated 1 -> 6 Bridge\nbridge_ddr2_char_axil - u_bridge\nddr2_apb 0x0, harness_csr 0x1_0000, debug_sram 0x4_0000,\ndfi_mon_ram 0x8_0000, obs_apb 0x9_0000 (unused), chargen_apb 0xA_0000", width=5.5];

    csr  [group=L, label="Harness CSRs (window 0x1_0000)\nharness_csr - u_harness_csr\nCTRL: clear_stats, freeze_trace, soft_reset;\nSTATUS, BUILD_ID, CRCs, timer + beat stamps,\nCTRLR_CFG, DFI_TUNING, perf counts"];
    regs [group=C, label="Generator Config (window 0xA_0000)\napb4_to_peakrdl + chargen_regs\nper-generator window, stride, burst,\nbank span, budget, GO; per-generator STATUS"];
    mem  [group=R, label="Host-access memories (no writer on this build)\nsdpram_slave_axil_axil - u_debug_sram (0x4_0000)\nsdpram_slave_axil_axil - u_dfi_mon_ram (0x8_0000)", fillcolor="white", style="filled,dashed"];

    meter [group=L, label="Perf Instruments\naxi_bus_meter x2 (wr, rd) +\naxi_perf_latency_hist x2\n(observed, nothing driven back)"];
    gen  [group=C, label="Generator Array\nchar_gen_unit - u_gen_unit (in char_engine_block)\nNUM_GEN = 4 writers + 4 readers;\nchar_gen_axi_mux + char_gen_wr_order_q: N:1 onto one s_axi"];

    dut  [group=C, label="DUT - pumice_top_geared - u_ctrl (in ddr2_char_macro)\nAXI4 front-end -> scheduler -> DFI layer; PeakRDL CSR on APB (apb4_to_peakrdl shim)", width=6.5, penwidth=1.8];

    pw   [group=L, shape=point, style=invis, width=0.01, label=""];
    cdly [group=C, label="Command Alignment\ndfi_cmd_delay - u_dfi_cmd_delay\ndelays address / bank / RAS / CAS / WE /\nCS / CKE / ODT + rddata_en by DFI_TUNING"];
    rdly [group=R, label="Read-Data Alignment\ndfi_rddata_delay\nu_dfi_rddata_delay\n(DFI_TUNING.rddata_delay)"];

    adap [group=C, label="DFI Flat to Per-Phase Ports\ndfi_v21_flat_to_a7ddrphy - u_dfi_adapter (in ddr2_char_top)", width=6.5];

    bar  [group=C, label="a7ddrphy - u_a7ddrphy (LiteDRAM-generated on the board; a7ddrphy_stub.sv in sim)  ->  DDR2 pads", fillcolor="white", width=8];

    { rank=same; csr; regs; mem; }
    csr -> regs -> mem [style=invis];
    { rank=same; meter; dut; }
    meter -> dut [style=invis];
    { rank=same; pw; cdly; rdly; }
    pw -> cdly -> rdly [style=invis];

    host -> uart [dir=both, penwidth=1.8, xlabel="UART bytes"];
    uart -> brg  [dir=both, xlabel="AXI4-Lite access"];
    brg  -> csr  [xlabel="harness_csr"];
    brg  -> regs [xlabel="chargen_apb"];
    brg  -> mem  [style=dashed, xlabel="debug_sram,\ndfi_mon_ram"];
    brg  -> dut  [xlabel="ddr2_apb: controller CSRs"];

    regs -> gen  [style=dashed, xlabel="GO + per-generator config"];
    gen  -> dut  [dir=both, penwidth=1.8, xlabel="s_axi: AW + W, AR down;\nB, R up"];
    gen -> meter [style=dashed, xlabel="tap on s_axi"];
    meter -> csr [style=dashed, xlabel="perf counts"];

    dut  -> pw   [dir=none];
    pw   -> adap [xlabel="write data\n(undelayed)"];
    dut  -> cdly [penwidth=1.8, xlabel="DFI command"];
    cdly -> adap [penwidth=1.8, xlabel="aligned command"];
    dut  -> rdly [dir=back, xlabel="read data (aligned)"];
    rdly -> adap [dir=back, xlabel="read data"];
    q1 [shape=point, style=invis, width=0.01, label=""];
    q2 [shape=point, style=invis, width=0.01, label=""];
    q3 [shape=point, style=invis, width=0.01, label=""];
    g1 [shape=box, style=invis, width=1.6, label=""];
    g2 [shape=box, style=invis, width=1.6, label=""];
    { rank=same; q1; g1; q2; g2; q3; }
    q1 -> g1 -> q2 -> g2 -> q3 [style=invis];
    adap -> q1 [dir=none];
    q1 -> bar  [xlabel="Write to DDR\n(per-phase wrdata)"];
    adap -> q2 [dir=none, penwidth=1.8];
    q2 -> bar  [penwidth=1.8, xlabel="DDR Command\n(per phase)"];
    adap -> q3 [dir=back];
    q3 -> bar  [dir=none, xlabel="Read from DDR\n(rddata + valid)"];
}
