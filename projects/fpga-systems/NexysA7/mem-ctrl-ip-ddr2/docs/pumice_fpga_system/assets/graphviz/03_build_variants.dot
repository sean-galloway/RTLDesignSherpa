// Figure 3.1 -- one harness source, five targets. House style
// (vault/handbook/authoring/block-diagrams.md): the shared source is the white
// box on top; every arrow to a target says what that target changes (debug
// cores, the DUT, or the PHY model); the targets are blue. The DUT behind
// each target is named in its label rather than as a floating block.
// Sources: projects/fpga-systems/rtl/mem_char_framework/rtl/ (char_engine_block,
// harness_csr, dfi_cmd_delay, dfi_rddata_delay, led_status_driver) and
// NexysA7/mem-ctrl-ip-ddr2/ddr2_char_framework/rtl/ (ddr2_char_macro,
// dfi_v21_flat_to_a7ddrphy, a7ddrphy_stub, seven_seg_4digit).
digraph build_variants {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.55", ranksep="0.70", splines=ortho, newrank=true,
           label="One harness source, five targets: the harness RTL is the constant", labelloc=t];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    src [group=C, label="One Harness Source\n(no per-build copies, no ifdef forks)\nrtl/mem_char_framework/rtl/: char_engine_block,\nharness_csr, dfi_cmd_delay, dfi_rddata_delay,\nled_status_driver (shared with LiteDRAM)\nddr2_char_framework/rtl/: ddr2_char_macro,\ndfi_v21_flat_to_a7ddrphy, a7ddrphy_stub,\nseven_seg_4digit", fillcolor="white"];

    b1  [group=C, label="build-perf:\nddr2_char.bit\nthe measurement\nbitstream; DUT:\npumice_top_geared\nat 75 MHz"];
    b2  [label="build-perf:\nddr2_char_ila.bit\n+ ILA on controller-\nside signals; same RTL"];
    b3  [label="build-perf:\nddr2_char_ila_phy.bit\n+ ILA on the PHY DQ\ntristate, marked\npost-synthesis"];
    lite [label="flows-litedram-uart:\nlitedram_char.bit\nchar_engine_harness:\nthe same harness minus\npumice; DUT: litedram_core;\nsame host program and CSV,\nso the numbers compare"];
    sim [label="ddr2_char_framework:\nsimulation twin\n(no bitstream)\nverilator + cocotb,\nthe SAME UART\nbytestream as the board"];

    pl [group=L2, shape=point, style=invis, width=0.01, label=""];
    ps [group=R2, shape=point, style=invis, width=0.01, label=""];
    lite [group=L2]; sim [group=R2];
    { rank=same; b2; pl; b1; b3; ps; }
    b2 -> pl -> b1 -> b3 -> ps [style=invis];
    { rank=same; lite; sim; }
    lite -> sim [style=invis, minlen=4];

    src -> b1   [penwidth=1.8, xlabel="as is"];
    src -> b2   [xlabel="+ ILA cores (tcl)"];
    src -> b3   [xlabel="+ post-synth ILA"];
    src -> pl   [dir=none];
    pl  -> lite [xlabel="DUT swapped:\nLiteDRAM"];
    src -> ps   [dir=none];
    ps  -> sim  [xlabel="PHY swapped:\nstub"];
}
