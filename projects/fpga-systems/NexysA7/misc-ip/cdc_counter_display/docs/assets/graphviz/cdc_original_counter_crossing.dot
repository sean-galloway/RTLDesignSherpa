// CDC_ANALYSIS.md crossing #2 (replaces an ASCII timing sketch). HISTORICAL:
// this is the original sync_pulse design the analysis was written against; the
// current build-phase1 RTL crosses with cdc_4_phase_handshake. Event timeline,
// not to scale: btn_clk is 10 Hz (100 ms period), disp_clk 1 kHz (1 ms period).
// Timeline figure, owner ruling 2026-10-13 (ASCII timing sketches become
// graphviz): one row per signal, one column per clock cycle; a shaded "1"
// cell is high, a white "0" cell low, grey "x" don't-care; equal neighbouring
// values merge into one wide cell. House style: vault/handbook/authoring/block-diagrams.md
digraph cdc_original_counter_crossing {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, labelloc=t,
           labeljust=c, label="Original design (sync_pulse): the counter value is stable long before\nthe display samples it", pad="0.15"];
    node  [fontname="Helvetica", fontsize=10, shape=plaintext];
    grid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="black"><TR><TD WIDTH="130" BORDER="0" ALIGN="RIGHT"><B>event</B></TD><TD WIDTH="135" BORDER="0"><B>before</B></TD><TD WIDTH="135" BORDER="0"><B>btn_clk edge</B></TD><TD WIDTH="135" BORDER="0"><B>2-3 ms later</B></TD><TD WIDTH="135" BORDER="0"><B>next disp_clk edge</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">clock domain</TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"> </TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>btn_clk</B></TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>disp_clk</B></TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><B>disp_clk</B></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">increment_pulse</TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="2" WIDTH="270" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">r_count_value</TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">0x3A</TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">0x3B (changes)</TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">0x3B (stable)</TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">0x3B (stable)</TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">pulse_sync</TD><TD COLSPAN="2" WIDTH="270" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="#D6E4F0"><B>1</B></TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white"><FONT COLOR="#555555">0</FONT></TD></TR><TR><TD BORDER="0" ALIGN="RIGHT" HEIGHT="38">r_display_count</TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">0x3A</TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">0x3A</TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">0x3A</TD><TD COLSPAN="1" WIDTH="135" HEIGHT="38" FIXEDSIZE="FALSE" BGCOLOR="white">0x3B (captured)</TD></TR><TR><TD BORDER="0"> </TD><TD COLSPAN="4" BORDER="1" BGCOLOR="white" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="9">The value changes on a btn_clk edge and then sits for 100 ms. The synchronized pulse reaches<BR ALIGN="LEFT"/>the display domain 2-3 ms later, so the multi-bit value is sampled only after it has settled.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
