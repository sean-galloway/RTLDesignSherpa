// render: no-key (decision-tree / process-flow vocabulary, not the element key)
// Figure 4.1 -- watch-fail: breaking a CDC on purpose. A process flow in the
// house vocabulary (vault/handbook/authoring/block-diagrams.md): steps
// top-down in one center column, each naming where it runs, every arrow
// labeled; the sweep loop climbs the right edge dashed; the two "why" notes
// are dashed notes attached to the step they explain.
// Source: build-demo/host/cdc_programs.py watch_fail(), host_cdc_demo.py.
digraph measurement_path {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.40", ranksep="0.45", splines=ortho, newrank=true,
           label="watch-fail: breaking a CDC on purpose, and watching the display say so", labelloc=t];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06", width=4.6];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    s0 [group=C, label="0. Prove the link (host)\nread BUILD_ID, expect 0x43434331 (\"CDC1\");\ncheck STATUS.any_written"];
    s1 [group=C, label="1. Keep the control group (board)\nthe other three counters stay in a correct\nmode for the whole experiment"];
    s2 [group=C, label="2. Break one counter (host)\nDISP_SELECT = that counter; CDC_MODE = 0 NO_CDC\n(raw flop per bit); AUTO_INC = 1; INIT 0, STEP 1, load"];
    s3 [group=C, label="3. Sweep its clock (host)\nDIV_PICKOFF = next point, slow to fast:\nf = sys_clk / 2^(pickoff + 1)"];
    s4 [group=C, label="4. Watch the display (board)\nthe 7-segment shows the broken counter: values\nit never held appear once the clock is fast"];
    s5 [group=C, label="5. Read the same value over UART (host)\nsample VALUE several times, record the spread;\nPRESS_COUNT crosses Gray-coded and stays clean"];
    s6 [group=C, label="Restore (host)\nCDC_MODE = 2 SYNC_FIFO, AUTO_INC = 0, slow pickoff"];

    why [label="Why a slow sweep is not enough: mode 0 mostly\nworks at low clock rates, so a demo that never\nraises the clock 'proves' the broken design fine.\nThe failure is probabilistic; the sweep shows it.", fillcolor="white", style="filled,dashed", width=3.4];
    ctl [label="Why four counters: the other three stay in a\ncorrect mode as the control group, on the same\nboard and bitstream, so a flickering display\ncannot be blamed on the board.", fillcolor="white", style="filled,dashed", width=3.4];

    pl [shape=point, style=invis, width=0.01, label=""];
    pt [shape=point, style=invis, width=0.01, label=""];
    { rank=same; ctl; s1; }
    { rank=same; why; s3; pt; }
    { rank=same; s5; pl; }
    ctl -> s1 [style=invis];
    why -> s3 [style=invis];
    s3 -> pt [style=invis, minlen=2];
    s5 -> pl [style=invis, minlen=2];

    s0 -> s1 [penwidth=1.8, xlabel="link proven"];
    s1 -> s2 [penwidth=1.8, xlabel="three counters correct"];
    s2 -> s3 [penwidth=1.8, xlabel="one counter broken"];
    s3 -> s4 [penwidth=1.8, xlabel="ctr_clk retuned"];
    s4 -> s5 [penwidth=1.8, xlabel="visible on the digits"];
    s5 -> s6 [penwidth=1.8, xlabel="sweep done"];

    ctl -> s1 [style=dashed, constraint=false];
    why -> s3 [style=dashed, constraint=false];

    s5 -> pl [style=dashed, dir=none];
    pl -> pt [style=dashed, dir=none, xlabel="next pickoff"];
    pt -> s3 [style=dashed];
}
