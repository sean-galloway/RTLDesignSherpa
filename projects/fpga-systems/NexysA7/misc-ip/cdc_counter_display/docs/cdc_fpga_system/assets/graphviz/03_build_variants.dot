// render: no-key (conceptual / software figure, not the hardware element key)
// Figure 3.1 -- two builds, two different designs. House style
// (vault/handbook/authoring/block-diagrams.md): the dispatcher Makefile is the
// white box on top; each arrow says which BUILD selects which design; each
// design's compile closure (its filelist) sits under it; the three shared
// modules are the white bar both closures touch. Contrast with the pumice
// system, where one harness source feeds every build.
// Sources: cdc_counter_display/Makefile, build-phase1/rtl/filelists/,
// build-demo/rtl/filelists/.
digraph build_variants {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11,
           nodesep="0.60", ranksep="0.55", splines=ortho, newrank=true,
           label="Two builds, two different designs (compare the pumice system, where the harness is shared)", labelloc=t];
    node  [fontname="Helvetica", fontsize=10, shape=box, style=filled,
           fillcolor="#D6E4F0", color="black", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=9, color="black", arrowsize=0.7];

    mk [label="cdc_counter_display/Makefile - a dispatcher only\nflow logic lives in make/fpga_flow.mk; the build Makefiles are variables.\nOne compile closure per build, and it is the filelist: lint, Vivado and\nthe dv/ equivalence sim all compile the same design", fillcolor="white"];

    p1top [label="build-phase1 - the teaching artifact\ncdc_counter_display_top.sv: ONE FILE\nPress BTNC -> counter +1 -> 7-seg;\nbutton domain 10 Hz, display 1 kHz;\nstandalone, no host"];
    dtop  [label="build-demo - the instrument (default)\ncdc_demo_top + cdc_demo_harness +\ncdc_counter_domain: three files\nfour counters, four clocks, host-set\ndivisors, five CDC modes, watch-fail", penwidth=1.8];

    p1dep [label="phase1 closure adds\nreset_defs, debounce, hex_to_7seg\nNo UART, no CSR, no Xilinx\nprimitive stubs"];
    ddep  [label="demo closure adds\nuart_axil_bridge, bin2gray, gray2bin,\nglitch_free_n_dff_arn, counter_bin,\ncounter_bingray, fifo_control, fifo_async,\ncdc_synchronizer, cdc_open_loop,\ncdc_2_phase_handshake,\nverilator_xilinx_stubs"];

    bar [label="Shared by both closures (three modules + rtl/amba/includes):  clock_divider  |  sync_pulse  |  cdc_4_phase_handshake", fillcolor="white", width=8];

    { rank=same; p1top; dtop; }
    p1top -> dtop [style=invis, minlen=3];
    { rank=same; p1dep; ddep; }

    mk    -> p1top [xlabel="BUILD=phase1"];
    mk    -> dtop  [penwidth=1.8, xlabel="default"];
    p1top -> p1dep [xlabel="filelist"];
    dtop  -> ddep  [xlabel="filelist"];
    p1dep -> bar   [xlabel="+ shared"];
    ddep  -> bar   [xlabel="+ shared"];
}
