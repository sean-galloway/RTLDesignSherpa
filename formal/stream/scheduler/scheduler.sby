[tasks]
prove
cover

[options]
prove: mode bmc
# depth 35 ran 5 h 43 min without finishing on 2026-09-24 (z3, one core); 20
# is the bounded budget -- raise it only with a longer engine budget.
prove: depth 20
cover: mode cover
cover: depth 60

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read_verilog -formal scheduler_flat.v
read -formal -sv formal_scheduler.sv
prep -top formal_scheduler

[files]
formal_scheduler.sv
scheduler_flat.v
