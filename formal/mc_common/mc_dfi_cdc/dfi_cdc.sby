[tasks]
prove
cover

[options]
# The properties are single-domain statements about the logic around the FIFOs
# (see the wrapper header); 20 cycles covers two staged bursts and the init
# token chain end to end.
prove: mode bmc
prove: depth 20
cover: mode cover
cover: depth 20

[engines]
prove: smtbmc bitwuzla
cover: smtbmc bitwuzla

[script]
read_verilog -formal cdc_flat.v
read -formal -sv formal_dfi_cdc.sv
prep -top formal_dfi_cdc

[files]
formal_dfi_cdc.sv
cdc_flat.v
