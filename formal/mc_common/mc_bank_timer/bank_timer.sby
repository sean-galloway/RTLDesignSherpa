[tasks]
prove
cover
equiv
equiv_live

[options]
# The timings are constrained to 1..4 in the wrapper, so 22 cycles is enough to
# see a full tRC elapse and a second ACT permitted after it. Counting a real
# tRC of 60 would unroll 60+ cycles for no extra confidence -- it is the same
# counter at 4 as at 60.
prove: mode bmc
prove: depth 22
cover: mode cover
cover: depth 22
# Equivalence of the ZF_REG registered flags (MC-011) against the golden copy:
# a bounded check, 40 cycles with free single-issue strobes and constant
# timings over the whole 8-bit range. A difference would show within a few
# cycles of any strobe. equiv is the board form (SET_LAG = 1); equiv_live the
# live-strobe form (SET_LAG = 0).
equiv: mode bmc
equiv: depth 40
equiv_live: mode bmc
equiv_live: depth 40

[engines]
prove: smtbmc z3
cover: smtbmc z3
equiv: smtbmc bitwuzla
equiv_live: smtbmc bitwuzla

[script]
read_verilog -formal bank_timer_flat.v
prove: read -formal -sv formal_bank_timer.sv
prove: prep -top formal_bank_timer
cover: read -formal -sv formal_bank_timer.sv
cover: prep -top formal_bank_timer
equiv: read_verilog -formal bank_timer_gold_flat.v
equiv: read -formal -sv formal_bank_timer_equiv.sv
equiv: prep -top formal_bank_timer_equiv
equiv_live: read_verilog -formal bank_timer_gold_flat.v
equiv_live: read -formal -sv formal_bank_timer_equiv.sv
equiv_live: chparam -set SET_LAG 0 formal_bank_timer_equiv
equiv_live: prep -top formal_bank_timer_equiv

[files]
formal_bank_timer.sv
formal_bank_timer_equiv.sv
bank_timer_flat.v
bank_timer_gold_flat.v
