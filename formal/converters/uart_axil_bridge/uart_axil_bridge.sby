[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 30
cover: mode cover
# 50 -> 80: a UART command must arrive before any AXI handshake; AR / AW
# are first reachable at step 71 and W at 72 (measured 2026-10-19), so
# depth 50 could never reach them. Margin over 72.
cover: depth 80

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read_verilog -formal uart_axil_bridge_flat.v
read -formal -sv formal_uart_axil_bridge.sv
prep -top formal_uart_axil_bridge

[files]
formal_uart_axil_bridge.sv
uart_axil_bridge_flat.v
