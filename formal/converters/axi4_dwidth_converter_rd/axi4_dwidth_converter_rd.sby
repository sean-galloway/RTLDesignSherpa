[tasks]
prove
cover
prove_rbypass prove rbypass
cover_rbypass cover rbypass

[options]
prove: mode bmc
prove: depth 25
cover: mode cover
cover: depth 25

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read_verilog -formal axi4_dwidth_converter_rd_flat.v
~rbypass: read -formal -sv formal_axi4_dwidth_converter_rd.sv
prove_rbypass: read -formal -D FORMAL_RBYPASS -sv formal_axi4_dwidth_converter_rd.sv
cover_rbypass: read -formal -D FORMAL_RBYPASS -sv formal_axi4_dwidth_converter_rd.sv
prep -top formal_axi4_dwidth_converter_rd

[files]
formal_axi4_dwidth_converter_rd.sv
axi4_dwidth_converter_rd_flat.v
