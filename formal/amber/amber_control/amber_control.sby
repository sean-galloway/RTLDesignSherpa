[tasks]
prove
cover

[options]
# BMC depth 48, a BUDGET bound, not a derived one. The derived worst-case
# poison arc is ~113 steps (init 18 + install ~29 + invalidating snoop ~6 +
# poisoned lookup, plus the snoop detours the old depth-60 estimate ignored;
# that estimate was under-derived and is UNSOUND for the poison claim), and
# the committed depth was 126 (~11% margin) while the model cost ~68 min at
# that depth. After the 2026-11 FPGA review (victim line as a RAM, block-RAM
# data array, REPLICATED_OUT reset) the same boolector BMC on the same flat
# shows per-step cost that roughly doubles every 2-3 steps past ~45:
# step 48 done at 4h29m, 50 at 8h37m, 53 at 26h06m, and step 54 was still
# open at 30h40m when the run was stopped (2026-11-09). Steps 0-53 all passed.
# Depth 48 is the deepest bound that completes in half a working day; the
# ~113-step arc is NOT covered by BMC on this model and needs an unbounded
# engine (abc pdr and aiger suprove both time out here; rIC3 untried -- see
# vault/handbook/dv/formal.md).
prove: mode bmc
prove: depth 48
cover: mode cover
# 80: all seven covers are witnessed by step 49 (deepest: cp_detour_drain
# @49); 80 leaves margin without paying for the tag store chains.
cover: depth 80

# Engine: boolector, not the house-default z3. Measured on this model:
# z3 4.15.5 incremental exhibits exponential per-step growth (0.09s/0.47s/33.6s
# at BMC depths 4/8/16) and cannot reach depth 80 in hours; boolector passes
# the full depth in seconds. Everything else follows the gaxi_fifo_sync house
# pattern. (Task 13 report, Toolchain findings.)
[engines]
prove: smtbmc boolector
cover: smtbmc boolector

[script]
read_verilog -formal -sv amber_control_flat.v
read -formal -sv formal_amber_control.sv
expose l1_control/state_q l1_control/req_set l1_control/req_tag l1_control/req_we_q l1_control/req_be_q l1_control/req_wdata_q l1_control/upgr_q l1_control/hit_state_q l1_control/hit_way_q l1_control/hit_way_onehot l1_control/victim_way_q l1_control/victim_tag_q l1_control/victim_way_onehot l1_control/victim_valid l1_control/victim_buf_addr l1_control/victim_sn_word l1_control/sn_set_q l1_control/sn_hit_tag_q l1_control/sn_hit_way_q l1_control/sn_hit_way_onehot l1_control/sn_hit_any_q l1_control/sn_pf_q l1_control/sn_stale_q l1_control/sn_victim_q l1_control/sn_upgr_line_q l1_control/sn_beat_q l1_control/sn_beat_gated l1_control/sn_complete l1_control/sn_wr_tag l1_control/sn_ref_q l1_control/sn_ref_grant l1_control/sn_type_q l1_control/w_sn_nxt l1_control/sn_pf_gnt_match l1_control/sn_stale_gnt l1_control/sn_upgr_line_gnt l1_control/victim_match l1_control/sn_hit_any l1_control/sn_hit_state l1_control/pf_active l1_control/pf_addr l1_control/pf_state l1_control/pf_match l1_control/pf_data_valid l1_control/pend_vld_q l1_control/pend_state_q l1_control/install_state_eff l1_control/sn_return_q l1_control/fill_seen_q l1_control/fill_done_q l1_control/drain_seen_q l1_control/drain_done_q
prep -top formal_amber_control
# memories -> discrete FFs: the tag model as an SMT array grows a store chain
# per step and collapses solver throughput past ~step 45; BV+ITE encoding
# is orders of magnitude faster at depth (house apb4_slave_cdc script does
# the same).
memory_map
# sv2v keeps the RTL's elaboration-time $error guards as $print cells
delete t:$print

[files]
formal_amber_control.sv
amber_control_flat.v
includes/reset_defs.svh ../../../rtl/amba/includes/reset_defs.svh
