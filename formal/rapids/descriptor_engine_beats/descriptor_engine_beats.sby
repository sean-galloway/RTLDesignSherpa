[tasks]
prove
cover

[options]
prove: mode bmc
# depth 20 reached step 16 in a 60 min budget on 2026-09-28 (z3, one core; the
# BUG-006 range check made the cone heavier) with no failure; 16 is the bounded
# budget that completes -- raise it only with a longer engine budget.
prove: depth 16
cover: mode cover
cover: depth 50

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read_verilog -formal descriptor_engine_beats_flat.v
read -formal -sv formal_descriptor_engine_beats.sv
prep -top formal_descriptor_engine_beats

