[tasks]
prove
cover

[options]
# bitwuzla, not z3: the SRAM arrays kill z3 (measured 2026-10-02 on this exact
# closure: z3 stuck ~step 15 at a 30-min cap; bitwuzla does the whole depth
# sweep). Depth semantics: `depth N` checks steps 0..N-1. Depth pinned to 15
# so the deepest checked step (14) covers BOTH the deepest cover witness
# (cp_kill_inflight, step 14; cover depth 40 PASS in 27 s) AND every mutation
# CEX observed in the 7-break battery (6 at steps 2-13, and the intermediate-
# beat hold-OR corruption at exactly step 14 -- at depth 14 that mutation
# PASSED, one step out of budget). Measured budget (2026-10-02, NC=2/DW=64/
# SD=8, full shadow state, single core): per-step cost explodes past step 12
# (step 14 ~16 min on a loaded box); depth 16 > 2 h. Depth-14 PASS in 26 min.
prove: mode bmc
prove: depth 15
cover: mode cover
cover: depth 40

[engines]
prove: smtbmc bitwuzla
cover: smtbmc bitwuzla

[script]
read_verilog -formal snk_data_path_axis_flat.v
read -formal -sv formal_snk_data_path_axis.sv
prep -top formal_snk_data_path_axis

[files]
formal_snk_data_path_axis.sv
snk_data_path_axis_flat.v
