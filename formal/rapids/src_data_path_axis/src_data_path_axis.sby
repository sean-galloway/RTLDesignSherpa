[tasks]
prove
cover

[options]
# bitwuzla, not z3: the SRAM arrays kill z3 (measured 2026-10-02 on the sink
# closure). Depth semantics: `depth N` checks steps 0..N-1.
# Prove depth pinned to 16 so the deepest checked step (15) covers the
# deepest cover witness: cp_flush at step 15 (cover depth 40 PASS, all 12
# cp_* reached, 2026-10-03). sby `depth N` checks steps 0..N-1, so a witness
# AT step 15 needs depth 16. Measured budget lives in the Makefile; re-pin
# here if a Task-7 mutation CEX lands at/past the bound.
prove: mode bmc
prove: depth 16
cover: mode cover
cover: depth 40

[engines]
prove: smtbmc bitwuzla
cover: smtbmc bitwuzla

[script]
read_verilog -formal src_data_path_axis_flat.v
read -formal -sv formal_src_data_path_axis.sv
prep -top formal_src_data_path_axis

[files]
formal_src_data_path_axis.sv
src_data_path_axis_flat.v
