[tasks]
prove
cover

[options]
# Liveness BMC depth 112 (TASK-003, 2026-11-20; was 192): the widest bound
# is now 80 (the per-entry age and the snoop wait, each derived in the
# wrapper from the environment's constants: 68 and 62 worst case) -- a
# violating trace must run init (17) + an alloc, then count 80 cycles
# without the entry retiring, so any violation fires by ~98; 112 leaves 14
# steps of margin and covers the hold-off (80) and corner (16) bounds with
# their deeper setups.  The step-5 run at 192 was stopped at step 123
# after 15:41 (TASK-001's stop note); the 128 bounds it was carrying were
# round numbers, not derived ones.  Cover depth 112: the composed corner
# is witnessed around step 29 with free tag data.
prove: mode bmc
prove: depth 112
cover: mode cover
cover: depth 112

# Engine: boolector (the amber Task 13 finding; see jet_prime_control.sby).
[engines]
prove: smtbmc boolector
cover: smtbmc boolector

[script]
read_verilog -formal -sv jet_prime_control_flat.v
read -formal -sv formal_jet_prime_control_live.sv
expose jet_prime_control/r_cmt_state jet_prime_control/r_sn_state jet_prime_control/r_sn_src jet_prime_control/r_sn_allb jet_prime_control/r_upgr_valid jet_prime_control/r_upgr_line jet_prime_control/r_upgr_set jet_prime_control/r_upgr_way jet_prime_control/r_upgr_killed jet_prime_control/r_fill_pend jet_prime_control/r_fill_idx jet_prime_control/r_ar_done jet_prime_control/r_claim_vld jet_prime_control/r_fq_cnt jet_prime_control/w_src_wb jet_prime_control/w_src_mshr jet_prime_control/w_src_array jet_prime_control/w_sn_ref jet_prime_control/w_sn_deliver jet_prime_control/w_mshr_pre_ar
prep -top formal_jet_prime_control_live
memory_map
# sv2v keeps the RTL's elaboration-time $error guards as $print cells
delete t:$print

[files]
formal_jet_prime_control_live.sv
jet_prime_control_flat.v
includes/reset_defs.svh ../../../rtl/amba/includes/reset_defs.svh
