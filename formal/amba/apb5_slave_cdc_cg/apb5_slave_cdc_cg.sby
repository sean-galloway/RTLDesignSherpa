[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 20
cover: mode cover
cover: depth 25

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read_verilog -formal -sv apb5_slave_cdc_cg_flat.v
read -formal -sv -Iincludes formal_apb5_slave_cdc_cg.sv
hierarchy -top formal_apb5_slave_cdc_cg
proc
delete t:$print
flatten
opt_expr
opt_clean
memory_map
async2sync
opt -full
setundef -undriven -init -expose

[files]
formal_apb5_slave_cdc_cg.sv
apb5_slave_cdc_cg_flat.v
includes/reset_defs.svh ../../../rtl/amba/includes/reset_defs.svh
