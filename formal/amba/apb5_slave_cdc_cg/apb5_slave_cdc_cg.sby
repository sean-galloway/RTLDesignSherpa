[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 20
cover: mode cover
cover: depth 25

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read -formal -sv -Iincludes icg.sv
read -formal -sv -Iincludes counter_load_clear.sv
read -formal -sv -Iincludes clock_gate_ctrl.sv
read -formal -sv -Iincludes glitch_free_n_dff_arn.sv
read -formal -sv -Iincludes cdc_synchronizer.sv
read -formal -sv -Iincludes amba_clock_gate_ctrl.sv
read -formal -sv -Iincludes gaxi_fifo_sync.sv
read -formal -sv -Iincludes counter_bin.sv
read -formal -sv -Iincludes find_first_set.sv
read -formal -sv -Iincludes find_last_set.sv
read -formal -sv -Iincludes leading_one_trailing_one.sv
read -formal -sv -Iincludes fifo_control.sv
read -formal -sv -Iincludes gray2bin.sv
read -formal -sv -Iincludes counter_bingray.sv
read -formal -sv -Iincludes counter_johnson.sv
read -formal -sv -Iincludes johnson2bin.sv
read -formal -sv -Iincludes gaxi_fifo_async.sv
read -formal -sv -Iincludes gaxi_skid_buffer.sv
read -formal -sv -Iincludes apb5_slave.sv
read -formal -sv -Iincludes apb5_slave_cdc.sv
read -formal -sv -Iincludes apb5_slave_cdc_cg.sv
read -formal -sv -Iincludes formal_apb5_slave_cdc_cg.sv
prep -top formal_apb5_slave_cdc_cg

