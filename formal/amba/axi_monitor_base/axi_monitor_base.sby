[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
prove: btor btormc
cover: btor btormc

[script]
read_verilog -formal axi_monitor_base_flat.v
prove: read -formal -sv formal_axi_monitor_base.sv
cover: read -formal -D PASSIVE_COVER -sv formal_axi_monitor_base.sv
prep -top formal_axi_monitor_base

[files]
formal_axi_monitor_base.sv
axi_monitor_base_flat.v
