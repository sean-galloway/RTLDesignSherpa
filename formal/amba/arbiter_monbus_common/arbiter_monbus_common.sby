[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 25
cover: mode cover
cover: depth 25

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read_verilog -formal -sv arbiter_monbus_common_flat.v
read -formal -sv formal_arbiter_monbus_common.sv
hierarchy -top formal_arbiter_monbus_common
proc
delete t:$print
flatten
opt_expr
opt_clean
memory_map
async2sync
opt -full
setundef -undriven -init -expose

[files]
formal_arbiter_monbus_common.sv
arbiter_monbus_common_flat.v
