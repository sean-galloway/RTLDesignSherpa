[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 25
cover: mode cover
cover: depth 25

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read_verilog -formal -sv monbus_arbiter_flat.v
read -formal -sv formal_monbus_arbiter.sv
hierarchy -top formal_monbus_arbiter
proc
delete t:$print
flatten
# Free undriven nets BEFORE any opt pass (see arbiter_monbus_common.sby):
# an opt that runs first folds an undriven input to a constant.
setundef -undriven -anyseq
opt_expr
opt_clean
memory_map
async2sync
opt -full
setundef -undriven -init -expose
[files]
formal_monbus_arbiter.sv
monbus_arbiter_flat.v
