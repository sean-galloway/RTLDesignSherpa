[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 20
cover: mode cover
cover: depth 25

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read_verilog -formal -sv apb4_slave_cdc_flat.v
read -formal -sv -Iincludes formal_apb4_slave_cdc.sv
hierarchy -top formal_apb4_slave_cdc
proc
# The RTL warns at runtime about an orphan response with $display. sv2v keeps
# it, yosys turns a CLOCKED message into a $check cell, and async2sync refuses
# one with a clock trigger. The message is a simulation aid, not part of the
# design, so drop the cells rather than change the model to clk2fflogic.
delete t:$print
flatten
# Free undriven nets BEFORE any opt pass. An opt that runs first folds an
# undriven net -- an input the harness left unconnected or never drove -- to
# a constant, pinning it for the whole proof. That is why the axi4 *_mon
# monbus covers were unreachable for as long as they existed: sixteen
# inputs pinned, including enables the packet path needs. sby's own plain
# prep already does this (setundef -undriven -anyseq); this script
# replaced prep, so it has to say so itself. (2026-09-11)
setundef -undriven -anyseq
opt_expr
opt_clean
memory_map
async2sync
opt -full
setundef -undriven -init -expose
[files]
formal_apb4_slave_cdc.sv
apb4_slave_cdc_flat.v
includes/reset_defs.svh ../../../rtl/amba/includes/reset_defs.svh
