read -formal -sv -Iincludes glitch_free_n_dff_arn.sv
read -formal -sv -Iincludes find_first_set.sv
read -formal -sv -Iincludes find_last_set.sv
read -formal -sv -Iincludes leading_one_trailing_one.sv
read -formal -sv -Iincludes fifo_control.sv
read -formal -sv -Iincludes gray2bin.sv
read -formal -sv -Iincludes counter_bingray.sv
read -formal -sv -Iincludes counter_johnson.sv
read -formal -sv -Iincludes johnson2bin.sv
read -formal -sv -Iincludes gaxi_fifo_async.sv
read -formal -sv -Iincludes amba_clock_gate_ctrl.sv
read -formal -sv -Iincludes apb_slave.sv
read -formal -sv -Iincludes apb_slave_cdc_cg.sv
read -formal -sv -Iincludes formal_apb_slave_cdc_cg.sv
prep -top formal_apb_slave_cdc_cg

