[tasks]
prove
bmc
cover

[options]
prove: mode prove
bmc: mode bmc
bmc: depth 20
cover: mode cover
cover: depth 40

[engines]
# suprove, not abc pdr: after the 2026-10-22 timing edits (free entry written
# every cycle, req_ok as one flat reduction) abc pdr times out at 50 min on
# the same properties; suprove proves them in ~2.5 min and returns FAIL on
# the write-every-entry and req_ok=1 mutants.
prove: aiger suprove
bmc: smtbmc bitwuzla
cover: smtbmc bitwuzla

[script]
read_verilog -formal bridge_id_remap_flat.v
read -formal -sv -Iincludes formal_bridge_id_remap.sv
prep -top formal_bridge_id_remap

[files]
formal_bridge_id_remap.sv
bridge_id_remap_flat.v
includes/reset_defs.svh ../../../rtl/amba/includes/reset_defs.svh
