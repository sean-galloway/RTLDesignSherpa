[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read -formal -sv -Iincludes arbiter_priority_encoder.sv
read -formal -sv -Iincludes arbiter_round_robin.sv
read -formal -sv -Iincludes arbiter_deficit_round_robin.sv
read -formal -sv formal_arbiter_drr.sv
prep -top formal_arbiter_drr

[files]
arbiter_priority_encoder.sv ../../../rtl/common/arbiter_priority_encoder.sv
arbiter_round_robin.sv ../../../rtl/common/arbiter_round_robin.sv
arbiter_deficit_round_robin.sv ../../../rtl/common/arbiter_deficit_round_robin.sv
formal_arbiter_drr.sv
includes/reset_defs.svh ../../../rtl/amba/includes/reset_defs.svh
