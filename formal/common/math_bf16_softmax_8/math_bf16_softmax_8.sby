# Formal proof for math_bf16_softmax_8.
# unpacked array PORT, so the module is flattened to packed Verilog first
# (see the Makefile). Lane i of i_data / ow_result is bits [W*i +: W].

[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 8
cover: mode cover
cover: depth 8

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read_verilog -formal -sv math_bf16_softmax_8_flat.v
read -formal -sv formal_math_bf16_softmax_8.sv
prep -top formal_math_bf16_softmax_8

[files]
formal_math_bf16_softmax_8.sv
math_bf16_softmax_8_flat.v
