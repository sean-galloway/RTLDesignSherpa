# SymbiYosys output directories
*_prove/
*_prove_*/
*_cover/
*_cover_*/
# sby names a run directory <sby>_<task>; these tasks are neither prove nor
# cover, so the two globs above miss them (one was committed 2026-10-19).
bridge_id_remap_bmc/
cmd_arbiter_issue019/
rd_return_ring_data/
scoria_cmd_arbiter_nofix/
# sby status databases (SQLite writes two sidecars beside the db in WAL mode;
# these live in a bare <unit>/<unit>/ dir, which *_prove/ does not match)
status.sqlite
status.sqlite-shm
status.sqlite-wal

# sv2v preprocessing scratch (regenerated by each unit's Makefile)
.sv2v_prep/
# make/formal_flat.mk scratch (flattened list, prep copies, check-flat output)
.flat_build/
