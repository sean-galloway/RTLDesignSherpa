[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 20
cover: mode cover
cover: depth 20

[engines]
prove: smtbmc z3
cover: smtbmc z3

[script]
read -formal -sv -Iincludes gaxi_skid_buffer.sv
read -formal -sv -Iincludes apb4_slave.sv
read -formal -sv -Iincludes apb4_master.sv
read -formal -sv -Iincludes apb5_slave.sv
read -formal -sv -Iincludes apb5_master.sv
read -formal -sv -Iincludes arbiter_priority_encoder.sv
read -formal -sv -Iincludes arbiter_round_robin.sv
read -formal -sv -Iincludes apbx_xbar_2to2_mixed.sv
read -formal -sv -Iincludes formal_apbx_xbar_2to2_mixed.sv
prep -top formal_apbx_xbar_2to2_mixed

[files]
