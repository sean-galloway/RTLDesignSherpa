#!/bin/bash
# pre-commit hook: check SystemVerilog declaration order
#
# Fails the commit if any staged .sv file has signals used before
# their declaration. While SystemVerilog allows forward references,
# some tools (particularly formal verification and certain synthesis
# flows) break when signals are used before declaration.
#
# Install: make setup-hooks
# Bypass:  git commit --no-verify

REPO_ROOT=$(git rev-parse --show-toplevel)

# --- task-tracker integrity (vault/Tasks/) ------------------------------------
# Only when a task page is staged: catches duplicate IDs and a stale
# "Next ID:" line before they enter history. Reusing an ID makes every
# [[LINK]] to it ambiguous, which is how PUMICE-010/011 each ended up naming
# two unrelated tasks.
STAGED_TASKS=$(git diff --cached --name-only --diff-filter=ACM | grep '^vault/Tasks/.*\.md$' || true)
if [ -n "$STAGED_TASKS" ]; then
    echo "[pre-commit] Checking task-tracker IDs..."
    if ! python3 "$REPO_ROOT/bin/check_task_ids.py"; then
        echo ""
        echo "[pre-commit] BLOCKED: task-tracker ID problem."
        echo "  Next free ID:  bin/check_task_ids.py --next <area>"
        echo "  Bypass with:   git commit --no-verify"
        echo ""
        exit 1
    fi
fi

STAGED_SV=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sv$' || true)

if [ -z "$STAGED_SV" ]; then
    exit 0
fi

NUM_FILES=$(echo "$STAGED_SV" | wc -l)
echo "[pre-commit] Checking declaration order in $NUM_FILES staged .sv file(s)..."

python3 "$REPO_ROOT/bin/check_sv_decl_order.py" --staged
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "[pre-commit] BLOCKED: Signal(s) used before declaration."
    echo "  Fix the ordering or bypass with: git commit --no-verify"
    echo ""
fi

exit $STATUS
